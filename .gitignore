# --- Build output ---
bin/
obj/
artifacts/
# Anchored deliberately. Unanchored, this matched ANY directory named "publish" at any
# depth, which silently excluded src/Castmill.Api/Services/Publish/ — four source files —
# from the repo, so a clean clone did not compile. Only `dotnet publish -o publish` at the
# root is build output; nested publish output is already covered by bin/.
/publish/
*.binlog

# --- IDE / user state ---
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
*.user
*.suo
.DS_Store
.idea/

# --- SECRETS — never committed, no exceptions ---
# Dev config holds the local connection string + signing key; the committed
# appsettings.Development.template.json documents the required keys.
appsettings.Development.json
# Local-only config (loaded last in dev, excluded from publish)
appsettings.Local.json
appsettings.*.Local.json
# Environment files
.env
.env.*
*.env
# Key material / certificates
*.pfx
*.p12
*.pem
*.key
*.cer
*.crt
# Azure publish profiles contain deployment credentials
*.pubxml
*.pubxml.user
*.PublishSettings
# Local secret stores
secrets.json
.azure/

# --- Test / coverage ---
TestResults/
coverage/
*.trx

# --- Node (editor-interop) ---
node_modules/
dist/

# --- Generated client assets ---
# The editor bundle is esbuild output from src/editor-interop, rebuilt by `npm run build`
# and by the RCL's BuildEditorInterop target. Never hand-edited, never committed.
src/Castmill.UI/wwwroot/js/castmill-editor.js
src/Castmill.UI/wwwroot/js/castmill-editor.js.map
src/Castmill.UI/wwwroot/js/castmill-apextree.js
src/Castmill.UI/wwwroot/js/castmill-apextree.js.map
src/Castmill.UI/wwwroot/js/*.LEGAL.txt
tests/e2e/test-results/
tests/e2e/playwright-report/
