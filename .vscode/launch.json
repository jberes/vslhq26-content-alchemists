{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Castmill API (serves WASM client)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Castmill.Api/bin/Debug/net10.0/Castmill.Api.dll",
      "cwd": "${workspaceFolder}/src/Castmill.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5005"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
