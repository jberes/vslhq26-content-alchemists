root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,csproj,props,targets,sln}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Nullability misuse is an error — this codebase treats null-safety as security-relevant
dotnet_diagnostic.CS8600.severity = error
dotnet_diagnostic.CS8602.severity = error
dotnet_diagnostic.CS8603.severity = error
dotnet_diagnostic.CS8604.severity = error
dotnet_diagnostic.CS8618.severity = error

# LoggerMessage source-gen is a perf micro-optimization; plain ILogger calls
# on cold paths (error handling) are fine here
dotnet_diagnostic.CA1848.severity = none

# var preferences
csharp_style_var_for_built_in_types = true
csharp_style_var_when_type_is_apparent = true
csharp_style_var_elsewhere = true

# Expression-bodied members where natural
csharp_style_expression_bodied_methods = when_on_single_line
csharp_style_expression_bodied_properties = true

# File-scoped namespaces
csharp_style_namespace_declarations = file_scoped:error

# EF Core migrations are tool-generated — exempt from style/quality analyzers
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

# Test projects: underscore test names are idiomatic xUnit; inline literal
# arrays in test payloads are clearer than hoisted fields
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.xUnit1051.severity = none
