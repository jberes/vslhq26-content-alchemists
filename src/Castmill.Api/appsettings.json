{
  // SECURITY: this file is committed — it must never contain secrets.
  // Jwt:SigningKey and ConnectionStrings:Castmill come from user-secrets in dev
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "castmill-api",
    "Audience": "castmill-clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "ExternalAuth": {
    "AttemptLifetimeMinutes": 10,
    "Providers": {
      "Microsoft": {
        "Enabled": false,
        "ClientId": "",
        "ClientSecret": ""
      },
      "Google": {
        "Enabled": false,
        "ClientId": "",
        "ClientSecret": ""
      }
    },
    "Clients": {
      "Web": {
        "SignInReturnUri": "https://localhost:7124/sign-in",
        "AccountSettingsReturnUri": "https://localhost:7124/settings/security"
      },
      "Desktop": {
        "SignInReturnUri": "",
        "AccountSettingsReturnUri": ""
      }
    }
  },
  "DataProtection": {
    "BlobPath": "system/data-protection/castmill-keyring.xml"
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
