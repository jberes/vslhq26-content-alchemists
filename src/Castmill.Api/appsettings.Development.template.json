{
  // ===========================================================================
  // TEMPLATE — copy to appsettings.Development.json (gitignored) and fill in.
  // appsettings.Development.json is the single source of local dev config;
  // real values (connection string, signing key) must only ever live there.
  // Generate a signing key with:  openssl rand -base64 48
  // ===========================================================================

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  "ConnectionStrings": {
    // Azure SQL, Entra auth (no password; requires `az login`):
    "Castmill": "Server=tcp:YOUR-SERVER.database.windows.net,1433;Database=Castmill;Authentication=Active Directory Default;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30"
    // or SQL auth:
    // "Castmill": "Server=tcp:YOUR-SERVER.database.windows.net,1433;Database=Castmill;User ID=YOUR-USER;Password=YOUR-PASSWORD;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30"
  },

  "Jwt": {
    "Issuer": "castmill-api",
    "Audience": "castmill-clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "SigningKey": "REPLACE-ME--openssl-rand-base64-48--min-32-bytes"
  },

  "RateLimits": {
    "AuthPerMinute": 10,
    "WritesPerMinute": 60
  },

  "Cors": {
    "AllowedOrigins": []
  }
}
