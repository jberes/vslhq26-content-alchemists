{
  // ===========================================================================
  // TEMPLATE — copy to appsettings.Development.json (gitignored) and fill in.
  // appsettings.Development.json is the single source of local dev config;
  // real values (connection string, signing key) must only ever live there.
  // Generate a signing key with:  openssl rand -base64 48
  // ===========================================================================

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  "ConnectionStrings": {
    // Azure SQL, Entra auth (no password; requires `az login`):
    "Castmill": ""
    // or SQL auth:
    // "Castmill": ""
  },

  "Jwt": {
    "Issuer": "castmill-api",
    "Audience": "castmill-clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "SigningKey": "REPLACE-ME--openssl-rand-base64-48--min-32-bytes"
  },

  "ExternalAuth": {
    // External sign-in requires the trusted HTTPS launch profile at
    // https://localhost:7105 because OIDC correlation/nonce cookies are secure-only.
    // Provider callback registrations use https://localhost:7105/signin-microsoft
    // and https://localhost:7105/signin-google respectively.
    "AttemptLifetimeMinutes": 10,
    "Providers": {
      "Microsoft": {
        "Enabled": false,
        "ClientId": "",
        "ClientSecret": ""
      },
      "Google": {
        "Enabled": false,
        "ClientId": "",
        "ClientSecret": ""
      }
    },
    "Clients": {
      "Web": {
        "SignInReturnUri": "https://localhost:7124/sign-in",
        "AccountSettingsReturnUri": "https://localhost:7124/settings/security"
      },
      "Desktop": {
        "SignInReturnUri": "",
        "AccountSettingsReturnUri": ""
      }
    }
  },

  "Castmill": {
    // AES-256-GCM key for encrypted user secrets: openssl rand -base64 32
    "EncryptionKey": "REPLACE-ME--openssl-rand-base64-32--exactly-32-bytes",
    // Optional (B9.3): licence-clean condensed .ttf/.otf used to composite
    // thumbnail headlines. Unset → platform fallback face, and every composite
    // response reports "fontFallback": true.
    "OverlayFontPath": ""
  },

  "Storage": {
    // Preferred: account name only (passwordless via az login + Storage Blob
    // Data Contributor role). Fallback: paste a connection string instead.
    "AccountName": "",
    "ConnectionString": "",
    "PrivateContainer": "private",
    "DefaultSasMinutes": 10,
    "MaxSasMinutes": 60,
    // Hard server-side boundary for resumable audio/video uploads (2 GiB).
    "MaxMediaBytes": 2147483648
  },

  "DataProtection": {
    // Production persists the shared external-auth/cookie key ring here. Development
    // retains the framework's normal local filesystem key ring and ignores this path.
    "BlobPath": "system/data-protection/castmill-keyring.xml"
  },

  "Ai": {
    "ImageApiVersion": "2025-04-01-preview",
    "Foundry": {
      "Endpoint": "",
      "ApiKey": ""
    },
    "Models": {
      // Plain "deployment" uses Ai:Foundry; "resourceName:deployment" routes
      // to the matching Ai:Resources entry (multi-resource deployments).
      "chat": "",
      "chat-audit": "",
      // Second-pass "Tech Edit" (ADR-020). Set it to the name of an Ai:TextProviders
      // entry to cross providers, or to a Foundry deployment to stay in-family.
      // Unset falls back to "chat", the same way "chat-audit" does.
      "chat-tech-edit": "",
      "image": "",
      "image-alt": "",
      "transcribe": ""
    },
    "Resources": {
      // "eastus2": { "Endpoint": "https://...openai.azure.com/", "ApiKey": "" }
    },
    "Providers": {
      // Non-Foundry IMAGE providers (ADR-015 / ADR-037). Text stays Foundry-only.
      //
      // "nano-banana" (Gemini) and "gpt-image" (OpenAI direct) SHIP BUILT-IN — nothing
      // here is needed to use them. Each is inert until its key is stored in the
      // encrypted per-user store, which is what actually gates it:
      //   Settings → AI keys, or PUT /api/v1/settings/secrets/NanoBananaKey
      //                          PUT /api/v1/settings/secrets/OpenAiImageKey
      //
      // Entries below OVERRIDE a built-in field by field (pin a model without losing
      // the endpoint), or switch one off entirely:
      // "nano-banana": { "Model": "gemini-3-pro-image-preview" },
      // "gpt-image":   { "Enabled": false },
      //
      // A provider you invent still has to opt in, and needs a Kind (openai|gemini);
      // its key doubles as the modelAlias a card asks for:
      // "vendor-x": { "Enabled": true, "Kind": "openai", "Endpoint": "https://.../v1",
      //               "Model": "their-model", "Credential": "ImageProviderKey" }
    },
    "TextProviders": {
      // Optional non-Foundry TEXT providers (ADR-020), off unless Enabled, and used
      // only by the second-pass Tech Edit — pass 1 and the whole fan-out stay on
      // Foundry. The key is the name an Ai:Models alias points at. The API key lives
      // in the encrypted store (PUT /api/v1/settings/secrets/TechEditKey), never here.
      // "anthropic": { "Enabled": false, "Kind": "anthropic", "Model": "claude-opus-5" }
    },
    "Speech": {
      // Production uses Endpoint + App Service managed identity. Local development
      // may leave Endpoint empty and provide Region + Key instead.
      "Endpoint": "",
      "Region": "",
      "Key": ""
    }
  },

  "KnowledgeBase": {
    // Optional RAG gateway the Tech Edit consults for product/docs knowledge.
    // The bearer token lives in the encrypted store
    // (PUT /api/v1/settings/secrets/KnowledgeBaseToken), never here.
    "BaseUrl": "",
    // Path and request field name are config because gateways differ; the defaults
    // match a POST {"query": "..."} contract.
    "QueryPath": "/query",
    "QueryField": "query"
  },

  "Publish": {
    "BrokerBaseUrl": ""
  },

  "Seo": {
    // The deep report can make up to roughly twenty metered DataForSEO calls:
    // keywords, SERP, ranked terms, authority, competitors, and four answer engines.
    "BaseUrl": "https://api.dataforseo.com",
    "ApiKey": "",
    "LocationCode": 2840,
    "LanguageCode": "en",
    "RequireAnalysisBeforeGeneration": true
  },

  "ApplicationInsights": {
    "ConnectionString": ""
  },

  "RateLimits": {
    "AuthPerMinute": 10,
    "ExternalAuthStartsPerMinute": 10,
    "ExternalAuthFlowPerMinute": 300,
    "ExternalAuthPollsPerMinute": 300,
    "WritesPerMinute": 60
  },

  "Cors": {
    // The client shells are separate origins. Dev: the WASM dev server ports.
    // Prod: the Static Web App hostname — never a localhost entry, which the
    // startup guard refuses in Production.
    "AllowedOrigins": [ "http://localhost:5084", "https://localhost:7124" ]
  },

  // Development-only conveniences. The seeder refuses to run outside the Development
  // environment, and the password below is a real credential: it lives only in your
  // gitignored appsettings.Development.json, never here and never in git.
  "Dev": {
    "SeedDemoUser": false,
    "DemoUserEmail": "demo@castmill.local",
    "DemoUserDisplayName": "Demo user",
    "DemoUserPassword": ""
  }
}
