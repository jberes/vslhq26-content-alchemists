    // Same canonical ordering as the Mill Floor lanes and the Focus rail (ADR-F40): lane
    // first, then kind, then age — the three views must present content in one order.
    private IEnumerable<ArtifactPreviewResponse> ImageContentItems => Campaign.Artifacts
        .Where(a => ArtifactKinds.IsDistributionContent(a.Kind))
        .OrderBy(a => Array.IndexOf(ArtifactDisplay.LaneOrder, ArtifactDisplay.Lane(a.Kind))
            is var lane && lane >= 0 ? lane : ArtifactDisplay.LaneOrder.Length)
        .ThenBy(a => ArtifactDisplay.KindOrder(a.Kind))
        .ThenBy(a => a.CreatedAt);

