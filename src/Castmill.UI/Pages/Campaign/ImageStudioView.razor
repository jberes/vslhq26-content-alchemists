@* The Image Studio (F10, handoff §8): the campaign's typed image plan as a workbench.
   Slots on the left, the selected slot's prompt/model/variants on the right. Nothing
   generates without an explicit click — variants are live model calls that cost money,
   which is why generation is a button, never a side effect (the user's rule). *@
@page "/campaigns/{CampaignId:guid}/images"
@using Castmill.Core.Ai
@using Castmill.Core.Resources
@using Castmill.UI.Design
@using Castmill.UI.Http
@using Castmill.UI.State
@implements IDisposable
@inject CampaignState Campaign
@inject ImagesClient Images
@inject StudioRunService StudioRun
@inject Castmill.UI.Http.GenerationClient Generation
@inject INotifier Notifier

<PageTitle>@(Campaign.Campaign?.Name ?? "Campaign") — Image studio</PageTitle>

<CampaignShell CampaignId="CampaignId" View="CampaignView.ImageStudio">
    <div class="cm-page">
        <div class="cm-measure--dashboard">
            @if (Campaign.ImageSlots.Count == 0)
            {
                <EmptyState Kicker="Image studio"
                            Headline="No image plan yet."
                            Detail="Every campaign gets six typed slots — YouTube thumbnail, blog header, a social card per shape. Reserving them costs nothing; generating variants is always your click.">
                    <Action>
                        <button type="button" class="cm-button" disabled="@_reserving" @onclick="ReserveAsync">
                            @(_reserving ? "Reserving…" : "Reserve the image plan")
                        </button>
                    </Action>
                </EmptyState>
            }
            else
            {
                <div class="cm-studio">
                    <section>
                        <span class="cm-kicker">Slots · @Campaign.ImagesFilled/@Campaign.ImagesTotal filled</span>
                        <ul class="cm-studio__slots">
                            @foreach (var slot in Campaign.ImageSlots)
                            {
                                <li>
                                    <button type="button"
                                            class="cm-studio__slot @(slot.Id == _selectedId ? "cm-studio__slot--active" : null)"
                                            @onclick="() => SelectSlotAsync(slot)">
                                        <span>@ArtifactDisplay.SlotLabel(slot.Kind)</span>
                                        @if (slot.State == "Filled")
                                        {
                                            <span class="cm-studio__badge">Done</span>
                                        }
                                        <span class="cm-studio__slot-size cm-mono">@slot.TargetWidth×@slot.TargetHeight</span>
                                    </button>
                                </li>
                            }
                        </ul>
                    </section>

                    @if (Selected is { } slot2)
                    {
                        <section class="cm-studio__pane">
                            <div>
                                <h2>@ArtifactDisplay.SlotLabel(slot2.Kind)</h2>
                                <p class="cm-meta">
                                    Generated at exactly @slot2.TargetWidth×@slot2.TargetHeight — the slot's published
                                    size, no client-side cropping.
                                    @if (ProvenanceLine(slot2) is { } prov)
                                    {
                                        <br />
                                        <span>Prompt seeded from @prov</span>
                                    }
                                </p>
                            </div>

                            <div>
                                <span class="cm-kicker">Prompt</span>
                                @* oninput, not onchange: the Generate button must enable while
                                   typing, not after the field loses focus. The PATCH waits for blur. *@
                                <textarea class="cm-studio__prompt" @bind="_prompt" @bind:event="oninput"
                                          @onblur="SavePromptAsync"
                                          placeholder="Describe the image. The generator adds the slot's exact dimensions."></textarea>
                                @if (string.IsNullOrWhiteSpace(_prompt) && Campaign.TranscriptArtifactId is not null)
                                {
                                    <p class="cm-meta">
                                        No prompt yet — write one, or let the AI draft a prompt for
                                        every slot from the transcript's strongest moments.
                                    </p>
                                    <button type="button" class="cm-button cm-button--quiet" disabled="@_seeding"
                                            @onclick="SeedPromptsAsync">
                                        @(_seeding ? "Writing prompts from the source… (~30s)" : "Seed all prompts from the source")
                                    </button>
                                }
                                <div class="cm-studio__chips">
                                    @foreach (var chip in ConstraintChips)
                                    {
                                        <button type="button" class="cm-studio__chip" @onclick="() => AppendChipAsync(chip)">+ @chip</button>
                                    }
                                </div>
                            </div>

                            <div class="cm-studio__models">
                                <span class="cm-kicker">Model</span>
                                @if (_status is null)
                                {
                                    <p class="cm-meta">Checking provider readiness…</p>
                                }
                                else
                                {
                                    @foreach (var provider in _status.ImageProviders)
                                    {
                                        <label class="cm-studio__model @(provider.Ready ? null : "cm-studio__model--off")">
                                            <input type="radio" name="cm-studio-model" disabled="@(!provider.Ready)"
                                                   checked="@(SelectedAlias == provider.Name)"
                                                   @onchange="() => PickModelAsync(provider.Name)" />
                                            <span>@provider.Name</span>
                                            @if (!provider.Ready)
                                            {
                                                <span class="cm-meta">— unavailable: @(provider.Reason ?? "not configured")</span>
                                            }
                                        </label>
                                    }
                                    <label class="cm-studio__model cm-studio__model--off">
                                        <input type="radio" name="cm-studio-model" disabled />
                                        <span>video frame reference</span>
                                        <span class="cm-meta">— unavailable: the clip worker isn't deployed yet</span>
                                    </label>
                                }
                            </div>

                            <div class="cm-studio__row">
                                <span class="cm-kicker">Variants</span>
                                @foreach (var n in VariantChoices)
                                {
                                    <label class="cm-studio__model">
                                        <input type="radio" name="cm-studio-variants" checked="@(_variantCount == n)"
                                               @onchange="() => _variantCount = n" />
                                        <span>@n</span>
                                    </label>
                                }
                                <button type="button" class="cm-button" disabled="@(IsGenerating || !CanGenerate)"
                                        @onclick="GenerateAsync">
                                    @(IsGenerating ? "Generating…" : $"Generate {_variantCount} variants")
                                </button>
                                <span class="cm-meta">≈ @((_variantCount * CostPerVariantUsd).ToString("$0.00")) estimated model spend</span>
                            </div>
                            @if (Campaign.Brand is { } studioBrand)
                            {
                                <p class="cm-meta">
                                    @studioBrand.Name's image style and palette are appended to
                                    every prompt automatically.
                                </p>
                            }
                            @if (!CanGenerate && !IsGenerating)
                            {
                                <p class="cm-meta">
                                    @(string.IsNullOrWhiteSpace(_prompt)
                                        ? "Generate enables as soon as this slot has a prompt."
                                        : _status is null
                                            ? "Waiting for provider readiness…"
                                            : "No image provider is configured — see the model list above.")
                                </p>
                            }
                            @if (_generateError is not null)
                            {
                                <p class="cm-form__error" role="alert">@_generateError</p>
                            }

                            @* The take gallery: every persisted variant for this slot, kept
                               first. In-flight renders show one shimmering tile each, with
                               already-finished takes filling in as the run reports progress. *@
                            <div>
                                <span class="cm-kicker">Takes</span>
                                @if (IsGenerating)
                                {
                                    <p class="cm-meta">
                                        <span class="cm-ai-dot" aria-hidden="true"></span>
                                        Generating @StudioRun.ExpectedVariants — @(StudioRun.Progress?.Completed ?? 0) done…
                                    </p>
                                }
                                else if (_gallery.Count == 0)
                                {
                                    <p class="cm-meta">No takes yet. Generate some — every take is kept here until you discard it.</p>
                                }
                                <div class="cm-gallery">
                                    @if (IsGenerating)
                                    {
                                        @for (var i = 0; i < Math.Max(0, StudioRun.ExpectedVariants - (StudioRun.Progress?.Completed ?? 0)); i++)
                                        {
                                            <div class="cm-skeleton cm-skeleton--tile"></div>
                                        }
                                    }
                                    @foreach (var variant in OrderedGallery)
                                    {
                                        <button type="button" class="cm-gallery__tile" @onclick="() => OpenVariant(variant)">
                                            <img src="@variant.ThumbUrl" width="@variant.Width" height="@variant.Height"
                                                 loading="lazy" decoding="async"
                                                 alt="Take for @ArtifactDisplay.SlotLabel(slot2.Kind)" />
                                            <span class="cm-gallery__meta">
                                                <span class="cm-mono">@variant.Model</span>
                                                @if (variant.State == "Kept")
                                                {
                                                    <span class="cm-badge cm-badge--done">KEPT</span>
                                                }
                                                @if (variant.SteeringNote is not null)
                                                {
                                                    <span class="cm-meta" title="@variant.SteeringNote">steered</span>
                                                }
                                            </span>
                                        </button>
                                    }
                                </div>
                                @foreach (var failure in _failures)
                                {
                                    <p class="cm-form__error">@failure</p>
                                }
                                <button type="button" class="cm-button cm-button--quiet" @onclick="ToggleDiscardedAsync">
                                    @(_showDiscarded ? "Hide discarded takes" : "Show discarded takes")
                                </button>
                            </div>

                            @if (slot2.State == "Filled" && slot2.PublishedUrl is { } published)
                            {
                                <div class="cm-studio__placed">
                                    <span class="cm-kicker">Placed</span>
                                    <img src="@(published + "?v=" + slot2.UpdatedAt.ToUnixTimeSeconds())"
                                         alt="Placed @ArtifactDisplay.SlotLabel(slot2.Kind)" />
                                    <div class="cm-studio__row">
                                        <button type="button" class="cm-button cm-button--quiet" @onclick="ClearAsync">
                                            Clear and redo
                                        </button>
                                    </div>
                                </div>

                                <div>
                                    <span class="cm-kicker">Overlay text</span>
                                    <p class="cm-meta">
                                        Composited server-side over the placed image — never sent to
                                        the model (ADR-013), so editing it never costs a render.
                                    </p>
                                    <div class="cm-studio__row">
                                        <input class="cm-input" maxlength="32" @bind="_headline"
                                               placeholder="Up to 32 characters" />
                                        <span class="cm-mono cm-meta">@(_headline?.Length ?? 0)/32</span>
                                        <label class="cm-studio__model">
                                            <input type="checkbox" @bind="_safeArea" />
                                            <span>@(slot2.Kind == "youtube-thumbnail"
                                                ? "keep YouTube's timestamp corner clear"
                                                : "respect the safe-area inset")</span>
                                        </label>
                                        <button type="button" class="cm-button cm-button--quiet"
                                                disabled="@(_compositing || string.IsNullOrWhiteSpace(_headline))"
                                                @onclick="CompositeAsync">
                                            @(_compositing ? "Compositing…" : "Composite overlay text")
                                        </button>
                                    </div>
                                </div>
                            }
                        </section>
                    }
                </div>
            }

            @if (_openVariant is { } take)
            {
                @* The take dialog: full-size view + steering + keep/discard/place. Custom
                   .cm-modal like the app's confirm dialog — Escape closes, backdrop closes. *@
                <div class="cm-modal" role="presentation" @onclick="CloseVariant">
                    <div class="cm-modal__panel cm-modal__panel--studio" role="dialog" aria-modal="true"
                         aria-labelledby="cm-variant-title" tabindex="-1"
                         @ref="_dialogPanel"
                         @onclick:stopPropagation
                         @onkeydown="OnDialogKey">
                        <h2 id="cm-variant-title" class="cm-front__block-title">
                            @ArtifactDisplay.SlotLabel(Selected?.Kind ?? "") take
                            <span class="cm-meta"> · @take.Model · @take.Width×@take.Height</span>
                        </h2>

                        <img class="cm-variant__preview" src="@take.Url"
                             width="@take.Width" height="@take.Height"
                             alt="Full-size take" />

                        @if (take.SteeringNote is { } note)
                        {
                            <p class="cm-meta">Steered from an earlier take: “@note”</p>
                        }

                        <label class="cm-field">
                            <span class="cm-field__label">Steer a new take from this one</span>
                            <textarea class="cm-input cm-textarea" rows="2" @bind="_steerNote" @bind:event="oninput"
                                      placeholder="e.g. add the host's face on the right, warmer background"></textarea>
                        </label>
                        <div class="cm-studio__chips">
                            @foreach (var chip in SteerChips)
                            {
                                <button type="button" class="cm-studio__chip" @onclick="() => AppendSteerChip(chip)">+ @chip</button>
                            }
                        </div>

                        <div class="cm-form__actions">
                            <button type="button" class="cm-button" disabled="@_placing"
                                    @onclick="() => PlaceAsync(take)">
                                @(_placing ? "Placing…" : "Place in slot")
                            </button>
                            <button type="button" class="cm-button cm-button--quiet"
                                    disabled="@(string.IsNullOrWhiteSpace(_steerNote) || IsGenerating)"
                                    @onclick="() => SteerAsync(take)">
                                New take from this (≈ @CostPerVariantUsd.ToString("$0.00"))
                            </button>
                            @if (take.State != "Kept")
                            {
                                <button type="button" class="cm-button cm-button--quiet"
                                        @onclick='() => SetStateAsync(take, "Kept")'>Keep</button>
                            }
                            @if (take.State != "Discarded")
                            {
                                <button type="button" class="cm-button cm-button--quiet"
                                        @onclick='() => SetStateAsync(take, "Discarded")'>Throw away</button>
                            }
                            else
                            {
                                <button type="button" class="cm-button cm-button--quiet"
                                        @onclick='() => SetStateAsync(take, "Candidate")'>Restore</button>
                            }
                            <button type="button" class="cm-button cm-button--quiet" @onclick="CloseVariant">Close</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</CampaignShell>

@code {
    private static readonly int[] VariantChoices = [2, 4, 6];

    // gpt-image-2 list price at 2026 rates for a single ~1-2 MP render; an estimate on the
    // surface beats a silent bill (the projected-vs-actual honesty rule, applied to money).
    private const decimal CostPerVariantUsd = 0.07m;

    private static readonly string[] ConstraintChips =
    [
        "no text in the image",
        "high contrast focal subject",
        "room for a headline top-left",
        "editorial photography, not illustration",
        "brand-warm palette",
    ];

    /// <summary>Quick adjustments for steering a new take from an existing one.</summary>
    private static readonly string[] SteerChips =
    [
        "add a face",
        "change the background",
        "more contrast",
        "zoom out",
        "warmer light",
        "remove any text",
    ];

    private Guid? _selectedId;
    private string _prompt = string.Empty;
    private string? _savedPrompt;
    private AiStatusResponse? _status;
    private string? _pickedAlias;
    private int _variantCount = 2;
    private bool _reserving;
    private bool _seeding;
    private bool _placing;
    private bool _compositing;
    private bool _showDiscarded;
    private string? _generateError;
    private List<ImageVariantResponse> _gallery = [];
    private List<string> _failures = [];
    private string? _headline;
    private bool _safeArea = true;
    private ImageVariantResponse? _openVariant;
    private string _steerNote = string.Empty;
    private ElementReference _dialogPanel;
    private bool _dialogNeedsFocus;

    [Parameter] public Guid CampaignId { get; set; }

    private ImageSlotResponse? Selected =>
        Campaign.ImageSlots.FirstOrDefault(s => s.Id == _selectedId);

    private string? SelectedAlias => _pickedAlias ?? Selected?.ModelAlias;

    private bool IsGenerating => _selectedId is { } id && StudioRun.IsActiveFor(id);

    private bool CanGenerate => !string.IsNullOrWhiteSpace(_prompt) &&
        _status?.ImageProviders.Any(p => p.Ready) == true;

    /// <summary>Kept takes lead, then candidates, then (when shown) discarded — newest first.</summary>
    private IEnumerable<ImageVariantResponse> OrderedGallery =>
        _gallery
            .OrderBy(v => v.State switch { "Kept" => 0, "Candidate" => 1, _ => 2 })
            .ThenByDescending(v => v.CreatedAt);

    protected override void OnInitialized()
    {
        Campaign.Changed += OnChanged;
        StudioRun.Changed += OnStudioRunChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await SyncSelectionAsync();
        _status ??= await LoadStatusAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_dialogNeedsFocus)
        {
            _dialogNeedsFocus = false;
            await _dialogPanel.FocusAsync();
        }
    }

    private void OnChanged() => InvokeAsync(async () =>
    {
        await SyncSelectionAsync();
        StateHasChanged();
    });

    /// <summary>When the run finishes, the gallery reloads and failures surface.</summary>
    private void OnStudioRunChanged() => InvokeAsync(async () =>
    {
        if (!StudioRun.IsRunning && StudioRun.SlotId == _selectedId)
        {
            if (StudioRun.Error is { } error)
            {
                _generateError = error;
            }
            else if (StudioRun.Result is { } result)
            {
                _failures = [.. (result.Failures ?? []).Select(f => $"Take {f} failed — the rest are fine.")];
                if (result.Variants.Count == 0 && _failures.Count > 0)
                {
                    _generateError = "No takes came back. Try again, or a simpler prompt.";
                }
            }

            await ReloadGalleryAsync();
        }

        StateHasChanged();
    });

    private async Task SyncSelectionAsync()
    {
        if (Campaign.ImageSlots.Count == 0)
        {
            return;
        }
        if (_selectedId is null || Campaign.ImageSlots.All(s => s.Id != _selectedId))
        {
            await SelectSlotAsync(Campaign.ImageSlots[0]);
        }
    }

    private async Task ReloadGalleryAsync()
    {
        if (_selectedId is not { } slotId)
        {
            return;
        }
        try
        {
            _gallery = await Images.ListVariantsAsync(CampaignId, slotId, _showDiscarded);
        }
        catch (ApiException)
        {
            // The gallery just stays as it was; the next action retries.
        }
    }

    private async Task ToggleDiscardedAsync()
    {
        _showDiscarded = !_showDiscarded;
        await ReloadGalleryAsync();
    }

    private void OpenVariant(ImageVariantResponse variant)
    {
        _openVariant = variant;
        _steerNote = string.Empty;
        _dialogNeedsFocus = true;
    }

    private void CloseVariant() => _openVariant = null;

    private void OnDialogKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseVariant();
        }
    }

    private void AppendSteerChip(string chip) =>
        _steerNote = string.IsNullOrWhiteSpace(_steerNote)
            ? chip
            : $"{_steerNote.TrimEnd().TrimEnd(',', '.')}, {chip}";

    private async Task SetStateAsync(ImageVariantResponse variant, string state)
    {
        try
        {
            var updated = await Images.SetVariantStateAsync(CampaignId, variant.SlotId, variant.Id, state);
            _gallery = [.. _gallery.Select(v => v.Id == updated.Id ? updated : v)];
            if (!_showDiscarded && state == "Discarded")
            {
                _gallery = [.. _gallery.Where(v => v.Id != updated.Id)];
                CloseVariant();
            }
            else if (_openVariant?.Id == updated.Id)
            {
                _openVariant = updated;
            }
        }
        catch (ApiException ex)
        {
            Notifier.ShowError(ex.Message);
        }
    }

    private void SteerAsync(ImageVariantResponse source)
    {
        if (Selected is not { } slot || string.IsNullOrWhiteSpace(_steerNote))
        {
            return;
        }
        _generateError = null;
        _failures = [];
        StudioRun.StartSteer(CampaignId, slot.Id, source.Id, _steerNote.Trim());
        CloseVariant();
    }

    private async Task<AiStatusResponse?> LoadStatusAsync()
    {
        try
        {
            return await Images.GetAiStatusAsync();
        }
        catch (ApiException)
        {
            return null; // the pane says "checking…" — a retry happens on next navigation
        }
    }

    private async Task SelectSlotAsync(ImageSlotResponse slot)
    {
        _selectedId = slot.Id;
        _prompt = slot.Prompt ?? string.Empty;
        _savedPrompt = slot.Prompt;
        _pickedAlias = null;
        _gallery = [];
        _failures = [];
        _generateError = null;
        _openVariant = null;
        _headline = slot.HeadlineText;
        _safeArea = slot.SafeArea;
        await ReloadGalleryAsync();
    }

    private async Task ReserveAsync()
    {
        _reserving = true;
        try
        {
            await Images.ReserveAsync(CampaignId);
            await Campaign.LoadAsync(CampaignId, force: true);
        }
        catch (ApiException ex)
        {
            Notifier.ShowError(ex.Message);
        }
        finally
        {
            _reserving = false;
        }
    }

    /// <summary>
    /// Runs the image-prompts generator through the fan-out path — the only path that
    /// seeds slot prompts server-side, each tied to the transcript moment it illustrates.
    /// </summary>
    private async Task SeedPromptsAsync()
    {
        if (Campaign.TranscriptArtifactId is not { } transcriptId)
        {
            return;
        }
        _seeding = true;
        try
        {
            await Generation.GenerateAsync(CampaignId, transcriptId, null, ["image-prompts"]);
            await Campaign.LoadAsync(CampaignId, force: true);
            if (Selected is { } refreshed)
            {
                _prompt = refreshed.Prompt ?? string.Empty;
                _savedPrompt = refreshed.Prompt;
            }
            Notifier.ShowSuccess("Every slot now has a prompt drawn from the transcript.");
        }
        catch (ApiException ex)
        {
            Notifier.ShowError(ex.Message);
        }
        finally
        {
            _seeding = false;
        }
    }

    private async Task SavePromptAsync()
    {
        if (Selected is not { } slot || string.Equals(_prompt, _savedPrompt, StringComparison.Ordinal))
        {
            return;
        }
        try
        {
            await Images.PatchAsync(CampaignId, slot.Id, prompt: _prompt);
            _savedPrompt = _prompt;
        }
        catch (ApiException ex)
        {
            Notifier.ShowError(ex.Message);
        }
    }

    private Task AppendChipAsync(string chip)
    {
        _prompt = string.IsNullOrWhiteSpace(_prompt) ? chip : $"{_prompt.TrimEnd().TrimEnd(',', '.')}, {chip}";
        return SavePromptAsync();
    }

    private async Task PickModelAsync(string alias)
    {
        if (Selected is not { } slot)
        {
            return;
        }
        _pickedAlias = alias;
        try
        {
            await Images.PatchAsync(CampaignId, slot.Id, modelAlias: alias);
        }
        catch (ApiException ex)
        {
            Notifier.ShowError(ex.Message);
        }
    }

    /// <summary>Fires the run through StudioRunService, so it survives navigating away —
    /// the studio shows one skeleton tile per expected take while the press works.</summary>
    private async Task GenerateAsync()
    {
        if (Selected is not { } slot)
        {
            return;
        }
        await SavePromptAsync();

        _generateError = null;
        _failures = [];
        StudioRun.StartGenerate(CampaignId, slot.Id, _variantCount);
    }

    private async Task PlaceAsync(ImageVariantResponse variant)
    {
        if (Selected is not { } slot)
        {
            return;
        }
        _placing = true;
        try
        {
            // The blog carries the ![stub:kind]() markers; if one exists, placing rewrites it.
            var blogId = Campaign.Artifacts.FirstOrDefault(a => a.Kind == "blog")?.Id;
            var result = await Images.PlaceAsync(CampaignId, slot.Id, variant.Id, blogId);
            CloseVariant();
            Notifier.ShowSuccess(result.BlogVersion is null
                ? "Placed and published."
                : "Placed, published, and the blog's stub is now the real image.");
            await Campaign.LoadAsync(CampaignId, force: true);
            await ReloadGalleryAsync();
        }
        catch (ApiException ex)
        {
            Notifier.ShowError(ex.Message);
        }
        finally
        {
            _placing = false;
        }
    }

    private async Task CompositeAsync()
    {
        if (Selected is not { } slot || string.IsNullOrWhiteSpace(_headline))
        {
            return;
        }
        _compositing = true;
        try
        {
            var result = await Images.CompositeAsync(CampaignId, slot.Id, _headline!, _safeArea);
            Notifier.ShowSuccess(result.FontFallback == true
                ? "Headline composited (system typeface — the display font wasn't available server-side)."
                : "Headline composited.");
            await Campaign.LoadAsync(CampaignId, force: true);
        }
        catch (ApiException ex)
        {
            Notifier.ShowError(ex.Message);
        }
        finally
        {
            _compositing = false;
        }
    }

    private async Task ClearAsync()
    {
        if (Selected is not { } slot)
        {
            return;
        }
        try
        {
            await Images.DeleteAsync(CampaignId, slot.Id);
            await Campaign.LoadAsync(CampaignId, force: true);
        }
        catch (ApiException ex)
        {
            Notifier.ShowError(ex.Message);
        }
    }

    /// <summary>"the transcript at 12:34" — the same provenance idea as the Mill Floor threads.</summary>
    private string? ProvenanceLine(ImageSlotResponse slot)
    {
        if (slot.SourceSegmentId is null || Campaign.Transcript is null)
        {
            return null;
        }
        var segment = Campaign.Transcript.Segments.FirstOrDefault(s => s.Id == slot.SourceSegmentId);
        if (segment is null)
        {
            return "the transcript";
        }
        var at = TimeSpan.FromSeconds(segment.StartSeconds);
        return $"the transcript at {(int)at.TotalMinutes}:{at.Seconds:00} — “{Truncate(segment.Text, 80)}”";
    }

    private static string Truncate(string text, int max) =>
        text.Length <= max ? text : text[..max].TrimEnd() + "…";

    public void Dispose()
    {
        Campaign.Changed -= OnChanged;
        StudioRun.Changed -= OnStudioRunChanged;
    }
}
