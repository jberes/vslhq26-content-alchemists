    private async Task LoadThumbnailConceptsAsync()
    {
        var preview = Campaign.Artifacts
            .Where(a => a.Kind == "thumbnail-concepts")
            .OrderByDescending(a => a.CreatedAt)
            .FirstOrDefault();
        if (preview is null || preview.Id == _conceptArtifactId)
        {
            return;
        }

        try
        {
            var (artifact, _) = await Campaigns.GetArtifactAsync(CampaignId, preview.Id);
            using var doc = JsonDocument.Parse(artifact.ContentJson);
            var root = doc.RootElement;
            var content = root.TryGetProperty("content", out var nested) ? nested : root;
            _thumbnailConcepts.Clear();
            if (content.TryGetProperty("concepts", out var concepts) && concepts.ValueKind == JsonValueKind.Array)
            {
                foreach (var item in concepts.EnumerateArray())
                {
                    _thumbnailConcepts.Add(new ThumbnailConcept(
                        Text(item, "name"), Text(item, "angle"), Text(item, "prompt"),
                        Text(item, "overlayText"), Text(item, "reason")));
                }
            }
            _conceptArtifactId = preview.Id;
        }
        catch (Exception ex) when (ex is ApiException or JsonException)
        {
            _thumbnailConcepts.Clear();
        }

        static string Text(JsonElement item, string name) =>
            item.TryGetProperty(name, out var value) && value.ValueKind == JsonValueKind.String
                ? value.GetString() ?? string.Empty
                : string.Empty;
    }

