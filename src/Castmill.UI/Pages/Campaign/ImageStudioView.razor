@* Image Studio. Phase F10 builds the studio pane — model gating on /ai/status, the
   provenance-labelled prompt, variants, reference frames and the headline compositor.
   F3 renders the image plan column, which is real data from the Preview payload (G9). *@
@page "/campaigns/{CampaignId:guid}/images"
@using Castmill.UI.Design
@using Castmill.UI.State
@implements IDisposable
@inject CampaignState Campaign

<PageTitle>@(Campaign.Campaign?.Name ?? "Campaign") — Image studio</PageTitle>

<CampaignShell CampaignId="CampaignId" View="CampaignView.ImageStudio">
    <div class="cm-region cm-pad">
        @if (Campaign.ImageSlots.Count == 0)
        {
            <EmptyState Kicker="Image plan"
                        Headline="No slots are reserved yet."
                        Detail="Six typed slots are reserved when a run starts, each with the transcript moment it illustrates." />
        }
        else
        {
            <div class="cm-studio">
                <section class="cm-plan">
                    <h2 class="cm-kicker">Image plan</h2>
                    <ul class="cm-plan__slots">
                        @foreach (var slot in Campaign.ImageSlots)
                        {
                            <li class="cm-plan__slot">
                                <span class="cm-plan__slot-name">@ArtifactDisplay.SlotLabel(slot.Kind)</span>
                                <span class="cm-mono cm-meta">@slot.TargetWidth×@slot.TargetHeight</span>
                                <span class="cm-badge @(IsFilled(slot.State) ? "cm-badge--done" : "cm-badge--empty")">
                                    @(IsFilled(slot.State) ? "DONE" : "EMPTY")
                                </span>
                            </li>
                        }
                    </ul>
                    <p class="cm-meta">@Campaign.ImagesFilled of @Campaign.ImagesTotal filled</p>
                </section>

                <section class="cm-plan__studio">
                    <p class="cm-meta">
                        The studio pane — model radio group, prompt with constraint chips,
                        variant tiles, reference frame and the thumbnail headline preview —
                        arrives with Phase F10.
                    </p>
                </section>
            </div>
        }
    </div>
</CampaignShell>

@code {
    [Parameter] public Guid CampaignId { get; set; }

    protected override void OnInitialized() => Campaign.Changed += OnChanged;

    private static bool IsFilled(string state) => string.Equals(state, "Filled", StringComparison.Ordinal);

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Campaign.Changed -= OnChanged;
}
