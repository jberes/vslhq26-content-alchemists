    private bool ConstraintSelected(string chip) => ContainsConstraint(_prompt, chip);

    private async Task ToggleConstraintChipAsync(string chip)
    {
        if (Selected is not { } slot)
        {
            return;
        }

        var previous = _prompt;
        _prompt = ToggleConstraint(_prompt, chip);
        try
        {
            await Images.PatchAsync(CampaignId, slot.Id, prompt: _prompt);
            _savedPrompt = _prompt;
        }
        catch (ApiException ex)
        {
            _prompt = previous;
            Notifier.ShowError(ex.Message);
        }
    }

    private static bool ContainsConstraint(string? text, string chip) =>
        !string.IsNullOrWhiteSpace(text)
        && text.Contains(chip, StringComparison.OrdinalIgnoreCase);

    private static string ToggleConstraint(string? text, string chip)
    {
        var value = text?.Trim() ?? string.Empty;
        if (!ContainsConstraint(value, chip))
        {
            return string.IsNullOrWhiteSpace(value)
                ? chip
                : $"{value.TrimEnd().TrimEnd(',', '.')}, {chip}";
        }

        var index = value.IndexOf(chip, StringComparison.OrdinalIgnoreCase);
        var before = value[..index].TrimEnd().TrimEnd(',', '.').TrimEnd();
        var after = value[(index + chip.Length)..].TrimStart().TrimStart(',', '.').TrimStart();
        return string.Join(", ", new[] { before, after }.Where(part => part.Length > 0));
    }

    private void OpenModelPicker()
    {
        _modelDraft = UsesWorkspaceDefault ? WorkspaceDefaultModel : EffectiveAlias;
        _modelPickerError = null;
        _modelPickerOpen = true;
        _modelPickerNeedsFocus = true;
    }

    private void CloseModelPicker()
    {
        if (_modelPickerBusy)
        {
            return;
        }
        _modelPickerOpen = false;
        _modelPickerError = null;
    }

    private void OnModelPickerKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseModelPicker();
        }
    }

    private async Task ApplyModelAsync()
    {
        if (Selected is not { } slot || !CanApplyModel)
        {
            return;
        }

        _modelPickerBusy = true;
        _modelPickerError = null;
        try
        {
            if (_modelDraft == WorkspaceDefaultModel)
            {
                await Images.PatchAsync(CampaignId, slot.Id, useDefaultModel: true);
                _sessionModelOverrides[slot.Id] = null;
            }
            else
            {
                await Images.PatchAsync(CampaignId, slot.Id, modelAlias: _modelDraft);
                _sessionModelOverrides[slot.Id] = _modelDraft;
            }
            _modelPickerOpen = false;
            Notifier.ShowSuccess(UsesWorkspaceDefault
                ? "This image now follows the workspace default model."
                : "Image model updated for this image.");
        }
        catch (ApiException ex)
        {
            _modelPickerError = ex.Message;
        }
        finally
        {
            _modelPickerBusy = false;
        }
    }

    /// <summary>Fires the run through StudioRunService, so it survives navigating away —
    /// the studio shows one skeleton tile per expected take while the press works.</summary>
    private async Task GenerateAsync()
    {
        if (Selected is not { } slot)
        {
            return;
        }
        await SavePromptAsync();

        _generateError = null;
        _failures = [];
        // The model goes with the request. Reading it from the slot instead meant a save that
        // failed (or simply hadn't landed) rendered with the previous model without saying so.
        StudioRun.StartGenerate(CampaignId, slot.Id, _variantCount, EffectiveAlias);
    }

    private async Task GeneratePendingAsync()
    {
        if (CurrentBatchPlan.MissingVariants == 0)
        {
            return;
        }
        await SavePromptAsync();
        _handledBatchRun = null;
        StudioRun.StartBatch(CampaignId, _batchTakeTarget);
    }

