    /// <summary>"the transcript at 12:34" — the same provenance idea as the Mill Floor threads.</summary>
    private string? ProvenanceLine(ImageSlotResponse slot)
    {
        if (slot.SourceSegmentId is null || Campaign.Transcript is null)
        {
            return null;
        }
        var segment = Campaign.Transcript.Segments.FirstOrDefault(s => s.Id == slot.SourceSegmentId);
        if (segment is null)
        {
            return "the transcript";
        }
        var at = TimeSpan.FromSeconds(segment.StartSeconds);
        return $"the transcript at {(int)at.TotalMinutes}:{at.Seconds:00} — “{Truncate(segment.Text, 80)}”";
    }

    private static string Truncate(string text, int max) =>
        text.Length <= max ? text : text[..max].TrimEnd() + "…";

