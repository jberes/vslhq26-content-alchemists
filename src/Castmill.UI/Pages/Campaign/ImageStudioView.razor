    /// <summary>Blogs in the campaign, oldest first — the candidates a stub can be placed into.</summary>
    private IReadOnlyList<ArtifactPreviewResponse> Blogs =>
        [.. Campaign.Artifacts.Where(a => a.Kind == "blog").OrderBy(a => a.CreatedAt)];

    /// <summary>
    /// The blog whose <c>![stub:kind]()</c> markers a placement rewrites. This used to be
    /// <c>Artifacts.FirstOrDefault(a =&gt; a.Kind == "blog")</c>, which is the OLDEST blog because
    /// the preview is ordered by kind then creation — so with two blogs, placing an image for
    /// the second one silently patched the first one's markdown.
    ///
    /// A slot reserved for a specific blog now carries that blog's id, so it answers for
    /// itself; the picker is only needed for legacy slots reserved before slots were
    /// artifact-scoped, which have no id to follow.
    /// </summary>
    private Guid? TargetBlogId =>
        Selected?.ArtifactId
        ?? (_targetBlogId is { } picked && Blogs.Any(b => b.Id == picked) ? picked : Blogs.FirstOrDefault()?.Id);

    /// <summary>Only these slot kinds have a stub marker in a blog; the rest place standalone.</summary>
    private static bool IsBlogSlot(string kind) =>
        kind.StartsWith("blog-", StringComparison.Ordinal);

    private IReadOnlyList<ImageModelChoice> ModelChoices => ImageModelCatalog.Choices(_status);

    /// <summary>Null is meaningful: it means this card follows the workspace preference.
    /// The dictionary distinguishes an explicit session clear from a stale preview row.</summary>
    private string? ExplicitModelAlias
    {
        get
        {
            if (Selected is not { } slot)
            {
                return null;
            }
            return _sessionModelOverrides.TryGetValue(slot.Id, out var sessionAlias)
                ? sessionAlias
                : slot.ModelAlias;
        }
    }

    private bool UsesWorkspaceDefault => string.IsNullOrWhiteSpace(ExplicitModelAlias);

    private ImageModelChoice? DefaultModel =>
        ImageModelCatalog.Resolve(ModelChoices, _defaultImageModel);

    /// <summary>
    /// The alias this batch will actually render with. A card saved before providers were
    /// aliased carries the literal "foundry", which names no entry in the list — it means
    /// "the default image alias", so it resolves to the first Foundry choice.
    /// </summary>
    private string? EffectiveAlias
    {
        get
        {
            var requested = ExplicitModelAlias;
            if (string.IsNullOrWhiteSpace(requested))
            {
                requested = _defaultImageModel;
            }
            return ImageModelCatalog.Resolve(ModelChoices, requested)?.Value;
        }
    }

    private ImageModelChoice? CurrentModel =>
        ImageModelCatalog.Resolve(ModelChoices, EffectiveAlias);

    private bool IsGenerating => _selectedId is { } id && StudioRun.IsActiveFor(id);

    private bool HasReferences => ProductAssets.Count > 0 || _picked.Count > 0;

    private bool SelectedProviderSupportsReferences
    {
        get
        {
            if (!HasReferences)
            {
                return true;
            }
            var alias = EffectiveAlias;
            var choice = ModelChoices.FirstOrDefault(c =>
                string.Equals(c.Value, alias, StringComparison.OrdinalIgnoreCase));
            return choice?.SupportsReferences == true;
        }
    }

    private bool IsUsable(ImageModelChoice choice) =>
        choice.Ready && (!HasReferences || choice.SupportsReferences);

    private bool CanApplyModel
    {
        get
        {
            var choice = _modelDraft == WorkspaceDefaultModel
                ? DefaultModel
                : ModelChoices.FirstOrDefault(model => string.Equals(
                    model.Value, _modelDraft, StringComparison.OrdinalIgnoreCase));
            return choice is not null && IsUsable(choice);
        }
    }

    /// <summary>"42s" under a minute, "2m 08s" after — renders run for minutes and a bare
    /// spinner gave no sense of whether anything was still moving.</summary>
    private static string ElapsedLabel(TimeSpan elapsed) =>
        elapsed.TotalSeconds < 60
            ? $"{(int)elapsed.TotalSeconds}s"
            : $"{(int)elapsed.TotalMinutes}m {elapsed.Seconds:00}s";

    private bool CanGenerate => (IsAutoPrompt || !string.IsNullOrWhiteSpace(_prompt)) &&
        _status?.ImageProviders.Any(p => p.Ready) == true && SelectedProviderSupportsReferences
        && !StudioRun.IsBatchRunning;

    private sealed record BatchPlan(
        int EligibleSlots, int MissingVariants, int SkippedSlots, bool HasBaselineEstimate)
    {
        public int TotalEvents => MissingVariants + SkippedSlots;
    }

    private BatchPlan CurrentBatchPlan
    {
        get
        {
            var eligible = 0;
            var missing = 0;
            var skipped = 0;
            var baselineEstimate = true;
            var modelValues = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var slot in Campaign.ImageSlots)
            {
                var remaining = Math.Max(0, _batchTakeTarget - slot.ActiveTakeCount);
                var references = ProductAssets.Count > 0 || slot.ReferenceAssetIds is { Count: > 0 };
                var model = BatchModel(slot);
                var prompt = slot.Id == _selectedId ? _prompt : slot.Prompt;
                if (slot.State == "Filled"
                    || StudioRun.IsActiveFor(slot.Id)
                    || (slot.PromptMode == "Manual" && string.IsNullOrWhiteSpace(prompt))
                    || remaining == 0
                    || model is null
                    || !model.Ready
                    || (references && !model.SupportsReferences))
                {
                    skipped++;
                    continue;
                }
                eligible++;
                missing += remaining;
                modelValues.Add(model.Value);
                baselineEstimate &= model.Value == "foundry"
                    || model.Detail?.StartsWith("Foundry", StringComparison.Ordinal) == true;
            }
            return new BatchPlan(
                eligible, missing, skipped,
                baselineEstimate && modelValues.Count == 1);
        }
    }

    private ImageModelChoice? BatchModel(ImageSlotResponse slot)
    {
        var requested = _sessionModelOverrides.TryGetValue(slot.Id, out var sessionAlias)
            ? sessionAlias
            : slot.ModelAlias;
        if (string.IsNullOrWhiteSpace(requested))
        {
            requested = _defaultImageModel;
        }
        return ImageModelCatalog.Resolve(ModelChoices, requested);
    }

    private bool HasDiscardedTakes =>
        _gallery.Any(v => string.Equals(v.State, "Discarded", StringComparison.Ordinal));

    /// <summary>Kept takes lead, then candidates, then (when shown) discarded — newest first.</summary>
    private IEnumerable<ImageVariantResponse> OrderedGallery =>
        _gallery
            .Where(v => _showDiscarded || !string.Equals(v.State, "Discarded", StringComparison.Ordinal))
            .OrderBy(v => v.State switch { "Kept" => 0, "Candidate" => 1, _ => 2 })
            .ThenByDescending(v => v.CreatedAt);

    private static string GalleryTileClass(ImageVariantResponse variant) =>
        string.Equals(variant.State, "Kept", StringComparison.Ordinal)
            ? "cm-gallery__tile cm-gallery__tile--keeper"
            : "cm-gallery__tile";

    protected override void OnInitialized()
    {
        Campaign.Changed += OnChanged;
        StudioRun.Changed += OnStudioRunChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await SyncSelectionAsync();

        if (!_defaultModelLoaded)
        {
            _defaultModelLoaded = true;
            try
            {
                _defaultImageModel = await SettingsApi.GetDefaultImageModelAsync();
            }
            catch (ApiException)
            {
                // The catalog still has a deterministic first-ready fallback. A settings
                // outage must not blank Image Studio or prevent an explicit model choice.
                _defaultImageModel = null;
            }
        }

        // Load the brand kit here too, not only from Campaign.Changed: entering the studio
        // from another campaign view finds the state already loaded, so no Changed event
        // ever fires and the reference picker sat disabled with "nothing in the kit".
        if (Campaign.Brand?.Id is { } brandId && _facesLoadedFor != brandId)
        {
            _facesLoadedFor = brandId;
            await LoadBrandFacesAsync();
        }

        // Never let provider readiness escape a lifecycle method: an unhandled exception
        // here blanks the studio rather than greying out a model.
        try
        {
            _status ??= await LoadStatusAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _status = null;
        }

        if (_batchAttachCampaign != CampaignId)
        {
            _batchAttachCampaign = CampaignId;
            await StudioRun.TryAttachBatchAsync(CampaignId);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_dialogNeedsFocus)
        {
            _dialogNeedsFocus = false;
            await _dialogPanel.FocusAsync();
        }

        if (_drawerNeedsFocus)
        {
            _drawerNeedsFocus = false;
            // Focus makes Escape-to-close work without a click into the drawer first.
            if (_selectedId is not null && _openVariant is null && !_kitPickerOpen && !_modelPickerOpen)
            {
                await _drawerPanel.FocusAsync();
            }
        }

        if (_kitPickerNeedsFocus)
        {
            _kitPickerNeedsFocus = false;
            if (_kitPickerOpen)
            {
                await _kitPickerPanel.FocusAsync();
            }
        }

        if (_modelPickerNeedsFocus)
        {
            _modelPickerNeedsFocus = false;
            if (_modelPickerOpen)
            {
                await _modelPickerPanel.FocusAsync();
            }
        }
    }

    private void OnChanged() => InvokeAsync(() =>
        StoreEvents.GuardedAsync(async () =>
    {
        await SyncSelectionAsync();
        // Keyed on the brand, not on the result: a brand with NO face assets would otherwise
        // re-fetch on every Changed event forever.
        if (Campaign.Brand?.Id is { } brandId && _facesLoadedFor != brandId)
        {
            _facesLoadedFor = brandId;
            await LoadBrandFacesAsync();
        }
    }, Notifier, StateHasChanged, "Refreshing the studio"));

    /// <summary>
    /// Takes appear as they land, not all at once at the end. The server persists each
    /// variant inside the generation loop, so every poll tick can already see the ones that
    /// have finished — waiting for the whole batch just hid work that was already done.
    /// </summary>
    private void OnStudioRunChanged() => InvokeAsync(() =>
        StoreEvents.GuardedAsync(async () =>
    {
        if (StudioRun.CampaignId == CampaignId && !StudioRun.IsBatchRunning
            && (StudioRun.BatchResult?.RunId ?? StudioRun.BatchProgress?.Id) is { } batchRunId
            && _handledBatchRun != batchRunId)
        {
            _handledBatchRun = batchRunId;
            await Campaign.LoadAsync(CampaignId, force: true);
        }

        if (StudioRun.IsRunning && StudioRun.SlotId == _selectedId)
        {
            await ReloadGalleryAsync();
        }

        if (!StudioRun.IsRunning && StudioRun.SlotId == _selectedId)
        {
            if (StudioRun.Error is { } error)
            {
                _generateError = error;
            }
            else if (StudioRun.Result is { } result)
            {
                // The server's failure strings are already sentences for refusals
                // (moderation) and type names otherwise — present them as-is per take.
                _failures = [.. (result.Failures ?? []).Select(f => $"Take {f}")];
                if (result.Variants.Count == 0 && _failures.Count > 0)
                {
                    _generateError = "No takes came back. Try again, or a simpler prompt.";
                }
            }

            await ReloadGalleryAsync();
            await Campaign.LoadAsync(CampaignId, force: true);
        }
    }, Notifier, StateHasChanged, "Loading the takes"));

    private async Task SyncSelectionAsync()
    {
        await LoadThumbnailConceptsAsync();

        if (Campaign.ImageSlots.Count == 0)
        {
            return;
        }

        var requested = RequestedSlot is { } slotId
            ? Campaign.ImageSlots.FirstOrDefault(s => s.Id == slotId)
            : RequestedArtifact is { } artifactId
                ? Campaign.ImageSlots.FirstOrDefault(s => s.ArtifactId == artifactId)
                : null;

        if (requested is not null && requested.Id != _selectedId)
        {
            await SelectSlotAsync(requested);
        }
        else if (_selectedId is { } current && Campaign.ImageSlots.All(s => s.Id != current))
        {
            // The open slot no longer exists — back to the sheet, never a blank drawer.
            _selectedId = null;
            _openVariant = null;
        }
    }

    private async Task ReloadGalleryAsync()
    {
        if (_selectedId is not { } slotId)
        {
            return;
        }
        try
        {
            // Load the complete persisted inventory once. The UI can only make an honest
            // "Show discarded" decision when it knows whether discarded rows exist; active
            // takes are filtered locally so the control never appears speculatively.
            _gallery = await Images.ListVariantsAsync(CampaignId, slotId, includeDiscarded: true);
            _galleryError = null;
        }
        catch (ApiException ex)
        {
            // Say so. Swallowing this was worse than useless: switching slots clears the
            // gallery first, so a failed reload left an empty grid with no message — takes
            // the user had just paid for looked like they had been thrown away.
            _galleryError = ex.Message;
        }
    }

    private void ToggleDiscarded() => _showDiscarded = !_showDiscarded;

    private void OpenVariant(ImageVariantResponse variant)
    {
        _openVariant = variant;
        _steerNote = string.Empty;
        _dialogNeedsFocus = true;
    }

    private void CloseVariant() => _openVariant = null;

    private void OnDialogKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseVariant();
        }
    }

    private bool SteerConstraintSelected(string chip) =>
        ContainsConstraint(_steerNote, chip);

    private void ToggleSteerChip(string chip) =>
        _steerNote = ToggleConstraint(_steerNote, chip);

    /// <summary>Hard delete after an explicit confirm. Discard is the reversible path; this
    /// removes the row and the blobs, so the dialog says exactly that.</summary>
    private async Task DeleteTakeAsync(ImageVariantResponse variant)
    {
        var accepted = await Confirm.ConfirmAsync(new ConfirmRequest(
            "Delete this take forever?",
            "The image and its thumbnail are removed from storage. This is not the same as "
            + "discarding — there is no restore and no undo.",
            AcceptLabel: "Delete forever",
            CancelLabel: "Keep it",
            Destructive: true));
        if (!accepted)
        {
            return;
        }

        try
        {
            await Images.DeleteVariantAsync(CampaignId, variant.SlotId, variant.Id);
            _gallery = [.. _gallery.Where(v => v.Id != variant.Id)];
            CloseVariant();
            await Campaign.LoadAsync(CampaignId, force: true);
            Notifier.ShowSuccess("Take deleted.");
        }
        catch (ApiException ex)
        {
            Notifier.ShowError(ex.Message);
        }
    }

    private async Task SetStateAsync(ImageVariantResponse variant, string state)
    {
        try
        {
            var updated = await Images.SetVariantStateAsync(CampaignId, variant.SlotId, variant.Id, state);
            _gallery = [.. _gallery.Select(v => v.Id == updated.Id ? updated : v)];
            if (!_showDiscarded && state == "Discarded")
            {
                CloseVariant();
            }
            else if (_openVariant?.Id == updated.Id)
            {
                _openVariant = updated;
            }

            // Restoring the last discarded take removes the need for a discarded view.
            if (_showDiscarded && !HasDiscardedTakes)
            {
                _showDiscarded = false;
            }
            await Campaign.LoadAsync(CampaignId, force: true);
        }
        catch (ApiException ex)
        {
            Notifier.ShowError(ex.Message);
        }
    }

    /// <summary>A typed note OR a picked reference justifies a new take: references are real
    /// image inputs, so "use this face" needs no accompanying text.</summary>
    private bool CanSteer => !string.IsNullOrWhiteSpace(_steerNote) || _picked.Count > 0;

    private void SteerAsync(ImageVariantResponse source)
    {
        if (Selected is not { } slot || !CanSteer)
        {
            return;
        }
        _generateError = null;
        _failures = [];
        StudioRun.StartSteer(CampaignId, slot.Id, source.Id, _steerNote.Trim(), modelAlias: EffectiveAlias);
        CloseVariant();
    }

    private async Task<AiStatusResponse?> LoadStatusAsync()
    {
        try
        {
            return await Images.GetAiStatusAsync();
        }
        catch (ApiException)
        {
            return null; // the pane says "checking…" — a retry happens on next navigation
        }
    }

    private async Task SelectSlotAsync(ImageSlotResponse slot)
    {
        _selectedId = slot.Id;
        _prompt = slot.Prompt ?? string.Empty;
        _savedPrompt = slot.Prompt;
        _promptMode = slot.PromptMode;
        _showDiscarded = false;
        _activeConceptName = null;
        _gallery = [];
        _failures = [];
        _generateError = null;
        _openVariant = null;
        _headline = slot.HeadlineText;
        _headlineBackground = slot.HeadlineBackground;
        _safeArea = slot.SafeArea;
        _picked.Clear();
        foreach (var id in slot.ReferenceAssetIds ?? [])
        {
            if (_brandAssets.FirstOrDefault(a => a.Id == id) is { } asset)
            {
                _picked[asset.Kind.ToLowerInvariant()] = asset;
            }
        }
        _drawerNeedsFocus = true;
        await Task.WhenAll(ReloadGalleryAsync(), LoadSupportingContextAsync(slot));
    }

    /// <summary>
    /// A tile click: select the slot AND put it in the URL, so the drawer state survives a
    /// refresh and a later campaign refresh can't snap the selection back to a stale
    /// <c>?slot=</c> deep link from before the click.
    /// </summary>
    private async Task OpenSlotAsync(ImageSlotResponse slot)
    {
        RequestedArtifact = slot.ArtifactId;
        RequestedSlot = slot.Id;
        await SelectSlotAsync(slot);
        Navigation.NavigateTo(
            $"{CampaignViews.PathFor(CampaignId, CampaignView.ImageStudio)}?slot={slot.Id}", replace: true);
    }

    private void CloseSlot()
    {
        _selectedId = null;
        _openVariant = null;
        _modelPickerOpen = false;
        // Strip the deep link too, or the next parameter sync would reopen the drawer.
        RequestedSlot = null;
        RequestedArtifact = null;
        Navigation.NavigateTo(CampaignViews.PathFor(CampaignId, CampaignView.ImageStudio), replace: true);
    }

    private void OnDrawerKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && _openVariant is null && !_kitPickerOpen && !_modelPickerOpen)
        {
            CloseSlot();
        }
    }

    private void OpenKitPicker()
    {
        _kitPickerOpen = true;
        // Start on what is already chosen, so "Change…" lands on the thing being changed.
        _kitPreviewAsset = _picked.Values.FirstOrDefault()
            ?? ReferenceKit.FirstOrDefault()?.FirstOrDefault();
        _kitPickerNeedsFocus = true;
    }

    private void CloseKitPicker() => _kitPickerOpen = false;

    private void OnKitPickerKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseKitPicker();
        }
    }

    /// <summary>
    /// One slot on the contact sheet, at the slot's true aspect ratio. State reads from the
    /// tile itself — a filled slot shows its published image, an empty one is a dashed hole —
    /// with the shared status encoding on top (ADR-F12: no surface invents its own).
    /// </summary>
    private RenderFragment SheetCard(ImageSlotResponse slot) => __builder =>
    {
        var active = slot.Id == _selectedId;
        var rendering = StudioRun.IsActiveFor(slot.Id);
        var filled = slot.State == "Filled" && slot.PublishedUrl is not null;
        // A slot with generated-but-unplaced takes previews its best take: work exists,
        // it just hasn't been placed — an empty dashed hole would misreport that.
        var takeThumb = !filled ? slot.LatestTakeThumbUrl : null;
        <button type="button"
                class="cm-studio__card @(filled || takeThumb is not null ? "cm-studio__card--filled" : null) @(active ? "cm-studio__card--active" : null)"
                style="aspect-ratio: @slot.TargetWidth / @slot.TargetHeight; flex-basis: @(TileBasis(slot))px;"
                aria-pressed="@(active ? "true" : "false")"
                @onclick="() => OpenSlotAsync(slot)">
            @if (filled)
            {
                <img src="@(slot.PublishedUrl + "?v=" + slot.UpdatedAt.ToUnixTimeSeconds())"
                     alt="" loading="lazy" decoding="async" />
            }
            else if (takeThumb is not null)
            {
                <img src="@takeThumb" alt="" loading="lazy" decoding="async" />
            }
            <span class="cm-studio__card-name">@ArtifactDisplay.SlotLabel(slot.Kind)</span>
            <span class="cm-studio__card-foot">
                @if (rendering)
                {
                    <span class="cm-status cm-status--queued cm-studio__card-state">Rendering</span>
                }
                else if (slot.State == "Filled")
                {
                    <span class="cm-status cm-status--published cm-studio__card-state">Done</span>
                }
                else if (takeThumb is not null)
                {
                    <span class="cm-status cm-status--review cm-studio__card-state">In takes</span>
                }
                else
                {
                    <span class="cm-status cm-studio__card-state">Empty</span>
                }
                <span class="cm-studio__card-size cm-mono">@slot.TargetWidth×@slot.TargetHeight</span>
            </span>
        </button>
    };

    /// <summary>Tile width scaled from the slot's real published width, clamped to stay
    /// usable — a 1600-wide header reads visibly wider than a 1280-wide thumbnail. The floor
    /// is what keeps the status + dimensions foot from clipping on 1200-wide slots.</summary>
    private static int TileBasis(ImageSlotResponse slot) =>
        Math.Clamp(slot.TargetWidth / 8, 160, 200);

    /// <summary>
    /// Loads only the selected owner, so the Studio can show the real copy that the image is
    /// meant to support without bloating every campaign preview with every manuscript. The
    /// slot id guard prevents a slower earlier request from overwriting a newer selection.
    /// </summary>
    private async Task LoadSupportingContextAsync(ImageSlotResponse slot)
    {
        var selectedSlotId = slot.Id;
        _supportingContext = null;
        _supportingContextLoading = slot.ArtifactId is not null;

        if (slot.ArtifactId is not { } artifactId)
        {
            return;
        }

        try
        {
            var (artifact, _) = await Campaigns.GetArtifactAsync(CampaignId, artifactId);
            var excerpt = SupportingExcerpt(artifact, slot.Kind);
            if (_selectedId == selectedSlotId && !string.IsNullOrWhiteSpace(excerpt))
            {
                _supportingContext = new SupportingContentContext(
                    artifact.Title, artifact.Kind, excerpt);
            }
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            // The image workbench remains usable if a deleted/stale owner cannot be read.
            // SelectedOwner already communicates that ownership problem beside placement.
        }
        finally
        {
            if (_selectedId == selectedSlotId)
            {
                _supportingContextLoading = false;
            }
        }
    }

    /// <summary>
    /// For an inline blog image, prefer the prose immediately surrounding its stub marker;
    /// otherwise use the opening substantive copy. This is orientation for the producer,
    /// not another AI summary, so the words remain the artifact's actual text.
    /// </summary>
    private static string SupportingExcerpt(ArtifactResponse artifact, string slotKind)
    {
        var markdown = StructuredContent.IsStructured(artifact.Kind)
            ? StructuredContent.ToDisplayMarkdown(artifact.Kind, artifact.ContentJson)
            : ArtifactContent.ToMarkdown(artifact.ContentJson);
        if (string.IsNullOrWhiteSpace(markdown))
        {
            return string.Empty;
        }

        var lines = markdown.Replace("\r", string.Empty, StringComparison.Ordinal).Split('\n');
        var marker = $"stub:{slotKind}";
        var markerIndex = Array.FindIndex(lines,
            line => line.Contains(marker, StringComparison.OrdinalIgnoreCase));
        var candidates = markerIndex >= 0
            ? lines.Skip(Math.Max(0, markerIndex - 5)).Take(11)
            : lines.AsEnumerable();

        var substantive = candidates
            .Select(CleanContextLine)
            .Where(line => !string.IsNullOrWhiteSpace(line))
            .Where(line => !string.Equals(line, artifact.Title, StringComparison.OrdinalIgnoreCase))
            .Take(5);
        return Truncate(string.Join(" ", substantive), 700);
    }

    private static string CleanContextLine(string line)
    {
        var cleaned = line.Trim();
        if (cleaned.Contains("![stub:", StringComparison.OrdinalIgnoreCase)
            || (cleaned.StartsWith("![", StringComparison.Ordinal) && cleaned.EndsWith(')')))
        {
            return string.Empty;
        }

        return cleaned.TrimStart('#', '>', '-', '*', ' ');
    }

