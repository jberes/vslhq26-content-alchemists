@* The Image Studio (F10, handoff §8): the campaign's typed image plan as a workbench.
   Slots on the left, the selected slot's prompt/model/variants on the right. Nothing
   generates without an explicit click — variants are live model calls that cost money,
   which is why generation is a button, never a side effect (the user's rule). *@
@page "/campaigns/{CampaignId:guid}/images"
@using Castmill.Core
@using System.Text.Json
@using Castmill.Core.Ai
@using Castmill.Core.Resources
@using Castmill.UI.Design
@using Castmill.UI.Editor
@using Castmill.UI.Http
@using Castmill.UI.State
@implements IDisposable
@inject CampaignState Campaign
@inject CampaignsClient Campaigns
@inject ImagesClient Images
@inject SettingsClient SettingsApi
@using Microsoft.AspNetCore.Components.Forms
@inject BrandsClient BrandsApi
@inject HttpClient Http
@inject StudioRunService StudioRun
@inject Castmill.UI.Http.GenerationClient Generation
@inject INotifier Notifier
@inject NavigationManager Navigation
@inject IConfirmService Confirm
@inject IFileDownloader Downloader

<PageTitle>@(Campaign.Campaign?.Name ?? "Campaign") — Image studio</PageTitle>

<CampaignShell CampaignId="CampaignId" View="CampaignView.ImageStudio">
    @* Fill-pattern page (the shell rule: main never scrolls, each surface owns its
       scrollbar). The sheet and the drawer are independent scroll regions, so the drawer's
       bottom is always reachable regardless of the shell chrome above it. *@
    <div class="cm-page cm-page--fill">
        <div class="cm-measure--dashboard cm-studio-fill">
            @if (!ImageContentItems.Any() && Campaign.ImageSlots.Count == 0)
            {
                <EmptyState Kicker="Image studio"
                            Headline="No content items yet."
                            Detail="Image Studio is organized by content item. Generate or add content first, then create the images that belong to it." />
            }
            else
            {
                @* The contact sheet (Alt B of the F5-F7 iteration): the canvas IS the image
                   plan. Each content piece is a row of tiles at their true aspect ratios —
                   empty tiles are the visible holes in the sheet. Selecting a tile opens the
                   editor as a drawer beside the sheet, so the plan never leaves view. *@
                <div class="cm-studio @(Selected is not null ? "cm-studio--open" : null)">
                    <div class="cm-studio__sheet" aria-label="Campaign image plan">
                        @{ var batchPlan = CurrentBatchPlan; }
                        <section class="cm-studio__batch" aria-label="Generate all pending images">
                            <div class="cm-studio__batch-head">
                                <div class="cm-studio__batch-copy">
                                    <span class="cm-kicker">Campaign pass</span>
                                    <h2>Generate every pending image</h2>
                                    <p class="cm-meta cm-studio__batch-sentence">
                                        <span>Bring each eligible slot up to</span>
                                        <select class="cm-input cm-studio__batch-target"
                                                aria-label="Target takes per slot"
                                                @bind="_batchTakeTarget" disabled="@StudioRun.IsBatchRunning">
                                            @foreach (var target in BatchTakeTargets)
                                            {
                                                <option value="@target">@target @(target == 1 ? "take" : "takes")</option>
                                            }
                                        </select>
                                        <span>without placing a take.</span>
                                    </p>
                                </div>
                                <button type="button" class="cm-button"
                                        disabled="@(StudioRun.IsRunning || StudioRun.IsBatchRunning || batchPlan.MissingVariants == 0)"
                                        @onclick="GeneratePendingAsync">
                                    @(StudioRun.IsBatchRunning ? "Generating pending images" : "Generate all pending")
                                </button>
                            </div>
                            <p class="cm-meta cm-studio__batch-estimate">
                                @batchPlan.EligibleSlots eligible · @batchPlan.MissingVariants missing
                                @(batchPlan.MissingVariants == 1 ? "take" : "takes")
                                @if (batchPlan.MissingVariants > 0 && batchPlan.HasBaselineEstimate)
                                {
                                    <span> · ≈ @((batchPlan.MissingVariants * CostPerVariantUsd).ToString("$0.00")) Foundry baseline estimate</span>
                                }
                                else if (batchPlan.MissingVariants > 0)
                                {
                                    <span> · estimate unavailable for mixed or externally billed models</span>
                                }
                                @if (batchPlan.SkippedSlots > 0)
                                {
                                    <span> · @batchPlan.SkippedSlots skipped before start</span>
                                }
                            </p>
                            @if (_status is null)
                            {
                                <p class="cm-meta">Checking provider readiness before calculating the pass.</p>
                            }
                            @if (StudioRun.IsBatchActiveFor(CampaignId))
                            {
                                var resultEvents = StudioRun.BatchResult is { } finalBatch
                                    ? finalBatch.SucceededVariants + finalBatch.FailedVariants + finalBatch.SkippedSlots
                                    : 0;
                                var completed = StudioRun.BatchProgress?.Completed ?? resultEvents;
                                var total = StudioRun.BatchProgress?.TotalKinds
                                    ?? (resultEvents > 0 ? resultEvents : batchPlan.TotalEvents);
                                <div class="cm-studio__batch-progress" role="status" aria-live="polite">
                                    <progress value="@completed" max="@Math.Max(1, total)"></progress>
                                    <p class="cm-meta">
                                        @(StudioRun.IsBatchRunning ? "Generating" : "Pass complete") ·
                                        @completed/@total slot events ·
                                        <span class="cm-mono">@ElapsedLabel(StudioRun.Elapsed)</span>
                                    </p>
                                    @if (StudioRun.BatchResult is { } batchResult)
                                    {
                                        <p class="cm-studio__batch-summary">
                                            <strong>@batchResult.SucceededSlots succeeded</strong> ·
                                            @batchResult.FailedSlots failed ·
                                            @batchResult.SkippedSlots skipped ·
                                            @batchResult.SucceededVariants takes created
                                        </p>
                                    }
                                    @if (StudioRun.BatchError is { } batchError)
                                    {
                                        <p class="cm-form__error" role="alert">@batchError</p>
                                    }
                                    @if (StudioRun.BatchProgress?.Items is { Count: > 0 } batchItems)
                                    {
                                        <ol class="cm-studio__batch-log" aria-label="Image batch progress">
                                            @foreach (var item in batchItems)
                                            {
                                                <li class="cm-studio__batch-event">
                                                    <span class="cm-status @BatchEventStatusClass(item)">@BatchEventOutcome(item)</span>
                                                    <span>@BatchEventLabel(item)</span>
                                                    @if (!string.IsNullOrWhiteSpace(item.Error))
                                                    {
                                                        <span class="cm-meta">@item.ErrorCode · @item.Error</span>
                                                    }
                                                </li>
                                            }
                                        </ol>
                                    }
                                </div>
                            }
                        </section>
                        @foreach (var item in ImageContentItems)
                        {
                            var slots = SlotsFor(item.Id).ToList();
                            <section class="cm-studio__group">
                                <header class="cm-studio__group-head">
                                    <span class="cm-kicker">@ArtifactDisplay.KindLabel(item.Kind)</span>
                                    <p class="cm-studio__content-title">@item.Title</p>
                                    <span class="cm-studio__fill cm-mono">@slots.Count(s => s.State == "Filled")/@slots.Count</span>
                                </header>
                                <div class="cm-studio__tiles">
                                    @foreach (var slot in slots)
                                    {
                                        @SheetCard(slot)
                                    }
                                    @* Add lives where it lands: a ghost tile at the end of the
                                       content piece's own row, not an orphaned button. *@
                                    <button type="button" class="cm-studio__card cm-studio__card--add"
                                            disabled="@(_addingFor == item.Id)" @onclick="() => AddImageAsync(item.Id)">
                                        <span class="cm-studio__card-plus" aria-hidden="true">+</span>
                                        <span>@(_addingFor == item.Id ? "Adding…" : "Add image")</span>
                                    </button>
                                </div>
                            </section>
                        }
                        @if (LegacySlots.Any())
                        {
                            <section class="cm-studio__group">
                                <header class="cm-studio__group-head">
                                    <span class="cm-kicker">Legacy campaign images</span>
                                    <span class="cm-studio__fill cm-mono">@LegacySlots.Count(s => s.State == "Filled")/@LegacySlots.Count()</span>
                                </header>
                                <div class="cm-studio__tiles">
                                    @foreach (var slot in LegacySlots)
                                    {
                                        @SheetCard(slot)
                                    }
                                </div>
                            </section>
                        }
                    </div>

                    @if (Selected is { } slot2)
                    {
                        @* The editor drawer: everything about ONE slot, beside the sheet so the
                           campaign's coverage stays in view while editing. Escape closes it;
                           the take lightbox stacks above it (modal z 70 > drawer z 60). *@
                        <section class="cm-studio__drawer" aria-label="Image editor" tabindex="-1"
                                 @ref="_drawerPanel" @onkeydown="OnDrawerKey">
                            <header class="cm-studio__drawer-head">
                                <div>
                                    <h2>@ArtifactDisplay.SlotLabel(slot2.Kind)</h2>
                                    <p class="cm-meta">
                                        Generated at exactly @slot2.TargetWidth×@slot2.TargetHeight — the slot's published
                                        size, no client-side cropping.
                                        @if (ProvenanceLine(slot2) is { } prov)
                                        {
                                            <br />
                                            <span>Prompt seeded from @prov</span>
                                        }
                                    </p>
                                </div>
                                <button type="button" class="cm-studio__drawer-close"
                                        aria-label="Close the editor" title="Close (Esc)"
                                        @onclick="CloseSlot">✕</button>
                            </header>

                            @if (_supportingContextLoading)
                            {
                                <p class="cm-meta">Loading the content this image supports…</p>
                            }
                            else if (_supportingContext is { } context)
                            {
                                <section class="cm-studio__context" aria-label="Content this image supports">
                                    <span class="cm-kicker">What this image supports</span>
                                    <p class="cm-studio__context-source">
                                        <strong>@context.Title</strong>
                                        <span class="cm-meta"> · @ArtifactDisplay.KindLabel(context.Kind)</span>
                                    </p>
                                    <blockquote>@context.Excerpt</blockquote>
                                </section>
                            }

                            <div>
                                @if (IsThumbnail(slot2) && _thumbnailConcepts.Count > 0)
                                {
                                    <span class="cm-kicker">Concepts first</span>
                                    <p class="cm-meta">Choose a strategic direction before generating pixels.</p>
                                    <div class="cm-studio__chips">
                                        @foreach (var concept in _thumbnailConcepts)
                                        {
                                            var selected = string.Equals(_activeConceptName, concept.Name, StringComparison.Ordinal);
                                            <button type="button" class="cm-studio__chip @(selected ? "cm-studio__chip--on" : null)"
                                                    aria-pressed="@(selected ? "true" : "false")" title="@concept.Reason"
                                                    @onclick="() => ApplyConceptAsync(concept)">
                                                @concept.Name · @concept.OverlayText
                                            </button>
                                        }
                                    </div>
                                }

                                <span class="cm-kicker">Prompt mode</span>
                                <div class="cm-studio__mode-switch" role="group" aria-label="Prompt mode">
                                    <button type="button"
                                            class="cm-studio__mode @(IsAutoPrompt ? "cm-studio__mode--on" : null)"
                                            aria-pressed="@(IsAutoPrompt ? "true" : "false")"
                                            disabled="@_changingPromptMode"
                                            @onclick='() => ChangePromptModeAsync("Auto")'>
                                        <strong>Auto</strong>
                                        <span>Rebuild from this item</span>
                                    </button>
                                    <button type="button"
                                            class="cm-studio__mode @(!IsAutoPrompt ? "cm-studio__mode--on" : null)"
                                            aria-pressed="@(!IsAutoPrompt ? "true" : "false")"
                                            disabled="@_changingPromptMode"
                                            @onclick='() => ChangePromptModeAsync("Manual")'>
                                        <strong>Manual</strong>
                                        <span>Use this prompt verbatim</span>
                                    </button>
                                </div>
                                <span class="cm-kicker">Prompt</span>
                                @* oninput, not onchange: the Generate button must enable while
                                   typing, not after the field loses focus. The PATCH waits for blur. *@
                                <textarea class="cm-studio__prompt" @bind="_prompt" @bind:event="oninput"
                                          @onblur="SavePromptAsync"
                                          disabled="@IsAutoPrompt"
                                          placeholder="Describe the image. The generator adds the slot's exact dimensions."></textarea>
                                @if (IsAutoPrompt)
                                {
                                    <p class="cm-meta">Castmill rebuilds the prompt from this item's content, the approved SEO/AEO targets and the brand style every time.</p>
                                }
                                else if (string.IsNullOrWhiteSpace(_prompt) && Campaign.TranscriptArtifactId is not null)
                                {
                                    <p class="cm-meta">
                                        No prompt yet — write one, or let the AI draft a prompt for
                                        every slot from the transcript's strongest moments.
                                    </p>
                                    <button type="button" class="cm-button cm-button--quiet" disabled="@_seeding"
                                            @onclick="SeedPromptsAsync">
                                        @(_seeding ? "Writing prompts from the source… (~30s)" : "Seed all prompts from the source")
                                    </button>
                                }
                                <div class="cm-studio__chips">
                                    @foreach (var chip in ConstraintChips)
                                    {
                                        var selected = ConstraintSelected(chip);
                                        <button type="button"
                                                class="cm-studio__chip @(selected ? "cm-studio__chip--on" : null)"
                                                aria-pressed="@(selected ? "true" : "false")"
                                                @onclick="() => ToggleConstraintChipAsync(chip)">
                                            @(selected ? "Applied · " : "Add · ")@chip
                                        </button>
                                    }
                                </div>
                            </div>

                            @if (Campaign.Brand is not null)
                            {
                                @* Selections only, not the whole kit: every face and background
                                   inline made the drawer mostly other people's assets. The kit
                                   itself lives in a master–detail dialog behind one button. *@
                                <div>
                                    <span class="cm-kicker">Reference images</span>
                                    @if (ProductAssets.Count > 0)
                                    {
                                        <p class="cm-meta">Up to three product screenshots (@string.Join(", ", ProductAssets.Take(3).Select(a => a.Label ?? a.FileName))) attach automatically for product fidelity.</p>
                                    }
                                    <div class="cm-studio__refbar">
                                        @foreach (var pick in _picked.OrderBy(p => Array.IndexOf(KitOrder, p.Key)).ToList())
                                        {
                                            <button type="button" class="cm-studio__refchip"
                                                    title="Remove @(pick.Value.Label ?? pick.Value.FileName)"
                                                    @onclick="() => TogglePickAsync(pick.Key, pick.Value)">
                                                @if (_kitPreviews.TryGetValue(pick.Value.AssetId, out var chipThumb))
                                                {
                                                    <img src="@chipThumb" alt="" loading="lazy" />
                                                }
                                                <span>@KindLabel(pick.Key) · @(pick.Value.Label ?? pick.Value.FileName)</span>
                                                <span class="cm-studio__refchip-x" aria-hidden="true">✕</span>
                                            </button>
                                        }
                                        <button type="button" class="cm-button cm-button--quiet"
                                                disabled="@(!ReferenceKit.Any())" @onclick="OpenKitPicker">
                                            @(_picked.Count == 0 ? "Choose references…" : "Change…")
                                        </button>
                                    </div>
                                    @if (!ReferenceKit.Any())
                                    {
                                        <p class="cm-meta">Nothing in @Campaign.Brand.Name's kit yet — add faces and backgrounds on the Brands page.</p>
                                    }
                                </div>
                            }

                            <div class="cm-studio__models">
                                <div class="cm-studio__model-head">
                                    <span class="cm-kicker">Model</span>
                                    <button type="button" class="cm-button cm-button--quiet cm-button--compact"
                                            disabled="@(_status is null || ModelChoices.Count == 0)"
                                            @onclick="OpenModelPicker">
                                        Change…
                                    </button>
                                </div>
                                @if (_status is null)
                                {
                                    <p class="cm-meta">Checking provider readiness…</p>
                                }
                                else if (CurrentModel is { } currentModel)
                                {
                                    <div class="cm-studio__model-current">
                                        <strong>@currentModel.Label</strong>
                                        <span class="cm-badge @(UsesWorkspaceDefault ? "cm-badge--done" : "cm-badge--empty")">
                                            @(UsesWorkspaceDefault ? "DEFAULT" : "THIS IMAGE")
                                        </span>
                                        <span class="cm-meta">@currentModel.Detail</span>
                                    </div>
                                    @if (!currentModel.Ready)
                                    {
                                        <p class="cm-form__error">Unavailable — @(currentModel.Reason ?? "not configured")</p>
                                    }
                                    else if (HasReferences && !currentModel.SupportsReferences)
                                    {
                                        <p class="cm-form__error">This model cannot use the selected reference images.</p>
                                    }
                                }
                                else
                                {
                                    <p class="cm-meta">No image generators are configured.</p>
                                }
                            </div>

                            @* A campaign can hold more than one blog — every regenerate prints a
                               new take as its own artifact. Placing used to patch whichever blog
                               was oldest, so ask only when it is genuinely ambiguous. *@
                            @if (slot2.ArtifactId is { } owner)
                            {
                                <p class="cm-meta">
                                    Belongs to
                                    <strong>@(SelectedOwner?.Title ?? "a content item that has been deleted")</strong>.
                                    @if (SelectedOwner?.Kind == "blog")
                                    {
                                        <text> Placing also rewrites that blog's stub.</text>
                                    }
                                </p>
                            }
                            else if (IsBlogSlot(slot2.Kind) && Blogs.Count > 1)
                            {
                                <div class="cm-studio__row">
                                    <span class="cm-kicker">Place into</span>
                                    <select class="cm-input" @bind="_targetBlogId" aria-label="Blog to place this image into">
                                        @foreach (var blog in Blogs)
                                        {
                                            <option value="@blog.Id">@blog.Title</option>
                                        }
                                    </select>
                                </div>
                            }

                            <div class="cm-studio__row">
                                <span class="cm-kicker">Variants</span>
                                @foreach (var n in VariantChoices)
                                {
                                    <label class="cm-studio__model">
                                        <input type="radio" name="cm-studio-variants" checked="@(_variantCount == n)"
                                               @onchange="() => _variantCount = n" />
                                        <span>@n</span>
                                    </label>
                                }
                                <button type="button" class="cm-button" disabled="@(IsGenerating || !CanGenerate)"
                                        @onclick="GenerateAsync">
                                    @(IsGenerating ? $"Generating… {ElapsedLabel(StudioRun.Elapsed)}" : $"Generate {_variantCount} {(_variantCount == 1 ? "variant" : "variants")}")
                                </button>
                                <span class="cm-meta">≈ @((_variantCount * CostPerVariantUsd).ToString("$0.00")) estimated model spend</span>
                            </div>
                            @if (Campaign.Brand is { } studioBrand)
                            {
                                <p class="cm-meta">
                                    @studioBrand.Name's image style and palette are appended to
                                    every prompt automatically.
                                </p>
                            }
                            @if (!CanGenerate && !IsGenerating)
                            {
                                <p class="cm-meta">
                                    @(!IsAutoPrompt && string.IsNullOrWhiteSpace(_prompt)
                                        ? "Generate enables as soon as this slot has a prompt."
                                        : _status is null
                                            ? "Waiting for provider readiness…"
                                            : HasReferences && !SelectedProviderSupportsReferences
                                                ? "Choose Foundry for real reference-image inputs, or remove the optional references."
                                            : "No image provider is configured — see the model list above.")
                                </p>
                            }
                            @if (_generateError is not null)
                            {
                                <p class="cm-form__error" role="alert">@_generateError</p>
                            }

                            @* The take gallery: every persisted variant for this slot, kept
                               first. In-flight renders show one shimmering tile each, with
                               already-finished takes filling in as the run reports progress. *@
                            <div>
                                <span class="cm-kicker">Takes</span>
                                @if (IsGenerating)
                                {
                                    <p class="cm-meta">
                                        <span class="cm-ai-dot" aria-hidden="true"></span>
                                        Generating @StudioRun.ExpectedVariants — @(StudioRun.Progress?.Completed ?? 0) done · <span class="cm-mono">@ElapsedLabel(StudioRun.Elapsed)</span>
                                    </p>
                                }
                                else if (_galleryError is { } galleryError)
                                {
                                    <p class="cm-form__error" role="alert">
                                        Couldn't load your takes — @galleryError
                                        <button type="button" class="cm-button cm-button--quiet"
                                                @onclick="ReloadGalleryAsync">Try again</button>
                                    </p>
                                }
                                else if (!OrderedGallery.Any())
                                {
                                    <p class="cm-meta">
                                        @(_gallery.Count == 0
                                            ? "No takes yet. Generate some — every take stays here until you discard or delete it."
                                            : "No active takes. Your discarded takes are still recoverable below.")
                                    </p>
                                }
                                <div class="cm-gallery">
                                    @if (IsGenerating)
                                    {
                                        @for (var i = 0; i < Math.Max(0, StudioRun.ExpectedVariants - (StudioRun.Progress?.Completed ?? 0)); i++)
                                        {
                                            @* Generation runs for minutes. A faint skeleton read as
                                               "nothing is happening", so each pending take gets a
                                               spinner, a frame and a number it can be identified by. *@
                                            <div class="cm-gallery__pending" role="status"
                                                 aria-label="Take @((StudioRun.Progress?.Completed ?? 0) + i + 1) of @StudioRun.ExpectedVariants rendering">
                                                <span class="cm-spinner" aria-hidden="true"></span>
                                                <span class="cm-gallery__pending-label cm-mono">
                                                    TAKE @((StudioRun.Progress?.Completed ?? 0) + i + 1)
                                                </span>
                                                <span class="cm-meta">rendering… @ElapsedLabel(StudioRun.Elapsed)</span>
                                            </div>
                                        }
                                    }
                                    @foreach (var variant in OrderedGallery)
                                    {
                                        <button @key="variant.Id" type="button"
                                                class="@GalleryTileClass(variant)"
                                                @onclick="() => OpenVariant(variant)">
                                            <img src="@variant.ThumbUrl" width="@variant.Width" height="@variant.Height"
                                                 loading="lazy" decoding="async"
                                                 alt="Take for @ArtifactDisplay.SlotLabel(slot2.Kind)" />
                                            @if (variant.State == "Kept")
                                            {
                                                <span class="cm-gallery__keeper" aria-label="Keeper take">
                                                    <span aria-hidden="true">✓</span> Keeper
                                                </span>
                                            }
                                            <span class="cm-gallery__meta">
                                                <span class="cm-mono">@variant.Model</span>
                                                @if (variant.SteeringNote is not null)
                                                {
                                                    <span class="cm-meta" title="@variant.SteeringNote">steered</span>
                                                }
                                            </span>
                                        </button>
                                    }
                                </div>
                                @foreach (var failure in _failures)
                                {
                                    <p class="cm-form__error">@failure</p>
                                }
                                @if (HasDiscardedTakes)
                                {
                                    <button type="button" class="cm-button cm-button--quiet" @onclick="ToggleDiscarded">
                                        @(_showDiscarded ? "Hide discarded takes" : "Show discarded takes")
                                    </button>
                                }
                            </div>

                            @if (slot2.State == "Filled" && slot2.PublishedUrl is { } published)
                            {
                                <div class="cm-studio__placed">
                                    <span class="cm-kicker">Placed</span>
                                    <img src="@(published + "?v=" + slot2.UpdatedAt.ToUnixTimeSeconds())"
                                         alt="Placed @ArtifactDisplay.SlotLabel(slot2.Kind)" />
                                    <div class="cm-studio__row">
                                        <button type="button" class="cm-button cm-button--quiet" @onclick="ClearAsync">
                                            Remove from slot
                                        </button>
                                        <span class="cm-meta">The slot goes back to empty; your takes are untouched.</span>
                                    </div>
                                </div>

                                <div>
                                    <span class="cm-kicker">Overlay text</span>
                                    <p class="cm-meta">
                                        Composited server-side over the placed image — never sent to
                                        the model (ADR-013), so editing it never costs a render.
                                    </p>
                                    <div class="cm-studio__row">
                                        <input class="cm-input" maxlength="32" @bind="_headline"
                                               placeholder="Up to 32 characters" />
                                        <span class="cm-mono cm-meta">@(_headline?.Length ?? 0)/32</span>
                                        <label class="cm-studio__model">
                                            <input type="checkbox" @bind="_safeArea" />
                                            <span>@(slot2.Kind == "youtube-thumbnail"
                                                ? "keep YouTube's timestamp corner clear"
                                                : "respect the safe-area inset")</span>
                                        </label>
                                        <button type="button" class="cm-button cm-button--quiet"
                                                disabled="@(_compositing || string.IsNullOrWhiteSpace(_headline))"
                                                @onclick="CompositeAsync">
                                            @(_compositing ? "Compositing…" : "Composite overlay text")
                                        </button>
                                    </div>
                                </div>
                            }
                        </section>
                    }
                </div>
            }

            @if (_modelPickerOpen)
            {
                <div class="cm-modal" role="presentation" @onclick="CloseModelPicker">
                    <div class="cm-modal__panel cm-modelpicker" role="dialog" aria-modal="true"
                         aria-labelledby="cm-modelpicker-title" tabindex="-1"
                         @ref="_modelPickerPanel" @onclick:stopPropagation @onkeydown="OnModelPickerKey">
                        <header>
                            <span class="cm-kicker">Image generator</span>
                            <h2 id="cm-modelpicker-title" class="cm-modal__title">Choose a model</h2>
                            <p class="cm-modal__message">
                                This choice applies only to this image. Keep Workspace default
                                selected to follow Settings automatically.
                            </p>
                        </header>

                        @if (DefaultModel is { } defaultModel)
                        {
                            var defaultUsable = IsUsable(defaultModel);
                            <label class="cm-modelpicker__choice @(!defaultUsable ? "cm-modelpicker__choice--off" : null)">
                                <input type="radio" name="cm-modelpicker-model"
                                       disabled="@(!defaultUsable)"
                                       checked="@(_modelDraft == WorkspaceDefaultModel)"
                                       @onchange="() => _modelDraft = WorkspaceDefaultModel" />
                                <span>
                                    <strong>Workspace default · @defaultModel.Label</strong>
                                    <small>@(defaultModel.Detail ?? defaultModel.Value)</small>
                                </span>
                                <span class="cm-badge">DEFAULT</span>
                            </label>
                        }

                        <div class="cm-modelpicker__choices">
                            @foreach (var choice in ModelChoices)
                            {
                                var usable = IsUsable(choice);
                                <label class="cm-modelpicker__choice @(!usable ? "cm-modelpicker__choice--off" : null)">
                                    <input type="radio" name="cm-modelpicker-model"
                                           disabled="@(!usable)"
                                           checked="@(_modelDraft == choice.Value)"
                                           @onchange="() => _modelDraft = choice.Value" />
                                    <span>
                                        <strong>@choice.Label</strong>
                                        <small>@(choice.Detail ?? choice.Value)</small>
                                        @if (!choice.Ready)
                                        {
                                            <small>Unavailable · @(choice.Reason ?? "not configured")</small>
                                        }
                                        else if (HasReferences && !choice.SupportsReferences)
                                        {
                                            <small>Cannot use this image's references</small>
                                        }
                                    </span>
                                </label>
                            }
                        </div>

                        @if (_modelPickerError is { } modelError)
                        {
                            <p class="cm-form__error" role="alert">@modelError</p>
                        }
                        <footer class="cm-modal__actions">
                            <button type="button" class="cm-button cm-button--quiet"
                                    disabled="@_modelPickerBusy" @onclick="CloseModelPicker">Cancel</button>
                            <button type="button" class="cm-button"
                                    disabled="@(_modelPickerBusy || !CanApplyModel)"
                                    @onclick="ApplyModelAsync">
                                @(_modelPickerBusy ? "Saving…" : "Use model")
                            </button>
                        </footer>
                    </div>
                </div>
            }

            @if (_openVariant is { } take)
            {
                @* The take dialog: full-size view + steering + keep/discard/place. Custom
                   .cm-modal like the app's confirm dialog — Escape closes, backdrop closes. *@
                <div class="cm-modal" role="presentation" @onclick="CloseVariant">
                    <div class="cm-lightbox" role="dialog" aria-modal="true"
                         aria-labelledby="cm-variant-title" tabindex="-1"
                         @ref="_dialogPanel"
                         @onclick:stopPropagation
                         @onkeydown="OnDialogKey">

                        @* The image is the subject, so it gets the room. Everything else is
                           a rail beside it rather than a form the picture sits inside. *@
                        <figure class="cm-lightbox__stage">
                            <img class="cm-lightbox__image" src="@take.Url" alt="Full-size take" />
                        </figure>

                        <div class="cm-lightbox__rail">
                            <header class="cm-lightbox__head">
                                <h2 id="cm-variant-title">@ArtifactDisplay.SlotLabel(Selected?.Kind ?? "")</h2>
                                <p class="cm-meta cm-mono">@take.Width×@take.Height · @take.Model</p>
                                @if (take.SteeringNote is { } note)
                                {
                                    <p class="cm-meta">Steered from an earlier take: “@note”</p>
                                }
                            </header>

                            @if (_supportingContext is { } dialogContext)
                            {
                                <section class="cm-lightbox__group cm-lightbox__context"
                                         aria-label="Content this image supports">
                                    <span class="cm-kicker">What this image supports</span>
                                    <strong>@dialogContext.Title</strong>
                                    <blockquote>@dialogContext.Excerpt</blockquote>
                                </section>
                            }

                            @if (Selected is { } headlineSlot && headlineSlot.SafeArea)
                            {
                                @* Overlay controls live here because this is where you can SEE
                                   the result. Models mangle small text, so the headline is
                                   composited after generation (ADR-013) — editing it is free. *@
                                <section class="cm-lightbox__group">
                                    <span class="cm-kicker">Overlay text</span>
                                    <input class="cm-input" maxlength="32" @bind="_headline"
                                           placeholder="Up to 32 characters" />

                                    <span class="cm-kicker">Behind the text</span>
                                    <div class="cm-rings">
                                        @foreach (var (label, value) in HeadlineBackgrounds)
                                        {
                                            <button type="button"
                                                    class="cm-ring @(value is null ? "cm-ring--none" : null) @(_headlineBackground == value ? "cm-ring--on" : null)"
                                                    style="@(value is null ? null : $"background:{value}")"
                                                    title="@label"
                                                    aria-label="@label"
                                                    aria-pressed="@((_headlineBackground == value).ToString().ToLowerInvariant())"
                                                    @onclick="() => _headlineBackground = value">
                                            </button>
                                        }
                                    </div>

                                    <label class="cm-fanout__item">
                                        <input type="checkbox" @bind="_safeArea" />
                                        <span>Keep clear of platform UI</span>
                                    </label>

                                    <button type="button" class="cm-button cm-button--quiet"
                                            disabled="@(_compositing || string.IsNullOrWhiteSpace(_headline))"
                                            @onclick="CompositeAsync">
                                        @(_compositing ? "Applying…" : "Apply overlay")
                                    </button>
                                    <p class="cm-meta">No model call — editing the overlay is free.</p>
                                </section>
                            }

                            <section class="cm-lightbox__group">
                                <span class="cm-kicker">Steer a new take</span>
                                <textarea class="cm-input cm-textarea" rows="3" @bind="_steerNote" @bind:event="oninput"
                                          placeholder="e.g. warmer background, more negative space top-left"></textarea>
                                <div class="cm-studio__chips">
                                    @foreach (var chip in SteerChips)
                                    {
                                        var selected = SteerConstraintSelected(chip);
                                        <button type="button"
                                                class="cm-studio__chip @(selected ? "cm-studio__chip--on" : null)"
                                                    aria-pressed="@(selected ? "true" : "false")"
                                                @onclick="() => ToggleSteerChip(chip)">
                                            @(selected ? "Applied · " : "Add · ")@chip
                                        </button>
                                    }
                                </div>

                                @* These are real image inputs persisted on the selected card.
                                   The same references are reattached when steering from a take. *@
                                <span class="cm-kicker">From @(Campaign.Brand?.Name ?? "the brand kit")</span>

                                @if (Campaign.Brand is null)
                                {
                                    <p class="cm-meta">
                                        This campaign has no brand, so there is no kit to draw on.
                                        <a href="campaigns">Pick one on the campaign</a> to reuse faces
                                        and backgrounds here.
                                    </p>
                                }
                                else
                                {
                                    @if (ProductAssets.Count > 0)
                                    {
                                        <p class="cm-meta">Product screenshots stay attached automatically.</p>
                                    }
                                    @foreach (var group in ReferenceKit)
                                    {
                                        <div class="cm-studio__kit">
                                            <span class="cm-meta">
                                                @KindLabel(group.Key)
                                                @if (_picked.TryGetValue(group.Key, out var chosen))
                                                {
                                                    <span class="cm-mono"> · @(chosen.Label ?? chosen.FileName)</span>
                                                }
                                            </span>
                                            <div class="cm-studio__picks">
                                                @foreach (var asset in group)
                                                {
                                                    var isOn = _picked.TryGetValue(group.Key, out var sel) && sel.Id == asset.Id;
                                                    <button type="button"
                                                            class="cm-studio__pick @(isOn ? "cm-studio__pick--on" : null)"
                                                            aria-pressed="@(isOn ? "true" : "false")"
                                                            title="@(asset.Label ?? asset.FileName)"
                                                            @onclick="() => TogglePickAsync(group.Key, asset)">
                                                        @if (_kitPreviews.TryGetValue(asset.AssetId, out var thumb))
                                                        {
                                                            <img src="@thumb" alt="" loading="lazy" />
                                                        }
                                                        <span class="cm-studio__pick-label">
                                                            @(asset.Label ?? asset.FileName)
                                                        </span>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }

                                    @if (!ReferenceKit.Any())
                                    {
                                        <p class="cm-meta">Nothing in the kit yet — add a face or background below.</p>
                                    }

                                    <div class="cm-studio__upload">
                                        <select class="cm-input" @bind="_uploadKind" aria-label="What this asset is">
                                            <option value="product">Product screenshot</option>
                                            <option value="face">Face</option>
                                            <option value="background">Background</option>
                                            <option value="logo">Logo</option>
                                            <option value="other">Other</option>
                                        </select>
                                        @* The label is load-bearing: it becomes the prompt text,
                                           so an unlabelled upload steers nothing useful. *@
                                        <input class="cm-input" placeholder="Describe it — e.g. the host, short dark hair"
                                               aria-label="Description used as prompt text"
                                               @bind="_uploadLabel" @bind:event="oninput" />
                                        <InputFile OnChange="UploadKitAssetAsync" accept="image/*"
                                                   disabled="@(_uploading || string.IsNullOrWhiteSpace(_uploadLabel))" />
                                        @if (_uploading)
                                        {
                                            <span class="cm-meta">Uploading…</span>
                                        }
                                    </div>
                                    @if (_uploadError is { } kitError)
                                    {
                                        <p class="cm-form__error" role="alert">@kitError</p>
                                    }
                                    <p class="cm-meta">
                                        Saved to @Campaign.Brand.Name, so it is available to every
                                        campaign on this brand.
                                    </p>
                                }

                                <button type="button" class="cm-button cm-button--quiet"
                                        disabled="@(!CanSteer || IsGenerating)"
                                        @onclick="() => SteerAsync(take)">
                                    New take from this (≈ @CostPerVariantUsd.ToString("$0.00"))
                                </button>
                                @if (!CanSteer)
                                {
                                    <p class="cm-meta">Pick a reference or type an adjustment — either is enough.</p>
                                }
                            </section>

                            <footer class="cm-lightbox__actions">
                                <button type="button" class="cm-button" disabled="@_placing"
                                        @onclick="() => PlaceAsync(take)">
                                    @(_placing ? "Placing…" : "Place in slot")
                                </button>
                                @if (take.State != "Kept")
                                {
                                    <button type="button" class="cm-button cm-button--quiet"
                                            title="Show this take in Focus without placing it"
                                            @onclick='() => SetStateAsync(take, "Kept")'>Mark as keeper</button>
                                }
                                <button type="button" class="cm-button cm-button--quiet"
                                        disabled="@_downloading" @onclick="() => DownloadAsync(take)">
                                    @(_downloading ? "Downloading…" : "↓ Download image")
                                </button>
                                @if (take.State != "Discarded")
                                {
                                    <button type="button" class="cm-button cm-button--quiet"
                                            title="Hides the take — recoverable from “Show discarded takes”"
                                            @onclick='() => SetStateAsync(take, "Discarded")'>Discard</button>
                                }
                                else
                                {
                                    <button type="button" class="cm-button cm-button--quiet"
                                            @onclick='() => SetStateAsync(take, "Candidate")'>Restore</button>
                                }
                                <button type="button" class="cm-button cm-button--quiet cm-button--danger"
                                        @onclick="() => DeleteTakeAsync(take)">Delete forever</button>
                                <button type="button" class="cm-button cm-button--quiet" @onclick="CloseVariant">Close</button>
                            </footer>
                        </div>
                    </div>
                </div>
            }

            @if (_kitPickerOpen && Campaign.Brand is { } kitBrand)
            {
                @* The kit picker: master–detail over the brand's reference assets. Left lists
                   the kit grouped by type, right previews the selection at a judgeable size.
                   Same .cm-modal chrome as the take lightbox — Escape closes, backdrop closes. *@
                <div class="cm-modal" role="presentation" @onclick="CloseKitPicker">
                    <div class="cm-kitpicker" role="dialog" aria-modal="true"
                         aria-label="Choose reference images" tabindex="-1"
                         @ref="_kitPickerPanel"
                         @onclick:stopPropagation
                         @onkeydown="OnKitPickerKey">
                        <header class="cm-kitpicker__head">
                            <div>
                                <h2>Reference images</h2>
                                <p class="cm-meta">From @kitBrand.Name's kit — one per type. A selection is a real image input to the model, not prompt text.</p>
                            </div>
                            <button type="button" class="cm-studio__drawer-close"
                                    aria-label="Close" title="Close (Esc)" @onclick="CloseKitPicker">✕</button>
                        </header>
                        <div class="cm-kitpicker__body">
                            <nav class="cm-kitpicker__list" aria-label="Kit assets by type">
                                @foreach (var group in ReferenceKit)
                                {
                                    <span class="cm-kicker">@KindLabel(group.Key)</span>
                                    <ul>
                                        @foreach (var asset in group)
                                        {
                                            var isPicked = _picked.TryGetValue(group.Key, out var sel) && sel.Id == asset.Id;
                                            var isCurrent = _kitPreviewAsset?.Id == asset.Id;
                                            <li>
                                                <button type="button"
                                                        class="cm-kitpicker__item @(isCurrent ? "cm-kitpicker__item--current" : null)"
                                                        aria-current="@(isCurrent ? "true" : "false")"
                                                        @onclick="() => _kitPreviewAsset = asset">
                                                    @if (_kitPreviews.TryGetValue(asset.AssetId, out var listThumb))
                                                    {
                                                        <img src="@listThumb" alt="" loading="lazy" />
                                                    }
                                                    <span class="cm-kitpicker__item-label">@(asset.Label ?? asset.FileName)</span>
                                                    @if (isPicked)
                                                    {
                                                        <span class="cm-kitpicker__tick" aria-label="Selected">✓</span>
                                                    }
                                                </button>
                                            </li>
                                        }
                                    </ul>
                                }
                            </nav>
                            <section class="cm-kitpicker__preview" aria-label="Preview">
                                @if (_kitPreviewAsset is { } previewAsset)
                                {
                                    var previewKind = previewAsset.Kind.ToLowerInvariant();
                                    var previewOn = _picked.TryGetValue(previewKind, out var chosenNow) && chosenNow.Id == previewAsset.Id;
                                    @if (_kitPreviews.TryGetValue(previewAsset.AssetId, out var big))
                                    {
                                        <img src="@big" alt="@(previewAsset.Label ?? previewAsset.FileName)" />
                                    }
                                    <strong>@(previewAsset.Label ?? previewAsset.FileName)</strong>
                                    <span class="cm-meta">@KindLabel(previewKind)</span>
                                    <button type="button" class="cm-button"
                                            @onclick="() => TogglePickAsync(previewKind, previewAsset)">
                                        @(previewOn ? "Remove from this card" : $"Use as the {KindLabel(previewKind).ToLowerInvariant()} reference")
                                    </button>
                                    @if (!previewOn && _picked.ContainsKey(previewKind))
                                    {
                                        <p class="cm-meta">Replaces the current @KindLabel(previewKind).ToLowerInvariant() — one per type.</p>
                                    }
                                }
                                else
                                {
                                    <p class="cm-meta">Pick an asset on the left to preview it here.</p>
                                }
                            </section>
                        </div>
                        <footer class="cm-kitpicker__actions">
                            <button type="button" class="cm-button" @onclick="CloseKitPicker">Done</button>
                        </footer>
                    </div>
                </div>
            }
        </div>
    </div>
</CampaignShell>

@code {

    /// <summary>
    /// Where the client is actually pointed. The desktop shell and the web shell resolve the
    /// API differently, so naming it turns "couldn't reach the API" into something a person
    /// can check.
    /// </summary>
    private string ApiOrigin() => Http.BaseAddress?.ToString() ?? "the API";
    private static readonly int[] VariantChoices = [1, 2, 4, 6];
    private static readonly int[] BatchTakeTargets = [1, 2, 4];

    // gpt-image-2 list price at 2026 rates for a single ~1-2 MP render; an estimate on the
    // surface beats a silent bill (the projected-vs-actual honesty rule, applied to money).
    private const decimal CostPerVariantUsd = 0.07m;

    private static readonly string[] ConstraintChips =
    [
        "no text in the image",
        "high contrast focal subject",
        "room for a headline top-left",
        "editorial photography, not illustration",
        "brand-warm palette",
    ];

    /// <summary>Quick adjustments for steering a new take from an existing one.</summary>
    private static readonly string[] SteerChips =
    [
        "add a face",
        "change the background",
        "more contrast",
        "zoom out",
        "warmer light",
        "remove any text",
    ];

    private Guid? _selectedId;
    private string _prompt = string.Empty;
    private string? _savedPrompt;
    private string _promptMode = "Auto";
    private bool _changingPromptMode;
    private string? _activeConceptName;
    private AiStatusResponse? _status;
    private string? _defaultImageModel;
    private bool _defaultModelLoaded;
    private readonly Dictionary<Guid, string?> _sessionModelOverrides = [];
    private const string WorkspaceDefaultModel = "__workspace_default__";
    private bool _modelPickerOpen;
    private bool _modelPickerBusy;
    private string? _modelPickerError;
    private string? _modelDraft;
    private int _variantCount = 1;
    private int _batchTakeTarget = 1;
    private Guid? _batchAttachCampaign;
    private Guid? _handledBatchRun;
    private Guid? _addingFor;
    private bool _seeding;
    private bool _placing;
    private bool _downloading;
    private bool _compositing;
    private bool _showDiscarded;
    private string? _generateError;
    private string? _galleryError;
    private string? _headlineBackground;
    private SupportingContentContext? _supportingContext;
    private bool _supportingContextLoading;

    private sealed record SupportingContentContext(string Title, string Kind, string Excerpt);

    /// <summary>
    /// Band colours behind overlay text. A short, opinionated set beats a colour wheel here:
    /// the job is legibility over an unpredictable generated background, and near-black or
    /// near-white at high opacity is what actually achieves it.
    /// </summary>
    private static readonly (string Label, string? Value)[] HeadlineBackgrounds =
    [
        ("No band", null),
        ("Black", "#000000"),
        ("Charcoal", "#1F2933"),
        ("White", "#FFFFFF"),
        ("Slate", "#2F4858"),
    ];

    /// <summary>The brand's real reference images. Selected ids are persisted on the card;
    /// product screenshots are attached automatically by the server.</summary>
    private List<BrandAssetResponse> _brandAssets = [];
    private Guid? _facesLoadedFor;

    private string _uploadKind = "face";
    private string _uploadLabel = string.Empty;
    private bool _uploading;
    private string? _uploadError;

    /// <summary>Faces first — they are what the panel is reached for most.</summary>
    private static readonly string[] KitOrder = ["product", "face", "background", "accent", "logo", "other"];

    private IEnumerable<IGrouping<string, BrandAssetResponse>> BrandKit =>
        _brandAssets
            .GroupBy(a => a.Kind.ToLowerInvariant())
            .OrderBy(g => Array.IndexOf(KitOrder, g.Key) is var i && i >= 0 ? i : KitOrder.Length);

    private IEnumerable<IGrouping<string, BrandAssetResponse>> ReferenceKit =>
        BrandKit.Where(g => g.Key != "product");

    private IReadOnlyList<BrandAssetResponse> ProductAssets =>
        [.. _brandAssets.Where(a => a.Kind.Equals("product", StringComparison.OrdinalIgnoreCase))];

    /// <summary>At most one asset per kind — a picker, not a multi-select.</summary>
    private readonly Dictionary<string, BrandAssetResponse> _picked = new(StringComparer.Ordinal);

    /// <summary>Read-SAS thumbnails, so a background is chosen by looking at it.</summary>
    private readonly Dictionary<Guid, string> _kitPreviews = [];

    private static string KindLabel(string kind) => kind switch
    {
        "face" => "Face",
        "product" => "Product screenshot",
        "background" => "Background",
        "accent" => "Accent",
        "logo" => "Logo",
        _ => "Other",
    };

    /// <summary>Selecting a reference changes the actual image input, not just prompt text.</summary>
    private async Task TogglePickAsync(string kind, BrandAssetResponse asset)
    {
        if (_picked.TryGetValue(kind, out var current) && current.Id == asset.Id)
        {
            _picked.Remove(kind);
        }
        else
        {
            _picked[kind] = asset;
        }

        if (Selected is not { } slot)
        {
            return;
        }

        try
        {
            await Images.PatchAsync(CampaignId, slot.Id,
                referenceAssetIds: [.. _picked.Values.Select(a => a.Id)]);
        }
        catch (ApiException ex)
        {
            Notifier.ShowError(ex.Message);
        }
    }

    // Kept as a pure selection helper for component-level tests and non-rendered callers.
    // The visible picker uses TogglePickAsync, which additionally persists real reference ids.
    private void TogglePick(string kind, BrandAssetResponse asset)
    {
        if (_picked.TryGetValue(kind, out var current) && current.Id == asset.Id)
        {
            _picked.Remove(kind);
        }
        else
        {
            _picked[kind] = asset;
        }
        SyncPickedSteering();
    }

    private static string AssetPrompt(BrandAssetResponse asset) =>
        asset.Kind.ToLowerInvariant() switch
        {
            "background" => $"set against {asset.Label ?? asset.FileName}",
            "accent" => $"accented with {asset.Label ?? asset.FileName}",
            "logo" => $"carrying {asset.Label ?? asset.FileName}",
            _ => $"featuring {asset.Label ?? asset.FileName}",
        };

    private void SyncPickedSteering()
    {
        const string marker = "From the brand kit: ";
        var typed = _steerNote ?? string.Empty;
        var at = typed.IndexOf(marker, StringComparison.Ordinal);
        if (at >= 0)
        {
            typed = typed[..at].TrimEnd();
        }
        var parts = _picked.OrderBy(p => Array.IndexOf(KitOrder, p.Key)).Select(p => AssetPrompt(p.Value));
        _steerNote = _picked.Count == 0
            ? typed
            : string.IsNullOrWhiteSpace(typed)
                ? marker + string.Join(", ", parts) + "."
                : typed + "\n" + marker + string.Join(", ", parts) + ".";
    }

    private async Task LoadBrandFacesAsync()
    {
        if (Campaign.Brand is not { } brand)
        {
            _brandAssets = [];
            return;
        }

        try
        {
            _brandAssets = [.. (await BrandsApi.ListAssetsAsync(brand.Id))
                .Where(a => !string.IsNullOrWhiteSpace(a.Label ?? a.FileName))];

            // Preview URLs for the whole kit in one call, pointing at cached small
            // derivatives. This was a sequential SAS mint per asset against the full-size
            // original, so the picker's tiles filled in one slow row at a time. Best effort:
            // a kit with no previews still shows labelled tiles, which remain usable.
            var wanted = _brandAssets
                .Select(a => a.AssetId)
                .Where(id => !_kitPreviews.ContainsKey(id))
                .Distinct()
                .ToList();
            if (wanted.Count > 0)
            {
                try
                {
                    foreach (var thumb in await BrandsApi.MintThumbsAsync(wanted))
                    {
                        _kitPreviews[thumb.AssetId] = thumb.ReadUrl;
                    }
                }
                catch (ApiException)
                {
                }
            }

            _picked.Clear();
            foreach (var id in Selected?.ReferenceAssetIds ?? [])
            {
                if (_brandAssets.FirstOrDefault(a => a.Id == id) is { } selected)
                {
                    _picked[selected.Kind.ToLowerInvariant()] = selected;
                }
            }
        }
        catch (ApiException)
        {
            // An empty kit rather than a broken panel; the steer box still works.
            _brandAssets = [];
        }
    }

    /// <summary>
    /// Uploads straight into the brand kit from the studio. Same three-step flow the Brands
    /// page uses — create the library asset, PUT the bytes to the SAS URL, link it to the
    /// brand — so there is one storage path, not a second one that drifts.
    /// </summary>
    private async Task UploadKitAssetAsync(InputFileChangeEventArgs e)
    {
        if (Campaign.Brand is not { } brand || e.File is null)
        {
            return;
        }

        _uploading = true;
        _uploadError = null;
        try
        {
            const long maxBytes = 20L * 1024 * 1024;
            var file = e.File;
            var asset = await BrandsApi.CreateLibraryAssetAsync(file.Name, file.ContentType, file.Size);

            // Through the API, not straight to storage — see BrandsClient.UploadAssetContentAsync.
            await using var stream = file.OpenReadStream(maxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            await BrandsApi.UploadAssetContentAsync(asset.Id, buffer.ToArray(), file.ContentType);

            await BrandsApi.LinkAssetAsync(brand.Id, asset.Id, _uploadKind, _uploadLabel.Trim());
            _uploadLabel = string.Empty;
            await LoadBrandFacesAsync();
            Notifier.ShowSuccess($"Added to {brand.Name}'s kit.");
        }
        catch (ApiException ex)
        {
            _uploadError = ex.Message;
        }
        catch (HttpRequestException ex)
        {
            // NAME the failure. A bare "couldn't reach the API" is unactionable and sent us
            // chasing storage CORS for three rounds while the real fault was elsewhere; the
            // inner exception is the one thing that identifies it.
            _uploadError = $"Upload failed talking to {ApiOrigin()} — "
                + $"{ex.GetType().Name}: {ex.Message}"
                + (ex.InnerException is { } inner ? $" ({inner.GetType().Name}: {inner.Message})" : "");
        }
        finally
        {
            _uploading = false;
        }
    }
    private List<ImageVariantResponse> _gallery = [];
    private List<string> _failures = [];
    private string? _headline;
