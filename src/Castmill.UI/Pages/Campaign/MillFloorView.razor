@* The Mill Floor (F5.1/5.2/5.4) — the campaign workspace's centrepiece.

   Two regions: the Source Master card (player band, scrubber, timed transcript) and the
   swimlane board (horizontal scroll inside its own region, transform-only zoom). Status is
   double-encoded per ADR-F12. Provenance threads draw on hover, pin on click. The Press Run
   reveals cards in completion order, driven by real run progress — never a timer (ADR-F13). *@
@page "/campaigns/{CampaignId:guid}/floor"
@using Castmill.Core
@using Castmill.Core.Ai
@using Castmill.Core.Resources
@using Castmill.UI.Canvas
@using Castmill.UI.Design
@using Castmill.UI.State
@implements IDisposable
@inject CampaignState Campaign
@inject PressRunService PressRun
@inject Castmill.UI.Http.CampaignsClient Campaigns
@inject Castmill.UI.Http.GenerationClient Generation
@inject IConfirmService Confirm
@inject INotifier Notifier
@inject NavigationManager Navigation

<PageTitle>@(Campaign.Campaign?.Name ?? "Campaign") — Mill Floor</PageTitle>

<CampaignShell CampaignId="CampaignId" View="CampaignView.MillFloor">
    <div class="cm-canvas" @ref="_canvas">
        <section class="cm-canvas__source">
            <header class="cm-source__head">
                <span class="cm-kicker">Source master</span>
                <span class="cm-meta">@(Campaign.Transcript?.Source ?? "no source")</span>
            </header>

            @if (Campaign.Transcript is { Segments.Count: > 0 } transcript)
            {
                <div class="cm-source__player cm-duotone" aria-hidden="true">
                    <span class="cm-source__play">&#9654;</span>
                </div>
                <div class="cm-source__scrub cm-mono cm-meta">
                    <span>0:00</span>
                    <span class="cm-source__scrub-bar"></span>
                    <span>@Clock(transcript.Segments[^1].EndSeconds)</span>
                </div>

                <SourceTranscript Transcript="transcript" Highlighted="_highlighted" />

                @if (_pinnedId is { } pinned && PinnedCitations.Count > 0)
                {
                    <aside class="cm-source__quotes">
                        <span class="cm-kicker">Cited by "@ArtifactTitle(pinned)"</span>
                        <ul>
                            @foreach (var id in PinnedCitations)
                            {
                                var segment = transcript.Segments.FirstOrDefault(s => s.Id == id);
                                if (segment is not null)
                                {
                                    <li>
                                        <span class="cm-mono cm-meta">@segment.Id · @Clock(segment.StartSeconds)</span>
                                        <blockquote>@segment.Text</blockquote>
                                    </li>
                                }
                            }
                        </ul>
                    </aside>
                }
            }
            else
            {
                <EmptyState Kicker="Source"
                            Headline="No transcript on this campaign."
                            Detail="The source master renders the timed transcript — every thread on this board points back into it." />
            }
        </section>

        <section class="cm-canvas__board cm-scroll-x" data-cm-scroll>
            @if (PressRun.IsActiveFor(CampaignId))
            {
                @* The press panel: the run narrated in full, not a footer whisper. Every
                   row is a requested kind; state comes from real completions (ADR-F13). *@
                <div class="cm-press">
                    <span class="cm-kicker">Press run</span>
                    <h2 class="cm-press__line">@PressLine</h2>
                    @if (PressRun.Error is { } runError)
                    {
                        <p class="cm-form__error" role="alert">@runError</p>
                    }
                    <ul class="cm-press__items">
                        @foreach (var kind in PressRun.Kinds)
                        {
                            var item = PressRun.Progress?.Items.FirstOrDefault(i => i.Kind == kind);
                            <li class="cm-press__item @(item is null ? "" : item.Success ? "cm-press__item--done" : "cm-press__item--failed")">
                                <span class="cm-press__mark cm-mono">
                                    @(item is null ? "…" : item.Success ? "✓" : "✕")
                                </span>
                                <span class="cm-press__kind">@ArtifactDisplay.KindLabel(kind)</span>
                                <span class="cm-meta">
                                    @(item is null
                                        ? "queued"
                                        : item.Success
                                            ? $"printed · {item.DurationMs / 1000.0:0.0}s"
                                            : item.Error)
                                </span>
                                @if (item?.ValidationWarnings is { Count: > 0 } warnings)
                                {
                                    <span class="cm-meta cm-press__audit">audit: @string.Join(" · ", warnings.Take(2))</span>
                                }
                            </li>
                        }
                    </ul>
                    @if (PressRun.IsRunning)
                    {
                        <p class="cm-meta">
                            Each artifact prints onto the board below the moment its generator
                            finishes. Long-form pieces take a minute or two against live models.
                        </p>
                    }
                    else
                    {
                        <button type="button" class="cm-button cm-button--quiet" @onclick="DismissRun">
                            Done — back to the board
                        </button>
                    }
                </div>
            }
            @if (Campaign.Transcript is not null && !PressRun.IsActiveFor(CampaignId))
            {
                <div class="cm-board__more">
                    <span class="cm-kicker">Print more from this source</span>
                    @* Every kind is offered, not just the ones missing. A campaign that already
                       has a blog is exactly the campaign that wants a second one on a different
                       angle — hiding the chip once you own one made "add another" unreachable. *@
                    <div class="cm-board__more-grid">
                        @foreach (var kind in AllKinds)
                        {
                            var label = kind == "social" ? "Social set (6)" : ArtifactDisplay.KindLabel(kind);
                            var owned = CountOf(kind);
                            <button type="button"
                                    class="cm-print-chip @(_addKind == kind ? "cm-print-chip--active" : null)"
                                    title="@(owned == 0 ? $"Generate {label} from this transcript" : $"Add another {label} — you have {owned}")"
                                    @onclick="() => ToggleAdd(kind)">
                                <span class="cm-print-chip__plus" aria-hidden="true">+</span>
                                <span class="cm-print-chip__label">@label</span>
                                @if (owned > 0)
                                {
                                    <span class="cm-meta cm-print-chip__count">@owned</span>
                                }
                            </button>
                        }
                    </div>

                    @if (_addKind is { } adding)
                    {
                        <div class="cm-board__add">
                            <label class="cm-field cm-board__add-angle">
                                <span class="cm-field__label">
                                    Angle for @(adding == "social" ? "these posts" : ArtifactDisplay.KindLabel(adding))
                                    <span class="cm-meta">optional</span>
                                </span>
                                <input class="cm-input" @bind="_addAngle" @bind:event="oninput"
                                       placeholder="Make this one about pricing objections." />
                            </label>
                            <div class="cm-board__add-count">
                                <span class="cm-kicker">How many</span>
                                @foreach (var n in CountChoices)
                                {
                                    <label class="cm-fanout__item">
                                        <input type="radio" name="cm-add-count" checked="@(_addCount == n)"
                                               @onchange="() => _addCount = n" />
                                        <span>@n</span>
                                    </label>
                                }
                            </div>
                            <div class="cm-form__actions">
                                <button type="button" class="cm-button" @onclick="() => GenerateKind(adding)">
                                    @AddButtonLabel(adding)
                                </button>
                                <button type="button" class="cm-button cm-button--quiet" @onclick="CancelAdd">
                                    Cancel
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (Campaign.Artifacts.Count == 0 && !PressRun.IsActiveFor(CampaignId))
            {
                <div class="cm-pad">
                    <EmptyState Kicker="Mill Floor"
                                Headline="Nothing has been printed yet."
                                Detail="A run turns the transcript into the whole set — blog, social, email, clips and the image plan." />
                </div>
            }
            else
            {
                <div class="cm-board__scale" style="transform: scale(@ZoomCss); transform-origin: top left;">
                    @foreach (var lane in Lanes)
                    {
                        <div class="cm-lane">
                            <h2 class="cm-kicker cm-lane__label">@lane.Name</h2>
                            <div class="cm-lane__groups">
                            @foreach (var kindGroup in lane.Cards
                                .GroupBy(a => ArtifactDisplay.Resolve(a.Kind).Kind)
                                .OrderBy(g => ArtifactDisplay.KindOrder(g.Key)))
                            {
                                <div class="cm-lane__group">
                                    @* Always show the count, not only when >1: a header that
                                       sometimes carries a number and sometimes does not reads
                                       as inconsistent rather than as tidy. *@
                                    <h3 class="cm-lane__kind">
                                        <span>@ArtifactDisplay.KindLabel(kindGroup.Key)</span>
                                        <span class="cm-lane__kind-count cm-mono">(@kindGroup.Count())</span>
                                    </h3>
                                    <ul class="cm-lane__cards">
                                        @foreach (var artifact in kindGroup.OrderBy(a => a.CreatedAt))
                                        {
                                            <li>
                                                <button type="button"
                                                        class="cm-card cm-card--lane @(artifact.Id == ActiveId ? "cm-card--traced" : "") @(_justPrinted.Contains(artifact.Id) ? "cm-card--printed" : "")"
                                                        data-card="@artifact.Id"
                                                        @onmouseover="() => Hover(artifact)"
                                                        @onmouseout="Unhover"
                                                        @onclick="() => TogglePin(artifact)">
                                                    <span class="cm-card__bar @BarClass(artifact.Status)" aria-hidden="true"></span>
                                                    <span class="cm-card__body">
                                                        <span class="cm-card__title">@artifact.Title</span>
                                                        <span class="@ArtifactDisplay.StatusModifier(artifact.Status)">
                                                            @ArtifactDisplay.StatusLabel(artifact.Status)
                                                        </span>
                                                    </span>
                                                </button>

                                                @* Hover toolbar. Editing used to need a
                                                   double-click, which is undiscoverable and has
                                                   no keyboard or touch equivalent — a card is a
                                                   button, so its actions are buttons too. *@
                                                <div class="cm-card__tools" role="group"
                                                     aria-label="Actions for @artifact.Title">
                                                    <button type="button" class="cm-card__tool"
                                                            title="Edit @ArtifactDisplay.KindLabel(artifact.Kind)"
                                                            aria-label="Edit @artifact.Title"
                                                            @onclick="() => OpenFocus(artifact)">
                                                        <span aria-hidden="true">✎</span>
                                                    </button>
                                                    <button type="button" class="cm-card__tool cm-card__tool--danger"
                                                            title="Delete @ArtifactDisplay.KindLabel(artifact.Kind)"
                                                            aria-label="Delete @artifact.Title"
                                                            @onclick="() => DeleteAsync(artifact)">
                                                        <span aria-hidden="true">🗑</span>
                                                    </button>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                            @if (lane.GhostKinds.Count > 0)
                            {
                                @* Ghost cards: content this run is still printing. No data-card
                                   attribute — the provenance overlay must never try to measure
                                   a card that has no citations yet. *@
                                <div class="cm-lane__group">
                                    <ul class="cm-lane__cards">
                                        @foreach (var kind in lane.GhostKinds)
                                        {
                                            <li>
                                                <div class="cm-card cm-card--lane cm-card--ghost" role="status"
                                                     aria-label="Printing @ArtifactDisplay.KindLabel(kind)">
                                                    <span class="cm-card__bar cm-card__bar--draft" aria-hidden="true"></span>
                                                    <span class="cm-card__body">
                                                        <span class="cm-skeleton cm-skeleton--title" aria-hidden="true"></span>
                                                        <span class="cm-meta">@ArtifactDisplay.KindLabel(kind)</span>
                                                        <span class="cm-meta cm-card__printing">
                                                            <span class="cm-ai-dot" aria-hidden="true"></span> printing…
                                                        </span>
                                                    </span>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        <ProvenanceOverlay Container="_canvas"
                           ActiveArtifactId="ActiveId"
                           Citations="ActiveCitations"
                           Epoch="_geometryEpoch"
                           OnHighlight="OnHighlight" />

        <footer class="cm-canvas__status">
            @if (PressRun.IsActiveFor(CampaignId))
            {
                <span class="cm-mono cm-canvas__printing" role="status">@PressLine</span>
            }
            else
            {
                <span class="cm-canvas__counts">
                    @foreach (var group in Campaign.Artifacts.Where(a => ArtifactDisplay.OnBoard(a.Kind)).GroupBy(a => a.Status))
                    {
                        <span class="@ArtifactDisplay.StatusModifier(group.Key) cm-canvas__count">
                            @group.Count() @ArtifactDisplay.StatusLabel(group.Key).ToLowerInvariant()
                        </span>
                    }
                </span>
            }

            <div class="cm-segmented" role="group" aria-label="Zoom">
                <button type="button" class="cm-segmented__option" aria-pressed="@(!_overview)"
                        @onclick="() => SetZoom(false)">100%</button>
                <button type="button" class="cm-segmented__option" aria-pressed="@_overview"
                        @onclick="() => SetZoom(true)">Overview</button>
            </div>
        </footer>
    </div>
</CampaignShell>

@code {
    private readonly HashSet<string> _highlighted = [];
    private readonly HashSet<Guid> _justPrinted = [];
    private readonly HashSet<Guid> _seenArtifacts = [];

    private ElementReference _canvas;
    private Guid? _hoverId;
    private Guid? _pinnedId;
    private bool _overview;
    private int _geometryEpoch;

    [Parameter] public Guid CampaignId { get; set; }

    /// <summary>Deep link from the omnibox's transcript search: highlights this segment.</summary>
    [SupplyParameterFromQuery(Name = "seg")]
    private string? RequestedSegment { get; set; }

    private Guid? ActiveId => _hoverId ?? _pinnedId;

    private IReadOnlyList<string> ActiveCitations =>
        ActiveId is { } id ? CitationsOf(id) : [];

    private IReadOnlyList<string> PinnedCitations =>
        _pinnedId is { } id ? CitationsOf(id) : [];

    private string ZoomCss => _overview ? "0.72" : "1";

    /// <summary>
    /// Kinds this run is still printing that have no card yet — each renders as a ghost
    /// card in its lane, so the board always shows that content is on the way (ADR-F13).
    /// </summary>
    /// <summary>
    /// Ghost cards for work still in flight. Counted rather than keyed on presence: a run that
    /// adds a SECOND blog is a run whose kind the board already shows, so a presence check made
    /// every added piece invisible while it printed. One ghost per copy still outstanding.
    /// </summary>
    private IReadOnlyList<string> PendingKinds
    {
        get
        {
            if (!PressRun.IsActiveFor(CampaignId) || !PressRun.IsRunning)
            {
                return [];
            }

            var ghosts = new List<string>();
            foreach (var kind in PressRun.Kinds.Where(ArtifactDisplay.OnBoard))
            {
                var done = PressRun.Progress?.Items.Count(i => i.Kind == kind) ?? 0;
                for (var i = done; i < PressRun.Copies; i++)
                {
                    ghosts.Add(kind);
                }
            }
            return ghosts;
        }
    }

    /// <summary>One lane per category, carrying both real cards and in-flight ghosts.</summary>
    private IEnumerable<(string Name, List<ArtifactPreviewResponse> Cards, List<string> GhostKinds)> Lanes
    {
        get
        {
            var cards = Campaign.Artifacts.Where(a => ArtifactDisplay.OnBoard(a.Kind)).ToList();
            var ghosts = PendingKinds;

            var laneNames = cards.Select(c => ArtifactDisplay.Lane(c.Kind))
                .Concat(ghosts.Select(ArtifactDisplay.Lane))
                .Distinct()
                .OrderBy(l => Array.IndexOf(ArtifactDisplay.LaneOrder, l) is var i && i >= 0
                    ? i
                    : ArtifactDisplay.LaneOrder.Length);

            foreach (var lane in laneNames)
            {
                yield return (lane,
                    cards.Where(c => ArtifactDisplay.Lane(c.Kind) == lane).ToList(),
                    ghosts.Where(g => ArtifactDisplay.Lane(g) == lane).ToList());
            }
        }
    }

    private string PressLine
    {
        get
        {
            var progress = PressRun.Progress;
            if (progress is null)
            {
                return PressRun.Error ?? "Starting the run…";
            }

            var last = progress.Items.LastOrDefault();
            var verb = PressRun.IsRunning ? "Printing" : "Printed";
            return last is null
                ? "Warming the press…"
                : $"{verb}: {ArtifactDisplay.KindLabel(last.Kind)} · {progress.Completed} of {progress.TotalKinds}";
        }
    }

    protected override void OnInitialized()
    {
        Campaign.Changed += OnCampaignChanged;
        PressRun.Changed += OnPressRunChanged;
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(RequestedSegment))
        {
            _highlighted.Add(RequestedSegment);
        }
    }

    private IReadOnlyList<string> CitationsOf(Guid artifactId) =>
        Campaign.Artifacts.FirstOrDefault(a => a.Id == artifactId)?.Citations ?? [];

    private string ArtifactTitle(Guid artifactId) =>
        Campaign.Artifacts.FirstOrDefault(a => a.Id == artifactId)?.Title ?? "…";

    private void Hover(ArtifactPreviewResponse artifact) => _hoverId = artifact.Id;

    private void Unhover() => _hoverId = null; // the pinned set, if any, takes back over

    private void TogglePin(ArtifactPreviewResponse artifact) =>
        _pinnedId = _pinnedId == artifact.Id ? null : artifact.Id;

    /// <summary>
    /// On-demand menu entries; "social" fans out to the six real platform kinds. Image
    /// prompts are deliberately absent — the Image Studio owns seeding its own prompts.
    /// </summary>
    private static readonly string[] AllKinds =
        ["blog", "social", "email-sequence", "newsletter", "landing-page", "show-notes",
         "clip-suggestions", "seo-brief"];

    private static readonly int[] CountChoices = [1, 2, 3, 5];

    private string? _addKind;
    private string _addAngle = string.Empty;
    private int _addCount = 1;

    /// <summary>How many of a kind the campaign already holds; "social" counts the set.</summary>
    private int CountOf(string kind) => kind == "social"
        ? ArtifactDisplay.SocialKinds.Min(k => Campaign.Artifacts.Count(a => a.Kind == k))
        : Campaign.Artifacts.Count(a => ArtifactDisplay.Resolve(a.Kind).Kind == kind);

    private void ToggleAdd(string kind)
    {
        _addKind = _addKind == kind ? null : kind;
        _addAngle = string.Empty;
        _addCount = 1;
    }

    private void CancelAdd() => _addKind = null;

    private string AddButtonLabel(string kind)
    {
        var noun = kind == "social" ? "social set" : ArtifactDisplay.KindLabel(kind).ToLowerInvariant();
        var verb = CountOf(kind) > 0 ? "Add" : "Print";
        return _addCount == 1 ? $"{verb} 1 {noun}" : $"{verb} {_addCount} {noun}s";
    }

    /// <summary>
    /// Prints one kind on demand — the owner's "generate the rest when I ask, not up
    /// front". Every press, even a single kind, rides the Press Run so the panel
    /// narrates it live: queued → printing → ✓ with timing, never a dead button.
    /// The angle rides as the run's brief, which is the same channel Focus mode's
    /// steering box already uses.
    /// </summary>
    private void GenerateKind(string kind)
    {
        if (Campaign.TranscriptArtifactId is not { } transcriptId)
        {
            return;
        }

        var kinds = kind == "social" ? ArtifactDisplay.SocialKinds : [kind];
        var angle = string.IsNullOrWhiteSpace(_addAngle) ? null : _addAngle.Trim();
        PressRun.Start(CampaignId, transcriptId, angle, kinds, _addCount);
        _addKind = null;
    }

    private void DismissRun() => PressRun.Acknowledge();

    /// <summary>Deletes one artifact after a confirm; the board reloads from the server.</summary>
    private async Task DeleteAsync(ArtifactPreviewResponse artifact)
    {
        // Named explicitly, and spelling out what ELSE goes with it: the revision ring holds
        // every earlier take, so deleting an artifact throws away work the user may not
        // realise is attached to it. "There is no undo" is the load-bearing sentence.
        var kind = ArtifactDisplay.KindLabel(artifact.Kind).ToLowerInvariant();
        var accepted = await Confirm.ConfirmAsync(new ConfirmRequest(
            $"Permanently delete this {kind}?",
            $"\u201c{artifact.Title}\u201d and its full revision history will be destroyed. "
            + "Any images placed into it stay in the library, but the piece itself cannot be "
            + "recovered — this is not the same as archiving, and there is no undo.",
            AcceptLabel: $"Delete {kind} forever",
            CancelLabel: "Keep it",
            Destructive: true));

        if (!accepted)
        {
            return;
        }

        try
        {
            await Campaigns.DeleteArtifactAsync(CampaignId, artifact.Id);
            if (_pinnedId == artifact.Id)
            {
                _pinnedId = null;
            }

            await Campaign.LoadAsync(CampaignId, force: true);
            Notifier.ShowSuccess($"Deleted \"{artifact.Title}\".");
        }
        catch (Http.ApiException ex)
        {
            Notifier.ShowError(ex.Message);
        }
    }

    private void OpenFocus(ArtifactPreviewResponse artifact) =>
        Navigation.NavigateTo(
            $"{CampaignViews.PathFor(CampaignId, CampaignView.Focus)}?artifact={artifact.Id}");

    private void SetZoom(bool overview)
    {
        _overview = overview;
        // transform: scale() changes no layout box, so ResizeObserver will NOT fire —
        // the overlay is told explicitly that geometry moved.
        _geometryEpoch++;
    }

    private Task OnHighlight(IReadOnlyList<string> segmentIds)
    {
        if (_highlighted.SetEquals(segmentIds))
        {
            return Task.CompletedTask;
        }

        _highlighted.Clear();
        foreach (var id in segmentIds)
        {
            _highlighted.Add(id);
        }

        return InvokeAsync(StateHasChanged);
    }

    private static string Clock(double seconds)
    {
        var t = TimeSpan.FromSeconds(Math.Max(0, seconds));
        return t.TotalHours >= 1 ? t.ToString(@"h\:mm\:ss") : t.ToString(@"m\:ss");
    }

    private static string BarClass(string status) => status switch
    {
        ArtifactStatus.InReview => "cm-card__bar--review",
        ArtifactStatus.Queued => "cm-card__bar--queued",
        ArtifactStatus.Published => "cm-card__bar--published",
        _ => "cm-card__bar--draft",
    };

    private void OnCampaignChanged() => InvokeAsync(() =>
    {
        // Track which artifacts are new so the Press Run's print-in animation applies to
        // exactly the cards that just landed, in completion order.
        foreach (var artifact in Campaign.Artifacts)
        {
            if (_seenArtifacts.Add(artifact.Id) && PressRun.IsActiveFor(CampaignId))
            {
                _justPrinted.Add(artifact.Id);
            }
        }

        StateHasChanged();
    });

    private void OnPressRunChanged() => InvokeAsync(StateHasChanged);
    // The board reload on completion lives in PressRunService now, so the floor refreshes
    // even when this view is not mounted; here only the render needs to happen.

    public void Dispose()
    {
        Campaign.Changed -= OnCampaignChanged;
        PressRun.Changed -= OnPressRunChanged;
    }
}
