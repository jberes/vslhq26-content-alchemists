    private void OpenMediaDialog(string kind)
    {
        _mediaDialog = kind;
        _mediaUrl = string.Empty;
    }

    private void CloseMediaDialog()
    {
        _mediaDialog = null;
        _mediaUrl = string.Empty;
    }

    private async Task ConfirmMediaAsync()
    {
        var url = _mediaUrl.Trim();
        if (url.Length == 0)
        {
            return;
        }

        if (_mediaDialog == "youtube")
        {
            var id = YouTubeId(url);
            if (id is null)
            {
                Notifier.ShowError("That doesn't look like a YouTube URL or video id.");
                return;
            }
            CloseMediaDialog();
            if (_editor is not null)
            {
                await _editor.InsertYouTubeAsync(id, null);
            }
            return;
        }

        await InsertImageAsync(url, null);
    }

    private async Task InsertImageAsync(string url, string? alt)
    {
        CloseMediaDialog();
        if (_editor is not null)
        {
            await _editor.InsertImageAsync(url, alt);
        }
    }

    /// <summary>
    /// A pasted or dropped file. The bytes go to the public container and only the URL ever
    /// enters the document — the editor refuses base64 images for exactly this reason.
    /// </summary>
    private async Task UploadDroppedImageAsync(EditorImageUpload upload)
    {
        try
        {
            _saveState = "Uploading image…";
            StateHasChanged();
            var result = await Images.UploadImageAsync(
                CampaignId, upload.FileName, upload.ContentType, upload.Base64);
            if (_editor is not null)
            {
                await _editor.InsertImageAsync(result.Url, Path.GetFileNameWithoutExtension(upload.FileName));
            }
            _saveState = "Image inserted — commits on blur";
        }
        catch (ApiException ex)
        {
            _saveState = "Not saved";
            Notifier.ShowError(ex.Message);
        }
        finally
        {
            StateHasChanged();
        }
    }

    /// <summary>
    /// Pulls the 11-character video id out of the URL forms people actually paste. Returns
    /// null rather than guessing — a wrong id renders a broken thumbnail into the artifact.
    /// </summary>
    internal static string? YouTubeId(string input)
    {
        var value = input.Trim();
        if (value.Length == 11 && value.All(c => char.IsLetterOrDigit(c) || c is '-' or '_'))
        {
            return value;
        }

        if (!Uri.TryCreate(value, UriKind.Absolute, out var uri))
        {
            return null;
        }

        if (uri.Host.EndsWith("youtu.be", StringComparison.OrdinalIgnoreCase))
        {
            var id = uri.AbsolutePath.Trim('/');
            return id.Length == 11 ? id : null;
        }

        if (!uri.Host.Contains("youtube.", StringComparison.OrdinalIgnoreCase))
        {
            return null;
        }

        // /watch?v=…, /shorts/…, /embed/…
        var v = uri.Query.TrimStart('?')
            .Split('&')
            .Select(pair => pair.Split('=', 2))
            .FirstOrDefault(pair => pair.Length == 2 && pair[0] == "v")?[1];
        if (v is { Length: 11 })
        {
            return v;
        }

        var segments = uri.AbsolutePath.Split('/', StringSplitOptions.RemoveEmptyEntries);
        var last = segments.LastOrDefault();
        return last is { Length: 11 } ? last : null;
    }

    private void OnChanged() => InvokeAsync(() =>
        StoreEvents.GuardedAsync(async () =>
    {
        StateHasChanged();
        await SyncSelectionAsync();
    }, Notifier, StateHasChanged, "Opening the artifact"));

    public void Dispose() => Campaign.Changed -= OnChanged;
