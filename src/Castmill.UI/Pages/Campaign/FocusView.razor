        var repo = _repos.FirstOrDefault(r => r.IsDefault) ?? _repos[0];
        _publishRepoId = repo.Id;
        _publishMode = repo.Mode;
        _published = null;
        _publishOpen = true;
        await LoadPreviewAsync();
    }

