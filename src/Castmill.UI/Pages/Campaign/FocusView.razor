    private string BlogMetadataOutput(string tab)
    {
        if (_artifact is null)
        {
            return string.Empty;
        }

        var output = BlogMetadataBuilder.Build(new BlogMetadataDocument(
            _artifact.Title, _markdown, _artifact.UpdatedAt, _blogMetadata));

        return tab switch
        {
            "HTML head" => output.HtmlHead,
            "JSON-LD only" => output.JsonLdOnly,
            _ => output.Combined,
        };
