    private string BlogMetadataOutput(string tab)
    {
        if (_artifact is null)
        {
            return string.Empty;
        }

        Func<string?, string?> encode = System.Net.WebUtility.HtmlEncode;
        var title = _artifact.Title;
        var description = string.IsNullOrWhiteSpace(_blogMetadata.Description)
            ? title
            : _blogMetadata.Description!;
        var canonical = _blogMetadata.CanonicalUrl;
        var head = $"""
            <title>{encode(title)}</title>
            <meta name="description" content="{encode(description)}" />
            <meta name="keywords" content="{encode(_blogMetadata.Keywords ?? string.Empty)}" />
            <meta property="og:type" content="article" />
            <meta property="og:title" content="{encode(title)}" />
            <meta property="og:description" content="{encode(description)}" />
            {(!string.IsNullOrWhiteSpace(canonical) ? $"<link rel=\"canonical\" href=\"{encode(canonical)}\" />" : string.Empty)}
            """;

        var article = new Dictionary<string, object?>
        {
            ["@type"] = "Article",
            ["headline"] = title,
            ["description"] = description,
            ["keywords"] = _blogMetadata.Keywords,
            ["mainEntityOfPage"] = canonical,
            ["dateModified"] = _artifact.UpdatedAt.ToString("O"),
            ["author"] = string.IsNullOrWhiteSpace(_blogMetadata.Author) ? null : new Dictionary<string, object?>
            {
                ["@type"] = "Person", ["name"] = _blogMetadata.Author,
            },
            ["publisher"] = string.IsNullOrWhiteSpace(_blogMetadata.SiteName) ? null : new Dictionary<string, object?>
            {
                ["@type"] = "Organization", ["name"] = _blogMetadata.SiteName,
                ["logo"] = _blogMetadata.OrganizationLogoUrl,
            },
        };
        var graph = new List<object> { article };
        if (!string.IsNullOrWhiteSpace(_blogMetadata.VideoUrl))
        {
            graph.Add(new Dictionary<string, object?>
            {
                ["@type"] = "VideoObject", ["name"] = title,
                ["description"] = description, ["contentUrl"] = _blogMetadata.VideoUrl,
            });
        }
        var jsonLd = JsonSerializer.Serialize(new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org", ["@graph"] = graph,
        }, new JsonSerializerOptions { WriteIndented = true });
        var jsonLdBlock = $"<script type=\"application/ld+json\">\n{jsonLd}\n</script>";

        return tab switch
        {
            "Head" => head,
            "JSON-LD" => jsonLdBlock,
            _ => head + "\n" + jsonLdBlock,
        };
    }

