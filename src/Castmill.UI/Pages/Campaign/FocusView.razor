    private async Task SaveBlogMetadataAsync()
    {
        if (_artifact is not { Kind: "blog" } artifact || _artifactId is not { } id)
        {
            return;
        }

        _savingMetadata = true;
        try
        {
            var contentJson = ArtifactContent.WithPublishingMetadata(artifact.ContentJson, _blogMetadata);
            var saved = await Campaigns.SaveArtifactAsync(
                CampaignId, id, artifact.Title, contentJson, _etag);
            _artifact = saved;
            _etag = $"\"{saved.Version}\"";
            _saveState = $"Metadata saved · v{saved.Version}";
            await LoadRevisionsAsync(id);
            Notifier.ShowSuccess("Blog metadata and schema saved on this blog.");
        }
        catch (ConflictApiException)
        {
            Notifier.ShowError("This blog changed since you opened it. Reload before saving metadata.");
        }
        catch (ApiException ex)
        {
            Notifier.ShowError(ex.Message);
        }
        finally
        {
            _savingMetadata = false;
        }
    }

    private void BuildBlogCanonicalUrl()
    {
        if (_artifact is null)
        {
            return;
        }

        var canonical = BlogMetadataBuilder.BuildCanonicalUrl(
            _blogMetadata.SiteUrl, _blogMetadata.Slug, _artifact.Title);
        if (canonical is null)
