            _published = await Git.PublishAsync(
                CampaignId, _artifact.Id, _publishRepoId, _publishImages, _publishMode);

            Notifier.ShowSuccess(_published.PullRequestNumber is { } number
                ? $"Pull request #{number} opened."
                : $"Committed to {_published.Branch}.");
        }
        catch (ApiException ex)
