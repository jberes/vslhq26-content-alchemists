@* Focus mode. Phase F5 builds the full Producer rail — steering, two-pass narrated log,
   image slots, the version filmstrip and the validator line. Phase F4's job is the editor
   itself: the manuscript column, the outline rail and blur-commit saving against the
   artifact's ETag. *@
@page "/campaigns/{CampaignId:guid}/focus"
@using System.Text.Json
@using Castmill.Core
@using Castmill.Core.Ai
@using Castmill.Core.Resources
@using Castmill.UI.Design
@using Castmill.UI.Editor
@using Castmill.UI.Platform
@using Castmill.UI.Http
@using Castmill.UI.State
@implements IDisposable
@inject CampaignState Campaign
@inject CampaignsClient Campaigns
@inject GenerationClient Generation
@inject ImagesClient Images
@inject ExportClient Exports
@inject GitClient Git
@inject IFileDownloader Downloader
@inject IClipboardService Clipboard
@inject IConfirmService Confirm
@inject INotifier Notifier
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(_artifact?.Title ?? Campaign.Campaign?.Name ?? "Campaign") — Focus</PageTitle>

<CampaignShell CampaignId="CampaignId" View="CampaignView.Focus">
    <div class="cm-focus cm-region @(_producerWide ? "cm-focus--producer-wide" : null)">
        <aside class="cm-focus__outline cm-region">
            <h2 class="cm-kicker">Artifacts</h2>
            @if (Campaign.Artifacts.Count == 0)
            {
                <p class="cm-meta cm-focus__pad">Nothing to edit yet.</p>
            }
            else
            {
                @* A vertical projection of the Mill Floor: the SAME lane names, in the SAME
                   order, with every editable card beneath its category. Category bands label
                   navigation; only content rows are interactive. *@
                <div class="cm-tree">
                    @foreach (var group in ArtifactGroups)
                    {
                        <section class="cm-focus__category-group" aria-labelledby="cm-focus-category-@CategoryId(group.Key)">
                            <header class="cm-focus__category" id="cm-focus-category-@CategoryId(group.Key)">
                                <span class="cm-kicker">@group.Key</span>
                                <span class="cm-tree__count cm-mono">(@group.Count())</span>
                            </header>
                            <ul class="cm-focus__list">
                                @foreach (var item in group)
                                {
                                    <li class="cm-tree__row">
                                        <button type="button"
                                                class="cm-focus__list-item @(item.Id == (_loadingArtifactId ?? _artifactId) ? "cm-focus__list-item--active" : "")"
                                                aria-current="@(item.Id == (_loadingArtifactId ?? _artifactId) ? "true" : "false")"
                                                aria-busy="@(item.Id == _loadingArtifactId ? "true" : "false")"
                                                @onclick="() => SelectAsync(item.Id)">
                                            <span class="cm-focus__list-title">@item.Title</span>
                                            @if (item.Id == _loadingArtifactId)
                                            {
                                                <span class="cm-meta">Loading content…</span>
                                            }
                                            else
                                            {
                                                <span class="cm-focus__list-meta">
                                                    <span class="cm-meta">@ArtifactDisplay.KindLabel(item.Kind)</span>
                                                    <span class="@ArtifactDisplay.StatusModifier(item.Status)">
                                                        @ArtifactDisplay.StatusLabel(item.Status)
                                                    </span>
                                                </span>
                                            }
                                        </button>
                                        <button type="button" class="cm-tree__delete"
                                                title="Delete @ArtifactDisplay.KindLabel(item.Kind)"
                                                aria-label="Delete @item.Title"
                                                @onclick="() => DeleteArtifactAsync(item)">
                                            <span aria-hidden="true">🗑</span>
                                        </button>
                                    </li>
                                }
                            </ul>
                        </section>
                    }
                </div>
            }

            @if (_headings.Count > 0)
            {
                <h2 class="cm-kicker">Outline</h2>
                <ul class="cm-focus__outline-list">
                    @foreach (var heading in _headings)
                    {
                        <li style="padding-inline-start: @((heading.Level - 1) * 10)px">
                            <button type="button" class="cm-focus__outline-item"
                                    @onclick="() => GoToAsync(heading)">
                                @heading.Text
                            </button>
                        </li>
                    }
                </ul>
            }
        </aside>

        <div class="cm-focus__manuscript cm-region @(_regenerating ? "cm-focus__manuscript--regenerating" : null)"
             aria-busy="@_regenerating">
            @if (_regenerating)
            {
                <div class="cm-focus__regenerating" role="status" aria-live="polite">
                    <span class="cm-ai-dot" aria-hidden="true"></span>
                    <strong>@_regenerationLabel</strong>
                    <span class="cm-meta">The current take is hidden while the replacement is drafted and checked.</span>
                </div>
            }
            @if (_loadingArtifactId is not null)
            {
                <div class="cm-focus__loading" role="status" aria-live="polite">
                    <span class="cm-ai-dot" aria-hidden="true"></span>
                    <strong>Loading @(_loadingArtifactTitle ?? "content")…</strong>
                    <span class="cm-meta">The current document will stay in place until the next one is ready.</span>
                </div>
            }

            @if (_loadError is { } error)
            {
                <EmptyState Kicker="Focus" Headline="That artifact couldn't be opened." Detail="@error" />
            }
            else if (_artifact is null)
            {
                <EmptyState Kicker="Focus"
                            Headline="Pick something to work on."
                            Detail="Focus mode edits one artifact at a time. Its markdown is the only thing persisted — no HTML, no editor-native format." />
            }
            else
            {
                <header class="cm-focus__head">
                    <span class="cm-kicker">@ArtifactDisplay.KindLabel(_artifact.Kind)</span>
                    <h1>@_artifact.Title</h1>
                    <div class="cm-focus__status">
                        <span class="@ArtifactDisplay.StatusModifier(_artifact.Status)">
                            @ArtifactDisplay.StatusLabel(_artifact.Status)
                        </span>
                        <span class="cm-meta">@_saveState</span>
                        @if (_artifact.Status == ArtifactStatus.Draft)
                        {
                            <button type="button" class="cm-button"
                                    @onclick="() => SetStatusAsync(ArtifactStatus.InReview)">
                                Send to review
                            </button>
                        }
                        else if (_artifact.Status == ArtifactStatus.InReview)
                        {
                            <button type="button" class="cm-button"
                                    @onclick="() => SetStatusAsync(ArtifactStatus.Queued)">
                                Mark reviewed
                            </button>
                            <button type="button" class="cm-button cm-button--quiet"
                                    @onclick="() => SetStatusAsync(ArtifactStatus.Draft)">
                                Back to draft
                            </button>
                        }
                        <button type="button" class="cm-button cm-button--quiet cm-focus__copy"
                                title="@CopyActionLabel" aria-label="@CopyActionLabel"
                                @onclick="CopyArtifactAsync">
                            <span aria-hidden="true">⧉</span> @CopyActionLabel
                        </button>
                        <div class="cm-focus__download">
                            <button type="button" class="cm-button cm-button--quiet"
                                    aria-expanded="@(_downloadOpen ? "true" : "false")"
                                    aria-controls="cm-focus-downloads"
                                    disabled="@_exporting" @onclick="() => _downloadOpen = !_downloadOpen">
                                Download <span aria-hidden="true">⌄</span>
                            </button>
                            @if (_downloadOpen)
                            {
                                <div class="cm-focus__download-menu" id="cm-focus-downloads">
                                    <button type="button" disabled="@_exporting"
                                            @onclick="@(() => ExportFromMenuAsync("md"))">Markdown (.md)</button>
                                    <button type="button" disabled="@_exporting"
                                            @onclick="@(() => ExportFromMenuAsync("docx"))">Word (.docx)</button>
                                    <button type="button" disabled="@_exporting"
                                            @onclick="ExportCampaignFromMenuAsync">Whole campaign (.zip)</button>
                                </div>
                            }
                        </div>
                        @if (_repos.Count > 0)
                        {
                            <button type="button" class="cm-button cm-button--quiet"
                                    @onclick="OpenPublishAsync">
                                Publish to GitHub
                            </button>
                        }
                    </div>
                </header>

                @if (_artifact.Kind is "clips" or "clip-suggestions")
                {
                    <ClipReview ContentJson="@_artifact.ContentJson" />
                }
                else
                {
                @if (IsStructured && !SupportsRichStructuredEditing)
                {
                    <p class="cm-meta">This content type has validated fields that are currently shown as a formatted preview.</p>
                    @if (_artifact.Kind is "email-sequence" or "newsletter")
                    {
                        <span class="cm-chip"
                              title="Replace this token with the final YouTube video URL in your email service provider before sending.">
                            <code>[YOUTUBE_VIDEO_URL]</code> · ESP replacement token
                        </span>
                    }
                }
                <RichEditor @key="EditorKey"
                            Markdown="@DisplayedMarkdown"
                            Editable="@(_previewRevision is null && (!IsStructured || SupportsRichStructuredEditing))"
                            Placeholder="Write, or press / for a block."
                            OnCommit="CommitAsync"
                            OnChanged="MarkDirty"
                            OnHeadings="OnHeadings"
                            OnRequestMedia="OpenMediaDialog"
                            OnImageFile="UploadDroppedImageAsync"
                            @ref="_editor" />

                @if (_publishOpen)
                {
                    <div class="cm-modal" role="presentation" @onclick="ClosePublish">
                        <div class="cm-modal__panel" role="dialog" aria-modal="true"
                             aria-labelledby="cm-publish-title" tabindex="-1" @onclick:stopPropagation>
                            <h2 id="cm-publish-title" class="cm-front__block-title">Publish to GitHub</h2>

                            <label class="cm-field">
                                <span class="cm-field__label">Repository</span>
                                <select class="cm-input" @bind="_publishRepoId" @bind:after="LoadPreviewAsync"
                                        aria-label="Repository to publish into">
                                    @foreach (var repo in _repos)
                                    {
                                        <option value="@repo.Id">@repo.Name — @repo.Owner/@repo.Repo</option>
                                    }
                                </select>
                            </label>

                            <div class="cm-studio__row">
                                <span class="cm-kicker">How</span>
                                @* Both modes, chosen per publish. A draft PR is the safe default:
                                   nothing reaches the site until someone merges it, and the
                                   repository's own CI preview runs on the branch. *@
                                <label class="cm-fanout__item">
                                    <input type="radio" name="cm-publish-mode"
                                           checked="@(_publishMode == "pull-request")"
                                           @onchange="@(() => _publishMode = "pull-request")" />
                                    <span>Open a pull request</span>
                                </label>
                                <label class="cm-fanout__item">
                                    <input type="radio" name="cm-publish-mode"
                                           checked="@(_publishMode == "direct-commit")"
                                           @onchange="@(() => _publishMode = "direct-commit")" />
                                    <span>Commit directly</span>
                                </label>
                            </div>

                            <label class="cm-fanout__item">
                                <input type="checkbox" @bind="_publishImages" @bind:after="LoadPreviewAsync" />
                                <span>Include this artifact's images</span>
                            </label>

                            @if (_preview is { } preview)
                            {
                                @* Shown before anything is committed. Every tool in this space
                                   that skipped this generates support tickets. *@
                                <div class="cm-publish__preview">
                                    <span class="cm-kicker">Will write</span>
                                    <p class="cm-mono cm-meta">@preview.ContentPath</p>
                                    @foreach (var image in preview.ImagePaths)
                                    {
                                        <p class="cm-mono cm-meta">@image</p>
                                    }
                                    <span class="cm-kicker">Front matter</span>
                                    <pre class="cm-publish__front">@preview.FrontMatter</pre>
                                    <p class="cm-meta">
                                        Branch <span class="cm-mono">@preview.Branch</span> —
                                        publishing again updates this branch rather than opening another.
                                    </p>
                                </div>
                            }

                            <div class="cm-form__actions">
                                <button type="button" class="cm-button" disabled="@_publishing"
                                        @onclick="PublishAsync">
                                    @(_publishing ? "Publishing…" : _publishMode == "direct-commit" ? "Commit" : "Open pull request")
                                </button>
                                <button type="button" class="cm-button cm-button--quiet" @onclick="ClosePublish">
                                    Cancel
                                </button>
                            </div>

                            @if (_published is { } done)
                            {
                                <p class="cm-meta">
                                    Committed <span class="cm-mono">@done.CommitSha[..Math.Min(7, done.CommitSha.Length)]</span>
                                    to <span class="cm-mono">@done.Branch</span>.
                                    @if (done.PullRequestUrl is { Length: > 0 } url)
                                    {
                                        <a href="@url" target="_blank" rel="noopener noreferrer">Open pull request #@done.PullRequestNumber</a>
                                    }
                                </p>
                            }
                        </div>
                    </div>
                }

                @if (_mediaDialog is { } media)
                {
                    <div class="cm-modal" role="presentation" @onclick="CloseMediaDialog">
                        <div class="cm-modal__panel" role="dialog" aria-modal="true"
                             aria-labelledby="cm-media-title" tabindex="-1"
                             @onclick:stopPropagation>
                            <h2 id="cm-media-title" class="cm-front__block-title">
                                @(media == "youtube" ? "Insert a YouTube video" : "Insert an image")
                            </h2>

                            @if (media == "image" && CampaignImages.Any())
                            {
                                @* This campaign's own generated images first: they are almost
                                   always what the writer means, and pasting a blob URL by hand
                                   is exactly the friction the Image Studio already removed. *@
                                <span class="cm-kicker">From this campaign</span>
                                <ul class="cm-media__picks">
                                    @foreach (var slot in CampaignImages)
                                    {
                                        <li>
                                            <button type="button" class="cm-media__pick"
                                                    @onclick="() => InsertImageAsync(slot.PublishedUrl!, ArtifactDisplay.SlotLabel(slot.Kind))">
                                                <img src="@slot.PublishedUrl" alt="" loading="lazy" />
                                                <span class="cm-meta">@ArtifactDisplay.SlotLabel(slot.Kind)</span>
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }

                            <label class="cm-field">
                                <span class="cm-field__label">
                                    @(media == "youtube" ? "YouTube URL or video id" : "Image URL")
                                </span>
                                <input class="cm-input" @bind="_mediaUrl" @bind:event="oninput"
                                       placeholder="@(media == "youtube" ? "https://www.youtube.com/watch?v=…" : "https://…")" />
                            </label>

                            <div class="cm-form__actions">
                                <button type="button" class="cm-button"
                                        disabled="@string.IsNullOrWhiteSpace(_mediaUrl)"
                                        @onclick="ConfirmMediaAsync">Insert</button>
                                <button type="button" class="cm-button cm-button--quiet"
                                        @onclick="CloseMediaDialog">Cancel</button>
                            </div>

                            @if (media == "image")
                            {
                                <p class="cm-meta">You can also paste or drag an image straight into the text.</p>
                            }
                        </div>
                    </div>
                }
                }

            }
        </div>

        <aside class="cm-focus__producer cm-region">
            <div class="cm-focus__producer-head">
                <h2 class="cm-kicker">Producer</h2>
                <button type="button" class="cm-button cm-button--icon cm-button--quiet"
                        title="@(_producerWide ? "Restore Producer width" : "Expand Producer")"
                        aria-label="@(_producerWide ? "Restore Producer width" : "Expand Producer")"
                        aria-pressed="@(_producerWide ? "true" : "false")"
                        @onclick="() => _producerWide = !_producerWide">
                    <span aria-hidden="true">@(_producerWide ? "↦↤" : "↤↦")</span>
                </button>
            </div>

            @if (_artifact is not null)
            {
                <div class="cm-producer__group">
                    <label class="cm-field">
                        <span class="cm-field__label">Steering</span>
                        <textarea class="cm-input cm-textarea" rows="3" @bind="_steering"
                                  placeholder="Tighter intro. Lead with the rollback story."></textarea>
                    </label>
                    <div class="cm-form__actions cm-producer__actions">
                        <button type="button" class="cm-button cm-button--quiet" disabled="@_regenerating"
                                @onclick="RegenerateAsync">
                            @(_regenerating ? "Generating…" : SelectedIsPlaceholder ? "Generate draft" : "Regenerate whole")
                        </button>
                        @* Second pass, deliberately a different model family (ADR-020).
                           Disabled with the reason rather than hidden, so an unconfigured
                           provider explains itself instead of the button just not existing. *@
                        <button type="button" class="cm-button cm-button--quiet"
                                disabled="@(_regenerating || !TechEditReady)"
                                title="@TechEditReason"
                                @onclick="TechEditAsync">
                            @(_regenerating ? "Working…" : $"Tech Edit · {TechEditProvider}")
                        </button>
                    </div>
                    @if (_artifact.Kind == "youtube")
                    {
                        <div class="cm-form__actions cm-producer__actions" aria-label="YouTube title experiment controls">
                            @foreach (var slot in new[] { "A", "B", "C" })
                            {
                                <button type="button" class="cm-button cm-button--quiet"
                                        disabled="@_regenerating" @onclick="() => RegenerateYoutubeTitleAsync(slot)">
                                    Regenerate title @slot
                                </button>
                            }
                        </div>
                    }
                    @if (KnowledgeBaseReady)
                    {
                        <label class="cm-fanout__item">
                            <input type="checkbox" @bind="_useKnowledgeBase" />
                            <span>Consult the knowledge base</span>
                        </label>
                    }
                    @* Shown whether or not the button is live: "this will run on Foundry
                       instead" is exactly the case where the control still works but the
                       result is not the cross-family pass the user asked for. *@
                    @if (TechEditReason is { Length: > 0 } reason)
                    {
                        <p class="cm-meta">@reason</p>
                    }
                    @if (_producerLog.Count > 0)
                    {
                        <ul class="cm-log">
                            @foreach (var line in _producerLog)
                            {
                                <li class="cm-mono cm-meta">@line</li>
                            }
                        </ul>
                    }
                    <p class="cm-meta">
                        Regenerate prints a <em>new take</em> as its own artifact (backend 🔶 5.7).
                        A Tech Edit revises <em>this</em> artifact in place and rings the filmstrip,
                        so you can compare it against the take before it.
                    </p>
                </div>

                @if (_artifact.Kind == "blog")
                {
                    <div class="cm-producer__group">
                        <span class="cm-kicker">Owned content set</span>
                        <p class="cm-meta">Generate one post for every social channel under this blog.</p>
                        <button type="button" class="cm-button cm-button--quiet"
                                disabled="@_generatingSocialSet" @onclick="GenerateSocialSetAsync">
                            @(_generatingSocialSet ? "Generating social set…" : "Generate social set")
                        </button>
                    </div>
                    <div class="cm-producer__group">
                        <span class="cm-kicker">Blog publishing metadata</span>
                        <p class="cm-meta">This belongs to this blog—not the campaign SEO report.</p>
                        <label class="cm-field">
                            <span class="cm-field__label">Metadata title</span>
                            <input class="cm-input" @bind="_blogMetadata.Title" />
                        </label>
                        <label class="cm-field">
                            <span class="cm-field__label">Site URL</span>
                            <input class="cm-input" type="url" @bind="_blogMetadata.SiteUrl" placeholder="https://example.com/blog" />
                        </label>
                        <label class="cm-field">
                            <span class="cm-field__label">Slug</span>
                            <input class="cm-input" @bind="_blogMetadata.Slug" placeholder="article-slug" />
                        </label>
                        <button type="button" class="cm-button cm-button--quiet" @onclick="BuildBlogCanonicalUrl">
                            Build canonical URL
                        </button>
                        <label class="cm-field">
                            <span class="cm-field__label">Canonical URL</span>
                            <input class="cm-input" type="url" @bind="_blogMetadata.CanonicalUrl" placeholder="https://example.com/blog/post" />
                        </label>
                        <label class="cm-field">
                            <span class="cm-field__label">Description</span>
                            <textarea class="cm-input cm-textarea" rows="3" maxlength="320" @bind="_blogMetadata.Description"></textarea>
                        </label>
                        <label class="cm-field">
                            <span class="cm-field__label">Keywords</span>
                            <input class="cm-input" @bind="_blogMetadata.Keywords" placeholder="primary keyword, supporting term" />
                        </label>
                        <label class="cm-field">
                            <span class="cm-field__label">Site name</span>
                            <input class="cm-input" @bind="_blogMetadata.SiteName" />
                        </label>
                        <label class="cm-field">
                            <span class="cm-field__label">Organization</span>
                            <input class="cm-input" @bind="_blogMetadata.OrganizationName" />
                        </label>
                        <label class="cm-field">
                            <span class="cm-field__label">Author</span>
                            <input class="cm-input" @bind="_blogMetadata.Author" />
                        </label>
                        <label class="cm-field">
                            <span class="cm-field__label">Organization logo URL</span>
                            <input class="cm-input" type="url" @bind="_blogMetadata.OrganizationLogoUrl" />
                        </label>
                        <label class="cm-field">
                            <span class="cm-field__label">Related video URL <span class="cm-meta">optional · schema requires a visible article link</span></span>
                            <input class="cm-input" type="url" @bind="_blogMetadata.VideoUrl" />
                        </label>
                        <button type="button" class="cm-button cm-button--quiet" disabled="@_savingMetadata"
                                @onclick="SaveBlogMetadataAsync">
                            @(_savingMetadata ? "Saving…" : "Save metadata")
                        </button>
                        <div class="cm-tabs" role="tablist" aria-label="Blog metadata format">
                            @foreach (var tab in BlogMetaTabs)
                            {
                                <button type="button" role="tab" class="cm-tabs__tab"
                                        aria-selected="@(_blogMetaTab == tab)" @onclick="() => _blogMetaTab = tab">@tab</button>
                            }
                        </div>
                        <pre class="cm-seo__meta-pre cm-mono">@BlogMetadataOutput(_blogMetaTab)</pre>
                        <button type="button" class="cm-button cm-button--quiet" @onclick="CopyBlogMetadataAsync">
                            Copy @_blogMetaTab
                        </button>
                    </div>
                }

                @if (_artifact.Kind is "blog" or "youtube")
                {
                    <div class="cm-producer__group">
                        <span class="cm-kicker">Real search data informing this content</span>
                        @if (_seoReport is null)
                        {
                            <p class="cm-meta">No SEO/AEO evidence is attached yet. Run the deep analysis before treating this artifact as search-informed.</p>
                        }
                        else
                        {
                            <div class="cm-chips">
                                @foreach (var keyword in _seoReport.Research.Keywords.Take(8))
                                {
                                    <span class="cm-chip">@keyword.Term @(keyword.Volume is { } volume ? $"· {volume:N0}" : "· volume unavailable")</span>
                                }
                            </div>
                            <p class="cm-meta">
                                @(_seoReport.Serp.AiOverview is null ? "No AI Overview was detected." : "AI Overview detected for the primary query.")
                                @(_seoReport.Serp.FeaturedSnippet is null ? " No featured snippet was detected." : " Featured snippet detected.")
                            </p>
                            @if (_seoReport.Serp.OrganicResults.Count > 0)
                            {
                                <ol class="cm-meta">
                                    @foreach (var result in _seoReport.Serp.OrganicResults.Take(3))
                                    {
                                        <li>#@result.Rank @result.Domain — @result.Title</li>
                                    }
                                </ol>
                            }
                            else
                            {
                                <p class="cm-meta">No live organic rows were returned; Castmill will not invent competitor evidence.</p>
                            }
                            @if (_seoReport.Research.Questions.Count > 0)
                            {
                                <p class="cm-meta"><strong>People also ask:</strong> @string.Join(" · ", _seoReport.Research.Questions.Take(3).Select(question => question.Question))</p>
                            }
                            else
                            {
                                <p class="cm-meta">No People Also Ask questions were available for this snapshot.</p>
                            }
                        }
                    </div>
                }

                <div class="cm-producer__group">
                    <span class="cm-kicker">Images for this content item</span>
                    @if (!ArtifactImageSlots.Any())
                    {
                        <p class="cm-meta">No image cards yet. Add one for this item, then create its takes in Image Studio.</p>
                    }
                    else
                    {
                    <ul class="cm-plan__slots">
                        @foreach (var slot in ArtifactImageSlots)
                        {
                            <li class="cm-plan__slot">
                                @if ((slot.PublishedUrl ?? slot.KeeperThumbUrl) is { } imageUrl)
                                {
                                    <div class="cm-plan__slot-preview">
                                        <img class="cm-plan__slot-image"
                                             src="@(imageUrl + "?v=" + slot.UpdatedAt.ToUnixTimeSeconds())"
                                             width="@slot.TargetWidth" height="@slot.TargetHeight"
                                             alt="@ArtifactDisplay.SlotLabel(slot.Kind) keeper" />
                                        @if (slot.KeeperVariantId is not null)
                                        {
                                            <button type="button" class="cm-plan__slot-download"
                                                    disabled="@(_downloadingImageSlot == slot.Id)"
                                                    title="Download image" aria-label="Download @ArtifactDisplay.SlotLabel(slot.Kind)"
                                                    @onclick="() => DownloadSlotImageAsync(slot)">
                                                <span aria-hidden="true">↓</span> Download
                                            </button>
                                        }
                                    </div>
                                }
                                <span class="cm-plan__slot-name">@ArtifactDisplay.SlotLabel(slot.Kind)</span>
                                <span class="cm-badge @(slot.State == "Filled" || slot.KeeperThumbUrl is not null ? "cm-badge--done" : "cm-badge--empty")">
                                    @(slot.State == "Filled" ? "PLACED" : slot.KeeperThumbUrl is not null ? "KEEPER" : "EMPTY")
                                </span>
                                <a class="cm-meta"
                                   href="@ImageStudioPath(slot.Id)">Open</a>
                            </li>
                        }
                    </ul>
                    }
                    <div class="cm-form__actions">
                        <button type="button" class="cm-button cm-button--quiet"
                                disabled="@_addingImage" @onclick="AddImageAsync">
                            @(_addingImage ? "Adding…" : "+ Add image")
                        </button>
                        @if (_artifactId is { } artifactId)
                        {
                            <a class="cm-meta" href="@ImageStudioForArtifact(artifactId)">
                                Focus in Image Studio
                            </a>
                        }
                    </div>
                </div>

                <div class="cm-producer__group">
                    <span class="cm-kicker">Versions</span>
                    @if (_revisions.Count == 0)
                    {
                        <p class="cm-meta">No earlier takes yet. The ring keeps the last 10.</p>
                    }
                    else
                    {
                        <ul class="cm-filmstrip">
                            @foreach (var revision in _revisions)
                            {
                                <li>
                                    <button type="button"
                                            class="cm-filmstrip__frame @(_previewRevision?.Id == revision.Id ? "cm-filmstrip__frame--active" : "")"
                                            @onclick="() => PreviewRevisionAsync(revision.Id)">
                                        <span class="cm-mono">v@(revision.Version)</span>
                                        <span class="cm-meta">@revision.Reason</span>
                                    </button>
                                </li>
                            }
                        </ul>
                    }

                    @if (_previewRevision is { } preview)
                    {
                        <div class="cm-filmstrip__actions">
                            <span class="cm-meta">Viewing v@(preview.Version) (@preview.Reason) — read-only.</span>
                            <button type="button" class="cm-button" @onclick="RestoreRevisionAsync">Restore this take</button>
                            <button type="button" class="cm-button cm-button--quiet" @onclick="ClosePreview">Back to current</button>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="cm-meta">Open an artifact to steer it.</p>
            }
        </aside>
    </div>
</CampaignShell>

@code {
    private bool _producerWide;

    /// <summary>Structured kinds render formatted but read-only (see StructuredContent).</summary>
    private bool IsStructured => _artifact is not null && StructuredContent.IsStructured(_artifact.Kind);

    private bool SupportsRichStructuredEditing => _artifact is not null
        && StructuredContent.IsRichEditable(_artifact.Kind);

    private string CopyActionLabel => _artifact?.Kind == "youtube"
        ? "Copy for YouTube"
        : "Copy formatted";

    private readonly List<EditorHeading> _headings = [];

    private readonly List<string> _producerLog = [];
    private readonly List<ArtifactRevisionResponse> _revisions = [];

    private RichEditor? _editor;
    private ArtifactRevisionDetailResponse? _previewRevision;
    private string _steering = string.Empty;
    private bool _regenerating;
    private string _regenerationLabel = "Regenerating content…";
    private bool _generatingSocialSet;
    private bool _addingImage;
    private Guid? _downloadingImageSlot;
    private bool _savingMetadata;
    private BlogPublishingMetadata _blogMetadata = new();
    private string _blogMetaTab = "Combined";
    private static readonly string[] BlogMetaTabs = ["Combined", "HTML head", "JSON-LD only"];
    private ArtifactResponse? _artifact;
    private Guid? _artifactId;
    private string? _etag;
    private string _markdown = string.Empty;
    private string _saveState = "Saved on blur";
    private string? _loadError;
    private Guid? _loadingArtifactId;
    private string? _loadingArtifactTitle;
    private int _selectionVersion;
    private bool _selecting;
    private Guid? _selectionCampaignId;
    private bool _useKnowledgeBase;
    private AiStatusResponse? _aiStatus;
    private SeoAnalysisReportResponse? _seoReport;
    private bool SelectedIsPlaceholder => Campaign.Artifacts.Any(
        item => item.Id == _artifactId && item.IsPlaceholder);

    /// <summary>
    /// The provider that would serve a Tech Edit. Foundry always can (the alias falls back to
    /// "chat"), so the button is never dead — a configured second family just makes it a
    /// genuine cross-model pass rather than a same-family one.
    /// </summary>
    private TextProviderReadiness? TechEditProviderStatus =>
        _aiStatus?.TextProviders?.FirstOrDefault(p => p.Ready)
        ?? _aiStatus?.TextProviders?.FirstOrDefault();

    private string TechEditProvider => TechEditProviderStatus is { Ready: true, Name: var name } ? name : "Foundry";

    private bool TechEditReady => _aiStatus?.EndpointConfigured == true;

    private string? TechEditReason => _aiStatus is null
        ? "Checking model configuration…"
        : !_aiStatus.EndpointConfigured
            ? "No model credentials configured, so there is nothing to run a second pass on."
            : TechEditProviderStatus is { Ready: false, Reason: { Length: > 0 } reason }
                ? $"Second-pass provider unavailable ({reason}) — this will run on Foundry instead."
                : null;

    private bool KnowledgeBaseReady => _aiStatus?.KnowledgeBaseReady == true;

    [Parameter] public Guid CampaignId { get; set; }

    /// <summary>Deep link from the front page's review queue.</summary>
    [SupplyParameterFromQuery(Name = "artifact")]
    private Guid? RequestedArtifact { get; set; }

    private IEnumerable<ArtifactPreviewResponse> Editable =>
        Campaign.Artifacts.Where(a => ArtifactDisplay.Editable(a.Kind));

    /// <summary>
    /// The selectable sequence is exactly the sequence the rail teaches: lane order first,
    /// then kind and creation order. API/EF ordering is deliberately irrelevant here.
    /// </summary>
    private IEnumerable<ArtifactPreviewResponse> OrderedEditable =>
        Editable
            .OrderBy(a => Array.IndexOf(ArtifactDisplay.LaneOrder, ArtifactDisplay.Lane(a.Kind))
                is var lane && lane >= 0 ? lane : ArtifactDisplay.LaneOrder.Length)
            .ThenBy(a => ArtifactDisplay.KindOrder(a.Kind))
            .ThenBy(a => a.CreatedAt);

    /// <summary>The tree's groups: lane categories in board order, kinds in registry order.</summary>
    private IEnumerable<IGrouping<string, ArtifactPreviewResponse>> ArtifactGroups =>
        OrderedEditable
            .GroupBy(a => ArtifactDisplay.Lane(a.Kind))
            .OrderBy(g => Array.IndexOf(ArtifactDisplay.LaneOrder, g.Key) is var i && i >= 0
                ? i
                : ArtifactDisplay.LaneOrder.Length);

    private static string CategoryId(string lane) =>
        new(lane.ToLowerInvariant().Select(character => char.IsLetterOrDigit(character) ? character : '-').ToArray());

    /// <summary>
    /// Deletes an artifact from the tree after a confirm. If the open artifact is the one
    /// deleted, focus moves to the next remaining editable artifact.
    /// </summary>
    private async Task DeleteArtifactAsync(ArtifactPreviewResponse item)
    {
        var accepted = await Confirm.ConfirmAsync(new ConfirmRequest(
            $"Delete \"{item.Title}\"?",
            $"This removes the {ArtifactDisplay.KindLabel(item.Kind).ToLowerInvariant()} and its revision history. There is no undo.",
            AcceptLabel: "Delete",
            Destructive: true));

        if (!accepted)
        {
            return;
        }

        try
        {
            await Campaigns.DeleteArtifactAsync(CampaignId, item.Id);

            if (_artifactId == item.Id)
            {
                _artifact = null;
                _artifactId = null;
                RequestedArtifact = null;
                Navigation.NavigateTo(CampaignViews.PathFor(CampaignId, CampaignView.Focus));
            }

            await Campaign.LoadAsync(CampaignId, force: true);
            Notifier.ShowSuccess($"Deleted \"{item.Title}\".");
        }
        catch (ApiException ex)
        {
            Notifier.ShowError(ex.Message);
        }
    }

    protected override void OnInitialized() => Campaign.Changed += OnChanged;

    /// <summary>
    /// Model readiness for the Tech Edit control. Best-effort: if /ai/status is unreachable
    /// the button falls back to disabled-with-a-reason rather than taking the page down.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }
        // Broad on purpose: this runs from a lifecycle method, so anything that escapes
        // becomes an unhandled render exception and blanks the page. Model readiness is a
        // nicety — it must never be able to take the editor down.
        try
        {
            _aiStatus = await Images.GetAiStatusAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _aiStatus = null;
        }

        // No repo profiles means no publish button at all — an optional feature that has not
        // been set up should be absent, not present-and-broken (G3).
        try
        {
            _repos = await Git.ListReposAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _repos = [];
        }

        StateHasChanged();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Blazor may reuse this page instance when only the campaign route value changes.
        // Never carry the previous campaign's selected id into the next campaign.
        if (_selectionCampaignId != CampaignId)
        {
            _selectionCampaignId = CampaignId;
            _artifact = null;
            _artifactId = null;
            _etag = null;
            _loadError = null;
        }

        // Focus owns a stronger invariant than the other campaign views: the query-selected
        // artifact must be open on the first usable render. CampaignShell also loads this
        // store, but it is a child and may not have run yet; CampaignState collapses this
        // duplicate request into the same single-flight operation.
        await Campaign.LoadAsync(CampaignId);
        await SyncSelectionAsync();
    }

    /// <summary>
    /// Chooses which artifact to edit. Called from OnParametersSetAsync AND from the store's
    /// Changed handler, because the campaign is still loading when the route parameters are
    /// first set — OnParametersSetAsync does not run again when that load finishes, so
    /// selecting only there left the editor permanently unmounted.
    /// </summary>
    private async Task SyncSelectionAsync()
    {
        if (Campaign.CampaignId != CampaignId || Campaign.IsLoading || _selecting)
        {
            return;
        }

        // Operational artifacts (SEO reports, transcripts, image plans) have dedicated
        // surfaces. Reject a stale/deep link to one rather than rendering its JSON as copy.
        var ordered = OrderedEditable.ToList();
        var requested = RequestedArtifact is { } requestedId
            && ordered.Any(item => item.Id == requestedId)
                ? requestedId
                : (Guid?)null;
        var current = _artifactId is { } currentId && ordered.Any(item => item.Id == currentId)
            ? currentId
            : (Guid?)null;
        var target = requested ?? current ?? ordered.FirstOrDefault()?.Id;

        if (target is { } id && id != _artifactId)
        {
            _selecting = true;
            try
            {
                await LoadArtifactAsync(id);
            }
            finally
            {
                _selecting = false;
            }
        }
        else if (target is null && _artifact is not null)
        {
            _artifact = null;
            _artifactId = null;
            StateHasChanged();
        }
    }

    private async Task SelectAsync(Guid id)
    {
        // Keep reload/deep-link behavior without triggering FocusOnNavigate, whose heading
        // focus scrolls the manuscript when someone selects a rail item.
        RequestedArtifact = id;
        await JS.InvokeVoidAsync("history.replaceState", null, string.Empty,
            $"{CampaignViews.PathFor(CampaignId, CampaignView.Focus)}?artifact={id}");
        await LoadArtifactAsync(id);
    }

    private async Task LoadArtifactAsync(Guid id)
    {
        var selectionVersion = ++_selectionVersion;
        _loadingArtifactId = id;
        _loadingArtifactTitle = Campaign.Artifacts.FirstOrDefault(item => item.Id == id)?.Title;
        _loadError = null;
        StateHasChanged();

        try
        {
            var (artifact, etag) = await Campaigns.GetArtifactAsync(CampaignId, id);
            if (selectionVersion != _selectionVersion)
            {
                return;
            }

            _artifact = artifact;
            _artifactId = id;
            _etag = etag;
            _markdown = StructuredContent.IsStructured(artifact.Kind)
                ? StructuredContent.ToEditorMarkdown(artifact.Kind, artifact.ContentJson)
                : ArtifactContent.ToMarkdown(artifact.ContentJson);
            _blogMetadata = artifact.Kind == "blog"
                ? ArtifactContent.PublishingMetadata(artifact.ContentJson)
                : new BlogPublishingMetadata();
            if (artifact.Kind == "blog")
            {
                _blogMetadata.Title ??= artifact.Title;
                _blogMetadata.Slug ??= BlogMetadataBuilder.Slug(artifact.Title);
            }
            _headings.Clear();
            _saveState = "Saved on blur";
            _previewRevision = null;
            _loadingArtifactId = null;
            _loadingArtifactTitle = null;
            StateHasChanged();

            await Task.WhenAll(LoadRevisionsAsync(id), LoadSeoReportAsync());
        }
        catch (ApiException ex)
        {
            _loadError = ex.Message;
        }
        catch (HttpRequestException)
        {
            _loadError = "Couldn't reach the Castmill API.";
        }
        finally
        {
            if (selectionVersion == _selectionVersion)
            {
                _loadingArtifactId = null;
                _loadingArtifactTitle = null;
            }
        }

        StateHasChanged();
    }

    private void MarkDirty()
    {
        _saveState = "Unsaved — commits on blur";
        StateHasChanged();
    }

    /// <summary>
    /// Blur-commit. A 412 means someone else changed the artifact; the user is told rather
    /// than having their edit silently dropped or silently overwriting the other version.
    /// </summary>
    private async Task CommitAsync(string markdown)
    {
        if (_artifact is null || _artifactId is not { } id
            || IsStructured && !SupportsRichStructuredEditing)
        {
            return;
        }

        if (string.Equals(markdown, _markdown, StringComparison.Ordinal))
        {
            _saveState = "Saved on blur";
            return;
        }

        _saveState = "Saving…";
        StateHasChanged();

        try
        {
            var contentJson = IsStructured
                ? StructuredContent.FromEditorMarkdown(_artifact.Kind, _artifact.ContentJson, markdown)
                : ArtifactContent.FromMarkdown(_artifact.ContentJson, markdown);
            var saved = await Campaigns.SaveArtifactAsync(
                CampaignId, id, _artifact.Title, contentJson, _etag);

            _artifact = saved;
            _markdown = markdown;
            _etag = $"\"{saved.Version}\"";
            _saveState = $"Saved · v{saved.Version}";

            // A manual save snapshots the prior take server-side (ADR-017), so the
            // filmstrip must refresh or the new frame is invisible until re-select.
            await LoadRevisionsAsync(id);
        }
        catch (ConflictApiException)
        {
            _saveState = "Conflict — reload to see the newer version";
            Notifier.ShowError(
                "Someone else changed this artifact while you were editing. Reload to see their version — your text is still on screen.");
        }
        catch (ApiException ex)
        {
            _saveState = "Not saved";
            Notifier.ShowError(ex.Message);
        }

        StateHasChanged();
    }

    private async Task CopyArtifactAsync()
    {
        var markdown = DisplayedMarkdown;
        var plain = MarkdownRenderer.ToPlainText(markdown);
        var html = MarkdownRenderer.ToHtml(markdown).Value;
        if (await Clipboard.CopyFormattedAsync(plain, html))
        {
            Notifier.ShowSuccess("Formatted content copied.");
        }
        else
        {
            Notifier.ShowError("Clipboard unavailable. Select the content and copy it manually.");
        }
    }


    private async Task SetStatusAsync(string status)
    {
        if (_artifactId is not { } id)
        {
            return;
        }

        try
        {
            _artifact = await Campaigns.SetArtifactStatusAsync(CampaignId, id, status, _etag);
            _etag = $"\"{_artifact.Version}\"";
            Notifier.ShowSuccess($"Moved to {ArtifactDisplay.StatusLabel(status).ToLowerInvariant()}.");

            // The front page and the header counter read the campaign preview, so refresh it.
            await Campaign.LoadAsync(CampaignId, force: true);
        }
        catch (ConflictApiException)
        {
            Notifier.ShowError("This artifact changed since you loaded it. Reload before changing its status.");
        }
        catch (ApiException ex)
        {
            Notifier.ShowError(ex.Message);
        }
    }

    private void OnHeadings(IReadOnlyList<EditorHeading> headings)
    {
        _headings.Clear();
        _headings.AddRange(headings);
        StateHasChanged();
    }

    private async Task GoToAsync(EditorHeading heading)
    {
        if (_editor is not null)
        {
            await _editor.GoToAsync(heading.Pos);
        }
    }

    /// <summary>What the editor shows: the live document, or a revision being previewed.</summary>
    private string DisplayedMarkdown => _previewRevision is { } preview
        ? _artifact is { } artifact && StructuredContent.IsStructured(artifact.Kind)
            ? StructuredContent.ToEditorMarkdown(artifact.Kind, preview.ContentJson)
            : ArtifactContent.ToMarkdown(preview.ContentJson)
        : _markdown;

    /// <summary>Remounts the editor when switching artifact OR entering/leaving preview.</summary>
    private string EditorKey => $"{_artifactId}:{_previewRevision?.Id.ToString() ?? "live"}";

    private async Task LoadRevisionsAsync(Guid artifactId)
    {
        try
        {
            var list = await Campaigns.ListRevisionsAsync(CampaignId, artifactId);
            _revisions.Clear();
            _revisions.AddRange(list);
        }
        catch (ApiException)
        {
            // The filmstrip is an enhancement; the editor must not fail over it.
            _revisions.Clear();
        }
    }

    private async Task PreviewRevisionAsync(Guid revisionId)
    {
        if (_artifactId is not { } id)
        {
            return;
        }

        try
        {
            _previewRevision = await Campaigns.GetRevisionAsync(CampaignId, id, revisionId);
        }
        catch (ApiException ex)
        {
            Notifier.ShowError(ex.Message);
        }
    }

    private void ClosePreview() => _previewRevision = null;

    /// <summary>
    /// Restore is an ordinary ETag-guarded write (ADR-017): the current take is snapshotted
    /// first server-side, so restoring is never destructive.
    /// </summary>
    private async Task RestoreRevisionAsync()
    {
        if (_artifactId is not { } id || _previewRevision is not { } preview)
        {
            return;
        }

        try
        {
            var restored = await Campaigns.RestoreRevisionAsync(CampaignId, id, preview.Id, _etag);
            _artifact = restored;
            _markdown = StructuredContent.IsStructured(restored.Kind)
                ? StructuredContent.ToEditorMarkdown(restored.Kind, restored.ContentJson)
                : ArtifactContent.ToMarkdown(restored.ContentJson);
            _etag = $"\"{restored.Version}\"";
            _previewRevision = null;
            _saveState = $"Restored v{preview.Version} · now v{restored.Version}";
            Notifier.ShowSuccess($"Restored take v{preview.Version}.");
            await LoadRevisionsAsync(id);
        }
        catch (ConflictApiException)
        {
            Notifier.ShowError("The artifact changed since you loaded it. Reload before restoring.");
        }
        catch (ApiException ex)
        {
            Notifier.ShowError(ex.Message);
        }
    }

    /// <summary>
    /// Regenerate whole, with the steering text as the brief. The narrated two-pass log is
    /// honest about what request/response generation can know: one line when the press
    /// starts, one when the result lands, with the real duration and audit warnings.
    /// </summary>
    private async Task RegenerateAsync()
    {
        if (_artifact is null || Campaign.TranscriptArtifactId is not { } transcriptId)
        {
            Notifier.ShowError("This campaign has no transcript to regenerate from.");
            return;
        }

        _regenerationLabel = $"Regenerating {ArtifactDisplay.KindLabel(_artifact.Kind).ToLowerInvariant()}…";
        _regenerating = true;
        _producerLog.Clear();
        _producerLog.Add($"queued {_artifact.Kind} · drafting, then cross-model audit…");
        StateHasChanged();

        try
        {
            var preview = Campaign.Artifacts.FirstOrDefault(item => item.Id == _artifact.Id);
            var result = await Generation.GenerateOneAsync(
                CampaignId, _artifact.Kind, transcriptId,
                string.IsNullOrWhiteSpace(_steering)
                    ? ArtifactContent.PlaceholderSeed(_artifact.ContentJson) is { } seed
                        ? $"Generate the pillar from the approved SEO/AEO angle: {seed}"
                        : null
                    : _steering,
                parentArtifactId: _artifact.ParentArtifactId,
                replaceArtifactId: preview?.IsPlaceholder == true ? _artifact.Id : null);

            if (result.Success)
            {
                _producerLog.Add($"printed {result.Kind} · {result.DurationMs} ms"
                    + (result.ValidationWarnings is { Count: > 0 } w
                        ? $" · audit: {string.Join("; ", w)}"
                        : " · audit clean"));

                // 🔶 5.7: the new take is a NEW artifact row. Reload and jump to it.
                await Campaign.LoadAsync(CampaignId, force: true);
                if (preview?.IsPlaceholder == true)
                {
                    await LoadArtifactAsync(_artifact.Id);
                    return;
                }
                var newest = Campaign.Artifacts
                    .Where(a => a.Kind == _artifact.Kind)
                    .OrderByDescending(a => a.CreatedAt)
                    .FirstOrDefault();
                if (newest is not null && newest.Id != _artifactId)
                {
                    await SelectAsync(newest.Id);
                }
            }
            else
            {
                _producerLog.Add($"failed {result.Kind} · {result.Error}");
                Notifier.ShowError(result.Error ?? "Generation failed.");
            }
        }
        catch (ApiException ex)
        {
            _producerLog.Add($"failed · {ex.Message}");
            Notifier.ShowError(ex.Message);
        }
        finally
        {
            _regenerating = false;
            StateHasChanged();
        }
    }

    private async Task RegenerateYoutubeTitleAsync(string slot)
    {
        if (_artifact is null) return;
        _regenerationLabel = $"Regenerating title {slot}…";
        _regenerating = true;
        try
        {
            var result = await Generation.RegenerateYoutubeTitleAsync(
                CampaignId, _artifact.Id, slot,
                string.IsNullOrWhiteSpace(_steering) ? null : _steering);
            await LoadArtifactAsync(result.ArtifactId);
            await Campaign.RefreshAsync(CampaignId);
            Notifier.ShowSuccess($"Title {slot} regenerated · {result.Option.Score:0}/100.");
        }
        catch (ApiException ex) { Notifier.ShowError(ex.Message); }
        finally { _regenerating = false; }
    }

    private async Task GenerateSocialSetAsync()
    {
        if (_artifact?.Kind != "blog" || Campaign.TranscriptArtifactId is not { } transcriptId) return;
        _generatingSocialSet = true;
        var failures = new List<string>();
        try
        {
            foreach (var kind in ArtifactDisplay.SocialKinds)
            {
                var result = await Generation.GenerateOneAsync(
                    CampaignId, kind, transcriptId,
                    string.IsNullOrWhiteSpace(_steering)
                        ? $"Promote and reinforce the owned blog titled \"{_artifact.Title}\"."
                        : _steering,
                    parentArtifactId: _artifact.Id);
                if (!result.Success) failures.Add(ArtifactDisplay.KindLabel(kind));
            }
            await Campaign.LoadAsync(CampaignId, force: true);
            if (failures.Count == 0) Notifier.ShowSuccess("Six-post social set added under this blog.");
            else Notifier.ShowError($"Some posts failed: {string.Join(", ", failures)}.");
        }
        catch (ApiException ex) { Notifier.ShowError(ex.Message); }
        finally { _generatingSocialSet = false; }
    }

    private async Task LoadSeoReportAsync()
    {
        if (_seoReport is not null) return;
        var preview = Campaign.Artifacts
            .Where(item => item.Kind == "seo-report")
            .OrderByDescending(item => item.UpdatedAt)
            .FirstOrDefault();
        if (preview is null) return;
        try
        {
            var (artifact, _) = await Campaigns.GetArtifactAsync(CampaignId, preview.Id);
            _seoReport = JsonSerializer.Deserialize<SeoAnalysisReportResponse>(
                artifact.ContentJson, new JsonSerializerOptions(JsonSerializerDefaults.Web));
        }
        catch (Exception ex) when (ex is ApiException or JsonException)
        {
            _seoReport = null;
        }
    }

    /// <summary>
    /// The second pass (ADR-020). Unlike Regenerate this does NOT reload-and-jump: the
    /// artifact keeps its id and takes a new version, so the manuscript is updated in place
    /// and the filmstrip picks up the "tech-edit" ring — exactly what restoring a revision
    /// already does.
    /// </summary>
    private async Task TechEditAsync()
    {
        if (_artifact is null)
        {
            return;
        }

        _regenerationLabel = $"Applying the {TechEditProvider} tech edit…";
        _regenerating = true;
        _producerLog.Clear();
        _producerLog.Add(_useKnowledgeBase
            ? $"tech edit queued {_artifact.Kind} · consulting the knowledge base…"
            : $"tech edit queued {_artifact.Kind} · second pass on {TechEditProvider}…");
        StateHasChanged();

        try
        {
            var result = await Generation.TechEditAsync(
                CampaignId, _artifact.Id,
                string.IsNullOrWhiteSpace(_steering) ? null : _steering,
                _useKnowledgeBase);

            if (!result.Success)
            {
                _producerLog.Add($"tech edit failed · {result.Error}");
                Notifier.ShowError(result.Error ?? "Tech edit failed.");
                return;
            }

            _producerLog.Add(
                $"tech edited {_artifact.Kind} · {result.DurationMs} ms · {result.Provider}"
                + (result.KnowledgeBaseUsed ? " · knowledge base consulted" : string.Empty)
                + $" · {result.Changes.Count} change{(result.Changes.Count == 1 ? "" : "s")}");
            foreach (var change in result.Changes)
            {
                _producerLog.Add($"  · {change}");
            }

            // Reload the artifact itself rather than the whole campaign: the id is unchanged,
            // only its content and version moved.
            var (updated, etag) = await Campaigns.GetArtifactAsync(CampaignId, _artifact.Id);
            _artifact = updated;
            _etag = etag;
            _markdown = ArtifactContent.ToMarkdown(updated.ContentJson);
            _saveState = $"Tech edited · v{result.Version}";
            await LoadRevisionsAsync(_artifact.Id);
            Notifier.ShowSuccess($"Tech edit applied · v{result.Version}.");
        }
        catch (ApiException ex)
        {
            _producerLog.Add($"tech edit failed · {ex.Message}");
            Notifier.ShowError(ex.Message);
        }
        finally
        {
            _regenerating = false;
            StateHasChanged();
        }
    }

    // ---- Exports (roadmap 5.6) ------------------------------------------------

    private bool _exporting;
    private bool _downloadOpen;

    private Task ExportArtifactAsync(string format) =>
        _artifact is null ? Task.CompletedTask
            : DownloadAsync(() => Exports.ArtifactAsync(CampaignId, _artifact.Id, format));

    private Task ExportCampaignAsync() => DownloadAsync(() => Exports.CampaignAsync(CampaignId));

    private async Task ExportFromMenuAsync(string format)
    {
        _downloadOpen = false;
        await ExportArtifactAsync(format);
    }

    private async Task ExportCampaignFromMenuAsync()
    {
        _downloadOpen = false;
        await ExportCampaignAsync();
    }

    private async Task DownloadAsync(Func<Task<DownloadedFile>> fetch)
    {
        _exporting = true;
        try
        {
            var file = await fetch();
            await Downloader.SaveAsync(file);
            Notifier.ShowSuccess($"Downloaded {file.FileName}.");
        }
        catch (ApiException ex)
        {
            Notifier.ShowError(ex.Message);
        }
        finally
        {
            _exporting = false;
        }
    }

    // ---- Publish to GitHub (ADR-021) ------------------------------------------

    private List<GitRepo> _repos = [];
    private bool _publishOpen;
    private bool _publishing;
    private Guid _publishRepoId;
    private string _publishMode = "pull-request";
    private bool _publishImages = true;
    private GitPublishPreview? _preview;
    private GitPublishOutcome? _published;

    private async Task OpenPublishAsync()
    {
        if (_repos.Count == 0 || _artifact is null)
        {
            return;
        }

        var repo = _repos.FirstOrDefault(r => r.IsDefault) ?? _repos[0];
        _publishRepoId = repo.Id;
        _publishMode = repo.Mode;
        _published = null;
        _publishOpen = true;
        await LoadPreviewAsync();
    }

    private void ClosePublish()
    {
        _publishOpen = false;
        _preview = null;
    }

    /// <summary>Costs no GitHub call — it is the "see it before you commit it" step.</summary>
    private async Task LoadPreviewAsync()
    {
        if (!_publishOpen || _artifact is null)
        {
            return;
        }

        try
        {
            _preview = await Git.PreviewAsync(CampaignId, _artifact.Id, _publishRepoId, _publishImages);
        }
        catch (ApiException ex)
        {
            _preview = null;
            Notifier.ShowError(ex.Message);
        }
    }

    private async Task PublishAsync()
    {
        if (_artifact is null)
        {
            return;
        }

        _publishing = true;
        try
        {
            _published = await Git.PublishAsync(
                CampaignId, _artifact.Id, _publishRepoId, _publishImages, _publishMode);

            Notifier.ShowSuccess(_published.PullRequestNumber is { } number
                ? $"Pull request #{number} opened."
                : $"Committed to {_published.Branch}.");
        }
        catch (ApiException ex)
        {
            Notifier.ShowError(ex.Message);
        }
        finally
        {
            _publishing = false;
        }
    }

    // ---- Media insertion (roadmap 5.4) ----------------------------------------

    private string? _mediaDialog;
    private string _mediaUrl = string.Empty;

    /// <summary>Every Producer control follows the selected artifact. Images from a sibling
    /// post are never offered for insertion or shown as though they belong to this item.</summary>
    private IEnumerable<ImageSlotResponse> ArtifactImageSlots
    {
        get
        {
            if (_artifactId is not { } artifactId || _artifact is null)
            {
                return [];
            }

            var slots = Campaign.ImageSlots.Where(slot => slot.ArtifactId == artifactId).ToList();
            var legacyChosen = Campaign.ImageSlots
                .Where(slot => slot.ArtifactId is null
                    && SlotMatchesArtifact(slot.Kind, _artifact.Kind)
                    && (slot.PublishedUrl is not null || slot.KeeperThumbUrl is not null))
                .GroupBy(slot => slot.Kind, StringComparer.OrdinalIgnoreCase)
                .Select(group => group.OrderByDescending(slot => slot.UpdatedAt).First());
            foreach (var legacy in legacyChosen)
            {
                var ownedIndex = slots.FindIndex(slot =>
                    slot.Kind.Equals(legacy.Kind, StringComparison.OrdinalIgnoreCase));
                if (ownedIndex < 0)
                {
                    slots.Add(legacy);
                }
                else if (slots[ownedIndex].PublishedUrl is null
                    && slots[ownedIndex].KeeperThumbUrl is null)
                {
                    slots[ownedIndex] = legacy;
                }
            }
            return slots;
        }
    }

    private static bool SlotMatchesArtifact(string slotKind, string artifactKind) => artifactKind switch
    {
        "youtube" => slotKind == "youtube-thumbnail",
        "blog" => slotKind.StartsWith("blog-", StringComparison.Ordinal)
            || slotKind == "content-image-1",
        _ when artifactKind.StartsWith("social-", StringComparison.Ordinal) => slotKind == "social-card",
        _ => false,
    };

    /// <summary>Filled image slots owned by the open content item.</summary>
    private IEnumerable<ImageSlotResponse> CampaignImages =>
        ArtifactImageSlots.Where(s => s.State == "Filled" && !string.IsNullOrWhiteSpace(s.PublishedUrl));

