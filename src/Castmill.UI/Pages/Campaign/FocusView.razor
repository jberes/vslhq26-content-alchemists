@* Focus mode. Phase F5 builds the full Producer rail — steering, two-pass narrated log,
   image slots, the version filmstrip and the validator line. Phase F4's job is the editor
   itself: the manuscript column, the outline rail and blur-commit saving against the
   artifact's ETag. *@
@page "/campaigns/{CampaignId:guid}/focus"
@using System.Text.Json
@using Castmill.Core
@using Castmill.Core.Ai
@using Castmill.Core.Resources
@using Castmill.UI.Design
@using Castmill.UI.Editor
@using Castmill.UI.Platform
@using Castmill.UI.Http
@using Castmill.UI.State
@implements IDisposable
@inject CampaignState Campaign
@inject CampaignsClient Campaigns
@inject GenerationClient Generation
@inject ImagesClient Images
@inject ExportClient Exports
@inject GitClient Git
@inject IFileDownloader Downloader
@inject IConfirmService Confirm
@inject INotifier Notifier
@inject NavigationManager Navigation

<PageTitle>@(_artifact?.Title ?? Campaign.Campaign?.Name ?? "Campaign") — Focus</PageTitle>

<CampaignShell CampaignId="CampaignId" View="CampaignView.Focus">
    <div class="cm-focus cm-region">
        <aside class="cm-focus__outline cm-region">
            <h2 class="cm-kicker">Artifacts</h2>
            @if (Campaign.Artifacts.Count == 0)
            {
                <p class="cm-meta cm-focus__pad">Nothing to edit yet.</p>
            }
            else
            {
                @* Grouped by type: one collapsible group per lane category, items labelled
                   with their kind. Each item carries a delete affordance with a confirm. *@
                <div class="cm-tree">
                    @foreach (var group in ArtifactGroups)
                    {
                        var collapsed = _collapsedGroups.Contains(group.Key);
                        <div class="cm-tree__group">
                            <button type="button" class="cm-tree__head"
                                    aria-expanded="@(collapsed ? "false" : "true")"
                                    @onclick="() => ToggleGroup(group.Key)">
                                <span class="cm-tree__chevron" aria-hidden="true">@(collapsed ? "▸" : "▾")</span>
                                <span class="cm-kicker">@group.Key</span>
                                <span class="cm-tree__count cm-mono">(@group.Count())</span>
                            </button>
                            @if (!collapsed)
                            {
                                <ul class="cm-focus__list">
                                    @foreach (var item in group)
                                    {
                                        <li class="cm-tree__row">
                                            <button type="button"
                                                    class="cm-focus__list-item @(item.Id == _artifactId ? "cm-focus__list-item--active" : "")"
                                                    @onclick="() => SelectAsync(item.Id)">
                                                <span class="cm-focus__list-title">@item.Title</span>
                                                <span class="cm-meta">@ArtifactDisplay.KindLabel(item.Kind)</span>
                                            </button>
                                            <button type="button" class="cm-tree__delete"
                                                    title="Delete @ArtifactDisplay.KindLabel(item.Kind)"
                                                    aria-label="Delete @item.Title"
                                                    @onclick="() => DeleteArtifactAsync(item)">✕</button>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                </div>
            }

            @if (_headings.Count > 0)
            {
                <h2 class="cm-kicker">Outline</h2>
                <ul class="cm-focus__outline-list">
                    @foreach (var heading in _headings)
                    {
                        <li style="padding-inline-start: @((heading.Level - 1) * 10)px">
                            <button type="button" class="cm-focus__outline-item"
                                    @onclick="() => GoToAsync(heading)">
                                @heading.Text
                            </button>
                        </li>
                    }
                </ul>
            }
        </aside>

        <div class="cm-focus__manuscript cm-region">
            @if (_loadError is { } error)
            {
                <EmptyState Kicker="Focus" Headline="That artifact couldn't be opened." Detail="@error" />
            }
            else if (_artifact is null)
            {
                <EmptyState Kicker="Focus"
                            Headline="Pick something to work on."
                            Detail="Focus mode edits one artifact at a time. Its markdown is the only thing persisted — no HTML, no editor-native format." />
            }
            else
            {
                <header class="cm-focus__head">
                    <span class="cm-kicker">@ArtifactDisplay.KindLabel(_artifact.Kind)</span>
                    <h1>@_artifact.Title</h1>
                    <div class="cm-focus__status">
                        <span class="@ArtifactDisplay.StatusModifier(_artifact.Status)">
                            @ArtifactDisplay.StatusLabel(_artifact.Status)
                        </span>
                        <span class="cm-meta">@_saveState</span>
                    </div>
                </header>

                @if (_artifact.Kind is "clips" or "clip-suggestions")
                {
                    <ClipReview ContentJson="@_artifact.ContentJson" />
                }
                else
                {
                @if (IsStructured)
                {
                    <p class="cm-meta">
                        Structured artifact — rendered read-only. Its fields are validated
                        server-side; a composer for structured kinds is a later phase.
                    </p>
                }
                <RichEditor @key="EditorKey"
                            Markdown="@DisplayedMarkdown"
                            Editable="@(_previewRevision is null && !IsStructured)"
                            Placeholder="Write, or press / for a block."
                            OnCommit="CommitAsync"
                            OnChanged="MarkDirty"
                            OnHeadings="OnHeadings"
                            OnRequestMedia="OpenMediaDialog"
                            OnImageFile="UploadDroppedImageAsync"
                            @ref="_editor" />

                @if (_publishOpen)
                {
                    <div class="cm-modal" role="presentation" @onclick="ClosePublish">
                        <div class="cm-modal__panel" role="dialog" aria-modal="true"
                             aria-labelledby="cm-publish-title" tabindex="-1" @onclick:stopPropagation>
                            <h2 id="cm-publish-title" class="cm-front__block-title">Publish to GitHub</h2>

                            <label class="cm-field">
                                <span class="cm-field__label">Repository</span>
                                <select class="cm-input" @bind="_publishRepoId" @bind:after="LoadPreviewAsync"
                                        aria-label="Repository to publish into">
                                    @foreach (var repo in _repos)
                                    {
                                        <option value="@repo.Id">@repo.Name — @repo.Owner/@repo.Repo</option>
                                    }
                                </select>
                            </label>

                            <div class="cm-studio__row">
                                <span class="cm-kicker">How</span>
                                @* Both modes, chosen per publish. A draft PR is the safe default:
                                   nothing reaches the site until someone merges it, and the
                                   repository's own CI preview runs on the branch. *@
                                <label class="cm-fanout__item">
                                    <input type="radio" name="cm-publish-mode"
                                           checked="@(_publishMode == "pull-request")"
                                           @onchange="@(() => _publishMode = "pull-request")" />
                                    <span>Open a pull request</span>
                                </label>
                                <label class="cm-fanout__item">
                                    <input type="radio" name="cm-publish-mode"
                                           checked="@(_publishMode == "direct-commit")"
                                           @onchange="@(() => _publishMode = "direct-commit")" />
                                    <span>Commit directly</span>
                                </label>
                            </div>

                            <label class="cm-fanout__item">
                                <input type="checkbox" @bind="_publishImages" @bind:after="LoadPreviewAsync" />
                                <span>Include this artifact's images</span>
                            </label>

                            @if (_preview is { } preview)
                            {
                                @* Shown before anything is committed. Every tool in this space
                                   that skipped this generates support tickets. *@
                                <div class="cm-publish__preview">
                                    <span class="cm-kicker">Will write</span>
                                    <p class="cm-mono cm-meta">@preview.ContentPath</p>
                                    @foreach (var image in preview.ImagePaths)
                                    {
                                        <p class="cm-mono cm-meta">@image</p>
                                    }
                                    <span class="cm-kicker">Front matter</span>
                                    <pre class="cm-publish__front">@preview.FrontMatter</pre>
                                    <p class="cm-meta">
                                        Branch <span class="cm-mono">@preview.Branch</span> —
                                        publishing again updates this branch rather than opening another.
                                    </p>
                                </div>
                            }

                            <div class="cm-form__actions">
                                <button type="button" class="cm-button" disabled="@_publishing"
                                        @onclick="PublishAsync">
                                    @(_publishing ? "Publishing…" : _publishMode == "direct-commit" ? "Commit" : "Open pull request")
                                </button>
                                <button type="button" class="cm-button cm-button--quiet" @onclick="ClosePublish">
                                    Cancel
                                </button>
                            </div>

                            @if (_published is { } done)
                            {
                                <p class="cm-meta">
                                    Committed <span class="cm-mono">@done.CommitSha[..Math.Min(7, done.CommitSha.Length)]</span>
                                    to <span class="cm-mono">@done.Branch</span>.
                                    @if (done.PullRequestUrl is { Length: > 0 } url)
                                    {
                                        <a href="@url" target="_blank" rel="noopener noreferrer">Open pull request #@done.PullRequestNumber</a>
                                    }
                                </p>
                            }
                        </div>
                    </div>
                }

                @if (_mediaDialog is { } media)
                {
                    <div class="cm-modal" role="presentation" @onclick="CloseMediaDialog">
                        <div class="cm-modal__panel" role="dialog" aria-modal="true"
                             aria-labelledby="cm-media-title" tabindex="-1"
                             @onclick:stopPropagation>
                            <h2 id="cm-media-title" class="cm-front__block-title">
                                @(media == "youtube" ? "Insert a YouTube video" : "Insert an image")
                            </h2>

                            @if (media == "image" && CampaignImages.Any())
                            {
                                @* This campaign's own generated images first: they are almost
                                   always what the writer means, and pasting a blob URL by hand
                                   is exactly the friction the Image Studio already removed. *@
                                <span class="cm-kicker">From this campaign</span>
                                <ul class="cm-media__picks">
                                    @foreach (var slot in CampaignImages)
                                    {
                                        <li>
                                            <button type="button" class="cm-media__pick"
                                                    @onclick="() => InsertImageAsync(slot.PublishedUrl!, ArtifactDisplay.SlotLabel(slot.Kind))">
                                                <img src="@slot.PublishedUrl" alt="" loading="lazy" />
                                                <span class="cm-meta">@ArtifactDisplay.SlotLabel(slot.Kind)</span>
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }

                            <label class="cm-field">
                                <span class="cm-field__label">
                                    @(media == "youtube" ? "YouTube URL or video id" : "Image URL")
                                </span>
                                <input class="cm-input" @bind="_mediaUrl" @bind:event="oninput"
                                       placeholder="@(media == "youtube" ? "https://www.youtube.com/watch?v=…" : "https://…")" />
                            </label>

                            <div class="cm-form__actions">
                                <button type="button" class="cm-button"
                                        disabled="@string.IsNullOrWhiteSpace(_mediaUrl)"
                                        @onclick="ConfirmMediaAsync">Insert</button>
                                <button type="button" class="cm-button cm-button--quiet"
                                        @onclick="CloseMediaDialog">Cancel</button>
                            </div>

                            @if (media == "image")
                            {
                                <p class="cm-meta">You can also paste or drag an image straight into the text.</p>
                            }
                        </div>
                    </div>
                }
                }

                <footer class="cm-focus__foot">
                    @* The review gate: advancing status is a distinct action from saving
                       (E6.9). The full validator line arrives with F5. *@
                    @if (_artifact.Status == ArtifactStatus.Draft)
                    {
                        <button type="button" class="cm-button" @onclick="() => SetStatusAsync(ArtifactStatus.InReview)">
                            Send to review
                        </button>
                    }
                    else if (_artifact.Status == ArtifactStatus.InReview)
                    {
                        <button type="button" class="cm-button" @onclick="() => SetStatusAsync(ArtifactStatus.Queued)">
                            Mark reviewed
                        </button>
                        <button type="button" class="cm-button cm-button--quiet" @onclick="() => SetStatusAsync(ArtifactStatus.Draft)">
                            Back to draft
                        </button>
                    }
                    else
                    {
                        <span class="cm-meta">
                            @ArtifactDisplay.StatusLabel(_artifact.Status). Scheduling lives on the Wire (F8).
                        </span>
                    }

                    @* Getting the work out (roadmap 5.6). The markdown IS the stored format,
                       so .md is a copy rather than a conversion — which is the whole reason
                       the editor's contract was kept to markdown. *@
                    <span class="cm-focus__export">
                        <button type="button" class="cm-button cm-button--quiet"
                                disabled="@_exporting" @onclick="@(() => ExportArtifactAsync("md"))">
                            Download .md
                        </button>
                        <button type="button" class="cm-button cm-button--quiet"
                                disabled="@_exporting" @onclick="@(() => ExportArtifactAsync("docx"))">
                            .docx
                        </button>
                        <button type="button" class="cm-button cm-button--quiet"
                                disabled="@_exporting" @onclick="ExportCampaignAsync">
                            Whole campaign (.zip)
                        </button>
                        @if (_repos.Count > 0)
                        {
                            <button type="button" class="cm-button cm-button--quiet"
                                    @onclick="OpenPublishAsync">
                                Publish to GitHub
                            </button>
                        }
                    </span>
                </footer>
            }
        </div>

        <aside class="cm-focus__producer cm-region">
            <h2 class="cm-kicker">Producer</h2>

            @if (_artifact is not null)
            {
                <div class="cm-producer__group">
                    <label class="cm-field">
                        <span class="cm-field__label">Steering</span>
                        <textarea class="cm-input cm-textarea" rows="3" @bind="_steering"
                                  placeholder="Tighter intro. Lead with the rollback story."></textarea>
                    </label>
                    <div class="cm-form__actions">
                        <button type="button" class="cm-button cm-button--quiet" disabled="@_regenerating"
                                @onclick="RegenerateAsync">
                            @(_regenerating ? "Regenerating…" : "Regenerate whole")
                        </button>
                        @* Second pass, deliberately a different model family (ADR-020).
                           Disabled with the reason rather than hidden, so an unconfigured
                           provider explains itself instead of the button just not existing. *@
                        <button type="button" class="cm-button cm-button--quiet"
                                disabled="@(_regenerating || !TechEditReady)"
                                title="@TechEditReason"
                                @onclick="TechEditAsync">
                            @(_regenerating ? "Working…" : $"Tech Edit · {TechEditProvider}")
                        </button>
                    </div>
                    @if (KnowledgeBaseReady)
                    {
                        <label class="cm-fanout__item">
                            <input type="checkbox" @bind="_useKnowledgeBase" />
                            <span>Consult the knowledge base</span>
                        </label>
                    }
                    @* Shown whether or not the button is live: "this will run on Foundry
                       instead" is exactly the case where the control still works but the
                       result is not the cross-family pass the user asked for. *@
                    @if (TechEditReason is { Length: > 0 } reason)
                    {
                        <p class="cm-meta">@reason</p>
                    }
                    @if (_producerLog.Count > 0)
                    {
                        <ul class="cm-log">
                            @foreach (var line in _producerLog)
                            {
                                <li class="cm-mono cm-meta">@line</li>
                            }
                        </ul>
                    }
                    <p class="cm-meta">
                        Regenerate prints a <em>new take</em> as its own artifact (backend 🔶 5.7).
                        A Tech Edit revises <em>this</em> artifact in place and rings the filmstrip,
                        so you can compare it against the take before it.
                    </p>
                </div>

                @if (_artifact.Kind == "blog")
                {
                    <div class="cm-producer__group">
                        <span class="cm-kicker">Blog publishing metadata</span>
                        <p class="cm-meta">This belongs to this blog—not the campaign SEO report.</p>
                        <label class="cm-field">
                            <span class="cm-field__label">Canonical URL</span>
                            <input class="cm-input" @bind="_blogMetadata.CanonicalUrl" placeholder="https://example.com/blog/post" />
                        </label>
                        <label class="cm-field">
                            <span class="cm-field__label">Description</span>
                            <textarea class="cm-input cm-textarea" rows="3" maxlength="320" @bind="_blogMetadata.Description"></textarea>
                        </label>
                        <label class="cm-field">
                            <span class="cm-field__label">Keywords</span>
                            <input class="cm-input" @bind="_blogMetadata.Keywords" placeholder="primary keyword, supporting term" />
                        </label>
                        <label class="cm-field">
                            <span class="cm-field__label">Site name</span>
                            <input class="cm-input" @bind="_blogMetadata.SiteName" />
                        </label>
                        <label class="cm-field">
                            <span class="cm-field__label">Author</span>
                            <input class="cm-input" @bind="_blogMetadata.Author" />
                        </label>
                        <label class="cm-field">
                            <span class="cm-field__label">Organization logo URL</span>
                            <input class="cm-input" @bind="_blogMetadata.OrganizationLogoUrl" />
                        </label>
                        <label class="cm-field">
                            <span class="cm-field__label">Related video URL <span class="cm-meta">optional</span></span>
                            <input class="cm-input" @bind="_blogMetadata.VideoUrl" />
                        </label>
                        <button type="button" class="cm-button cm-button--quiet" disabled="@_savingMetadata"
                                @onclick="SaveBlogMetadataAsync">
                            @(_savingMetadata ? "Saving…" : "Save metadata")
                        </button>
                        <div class="cm-tabs" role="tablist" aria-label="Blog metadata format">
                            @foreach (var tab in BlogMetaTabs)
                            {
                                <button type="button" role="tab" class="cm-tabs__tab"
                                        aria-selected="@(_blogMetaTab == tab)" @onclick="() => _blogMetaTab = tab">@tab</button>
                            }
                        </div>
                        <pre class="cm-seo__meta-pre cm-mono">@BlogMetadataOutput(_blogMetaTab)</pre>
                    </div>
                }

                <div class="cm-producer__group">
                    <span class="cm-kicker">Images for this content item</span>
                    @if (!ArtifactImageSlots.Any())
                    {
                        <p class="cm-meta">No image cards yet. Add one for this item, then create its takes in Image Studio.</p>
                    }
                    else
                    {
                    <ul class="cm-plan__slots">
                        @foreach (var slot in ArtifactImageSlots)
                        {
                            <li class="cm-plan__slot">
                                <span class="cm-plan__slot-name">@ArtifactDisplay.SlotLabel(slot.Kind)</span>
                                <span class="cm-badge @(slot.State == "Filled" ? "cm-badge--done" : "cm-badge--empty")">
                                    @(slot.State == "Filled" ? "DONE" : "EMPTY")
                                </span>
                                <a class="cm-meta"
                                   href="@ImageStudioPath(slot.Id)">Open</a>
                            </li>
                        }
                    </ul>
                    }
                    <div class="cm-form__actions">
                        <button type="button" class="cm-button cm-button--quiet"
                                disabled="@_addingImage" @onclick="AddImageAsync">
                            @(_addingImage ? "Adding…" : "+ Add image")
                        </button>
                        @if (_artifactId is { } artifactId)
                        {
                            <a class="cm-meta" href="@ImageStudioForArtifact(artifactId)">
                                Focus in Image Studio
                            </a>
                        }
                    </div>
                </div>

                <div class="cm-producer__group">
                    <span class="cm-kicker">Versions</span>
                    @if (_revisions.Count == 0)
                    {
                        <p class="cm-meta">No earlier takes yet. The ring keeps the last 10.</p>
                    }
                    else
                    {
                        <ul class="cm-filmstrip">
                            @foreach (var revision in _revisions)
                            {
                                <li>
                                    <button type="button"
                                            class="cm-filmstrip__frame @(_previewRevision?.Id == revision.Id ? "cm-filmstrip__frame--active" : "")"
                                            @onclick="() => PreviewRevisionAsync(revision.Id)">
                                        <span class="cm-mono">v@(revision.Version)</span>
                                        <span class="cm-meta">@revision.Reason</span>
                                    </button>
                                </li>
                            }
                        </ul>
                    }

                    @if (_previewRevision is { } preview)
                    {
                        <div class="cm-filmstrip__actions">
                            <span class="cm-meta">Viewing v@(preview.Version) (@preview.Reason) — read-only.</span>
                            <button type="button" class="cm-button" @onclick="RestoreRevisionAsync">Restore this take</button>
                            <button type="button" class="cm-button cm-button--quiet" @onclick="ClosePreview">Back to current</button>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="cm-meta">Open an artifact to steer it.</p>
            }
        </aside>
    </div>
</CampaignShell>

@code {
    /// <summary>Structured kinds render formatted but read-only (see StructuredContent).</summary>
    private bool IsStructured => _artifact is not null && StructuredContent.IsStructured(_artifact.Kind);

    private readonly List<EditorHeading> _headings = [];

    private readonly List<string> _producerLog = [];
    private readonly List<ArtifactRevisionResponse> _revisions = [];

    private RichEditor? _editor;
    private ArtifactRevisionDetailResponse? _previewRevision;
    private string _steering = string.Empty;
    private bool _regenerating;
    private bool _addingImage;
    private bool _savingMetadata;
    private BlogPublishingMetadata _blogMetadata = new();
    private string _blogMetaTab = "Combined";
    private static readonly string[] BlogMetaTabs = ["Combined", "Head", "JSON-LD"];
    private ArtifactResponse? _artifact;
    private Guid? _artifactId;
    private string? _etag;
    private string _markdown = string.Empty;
    private string _saveState = "Saved on blur";
    private string? _loadError;
    private bool _selecting;
    private bool _useKnowledgeBase;
    private AiStatusResponse? _aiStatus;

    /// <summary>
    /// The provider that would serve a Tech Edit. Foundry always can (the alias falls back to
    /// "chat"), so the button is never dead — a configured second family just makes it a
    /// genuine cross-model pass rather than a same-family one.
    /// </summary>
    private TextProviderReadiness? TechEditProviderStatus =>
        _aiStatus?.TextProviders?.FirstOrDefault(p => p.Ready)
        ?? _aiStatus?.TextProviders?.FirstOrDefault();

    private string TechEditProvider => TechEditProviderStatus is { Ready: true, Name: var name } ? name : "Foundry";

    private bool TechEditReady => _aiStatus?.EndpointConfigured == true;

    private string? TechEditReason => _aiStatus is null
        ? "Checking model configuration…"
        : !_aiStatus.EndpointConfigured
            ? "No model credentials configured, so there is nothing to run a second pass on."
            : TechEditProviderStatus is { Ready: false, Reason: { Length: > 0 } reason }
                ? $"Second-pass provider unavailable ({reason}) — this will run on Foundry instead."
                : null;

    private bool KnowledgeBaseReady => _aiStatus?.KnowledgeBaseReady == true;

    [Parameter] public Guid CampaignId { get; set; }

    /// <summary>Deep link from the front page's review queue.</summary>
    [SupplyParameterFromQuery(Name = "artifact")]
    private Guid? RequestedArtifact { get; set; }

    private readonly HashSet<string> _collapsedGroups = [];

    private IEnumerable<ArtifactPreviewResponse> Editable =>
        Campaign.Artifacts.Where(a => ArtifactDisplay.Editable(a.Kind));

    /// <summary>The tree's groups: lane categories in board order, kinds in registry order.</summary>
    private IEnumerable<IGrouping<string, ArtifactPreviewResponse>> ArtifactGroups =>
        Editable
            .OrderBy(a => ArtifactDisplay.KindOrder(a.Kind))
            .ThenBy(a => a.CreatedAt)
            .GroupBy(a => ArtifactDisplay.Lane(a.Kind))
            .OrderBy(g => Array.IndexOf(ArtifactDisplay.LaneOrder, g.Key) is var i && i >= 0
                ? i
                : ArtifactDisplay.LaneOrder.Length);

    private void ToggleGroup(string lane)
    {
        if (!_collapsedGroups.Remove(lane))
        {
            _collapsedGroups.Add(lane);
        }
    }

    /// <summary>
    /// Deletes an artifact from the tree after a confirm. If the open artifact is the one
    /// deleted, focus moves to the next remaining editable artifact.
    /// </summary>
    private async Task DeleteArtifactAsync(ArtifactPreviewResponse item)
    {
        var accepted = await Confirm.ConfirmAsync(new ConfirmRequest(
            $"Delete \"{item.Title}\"?",
            $"This removes the {ArtifactDisplay.KindLabel(item.Kind).ToLowerInvariant()} and its revision history. There is no undo.",
            AcceptLabel: "Delete",
            Destructive: true));

        if (!accepted)
        {
            return;
        }

        try
        {
            await Campaigns.DeleteArtifactAsync(CampaignId, item.Id);

            if (_artifactId == item.Id)
            {
                _artifact = null;
                _artifactId = null;
                RequestedArtifact = null;
                Navigation.NavigateTo(CampaignViews.PathFor(CampaignId, CampaignView.Focus));
            }

            await Campaign.LoadAsync(CampaignId, force: true);
            Notifier.ShowSuccess($"Deleted \"{item.Title}\".");
        }
        catch (ApiException ex)
        {
            Notifier.ShowError(ex.Message);
        }
    }

    protected override void OnInitialized() => Campaign.Changed += OnChanged;

    /// <summary>
    /// Model readiness for the Tech Edit control. Best-effort: if /ai/status is unreachable
    /// the button falls back to disabled-with-a-reason rather than taking the page down.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }
        // Broad on purpose: this runs from a lifecycle method, so anything that escapes
        // becomes an unhandled render exception and blanks the page. Model readiness is a
        // nicety — it must never be able to take the editor down.
        try
        {
            _aiStatus = await Images.GetAiStatusAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _aiStatus = null;
        }

        // No repo profiles means no publish button at all — an optional feature that has not
        // been set up should be absent, not present-and-broken (G3).
        try
        {
            _repos = await Git.ListReposAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _repos = [];
        }

        StateHasChanged();
    }

    protected override Task OnParametersSetAsync() => SyncSelectionAsync();

    /// <summary>
    /// Chooses which artifact to edit. Called from OnParametersSetAsync AND from the store's
    /// Changed handler, because the campaign is still loading when the route parameters are
    /// first set — OnParametersSetAsync does not run again when that load finishes, so
    /// selecting only there left the editor permanently unmounted.
    /// </summary>
    private async Task SyncSelectionAsync()
    {
        if (Campaign.CampaignId != CampaignId || Campaign.IsLoading || _selecting)
        {
            return;
        }

        var target = RequestedArtifact ?? _artifactId ?? Editable.FirstOrDefault()?.Id;

        if (target is { } id && id != _artifactId)
        {
            _selecting = true;
            try
            {
                await LoadArtifactAsync(id);
            }
            finally
            {
                _selecting = false;
            }
        }
        else if (target is null && _artifact is not null)
        {
            _artifact = null;
            _artifactId = null;
            StateHasChanged();
        }
    }

    private async Task SelectAsync(Guid id)
    {
        // Keep the URL honest so a reload or a Back lands on the same artifact (ADR-F07).
        Navigation.NavigateTo($"{CampaignViews.PathFor(CampaignId, CampaignView.Focus)}?artifact={id}");
        await LoadArtifactAsync(id);
    }

    private async Task LoadArtifactAsync(Guid id)
    {
        _loadError = null;

        try
        {
            var (artifact, etag) = await Campaigns.GetArtifactAsync(CampaignId, id);
            _artifact = artifact;
            _artifactId = id;
            _etag = etag;
            _markdown = StructuredContent.IsStructured(artifact.Kind)
                ? StructuredContent.ToDisplayMarkdown(artifact.Kind, artifact.ContentJson)
                : ArtifactContent.ToMarkdown(artifact.ContentJson);
            _blogMetadata = artifact.Kind == "blog"
                ? ArtifactContent.PublishingMetadata(artifact.ContentJson)
                : new BlogPublishingMetadata();
            _headings.Clear();
            _saveState = "Saved on blur";
            _previewRevision = null;
            await LoadRevisionsAsync(id);
        }
        catch (ApiException ex)
        {
            _loadError = ex.Message;
        }
        catch (HttpRequestException)
        {
            _loadError = "Couldn't reach the Castmill API.";
        }

        StateHasChanged();
    }

    private void MarkDirty()
    {
        _saveState = "Unsaved — commits on blur";
        StateHasChanged();
    }

    /// <summary>
    /// Blur-commit. A 412 means someone else changed the artifact; the user is told rather
    /// than having their edit silently dropped or silently overwriting the other version.
    /// </summary>
    private async Task CommitAsync(string markdown)
    {
        if (_artifact is null || _artifactId is not { } id || IsStructured)
        {
            return;
        }

        if (string.Equals(markdown, _markdown, StringComparison.Ordinal))
        {
            _saveState = "Saved on blur";
            return;
        }

        _saveState = "Saving…";
        StateHasChanged();

        try
        {
            var saved = await Campaigns.SaveArtifactAsync(
                CampaignId, id, _artifact.Title, ArtifactContent.FromMarkdown(_artifact.ContentJson, markdown), _etag);

            _artifact = saved;
            _markdown = markdown;
            _etag = $"\"{saved.Version}\"";
            _saveState = $"Saved · v{saved.Version}";

            // A manual save snapshots the prior take server-side (ADR-017), so the
            // filmstrip must refresh or the new frame is invisible until re-select.
            await LoadRevisionsAsync(id);
        }
        catch (ConflictApiException)
        {
            _saveState = "Conflict — reload to see the newer version";
            Notifier.ShowError(
                "Someone else changed this artifact while you were editing. Reload to see their version — your text is still on screen.");
        }
        catch (ApiException ex)
        {
            _saveState = "Not saved";
            Notifier.ShowError(ex.Message);
        }

        StateHasChanged();
    }

    private async Task SetStatusAsync(string status)
    {
        if (_artifactId is not { } id)
        {
            return;
        }

        try
        {
            _artifact = await Campaigns.SetArtifactStatusAsync(CampaignId, id, status, _etag);
            _etag = $"\"{_artifact.Version}\"";
            Notifier.ShowSuccess($"Moved to {ArtifactDisplay.StatusLabel(status).ToLowerInvariant()}.");

            // The front page and the header counter read the campaign preview, so refresh it.
            await Campaign.LoadAsync(CampaignId, force: true);
        }
        catch (ConflictApiException)
        {
            Notifier.ShowError("This artifact changed since you loaded it. Reload before changing its status.");
        }
        catch (ApiException ex)
        {
            Notifier.ShowError(ex.Message);
        }
    }

    private void OnHeadings(IReadOnlyList<EditorHeading> headings)
    {
        _headings.Clear();
        _headings.AddRange(headings);
        StateHasChanged();
    }

    private async Task GoToAsync(EditorHeading heading)
