    private void ClosePreview() => _previewRevision = null;

    /// <summary>
    /// Restore is an ordinary ETag-guarded write (ADR-017): the current take is snapshotted
    /// first server-side, so restoring is never destructive.
    /// </summary>
    private async Task RestoreRevisionAsync()
    {
        if (_artifactId is not { } id || _previewRevision is not { } preview)
        {
            return;
        }

        try
        {
            var restored = await Campaigns.RestoreRevisionAsync(CampaignId, id, preview.Id, _etag);
            _artifact = restored;
            _markdown = ArtifactContent.ToMarkdown(restored.ContentJson);
            _etag = $"\"{restored.Version}\"";
            _previewRevision = null;
            _saveState = $"Restored v{preview.Version} · now v{restored.Version}";
            Notifier.ShowSuccess($"Restored take v{preview.Version}.");
            await LoadRevisionsAsync(id);
        }
        catch (ConflictApiException)
        {
            Notifier.ShowError("The artifact changed since you loaded it. Reload before restoring.");
        }
        catch (ApiException ex)
        {
            Notifier.ShowError(ex.Message);
        }
    }

    /// <summary>
    /// Regenerate whole, with the steering text as the brief. The narrated two-pass log is
    /// honest about what request/response generation can know: one line when the press
    /// starts, one when the result lands, with the real duration and audit warnings.
    /// </summary>
    private async Task RegenerateAsync()
    {
        if (_artifact is null || Campaign.TranscriptArtifactId is not { } transcriptId)
        {
            Notifier.ShowError("This campaign has no transcript to regenerate from.");
            return;
        }

        _regenerating = true;
        _producerLog.Clear();
        _producerLog.Add($"queued {_artifact.Kind} · drafting, then cross-model audit…");
        StateHasChanged();

        try
        {
            var result = await Generation.GenerateOneAsync(
                CampaignId, _artifact.Kind, transcriptId,
                string.IsNullOrWhiteSpace(_steering) ? null : _steering);

            if (result.Success)
            {
                _producerLog.Add($"printed {result.Kind} · {result.DurationMs} ms"
                    + (result.ValidationWarnings is { Count: > 0 } w
                        ? $" · audit: {string.Join("; ", w)}"
                        : " · audit clean"));

                // 🔶 5.7: the new take is a NEW artifact row. Reload and jump to it.
                await Campaign.LoadAsync(CampaignId, force: true);
                var newest = Campaign.Artifacts
                    .Where(a => a.Kind == _artifact.Kind)
                    .OrderByDescending(a => a.CreatedAt)
                    .FirstOrDefault();
                if (newest is not null && newest.Id != _artifactId)
                {
                    await SelectAsync(newest.Id);
                }
            }
            else
            {
                _producerLog.Add($"failed {result.Kind} · {result.Error}");
                Notifier.ShowError(result.Error ?? "Generation failed.");
            }
        }
        catch (ApiException ex)
        {
            _producerLog.Add($"failed · {ex.Message}");
            Notifier.ShowError(ex.Message);
        }
        finally
        {
            _regenerating = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// The second pass (ADR-020). Unlike Regenerate this does NOT reload-and-jump: the
    /// artifact keeps its id and takes a new version, so the manuscript is updated in place
    /// and the filmstrip picks up the "tech-edit" ring — exactly what restoring a revision
    /// already does.
    /// </summary>
    private async Task TechEditAsync()
    {
        if (_artifact is null)
        {
            return;
        }

        _regenerating = true;
        _producerLog.Clear();
        _producerLog.Add(_useKnowledgeBase
            ? $"tech edit queued {_artifact.Kind} · consulting the knowledge base…"
            : $"tech edit queued {_artifact.Kind} · second pass on {TechEditProvider}…");
        StateHasChanged();

        try
        {
            var result = await Generation.TechEditAsync(
                CampaignId, _artifact.Id,
                string.IsNullOrWhiteSpace(_steering) ? null : _steering,
                _useKnowledgeBase);

            if (!result.Success)
            {
                _producerLog.Add($"tech edit failed · {result.Error}");
                Notifier.ShowError(result.Error ?? "Tech edit failed.");
                return;
            }

            _producerLog.Add(
                $"tech edited {_artifact.Kind} · {result.DurationMs} ms · {result.Provider}"
                + (result.KnowledgeBaseUsed ? " · knowledge base consulted" : string.Empty)
                + $" · {result.Changes.Count} change{(result.Changes.Count == 1 ? "" : "s")}");
            foreach (var change in result.Changes)
            {
                _producerLog.Add($"  · {change}");
            }

            // Reload the artifact itself rather than the whole campaign: the id is unchanged,
            // only its content and version moved.
            var (updated, etag) = await Campaigns.GetArtifactAsync(CampaignId, _artifact.Id);
            _artifact = updated;
            _etag = etag;
            _markdown = ArtifactContent.ToMarkdown(updated.ContentJson);
            _saveState = $"Tech edited · v{result.Version}";
            await LoadRevisionsAsync(_artifact.Id);
            Notifier.ShowSuccess($"Tech edit applied · v{result.Version}.");
        }
        catch (ApiException ex)
        {
            _producerLog.Add($"tech edit failed · {ex.Message}");
            Notifier.ShowError(ex.Message);
        }
        finally
        {
            _regenerating = false;
            StateHasChanged();
        }
    }

