    [Parameter] public Guid BrandId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded)
        {
            return;
        }

        try
        {
            var brand = await Brands.GetAsync(BrandId);
            _name = brand.Name;
            _isOwner = brand.IsOwner;

            if (brand.StyleCard is { } card)
            {
                _tagline = card.Tagline ?? string.Empty;
                _voice = card.Voice ?? string.Empty;
                _audience = card.Audience ?? string.Empty;
                _headingFont = card.HeadingFont ?? string.Empty;
                _bodyFont = card.BodyFont ?? string.Empty;
                _imageStyle = card.ImageStyle ?? string.Empty;
                _bannedText = string.Join('\n', card.BannedPhrases ?? []);
                _colors.AddRange((card.Colors ?? []).Select(c => new ColorRow { Role = c.Role, Hex = c.Hex }));
            }

            await ReloadKitAsync();
        }
        catch (ApiException ex)
        {
            _loadError = ex.Message;
        }
        catch (HttpRequestException)
        {
            _loadError = "Couldn't reach the Castmill API.";
        }

        _loaded = true;
    }

    private async Task ReloadKitAsync()
    {
        var assets = await Brands.ListAssetsAsync(BrandId);
        _assets.Clear();
        _assets.AddRange(assets);

        var templates = await Brands.ListTemplatesAsync(BrandId);
        _templates.Clear();
        _templates.AddRange(templates);

        // Previews for the whole grid in ONE call, pointing at cached small derivatives.
        // This used to be a sequential SAS mint per asset against the full-size original:
        // nine faces meant nine round trips before the first tile could appear, then tens of
        // megabytes of photography to draw 140 px cards. Best effort — storage may be
        // unconfigured in some dev setups, and a kit with no previews still edits fine.
        var wanted = assets
            .Where(a => a.ContentType.StartsWith("image/", StringComparison.Ordinal))
            .Select(a => a.AssetId)
            .Where(id => !_assetPreviews.ContainsKey(id))
            .Distinct()
            .ToList();
        if (wanted.Count == 0)
        {
            return;
        }

        try
        {
            foreach (var thumb in await Brands.MintThumbsAsync(wanted))
            {
                _assetPreviews[thumb.AssetId] = thumb.ReadUrl;
            }
        }
        catch (ApiException)
        {
            // Storage unconfigured, or the derivative pass is unavailable: leave the cards
            // blank rather than firing N per-asset requests that would fail the same way.
        }
    }

    private void AddColor() => _colors.Add(new ColorRow());

    private BrandStyleCard BuildCard() => new(
        Voice: NullIfEmpty(_voice),
        Audience: NullIfEmpty(_audience),
        Tagline: NullIfEmpty(_tagline),
        Colors: _colors.Count == 0
            ? null
            : [.. _colors
                .Where(c => !string.IsNullOrWhiteSpace(c.Role))
                .Select(c => new BrandColor(c.Role.Trim(), c.Hex))],
        HeadingFont: NullIfEmpty(_headingFont),
        BodyFont: NullIfEmpty(_bodyFont),
        ImageStyle: NullIfEmpty(_imageStyle),
        BannedPhrases: _bannedText.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            is { Length: > 0 } phrases ? phrases : null);

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            Notifier.ShowWarning("A brand needs a name.");
            return;
        }

        _saving = true;
        try
        {
            var saved = await Brands.UpdateAsync(BrandId, _name.Trim(), BuildCard());
            _saveState = $"Saved · {saved.UpdatedAt.ToLocalTime():HH:mm}";
            Notifier.ShowSuccess($"Saved \"{saved.Name}\".");
        }
        catch (ApiException ex)
        {
            Notifier.ShowError(ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>Upload rides the ordinary asset flow: metadata row → single-blob write SAS
    /// → direct PUT (no bearer header — the SAS is the credential) → link into the kit.</summary>
    /// <summary>
    /// Uploads every selected file into the kit. Sequential rather than parallel: each file is
    /// a create + a SAS mint + a link, all behind the per-user write limiter, and firing ten
    /// at once trips it.
    ///
    /// A partial failure keeps whatever already landed — re-picking the rest is far better
    /// than losing nine good uploads to the tenth.
    /// </summary>
    private async Task UploadAsync(InputFileChangeEventArgs e)
    {
        const long maxBytes = 20 * 1024 * 1024;
        var files = e.GetMultipleFiles(20);

        _uploading = true;
        _uploadError = null;
        _uploadTotal = files.Count;
        _uploadDone = 0;
        var added = 0;

        try
        {
            foreach (var file in files)
            {
                if (file.Size > maxBytes)
                {
                    _uploadError = $"{file.Name} is over the 20 MB cap and was skipped.";
                    continue;
                }

                var asset = await Brands.CreateLibraryAssetAsync(file.Name, file.ContentType, file.Size);

                // Through the API, not straight to storage: the direct SAS PUT is cross-origin
                // and so depends on the storage account's CORS rules, which differ between the
                // web shell and the desktop WebView.
                await Brands.UploadAssetContentAsync(
                    asset.Id, await ReadAllAsync(file, maxBytes), file.ContentType);

                await Brands.LinkAssetAsync(BrandId, asset.Id, _newAssetKind, LabelFor(file.Name, files.Count));
                added++;
                _uploadDone = added;
                StateHasChanged();
            }

            _newAssetLabel = string.Empty;
            await ReloadKitAsync();
            if (added > 0)
            {
                Notifier.ShowSuccess($"Added {added} {KindLabel(_newAssetKind).ToLowerInvariant()}"
                    + $"{(added == 1 ? "" : "s")} to the kit.");
            }
        }
        catch (ApiException ex)
        {
            _uploadError = ex.Message;
            await ReloadKitAsync();
        }
        catch (HttpRequestException ex)
        {
            // NAME the failure. A bare "couldn't reach the API" is unactionable and sent us
            // chasing storage CORS for three rounds while the real fault was elsewhere; the
            // inner exception is the one thing that identifies it.
            _uploadError = $"Upload failed talking to {ApiOrigin()} — "
                + $"{ex.GetType().Name}: {ex.Message}"
                + (ex.InnerException is { } inner ? $" ({inner.GetType().Name}: {inner.Message})" : "");
        }
        finally
        {
            _uploading = false;
            _uploadTotal = 0;
        }
    }

    /// <summary>
    /// Reads an uploaded file fully into memory. The WebView hands these over JS interop as a
    /// one-shot, non-seekable stream, and both the HTTP layer's refresh-replay and any retry
    /// need to read the body more than once.
    /// </summary>
    private static async Task<byte[]> ReadAllAsync(IBrowserFile file, long maxBytes)
    {
        await using var stream = file.OpenReadStream(maxBytes);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        return buffer.ToArray();
    }

    private int _uploadTotal;
    private int _uploadDone;

    private static readonly string[] AssetKinds = ["product", "face", "background", "accent", "logo", "other"];

    private static string KindLabel(string kind) => kind switch
    {
        "product" => "Product screenshot",
        "face" => "Face",
        "background" => "Background",
        "accent" => "Accent",
        "logo" => "Logo",
        _ => "Other",
    };

    /// <summary>
    /// One typed label cannot describe five files, and every asset needs its own — the label
    /// IS the prompt text, and it is how they are told apart in the picker. With several files
    /// the filename stem wins, because it is at least distinct.
    /// </summary>
    private string? LabelFor(string fileName, int fileCount)
    {
        var typed = _newAssetLabel.Trim();
        if (fileCount == 1)
        {
            return string.IsNullOrWhiteSpace(typed) ? Path.GetFileNameWithoutExtension(fileName) : typed;
        }

        var stem = Path.GetFileNameWithoutExtension(fileName).Replace('-', ' ').Replace('_', ' ').Trim();
        return string.IsNullOrWhiteSpace(typed) ? stem : $"{typed} — {stem}";
    }

    private IEnumerable<IGrouping<string, BrandAssetResponse>> GroupedAssets =>
        _assets
            .GroupBy(a => a.Kind.ToLowerInvariant())
            .OrderBy(g => Array.IndexOf(AssetKinds, g.Key) is var i && i >= 0 ? i : AssetKinds.Length);

    private bool _contextOpen;
    private string _contextUrl = string.Empty;
    private string _contextNotes = string.Empty;
    private bool _reading;
    private string? _contextError;

    /// <summary>
    /// Fills the form from pasted material and/or a URL. Only ever fills fields that are
    /// EMPTY — the user's own words survive, which is what makes this safe to press twice.
    /// Colours are appended rather than replaced for the same reason.
    /// </summary>
    private async Task ApplyContextAsync()
    {
        _reading = true;
        _contextError = null;
        try
        {
            var draft = await Brands.LookupAsync(
                string.IsNullOrWhiteSpace(_contextUrl) ? null : _contextUrl.Trim(),
                string.IsNullOrWhiteSpace(_contextNotes) ? null : _contextNotes);

            var filled = new List<string>();
            Fill(ref _name, draft.Name, "name", filled);

            if (draft.StyleCard is { } card)
            {
                Fill(ref _tagline, card.Tagline, "tagline", filled);
                Fill(ref _voice, card.Voice, "voice", filled);
                Fill(ref _audience, card.Audience, "audience", filled);
                Fill(ref _imageStyle, card.ImageStyle, "image style", filled);
                Fill(ref _headingFont, card.HeadingFont, "heading font", filled);
                Fill(ref _bodyFont, card.BodyFont, "body font", filled);

                if (card.Colors is { Count: > 0 } colors)
                {
                    var added = 0;
                    foreach (var colour in colors)
                    {
                        // Matched on hex: the model's role names differ run to run, and a
                        // duplicate swatch is more confusing than a missing one.
                        if (!_colors.Any(existing =>
                                string.Equals(existing.Hex, colour.Hex, StringComparison.OrdinalIgnoreCase)))
                        {
                            _colors.Add(new ColorRow { Role = colour.Role, Hex = colour.Hex });
                            added++;
                        }
                    }
                    if (added > 0)
                    {
                        filled.Add($"{added} colour{(added == 1 ? "" : "s")}");
                    }
                }

                if (card.BannedPhrases is { Count: > 0 } banned && string.IsNullOrWhiteSpace(_bannedText))
                {
                    _bannedText = string.Join("\n", banned);
                    filled.Add("banned phrases");
                }
            }

            foreach (var note in draft.Notes)
            {
                Notifier.ShowWarning(note);
            }

            Notifier.ShowSuccess(filled.Count == 0
                ? "Nothing new to add — every field already had a value."
                : $"Filled {string.Join(", ", filled)}. Review, then Save.");

            _contextOpen = false;
        }
        catch (ApiException ex)
        {
            _contextError = ex.Message;
        }
        catch (HttpRequestException)
        {
            _contextError = "Couldn't reach the Castmill API.";
        }
        finally
        {
            _reading = false;
        }

        static void Fill(ref string field, string? value, string label, List<string> filled)
        {
            if (string.IsNullOrWhiteSpace(field) && !string.IsNullOrWhiteSpace(value))
            {
                field = value.Trim();
                filled.Add(label);
            }
        }
    }

    private async Task UnlinkAssetAsync(BrandAssetResponse asset)
    {
        try
        {
            await Brands.UnlinkAssetAsync(BrandId, asset.Id);
            _assets.RemoveAll(a => a.Id == asset.Id);
        }
        catch (ApiException ex)
        {
            Notifier.ShowError(ex.Message);
        }
    }

    private static string? NullIfEmpty(string value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
