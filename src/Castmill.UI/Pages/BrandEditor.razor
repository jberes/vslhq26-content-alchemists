@* One brand's full kit: identity + voice, colour scheme, type, image style, banned
   phrases, the asset kit (logos / backgrounds / faces — ordinary Assets linked in) and
   per-generator templates. Everything here flows into generation server-side through
   BrandContextService; nothing on this page talks to a model directly. *@
@page "/brands/{BrandId:guid}"
@using Castmill.Core.Resources
@using Castmill.UI.Design
@using Castmill.UI.Http
@using Castmill.UI.State
@using Microsoft.AspNetCore.Components.Forms
@inject BrandsClient Brands
@inject HttpClient Http
@inject INotifier Notifier
@inject NavigationManager Navigation

<PageTitle>@(_name.Length > 0 ? _name : "Brand") — Castmill</PageTitle>

<div class="cm-page @(_brandTab == "templates" ? "cm-page--brand-template" : "")"><div class="cm-measure--dashboard cm-brand-editor">
    <header class="cm-front__head">
        <a class="cm-meta" href="brands">Brands /</a>
        <h1>@(_name.Length > 0 ? _name : "Brand")</h1>
        @if (_loaded && !_isOwner)
        {
            <span class="cm-meta">Shared with you · full editing access</span>
        }
    </header>

    @if (!_loaded)
    {
        <p class="cm-meta">Loading the brand…</p>
    }
    else if (_loadError is { } error)
    {
        <EmptyState Kicker="Brand" Headline="That brand couldn't be opened." Detail="@error" />
    }
    else
    {
        @* Tabs, not one endless column: four unrelated jobs (identity, colours, assets,
           templates) stacked into a single 72ch strip left half the window empty and put the
           templates a full page-height below the fold. Same pattern as Settings. *@
        <div class="cm-tabs" role="tablist" aria-label="Brand sections">
            @foreach (var (id, label) in VisibleBrandTabs)
            {
                <button type="button" role="tab" class="cm-tabs__tab"
                        aria-selected="@(_brandTab == id ? "true" : "false")"
                        @onclick="() => SwitchTabAsync(id)">
                    @label
                </button>
            }
        </div>

        <div class="cm-brand @(_brandTab == "templates" ? "cm-brand--template" : "")">
        @if (_brandTab == "identity")
        {
            @* Paste whatever the brand team actually gave you — a voice doc, a palette, an
               email — and optionally a URL, and let the model fill the form from both. Pasted
               material outranks the website server-side, because someone wrote it on purpose. *@
            <section class="cm-brand__section">
                <div class="cm-brand__context-head">
                    <h2 class="cm-front__block-title">Add context</h2>
                    <button type="button" class="cm-button cm-button--quiet"
                            aria-expanded="@(_contextOpen ? "true" : "false")"
                            @onclick="() => _contextOpen = !_contextOpen">
                        @(_contextOpen ? "Hide" : "Paste brand material")
                    </button>
                </div>

                @if (_contextOpen)
                {
                    <p class="cm-meta">
                        Fills anything below that is still empty. Nothing you have already typed
                        is overwritten.
                    </p>
                    <label class="cm-field">
                        <span class="cm-field__label">Website (optional)</span>
                        <input class="cm-input" type="url" placeholder="https://your-brand.com"
                               @bind="_contextUrl" @bind:event="oninput" />
                    </label>
                    <label class="cm-field">
                        <span class="cm-field__label">Anything the brand team gave you</span>
                        <textarea class="cm-input cm-textarea cm-brand__context-body" rows="12"
                                  placeholder="Brand voice guidelines, image direction, palette, words to avoid, positioning — paste it all."
                                  @bind="_contextNotes" @bind:event="oninput"></textarea>
                    </label>
                    <div class="cm-form__actions">
                        <button type="button" class="cm-button"
                                disabled="@(_reading || (string.IsNullOrWhiteSpace(_contextUrl) && string.IsNullOrWhiteSpace(_contextNotes)))"
                                @onclick="ApplyContextAsync">
                            @(_reading ? "Reading…" : "Fill the brand from this")
                        </button>
                        @if (_contextError is { } contextError)
                        {
                            <span class="cm-form__error" role="alert">@contextError</span>
                        }
                    </div>
                }
            </section>

            <section class="cm-brand__section">
                <h2 class="cm-front__block-title">Identity &amp; voice</h2>
                <label class="cm-field">
                    <span class="cm-field__label">Name</span>
                    <input class="cm-input" @bind="_name" maxlength="200" />
                </label>
                <label class="cm-field">
                    <span class="cm-field__label">Tagline</span>
                    <input class="cm-input" @bind="_tagline" maxlength="300" />
                </label>
                <label class="cm-field">
                    <span class="cm-field__label">Brand voice — tone, personality, dos and don'ts</span>
                    <textarea class="cm-input cm-textarea" rows="4" @bind="_voice" maxlength="4000"
                              placeholder="Confident but never salesy. Short sentences. Developer-to-developer. Humor is dry, sparse."></textarea>
                </label>
                <label class="cm-field">
                    <span class="cm-field__label">Audience</span>
                    <textarea class="cm-input cm-textarea" rows="2" @bind="_audience" maxlength="2000"
                              placeholder=".NET team leads evaluating tooling; skeptical of marketing."></textarea>
                </label>
                <label class="cm-field">
                    <span class="cm-field__label">Banned phrases — one per line</span>
                    <textarea class="cm-input cm-textarea" rows="3" @bind="_bannedText"
                              placeholder="game-changer&#10;unlock the power of"></textarea>
                </label>
            </section>

            <div class="cm-form__actions">
                <button type="button" class="cm-button" disabled="@_saving" @onclick="SaveAsync">
                    @(_saving ? "Saving…" : "Save brand")
                </button>
                <span class="cm-meta">@_saveState</span>
            </div>
        }
        @if (_brandTab == "style")
        {
            <section class="cm-brand__section">
                <h2 class="cm-front__block-title">Colour scheme</h2>
                @foreach (var color in _colors)
                {
                    <div class="cm-brand__color-row">
                        <input class="cm-input cm-brand__color-role" placeholder="role (primary, background…)"
                               maxlength="50" @bind="color.Role" />
                        @* The OS colour panel itself cannot be styled — but the swatch that
                           opens it can be a real target, and the hex is TYPED as often as it
                           is picked, so it is an input rather than a caption. *@
                        <input class="cm-brand__color-pick" type="color" @bind="color.Hex"
                               aria-label="Pick @color.Role colour" />
                        <input class="cm-input cm-mono cm-brand__color-hex" maxlength="7"
                               aria-label="Hex for @color.Role" @bind="color.Hex" />
                        <button type="button" class="cm-tree__delete" aria-label="Remove colour"
                            @onclick="() => _colors.Remove(color)"><AppIcon Name="trash" /></button>
                    </div>
                }
                <button type="button" class="cm-button cm-button--quiet" @onclick="AddColor"
                        disabled="@(_colors.Count >= 12)">+ Add colour</button>
            </section>

            <section class="cm-brand__section">
                <h2 class="cm-front__block-title">Type &amp; image style</h2>
                <label class="cm-field">
                    <span class="cm-field__label">Heading font</span>
                    <input class="cm-input" @bind="_headingFont" maxlength="200" placeholder="e.g. Barlow Condensed" />
                </label>
                <label class="cm-field">
                    <span class="cm-field__label">Body font</span>
                    <input class="cm-input" @bind="_bodyFont" maxlength="200" placeholder="e.g. Inter" />
                </label>
                <label class="cm-field">
                    <span class="cm-field__label">Image style — steering appended to every image prompt</span>
                    <textarea class="cm-input cm-textarea" rows="3" @bind="_imageStyle" maxlength="4000"
                              placeholder="Clean editorial photography, soft natural light, muted blues, no text baked into the image."></textarea>
                </label>
            </section>

            <div class="cm-form__actions">
                <button type="button" class="cm-button" disabled="@_saving" @onclick="SaveAsync">
                    @(_saving ? "Saving…" : "Save brand")
                </button>
                <span class="cm-meta">@_saveState</span>
            </div>
        }
        @if (_brandTab == "assets")
        {
            <section class="cm-brand__section">
                <h2 class="cm-front__block-title">Asset kit — logos, backgrounds, faces</h2>
                <p class="cm-meta">
                    Labels double as prompt text: "the host, short dark hair" tells the image
                    model who may appear.
                </p>
                @* Square cards, label editable in place: the label IS the prompt text,
                   and "20210920 Infragistics 005" steers an image model toward nothing. *@
                @foreach (var group in GroupedAssets)
                {
                    <div class="cm-brand__asset-group" @key="group.Key">
                        <span class="cm-kicker">@KindLabel(group.Key) · @group.Count()</span>
                        <div class="cm-asset-grid">
                            @foreach (var asset in group)
                            {
                                <figure class="cm-asset-card" @key="asset.Id">
                                    @if (_assetPreviews.TryGetValue(asset.AssetId, out var url))
                                    {
                                        @* decoding=async keeps a large decode off the UI thread —
                                           a grid of faces otherwise stalls the first paint. *@
                                        <img src="@url" alt="@(asset.Label ?? asset.FileName)"
                                             loading="lazy" decoding="async" />
                                    }
                                    else
                                    {
                                        <span class="cm-asset-card__blank" aria-hidden="true"></span>
                                    }
                                    <button type="button" class="cm-tree__delete cm-asset-card__delete"
                                            aria-label="Remove @(asset.Label ?? asset.FileName) from the kit"
                                            @onclick="() => UnlinkAssetAsync(asset)"><AppIcon Name="trash" /></button>
                                    <label class="cm-asset-card__type">
                                        <span>Type</span>
                                        <select value="@asset.Kind"
                                                disabled="@(_retypingAsset == asset.Id)"
                                                aria-label="Type for @(asset.Label ?? asset.FileName)"
                                                @onchange="e => ChangeAssetKindAsync(asset, e)">
                                            @foreach (var kind in AssetKinds)
                                            {
                                                <option value="@kind">@KindLabel(kind)</option>
                                            }
                                        </select>
                                    </label>
                                    <input class="cm-input cm-asset-card__label"
                                           value="@(asset.Label ?? asset.FileName)"
                                           aria-label="Label — used as prompt text"
                                           @onchange="e => RenameAssetHandlerAsync(asset, e)" />
                                </figure>
                            }
                        </div>
                    </div>
                }
                <div class="cm-brand__upload">
                    <select class="cm-input cm-brand__kind" @bind="_newAssetKind">
                        @foreach (var kind in AssetKinds)
                        {
                            <option value="@kind">@KindLabel(kind)</option>
                        }
                    </select>
                    <input class="cm-input" placeholder="Label (used in prompts)" maxlength="200"
                           @bind="_newAssetLabel" />
                    @* multiple: a brand has several faces and several backgrounds, and adding
                       them one file at a time was the slowest part of setting a brand up. Each
                       file keeps its own label so they stay tellable apart in the picker. *@
                    <InputFile OnChange="UploadAsync" accept="image/*" multiple disabled="@_uploading" />
                    @if (_uploading)
                    {
                        <span class="cm-meta">
                            <span class="cm-ai-dot" aria-hidden="true"></span>
                            uploading@(_uploadTotal > 1 ? $" {_uploadDone} of {_uploadTotal}" : "")…
                        </span>
                    }
                </div>
                @if (_uploadError is { } uploadError)
                {
                    <p class="cm-form__error" role="alert">@uploadError</p>
                }
            </section>

        }
        @if (_brandTab == "templates")
        {
            <section class="cm-brand__section cm-brand__section--template">
                <h2 class="cm-front__block-title">Content templates</h2>
                <p class="cm-meta">
                    This is the primary content brief sent to AI for this Brand and content type.
                    It overrides Castmill's generic writing guidance on every generation pass;
                    the required JSON shape, transcript grounding and safety rules still apply.
                    Pick a type and edit — it saves when you click away.
                </p>

                <div class="cm-brand__tpl-bar">
                    <select class="cm-input cm-brand__kind" value="@_tplKind"
                            @onchange="OnTemplateKindPicked">
                        @foreach (var kind in ArtifactDisplay.BrandTemplateKinds)
                        {
                            <option value="@kind.Kind">@kind.Label</option>
                        }
                    </select>
                    <button type="button" class="cm-button cm-button--quiet" disabled="@_tplBusy"
                            @onclick="ResetTemplateAsync">
                        Reset to starter
                    </button>
                    <span class="cm-meta" role="status">@_tplStatus</span>
                </div>

                @* The select changes WHICH template this editor shows, and the text always
                   follows it — the previous design was an add-new form wearing an editor's
                   clothes, where the select picked a kind for a future template and the box
                   deliberately never changed under your typing. *@
                <textarea class="cm-input cm-textarea cm-brand__template-body"
                          aria-label="Template for @ArtifactDisplay.KindLabel(_tplKind)"
                          maxlength="20000" disabled="@_tplBusy"
                          @bind="_tplPrompt" @bind:event="oninput"
                          @onblur="SaveTemplateAsync"></textarea>
            </section>
        }
        @if (_brandTab == "sharing" && _isOwner)
        {
            <section class="cm-brand__section cm-brand__sharing">
                <h2 class="cm-front__block-title">Collaborators</h2>
                <p class="cm-meta">
                    Collaborators can edit this Brand's profile, asset kit, and templates,
                    and use it in their own campaigns.
                </p>
                <div class="cm-brand__share-form">
                    <label class="cm-field">
                        <span class="cm-field__label">Castmill account email</span>
                        <input class="cm-input" type="email" maxlength="256"
                               placeholder="person@company.com"
                               disabled="@_sharing"
                               @bind="_shareEmail" @bind:event="oninput"
                               @onkeydown="ShareKeyDownAsync" />
                    </label>
                    <button type="button" class="cm-button"
                            disabled="@(_sharing || string.IsNullOrWhiteSpace(_shareEmail))"
                            @onclick="ShareAsync">
                        @(_sharing ? "Adding…" : "Add collaborator")
                    </button>
                </div>
                @if (_shareError is { } shareError)
                {
                    <p class="cm-form__error" role="alert">@shareError</p>
                }

                @if (_collaborators.Count == 0)
                {
                    <p class="cm-meta">No collaborators.</p>
                }
                else
                {
                    <ul class="cm-brand__collaborators">
                        @foreach (var collaborator in _collaborators)
                        {
                            <li @key="collaborator.Id">
                                <span>
                                    <strong>@(string.IsNullOrWhiteSpace(collaborator.DisplayName)
                                        ? collaborator.Email
                                        : collaborator.DisplayName)</strong>
                                    <span class="cm-meta">@collaborator.Email</span>
                                </span>
                                <button type="button" class="cm-tree__delete"
                                        aria-label="Remove @collaborator.Email"
                                        disabled="@(_removingCollaborator == collaborator.Id)"
                                        @onclick="() => RemoveCollaboratorAsync(collaborator)">
                                    <AppIcon Name="trash" />
                                </button>
                            </li>
                        }
                    </ul>
                }
            </section>
        }

        </div>
    }
</div></div>

@code {

    /// <summary>
    /// Where the client is actually pointed. The desktop shell and the web shell resolve the
    /// API differently, so naming it turns "couldn't reach the API" into something a person
    /// can check.
    /// </summary>
    private string ApiOrigin() => Http.BaseAddress?.ToString() ?? "the API";

    // ---- Tabs ---------------------------------------------------------------------

    private static readonly (string Id, string Label)[] BrandTabs =
        [("identity", "Identity & voice"), ("style", "Colours & type"),
         ("assets", "Asset kit"), ("templates", "Templates"), ("sharing", "Sharing")];

    private IEnumerable<(string Id, string Label)> VisibleBrandTabs =>
        _isOwner ? BrandTabs : BrandTabs.Where(tab => tab.Id != "sharing");

    private string _brandTab = "identity";

    private async Task SwitchTabAsync(string tab)
    {
        _brandTab = tab;

        // The template editor materialises its row lazily, on the tab that shows it — a page
        // LOAD must not write to the database.
        if (tab == "templates" && _tplTemplateId is null)
        {
            await SelectTemplateKindAsync(_tplKind);
        }
        if (tab == "sharing" && _isOwner)
        {
            await LoadCollaboratorsAsync();
        }
    }

    // ---- Collaborators -------------------------------------------------------------

    private readonly List<BrandCollaboratorResponse> _collaborators = [];
    private string _shareEmail = string.Empty;
    private string? _shareError;
    private bool _sharing;
    private Guid? _removingCollaborator;

    private async Task LoadCollaboratorsAsync()
    {
        try
        {
            var collaborators = await Brands.ListCollaboratorsAsync(BrandId);
            _collaborators.Clear();
            _collaborators.AddRange(collaborators);
            _shareError = null;
        }
        catch (ApiException ex)
        {
            _shareError = ex.Message;
        }
    }

    private Task ShareKeyDownAsync(KeyboardEventArgs args) =>
        args.Key == "Enter" ? ShareAsync() : Task.CompletedTask;

    private async Task ShareAsync()
    {
        if (string.IsNullOrWhiteSpace(_shareEmail) || _sharing)
        {
            return;
        }

        _sharing = true;
        _shareError = null;
        try
        {
            var collaborator = await Brands.AddCollaboratorAsync(BrandId, _shareEmail.Trim());
            _collaborators.Add(collaborator);
            _collaborators.Sort((left, right) =>
                StringComparer.OrdinalIgnoreCase.Compare(left.Email, right.Email));
            _shareEmail = string.Empty;
            Notifier.ShowSuccess($"Shared with {collaborator.Email}.");
        }
        catch (ApiException ex)
        {
            _shareError = ex.Message;
        }
        finally
        {
            _sharing = false;
        }
    }

    private async Task RemoveCollaboratorAsync(BrandCollaboratorResponse collaborator)
    {
        _removingCollaborator = collaborator.Id;
        try
        {
            await Brands.RemoveCollaboratorAsync(BrandId, collaborator.Id);
            _collaborators.RemoveAll(item => item.Id == collaborator.Id);
            Notifier.ShowSuccess($"Removed {collaborator.Email}.");
        }
        catch (ApiException ex)
        {
            Notifier.ShowError(ex.Message);
        }
        finally
        {
            _removingCollaborator = null;
        }
    }

    // ---- Template editor ------------------------------------------------------------

    private string _tplKind = "youtube";
    private string _tplPrompt = string.Empty;
    private string _tplLoadedPrompt = string.Empty;
    private Guid? _tplTemplateId;
    private string _tplStatus = string.Empty;
    private bool _tplBusy;

    private Task OnTemplateKindPicked(ChangeEventArgs e) =>
        SelectTemplateKindAsync(e.Value?.ToString() ?? "blog");

    /// <summary>
    /// Loads the kind's default template into the editor, creating it from the starter when
    /// none exists — "always create the default" is the contract, so the editor never faces
    /// an empty void. Unsaved edits to the previous kind are saved first: a select click blurs
    /// the textarea, but relying on event order would be a race.
    /// </summary>
    private async Task SelectTemplateKindAsync(string kind)
    {
        await SaveTemplateAsync();

        _tplKind = kind;
        _tplBusy = true;
        _tplStatus = string.Empty;
        try
        {
            var existing = _templates.FirstOrDefault(t =>
                t.IsDefault && string.Equals(t.Kind, kind, StringComparison.Ordinal));

            if (existing is null)
            {
                var starter = Starters.GetValueOrDefault(kind, string.Empty);
                var created = await Brands.CreateTemplateAsync(BrandId, new BrandTemplateRequest(
                    kind, $"{ArtifactDisplay.KindLabel(kind)} default", starter, IsDefault: true));
                _templates.Add(created);
                existing = created;
                _tplStatus = "Created from the starter — edit away.";
            }

            _tplTemplateId = existing.Id;
            _tplPrompt = existing.SteeringPrompt;
            _tplLoadedPrompt = existing.SteeringPrompt;
        }
        catch (ApiException ex)
        {
            _tplStatus = $"Couldn't load this template — {ex.Message}";
            _tplTemplateId = null;
        }
        finally
        {
            _tplBusy = false;
        }
    }

    /// <summary>Blur-save, the app's editing contract. A no-op when nothing changed, so
    /// clicking around never burns writes.</summary>
    private async Task SaveTemplateAsync()
    {
        if (_tplTemplateId is not { } id
            || string.Equals(_tplPrompt, _tplLoadedPrompt, StringComparison.Ordinal)
            || string.IsNullOrWhiteSpace(_tplPrompt))
        {
            return;
        }

        try
        {
            var updated = await Brands.UpdateTemplateAsync(BrandId, id, new BrandTemplateRequest(
                _tplKind, $"{ArtifactDisplay.KindLabel(_tplKind)} default", _tplPrompt.Trim(), IsDefault: true));

            _tplLoadedPrompt = _tplPrompt;
            _templates.RemoveAll(t => t.Id == id);
            _templates.Add(updated);
            _tplStatus = $"Saved · {DateTime.Now:HH:mm:ss}";
        }
        catch (ApiException ex)
        {
            _tplStatus = $"Not saved — {ex.Message}";
        }
    }

    private async Task ResetTemplateAsync()
    {
        _tplPrompt = Starters.GetValueOrDefault(_tplKind, string.Empty);
        await SaveTemplateAsync();
    }

    // ---- Asset labels -----------------------------------------------------------------

    /// <summary>
    /// Rename in place, saved on blur. The label is the prompt text, so this is a content
    /// decision, not housekeeping — and re-uploading a file to fix its name was absurd.
    /// </summary>
    private async Task RenameAssetHandlerAsync(BrandAssetResponse asset, ChangeEventArgs e)
    {
        var label = e.Value?.ToString()?.Trim();
        if (string.Equals(label, asset.Label ?? asset.FileName, StringComparison.Ordinal))
        {
            return;
        }

        try
        {
            await Brands.RenameAssetAsync(BrandId, asset.Id, label);
            var index = _assets.FindIndex(a => a.Id == asset.Id);
            if (index >= 0)
            {
                _assets[index] = asset with { Label = string.IsNullOrWhiteSpace(label) ? null : label };
            }
        }
        catch (ApiException ex)
        {
            Notifier.ShowError($"Couldn't rename that asset — {ex.Message}");
        }
    }

    private async Task ChangeAssetKindAsync(BrandAssetResponse asset, ChangeEventArgs e)
    {
        var kind = e.Value?.ToString()?.Trim().ToLowerInvariant();
        if (string.IsNullOrWhiteSpace(kind)
            || string.Equals(kind, asset.Kind, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _retypingAsset = asset.Id;
        try
        {
            var updated = await Brands.ChangeAssetKindAsync(BrandId, asset.Id, kind);
            var index = _assets.FindIndex(item => item.Id == asset.Id);
            if (index >= 0)
            {
                // Use the server's canonical value, not the selection event's transient DOM
                // value. Combined with @key on the card this prevents a moved card inheriting
                // the select state of the card that previously occupied its DOM position.
                _assets[index] = updated;
            }
            Notifier.ShowSuccess($"Moved to {KindLabel(updated.Kind)}.");
        }
        catch (ApiException ex)
        {
            Notifier.ShowError($"Couldn't change that asset type — {ex.Message}");
        }
        finally
        {
            _retypingAsset = null;
        }
    }

    private sealed class ColorRow
    {
        public string Role { get; set; } = string.Empty;
        public string Hex { get; set; } = "#5980a6";
    }

    private readonly List<ColorRow> _colors = [];
    private readonly List<BrandAssetResponse> _assets = [];
    private readonly List<BrandTemplateResponse> _templates = [];
    private readonly Dictionary<Guid, string> _assetPreviews = [];

    private bool _loaded;
    private bool _isOwner;
    private bool _saving;
    private bool _uploading;
    private Guid? _retypingAsset;
    private string? _loadError;
    private string? _uploadError;
    private string _saveState = string.Empty;

    private string _name = string.Empty;
    private string _tagline = string.Empty;
    private string _voice = string.Empty;
    private string _audience = string.Empty;
    private string _bannedText = string.Empty;
    private string _headingFont = string.Empty;
    private string _bodyFont = string.Empty;
    private string _imageStyle = string.Empty;

    private string _newAssetKind = "background";
    private string _newAssetLabel = string.Empty;

    /// <summary>
    /// A usable first draft per content type, so a new brand is steering generation within a
    /// minute instead of facing an empty box. These are starting points to edit, not rules —
    /// the shape of each one mirrors what its generator already asks the model for.
    /// </summary>
    private static readonly Dictionary<string, string> Starters = new(StringComparer.Ordinal)
    {
        ["youtube"] = """
            Act as an expert YouTube content strategist specializing in SEO, answer-engine
            optimization, generative-search visibility and accurate technical content.

            Priority order:
            1. Accurately represent what is actually shown or discussed in the transcript.
            2. Satisfy the search intent behind the approved primary keyword.
            3. Make the title and first 1–2 description sentences compelling to a human.
            4. Make the package easy for search engines and answer engines to understand.
            5. Cover related entities, capabilities, problems and terminology only when the
               transcript supports them.
            6. Never use keyword stuffing, unsupported claims, generic hype or clickbait.

            Before writing, determine the video's subject, problem, audience, learning outcome,
            demonstrated products/features, supported claims and questions it answers. Silently
            correct obvious transcription errors, but do not invent facts. Build a semantic topic
            cluster around the approved primary keyword: close variants, category terms,
            problem/feature/implementation searches, named technologies and natural questions.

            Produce three genuinely different A/B/C title strategies using distinct supported
            angles. Keep titles accurate and preferably 45–65 characters, front-load the important
            concept where natural, and avoid minor rewrites of one title.

            The first 200 description characters must explain exactly what the viewer will learn,
            naturally use the primary phrase or strongest semantic variation, and name a concrete
            capability or outcome. Follow with 2–4 short paragraphs covering the problem, major
            capabilities, learning outcome, technologies and differentiators actually shown.
            Where useful, add an "In this video, you'll learn" list with 4–8 concise bullets.

