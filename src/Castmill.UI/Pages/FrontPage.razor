@* Front page (workspace scope): what needs a human today.
   Four blocks from the handoff §1 — ready for review, on the wire, drafts aging, and image
   slots waiting. The last one exists because empty image slots were otherwise invisible
   until publish time (G9). *@
@page "/"
@using Castmill.Core
@using Castmill.Core.Resources
@using Castmill.UI.Design
@using Castmill.UI.Http
@using Castmill.UI.State
@implements IDisposable
@inject WorkspaceState Workspace
@inject CampaignsClient Campaigns
@inject NavigationManager Navigation

<PageTitle>Front page — Castmill</PageTitle>

<div class="cm-page cm-page--fill"><div class="cm-measure--dashboard cm-front__frame">
    <header class="cm-front__head">
        <span class="cm-kicker">Front page</span>
        <h1>What needs you today.</h1>
    </header>

    @if (!Workspace.IsLoaded)
    {
        <p class="cm-meta">Loading your workspace…</p>
    }
    else if (Workspace.LoadError is { } error)
    {
        <EmptyState Kicker="Workspace" Headline="Couldn't load your campaigns." Detail="@error" />
    }
    else if (Workspace.Campaigns.Count == 0)
    {
        <EmptyState Kicker="Workspace"
                    Headline="Nothing has come off the press yet."
                    Detail="A campaign starts from one source asset — a video, a podcast, a webinar or a transcript — and fans out into everything else.">
            <Action>
                <a class="cm-button" href="campaigns/new">Start a run</a>
            </Action>
        </EmptyState>
    }
    else
    {
        <div class="cm-front">
            <section class="cm-front__primary">
                <h2 class="cm-front__block-title">Ready for review</h2>
                @if (_review.Count == 0)
                {
                    <p class="cm-meta">Nothing is waiting on you. @(_loaded ? "" : "Still checking…")</p>
                }
                else
                {
                    <ul class="cm-cards">
                        @foreach (var item in _review)
                        {
                            <li>
                                <button type="button" class="cm-card cm-card--artifact"
                                        @onclick="() => OpenFocus(item)">
                                    <span class="cm-card__bar cm-card__bar--review" aria-hidden="true"></span>
                                    <span class="cm-card__body">
                                        <span class="cm-kicker">@item.CampaignName · @ArtifactDisplay.KindLabel(item.Kind)</span>
                                        <span class="cm-card__title">@item.Title</span>
                                        <span class="cm-meta">
                                            Updated @ArtifactDisplay.Ago(item.UpdatedAt, Now)
                                        </span>
                                    </span>
                                    <span class="@ArtifactDisplay.StatusModifier(item.Status)">
                                        @ArtifactDisplay.StatusLabel(item.Status)
                                    </span>
                                </button>
                            </li>
                        }
                    </ul>
                }
            </section>

            <aside class="cm-front__secondary">
                <section>
                    <h2 class="cm-front__block-title">On the wire this week</h2>
                    @* The Wire's own data source arrives with F8; until then this block says
                       so rather than inventing rows. *@
                    <p class="cm-meta">Scheduling arrives with the Wire (Phase F8).</p>
                </section>

                <section>
                    <h2 class="cm-front__block-title">Drafts aging</h2>
                    @if (_aging.Count == 0)
                    {
                        <p class="cm-meta">No draft has been sitting long enough to worry about.</p>
                    }
                    else
                    {
                        <ul class="cm-rows">
                            @foreach (var item in _aging)
                            {
                                <li class="cm-row">
                                    <span class="cm-row__label">@item.Title</span>
                                    <span class="cm-meta">@ArtifactDisplay.Ago(item.UpdatedAt, Now)</span>
                                </li>
                            }
                        </ul>
                    }
                </section>

                <section>
                    <h2 class="cm-front__block-title">Image slots waiting</h2>
                    @if (_emptySlots == 0)
                    {
                        <p class="cm-meta">Every reserved slot is filled.</p>
                    }
                    else
                    {
                        <p class="cm-front__slots">
                            <span class="cm-mono cm-front__slot-count">@_emptySlots</span>
                            <span class="cm-meta">
                                empty across @_campaignsWithSlots
                                @(_campaignsWithSlots == 1 ? "campaign" : "campaigns")
                            </span>
                        </p>
                        <ul class="cm-chips">
                            @foreach (var model in _slotModels)
                            {
                                <li><span class="cm-chip cm-mono">@model</span></li>
                            }
                        </ul>
                        @if (_firstSlotCampaign is { } target)
                        {
                            <a class="cm-meta" href="@CampaignViews.PathFor(target, CampaignView.ImageStudio)">
                                Open image studio &rarr;
                            </a>
                        }
                    }
                </section>
            </aside>
        </div>
    }
</div>
</div>

@code {
    private readonly List<DashboardArtifact> _review = [];
    private readonly List<DashboardArtifact> _aging = [];
    private readonly List<string> _slotModels = [];

    private int _emptySlots;
    private int _campaignsWithSlots;
    private Guid? _firstSlotCampaign;
    private bool _loaded;

    private static DateTimeOffset Now => DateTimeOffset.Now;

    protected override void OnInitialized() => Workspace.Changed += OnChanged;

    protected override async Task OnInitializedAsync()
    {
        await Workspace.LoadAsync();
        await LoadDashboardAsync();
    }

    /// <summary>One server-side projection instead of a preview fetch per campaign —
    /// the old N+1 was this page's whole G4 budget once campaigns accumulated.</summary>
    private async Task LoadDashboardAsync()
    {
        try
        {
            var dashboard = await Campaigns.GetDashboardAsync();

            _review.Clear();
            _review.AddRange(dashboard.ReviewQueue);
            _aging.Clear();
            _aging.AddRange(dashboard.AgingDrafts);
            _slotModels.Clear();
            _slotModels.AddRange(dashboard.EmptySlotModels);
            _emptySlots = dashboard.EmptySlots;
            _campaignsWithSlots = dashboard.CampaignsWithEmptySlots;
            _firstSlotCampaign = dashboard.FirstEmptySlotCampaign;
        }
        catch (ApiException)
        {
            // The blocks render their empty states; the workspace itself already loaded.
        }
        catch (HttpRequestException)
        {
        }

        _loaded = true;
        StateHasChanged();
    }

    private void OpenFocus(DashboardArtifact item)
    {
        Workspace.SetActive(item.CampaignId);
        Navigation.NavigateTo(
            $"{CampaignViews.PathFor(item.CampaignId, CampaignView.Focus)}?artifact={item.ArtifactId}");
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Workspace.Changed -= OnChanged;
}
