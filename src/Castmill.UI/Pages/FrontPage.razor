@* Front page (workspace scope): what needs a human today.
   Four blocks from the handoff §1 — ready for review, on the wire, drafts aging, and image
   slots waiting. The last one exists because empty image slots were otherwise invisible
   until publish time (G9). *@
@page "/"
@using Castmill.Core
@using Castmill.Core.Resources
@using Castmill.UI.Design
@using Castmill.UI.Http
@using Castmill.UI.State
@implements IDisposable
@inject WorkspaceState Workspace
@inject CampaignsClient Campaigns
@inject ScheduleClient Schedule
@inject NavigationManager Navigation

<PageTitle>Front page — Castmill</PageTitle>

<div class="cm-page cm-page--fill"><div class="cm-measure--dashboard cm-front__frame">
    <header class="cm-front__head">
        <div>
            <span class="cm-kicker">Front page</span>
            <h1>What needs you today.</h1>
        </div>
    </header>

    @if (!Workspace.IsLoaded)
    {
        <p class="cm-meta">Loading your workspace…</p>
    }
    else if (Workspace.LoadError is { } error)
    {
        <EmptyState Kicker="Workspace" Headline="Couldn't load your campaigns." Detail="@error" />
    }
    else if (Workspace.Campaigns.Count == 0)
    {
        <EmptyState Kicker="Workspace"
                    Headline="Nothing has come off the press yet."
                    Detail="A campaign starts from one source asset — a video, a podcast, a webinar or a transcript — and fans out into everything else.">
            <Action>
                <a class="cm-button" href="campaigns/new">Start a run</a>
            </Action>
        </EmptyState>
    }
    else
    {
        <div class="cm-front">
            <section class="cm-front__primary cm-review-desk" aria-labelledby="cm-review-desk-title">
                <header class="cm-review-desk__head">
                    <div>
                        <span class="cm-kicker">Editorial workflow</span>
                        <h2 class="cm-front__block-title" id="cm-review-desk-title">Review desk</h2>
                    </div>
                    <span class="cm-meta">@ReviewDescription</span>
                </header>

                <div class="cm-review-bins" role="tablist" aria-label="Content review state">
                    @foreach (var bin in ReviewBins)
                    {
                        <button type="button" role="tab"
                                class="cm-review-bin @(_reviewStatus == bin.Status ? "cm-review-bin--active" : null)"
                                aria-selected="@(_reviewStatus == bin.Status ? "true" : "false")"
                                @onclick="() => SelectReviewStatusAsync(bin.Status)">
                            <span class="cm-review-bin__label">@bin.Label</span>
                            <span class="cm-review-bin__count cm-mono">@ReviewCount(bin.Status)</span>
                        </button>
                    }
                </div>

                @if (_reviewLoading && ReviewItems.Count == 0)
                {
                    <p class="cm-loading-line" role="status">
                        <span class="cm-ai-dot" aria-hidden="true"></span>
                        Loading @ReviewBinLabel.ToLowerInvariant()…
                    </p>
                }
                else if (_reviewError is { } reviewError)
                {
                    <p class="cm-form__error" role="alert">@reviewError</p>
                }
                else if (ReviewItems.Count == 0)
                {
                    <p class="cm-meta cm-review-desk__empty">@ReviewEmptyMessage</p>
                }
                else
                {
                    <ul class="cm-cards cm-review-desk__list" data-cm-scroll>
                        @foreach (var item in ReviewItems)
                        {
                            <li>
                                @* A row, not a giant click target: the actions are explicit
                                   buttons because "what happens if I click this card" was
                                   previously guesswork. *@
                                <div class="cm-card cm-card--artifact cm-front__item">
                                    <span class="cm-card__bar @ArtifactDisplay.StatusBarModifier(item.Status)" aria-hidden="true"></span>
                                    <span class="cm-card__body">
                                        <span class="cm-kicker">@item.CampaignName · @ArtifactDisplay.KindLabel(item.Kind)</span>
                                        <span class="cm-card__title">@item.Title</span>
                                        <span class="cm-meta">Updated @ArtifactDisplay.Ago(item.UpdatedAt, Now)</span>
                                    </span>
                                    <span class="@ArtifactDisplay.StatusModifier(item.Status)">
                                        @ArtifactDisplay.StatusLabel(item.Status)
                                    </span>
                                    <span class="cm-front__item-actions">
                                        <button type="button" class="cm-button cm-button--quiet"
                                            @onclick="() => OpenFocus(item)">@ReviewActionLabel(item.Status)</button>
                                        <button type="button" class="cm-button cm-button--quiet"
                                                @onclick="() => OpenCampaign(item)">Campaign</button>
                                    </span>
                                </div>
                            </li>
                        }
                    </ul>
                }

                @if (ReviewItems.Count < ReviewTotal)
                {
                    <button type="button" class="cm-button cm-button--quiet cm-review-desk__more"
                            disabled="@_reviewLoading" @onclick="LoadMoreReviewAsync">
                        @(_reviewLoading ? "Loading more…" : $"Show more · {ReviewTotal - ReviewItems.Count} remaining")
                    </button>
                }
            </section>

            <aside class="cm-front__secondary">
                <section>
                    <h2 class="cm-front__block-title">
                        Slated for socials
                        @if (_wire.Count > 0)
                        {
                            <span class="cm-mono cm-meta">(@_wire.Count)</span>
                        }
                    </h2>
                    @* Reads the schedule mirror we already own (ADR-016), not a broker
                       round-trip — the same source the Wire draws from. *@
                    @if (!_wireLoaded)
                    {
                        <p class="cm-meta">Checking the schedule…</p>
                    }
                    else if (_wire.Count == 0)
                    {
                        <p class="cm-meta">
                            Nothing is scheduled for the next seven days.
                            <a href="wire">Open the Wire &rarr;</a>
                        </p>
                    }
                    else
                    {
                        <ul class="cm-rows">
                            @foreach (var post in _wire)
                            {
                                <li class="cm-row">
                                    <span class="cm-row__label">
                                        <span class="cm-mono cm-meta">@post.ChannelId</span>
                                        @Excerpt(post.Text)
                                    </span>
                                    <span class="cm-meta">@post.ScheduledAt.ToLocalTime().ToString("ddd HH:mm")</span>
                                </li>
                            }
                        </ul>
                        <a class="cm-meta" href="wire">Open the Wire &rarr;</a>
                    }
                </section>

                <section class="cm-front__aging">
                    <h2 class="cm-front__block-title">Drafts aging</h2>
                    @if (_aging.Count == 0)
                    {
                        <p class="cm-meta">No draft has been sitting long enough to worry about.</p>
                    }
                    else
                    {
                        <ul class="cm-rows cm-front__aging-list" data-cm-scroll>
                            @foreach (var item in _aging)
                            {
                                <li class="cm-row">
                                    <span class="cm-row__label" title="@item.Title">@item.Title</span>
                                    <span class="cm-meta cm-row__age">@ArtifactDisplay.Ago(item.UpdatedAt, Now)</span>
                                    <button type="button" class="cm-button cm-button--quiet cm-row__action"
                                            aria-label="Edit @item.Title"
                                            @onclick="() => OpenFocus(item)">
                                        Edit
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                </section>

                <section>
                    <h2 class="cm-front__block-title">Image slots waiting</h2>
                    @if (_emptySlots == 0)
                    {
                        <p class="cm-meta">Every reserved slot is filled.</p>
                    }
                    else
                    {
                        <p class="cm-front__slots">
                            <span class="cm-mono cm-front__slot-count">@_emptySlots</span>
                            <span class="cm-meta">
                                empty across @_campaignsWithSlots
                                @(_campaignsWithSlots == 1 ? "campaign" : "campaigns")
                            </span>
                        </p>
                        <ul class="cm-chips">
                            @foreach (var model in _slotModels)
                            {
                                <li><span class="cm-chip cm-mono">@model</span></li>
                            }
                        </ul>
                        @if (_firstSlotCampaign is { } target)
                        {
                            <a class="cm-meta" href="@CampaignViews.PathFor(target, CampaignView.ImageStudio)">
                                Open image studio &rarr;
                            </a>
                        }
                    }
                </section>
            </aside>
        </div>
    }
</div>
</div>

@code {
    private const int ReviewPageSize = 12;
    private sealed record ReviewBin(string Status, string Label);
    private static readonly ReviewBin[] ReviewBins =
    [
        new(ArtifactStatus.Draft, "Drafts"),
        new(ArtifactStatus.InReview, "Needs review"),
        new(ArtifactStatus.Queued, "Reviewed"),
        new(ArtifactStatus.Published, "Published"),
    ];

    private readonly Dictionary<string, List<DashboardArtifact>> _reviewPages =
        new(StringComparer.Ordinal);
    private ReviewDeskCounts _reviewCounts = new(0, 0, 0, 0);
    private string _reviewStatus = ArtifactStatus.InReview;
    private bool _reviewLoading;
    private string? _reviewError;
    private int _reviewRequestVersion;
    private readonly List<DashboardArtifact> _aging = [];
    private readonly List<string> _slotModels = [];
    private readonly List<ScheduleEntryResponse> _wire = [];
    private bool _wireLoaded;

    private List<DashboardArtifact> ReviewItems =>
        _reviewPages.GetValueOrDefault(_reviewStatus) ?? [];

    private int ReviewTotal => ReviewCount(_reviewStatus);

    private string ReviewBinLabel =>
        ReviewBins.Single(bin => bin.Status == _reviewStatus).Label;

    private string ReviewDescription => _reviewStatus switch
    {
        ArtifactStatus.Draft => "Work in progress that has not been submitted.",
        ArtifactStatus.InReview => "Submitted content waiting for your decision.",
        ArtifactStatus.Queued => "Reviewed content ready for scheduling or publishing.",
        ArtifactStatus.Published => "Content that has already shipped.",
        _ => string.Empty,
    };

    private string ReviewEmptyMessage => _reviewStatus switch
    {
        ArtifactStatus.Draft => "No drafts are waiting in the workspace.",
        ArtifactStatus.InReview => "Nothing needs review right now.",
        ArtifactStatus.Queued => "Nothing has been marked reviewed yet.",
        ArtifactStatus.Published => "Nothing has been published yet.",
        _ => "Nothing is in this state.",
    };

    private int _emptySlots;
    private int _campaignsWithSlots;
    private Guid? _firstSlotCampaign;

    private static DateTimeOffset Now => DateTimeOffset.Now;

    protected override void OnInitialized() => Workspace.Changed += OnChanged;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            Workspace.LoadAsync(),
            LoadDashboardAsync(),
            LoadWireAsync());
    }

    /// <summary>One server-side projection instead of a preview fetch per campaign —
    /// the old N+1 was this page's whole G4 budget once campaigns accumulated.</summary>
    private async Task LoadDashboardAsync()
    {
        try
        {
            var dashboard = await Campaigns.GetDashboardAsync();

            _reviewCounts = dashboard.ReviewCounts
                ?? new ReviewDeskCounts(
                    dashboard.AgingDrafts.Count,
                    dashboard.ReviewQueue.Count,
                    dashboard.ReadyToSchedule?.Count ?? 0,
                    0);
            _reviewPages[ArtifactStatus.InReview] =
                [.. dashboard.ReviewQueue.Where(item => ArtifactDisplay.Editable(item.Kind))];
            _aging.Clear();
            _aging.AddRange(dashboard.AgingDrafts);
            _slotModels.Clear();
            _slotModels.AddRange(dashboard.EmptySlotModels);
            _emptySlots = dashboard.EmptySlots;
            _campaignsWithSlots = dashboard.CampaignsWithEmptySlots;
            _firstSlotCampaign = dashboard.FirstEmptySlotCampaign;
        }
        catch (ApiException)
        {
            // The blocks render their empty states; the workspace itself already loaded.
        }
        catch (HttpRequestException)
        {
        }

        StateHasChanged();
    }

    private async Task SelectReviewStatusAsync(string status)
    {
        _reviewStatus = status;
        _reviewError = null;
        if (!_reviewPages.ContainsKey(status))
        {
            await LoadReviewPageAsync(status, append: false);
        }
    }

    private Task LoadMoreReviewAsync() => LoadReviewPageAsync(_reviewStatus, append: true);

    private async Task LoadReviewPageAsync(string status, bool append)
    {
        var version = ++_reviewRequestVersion;
        _reviewLoading = true;
        _reviewError = null;
        StateHasChanged();
        try
        {
            var items = append && _reviewPages.TryGetValue(status, out var existing)
                ? existing
                : [];
            var page = await Campaigns.GetReviewDeskAsync(
                status, append ? items.Count : 0, ReviewPageSize);
            if (version != _reviewRequestVersion || _reviewStatus != status)
            {
                return;
            }

            if (!append)
            {
                items = [];
                _reviewPages[status] = items;
            }
            items.AddRange(page.Items.Where(item => ArtifactDisplay.Editable(item.Kind)));
            SetReviewCount(status, page.Total);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            if (version == _reviewRequestVersion)
            {
                _reviewError = "This review bin couldn't be loaded.";
            }
        }
        finally
        {
            if (version == _reviewRequestVersion)
            {
                _reviewLoading = false;
                StateHasChanged();
            }
        }
    }

    private int ReviewCount(string status) => status switch
    {
        ArtifactStatus.Draft => _reviewCounts.Draft,
        ArtifactStatus.InReview => _reviewCounts.InReview,
        ArtifactStatus.Queued => _reviewCounts.Reviewed,
        ArtifactStatus.Published => _reviewCounts.Published,
        _ => 0,
    };

    private void SetReviewCount(string status, int value)
    {
        _reviewCounts = status switch
        {
            ArtifactStatus.Draft => _reviewCounts with { Draft = value },
            ArtifactStatus.InReview => _reviewCounts with { InReview = value },
            ArtifactStatus.Queued => _reviewCounts with { Reviewed = value },
            ArtifactStatus.Published => _reviewCounts with { Published = value },
            _ => _reviewCounts,
        };
    }

    private static string ReviewActionLabel(string status) => status switch
    {
        ArtifactStatus.InReview => "Review",
        ArtifactStatus.Draft => "Edit",
        _ => "Open",
    };

    private async Task LoadWireAsync()
    {
        try
        {
            var now = DateTimeOffset.Now;
            _wire.Clear();
            _wire.AddRange((await Schedule.ListAsync(now, now.AddDays(7)))
                .Where(e => !string.Equals(e.Status, "Cancelled", StringComparison.OrdinalIgnoreCase))
                .OrderBy(e => e.ScheduledAt)
                .Take(6));
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            // The block renders its empty state; a missing broker must not blank the page.
        }

        _wireLoaded = true;
        StateHasChanged();
    }

    private static string Excerpt(string text) =>
        text.Length <= 60 ? text : string.Concat(text.AsSpan(0, 59), "…");

    private void OpenCampaign(DashboardArtifact item)
    {
        Workspace.SetActive(item.CampaignId);
        Navigation.NavigateTo(CampaignViews.PathFor(item.CampaignId, CampaignView.MillFloor));
    }

    private void OpenFocus(DashboardArtifact item)
    {
        Workspace.SetActive(item.CampaignId);
        Navigation.NavigateTo(
            $"{CampaignViews.PathFor(item.CampaignId, CampaignView.Focus)}?artifact={item.ArtifactId}");
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Workspace.Changed -= OnChanged;
}
