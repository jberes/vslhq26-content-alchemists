@* Campaigns index: the card grid the rail links to past its listing limit (handoff §2).

   The design's card carries a duotone media band and a kicker like "Webinar · 58:12". Source
   media is not modelled on the campaign server-side yet, so the band is a placeholder
   treatment and the kicker reports what we actually know — artifact and image counts —
   rather than inventing a duration. *@
@page "/campaigns"
@using Castmill.Core
@using Castmill.Core.Resources
@using Castmill.UI.Design
@using Castmill.UI.Http
@using Castmill.UI.State
@implements IDisposable
@inject WorkspaceState Workspace
@inject CampaignsClient Campaigns
@inject NavigationManager Navigation
@inject IConfirmService Confirm
@inject INotifier Notifier

<PageTitle>Campaigns — Castmill</PageTitle>

<div class="cm-page"><div class="cm-measure--dashboard">
    @* Starting a run is reachable from the page itself, not only from the rail: the rail is
       collapsible, and a producer working with it shut had no way in from here. *@
    <header class="cm-front__head cm-front__head--actions">
        <div>
            <span class="cm-kicker">Workspace</span>
            <h1>Campaigns</h1>
        </div>
        <a class="cm-button" href="campaigns/new">Start a run</a>
    </header>

    @if (!Workspace.IsLoaded)
    {
        <p class="cm-meta">Loading campaigns…</p>
    }
    else if (Workspace.Campaigns.Count == 0)
    {
        <EmptyState Kicker="Campaigns"
                    Headline="No campaigns yet."
                    Detail="Every campaign starts from one source asset and fans out from there.">
            <Action>
                <a class="cm-button" href="campaigns/new">Start a run</a>
            </Action>
        </EmptyState>
    }
    else
    {
        <ul class="cm-campaign-grid">
            @foreach (var campaign in Workspace.Campaigns.OrderByDescending(c => c.UpdatedAt))
            {
                var summary = _summaries.GetValueOrDefault(campaign.Id);
                <li class="cm-campaign-cell @(_deleting == campaign.Id ? "cm-campaign-cell--deleting" : null)"
                    aria-busy="@(_deleting == campaign.Id ? "true" : "false")">
                    @* The delete control is a SIBLING of the card, not a child: the card is
                       itself a button, and a button inside a button is invalid HTML that
                       swallows the inner click. *@
                    <button type="button" class="cm-campaign-card__delete"
                            title="@($"Delete {campaign.Name}")"
                            aria-label="@($"Delete campaign {campaign.Name}")"
                            disabled="@(_deleting == campaign.Id)"
                            @onclick="() => DeleteAsync(campaign)">
                        @if (_deleting == campaign.Id)
                        {
                            <span aria-hidden="true">…</span>
                        }
                        else
                        {
                            <AppIcon Name="trash" />
                        }
                    </button>
                    <button type="button" class="cm-campaign-card" @onclick="() => Open(campaign)">
                        @if (summary?.HeroImageUrl is { } hero)
                        {
                            @* The campaign's most recently placed image — reference only, so
                               cover-cropping into the band is fine. *@
                            <img class="cm-campaign-card__band cm-campaign-card__band--image"
                                 src="@hero" alt="" loading="lazy" decoding="async" />
                        }
                        else
                        {
                            @* Duotone placeholder band — the design's treatment when the
                               campaign has no placed image yet. *@
                            <span class="cm-campaign-card__band cm-duotone" aria-hidden="true"></span>
                        }
                        <span class="cm-campaign-card__body">
                            <span class="cm-kicker">
                                @CampaignContentType.DisplayLabel(campaign.ContentType)
                                @if (summary is not null)
                                {
                                    <span> · @summary.Artifacts artifacts · @summary.Filled/@summary.Slots images</span>
                                }
                            </span>
                            <span class="cm-campaign-card__title">@campaign.Name</span>
                            <span class="cm-campaign-card__dates cm-meta">
                                <span>Added @campaign.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</span>
                                <span>Updated @ArtifactDisplay.Ago(campaign.UpdatedAt, DateTimeOffset.Now)</span>
                            </span>
                            @if (summary is not null)
                            {
                                <span class="cm-campaign-card__states" aria-label="Content workflow counts">
                                    <span class="cm-campaign-card__state">
                                        <span class="cm-status">Draft</span>
                                        <strong class="cm-mono">@summary.Draft</strong>
                                    </span>
                                    <span class="cm-campaign-card__state">
                                        <span class="cm-status cm-status--review">In review</span>
                                        <strong class="cm-mono">@summary.Review</strong>
                                    </span>
                                    <span class="cm-campaign-card__state">
                                        <span class="cm-status cm-status--queued">Reviewed</span>
                                        <strong class="cm-mono">@summary.Reviewed</strong>
                                    </span>
                                    <span class="cm-campaign-card__state">
                                        <span class="cm-status cm-status--published">Published</span>
                                        <strong class="cm-mono">@summary.Published</strong>
                                    </span>
                                </span>
                            }
                        </span>
                    </button>
                    @* A campaign delete cascades through artifacts, images and uploaded media,
                       so it is slow enough that the card must say what is happening. The
                       hover-revealed button was the only signal before, and the pointer is
                       rarely still on the card once the confirm dialog closes. No spinner
                       (ADR-F13): a single DELETE has no observable steps, so this is the
                       app's pulsing-dot vocabulary with the real work named. *@
                    @if (_deleting == campaign.Id)
                    {
                        <span class="cm-campaign-card__deleting" role="status">
                            <span class="cm-loading-line">
                                <span class="cm-ai-dot" aria-hidden="true"></span>
                                Deleting @campaign.Name…
                            </span>
                            <span class="cm-meta">@DeletingDetail(summary)</span>
                        </span>
                    }
                </li>
            }
        </ul>
    }
</div>
</div>

@code {
    private sealed record Summary(
        int Artifacts,
        int Draft,
        int Review,
        int Reviewed,
        int Published,
        int Filled,
        int Slots,
        string? HeroImageUrl);

    private readonly Dictionary<Guid, Summary> _summaries = [];
    private Guid? _deleting;

    protected override void OnInitialized() => Workspace.Changed += OnChanged;

    protected override async Task OnInitializedAsync()
    {
        await Workspace.LoadAsync();
        await LoadSummariesAsync();
    }

    /// <summary>One dashboard call carries every card's counters (was one preview per
    /// campaign — an N+1 whose payloads included every artifact preview and slot).</summary>
    private async Task LoadSummariesAsync()
    {
        try
        {
            var dashboard = await Campaigns.GetDashboardAsync();
            foreach (var counts in dashboard.Campaigns)
            {
                _summaries[counts.CampaignId] = new Summary(
                    counts.Artifacts,
                    counts.Draft,
                    counts.InReview,
                    counts.Reviewed,
                    counts.Published,
                    counts.ImagesFilled,
                    counts.ImagesTotal,
                    counts.HeroImageUrl);
            }
        }
        catch (ApiException)
        {
            // Cards render without counters; the campaign list itself already loaded.
        }
        catch (HttpRequestException)
        {
        }

        StateHasChanged();
    }

    private void Open(CampaignResponse campaign)
    {
        Workspace.SetActive(campaign.Id);
        Navigation.NavigateTo(CampaignViews.PathFor(campaign.Id, CampaignView.MillFloor));
    }

    /// <summary>
    /// Deletes the campaign and everything made from it. The prompt names the real counts
    /// rather than saying "all content", and requires the campaign's name to be typed: this
    /// destroys work irreversibly, including the uploaded source media, and a card grid is
    /// exactly where a stray click lands.
    /// </summary>
    /// <summary>Names what the cascade is removing, so a slow delete reads as work rather
    /// than as a hang. Falls back to prose when the summary never loaded.</summary>
    private static string DeletingDetail(Summary? summary) =>
        summary is null
            ? "Removing its artifacts, images and uploaded media."
            : $"Removing {Plural(summary.Artifacts, "artifact")}, "
              + $"{Plural(summary.Filled, "generated image")} and the uploaded media.";

    private async Task DeleteAsync(CampaignResponse campaign)
    {
        var summary = _summaries.GetValueOrDefault(campaign.Id);
        var trail = summary is null
            ? "Every artifact, image and uploaded source file made from it goes too."
            : $"{Plural(summary.Artifacts, "artifact")}, {Plural(summary.Filled, "generated image")} "
              + "and the uploaded source media go with it.";

        if (!await Confirm.ConfirmAsync(new ConfirmRequest(
            Title: $"Delete {campaign.Name}?",
            Message: $"{trail} This cannot be undone.",
            AcceptLabel: "Delete campaign",
            Destructive: true,
            RequirePhrase: campaign.Name)))
        {
            return;
        }

        _deleting = campaign.Id;
        StateHasChanged();
        try
        {
            await Campaigns.DeleteAsync(campaign.Id);
            _summaries.Remove(campaign.Id);
            // Reloads the list and clears the active campaign if it was this one, so the rail
            // and any open view do not keep pointing at a campaign that no longer exists.
            Workspace.Remove(campaign.Id);
            Notifier.ShowSuccess($"Deleted {campaign.Name}.");
        }
        catch (ApiException ex)
        {
            Notifier.ShowError($"Couldn't delete {campaign.Name}: {ex.Message}");
        }
        catch (HttpRequestException)
        {
            Notifier.ShowError("Couldn't reach the Castmill API.");
        }
        finally
        {
            _deleting = null;
            StateHasChanged();
        }
    }

    private static string Plural(int count, string noun) =>
        count == 1 ? $"1 {noun}" : $"{count} {noun}s";

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Workspace.Changed -= OnChanged;
}
