@* Brands index (workspace scope). Each brand is a steering kit for generation: voice,
   palette, image style, reference assets and per-kind templates. Campaigns pick one (or
   None) and every generator run reads it through the server's BrandContextService. *@
@page "/brands"
@using Castmill.Core.Resources
@using Castmill.UI.Design
@using Castmill.UI.Http
@inject BrandsClient BrandsApi
@inject IConfirmService Confirm
@inject INotifier Notifier
@inject NavigationManager Navigation

<PageTitle>Brands — Castmill</PageTitle>

<div class="cm-page"><div class="cm-measure--dashboard">
    <header class="cm-front__head">
        <span class="cm-kicker">Brands</span>
        <h1>Steering kits for everything you print.</h1>
    </header>

    @if (!_loaded)
    {
        <p class="cm-meta">Loading brands…</p>
    }
    else if (_error is { } error)
    {
        <EmptyState Kicker="Brands" Headline="Couldn't load brands." Detail="@error" />
    }
    else if (_brands.Count == 0)
    {
        <EmptyState Kicker="Brands"
                    Headline="No brands yet."
                    Detail="A brand carries the voice, colours, image style, faces and templates that steer generation. Campaigns pick a brand — or none.">
            <Action>
                <div class="cm-brand-start__row">
                    <input class="cm-input" type="url" placeholder="https://your-brand.com"
                           aria-label="Brand website to look up" disabled="@_looking"
                           @bind="_lookupUrl" @bind:event="oninput" />
                    <button type="button" class="cm-button"
                            disabled="@(_looking || string.IsNullOrWhiteSpace(_lookupUrl))"
                            @onclick="LookupAsync">
                        @(_looking ? "Reading the site…" : "Create from URL")
                    </button>
                    <button type="button" class="cm-button cm-button--quiet" @onclick="CreateAsync">Start blank</button>
                </div>
                @if (_lookupError is { } emptyError)
                {
                    <p class="cm-form__error" role="alert">@emptyError</p>
                }
            </Action>
        </EmptyState>
    }
    else
    {
        @* Start from the brand's own website. The lookup drafts a style card and hands it to
           the editor — it never saves, because a brand steers every generator and that has to
           be a human's call. *@
        <div class="cm-brand-start">
            <div class="cm-brand-start__row">
                <input class="cm-input" type="url" placeholder="https://your-brand.com"
                       aria-label="Brand website to look up"
                       disabled="@_looking"
                       @bind="_lookupUrl" @bind:event="oninput"
                       @onkeydown="@(e => { if (e.Key == "Enter") { _ = LookupAsync(); } })" />
                <button type="button" class="cm-button"
                        disabled="@(_looking || string.IsNullOrWhiteSpace(_lookupUrl))"
                        @onclick="LookupAsync">
                    @(_looking ? "Reading the site…" : "New brand from URL")
                </button>
                <button type="button" class="cm-button cm-button--quiet" disabled="@_looking"
                        @onclick="CreateAsync">
                    Start blank
                </button>
            </div>
            @if (_lookupError is { } lookupError)
            {
                <p class="cm-form__error" role="alert">@lookupError</p>
            }
            else
            {
                <p class="cm-meta">
                    Reads the page and drafts voice, audience, palette, fonts and image style.
                    You review everything before it is saved.
                </p>
            }
        </div>

        <ul class="cm-campaign-grid">
            @foreach (var brand in _brands)
            {
                <li>
                    <div class="cm-brand-card">
                        <button type="button" class="cm-brand-card__open" @onclick="() => Open(brand.Id)">
                            <span class="cm-kicker">@(brand.IsOwner ? "Brand" : "Shared brand")</span>
                            <span class="cm-campaign-card__title">@brand.Name</span>
                            @if (!string.IsNullOrWhiteSpace(brand.StyleCard?.Voice))
                            {
                                <span class="cm-meta cm-brand-card__voice">@Excerpt(brand.StyleCard.Voice)</span>
                            }
                            @if (brand.StyleCard?.Colors is { Count: > 0 } colors)
                            {
                                <span class="cm-brand-card__swatches" aria-label="Brand colours">
                                    @foreach (var color in colors.Take(6))
                                    {
                                        <span class="cm-brand-card__swatch" title="@color.Role"
                                              style="background:@color.Hex"></span>
                                    }
                                </span>
                            }
                            <span class="cm-meta">Updated @Castmill.UI.State.ArtifactDisplay.Ago(brand.UpdatedAt, DateTimeOffset.Now)</span>
                        </button>
                        @if (brand.IsOwner)
                        {
                            <button type="button" class="cm-tree__delete" aria-label="Delete @brand.Name"
                                @onclick="() => DeleteAsync(brand)"><AppIcon Name="trash" /></button>
                        }
                    </div>
                </li>
            }
        </ul>
    }
</div></div>

@code {
    private readonly List<BrandProfileDetailResponse> _brands = [];
    private bool _loaded;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            var brands = await BrandsApi.ListAsync();
            _brands.Clear();
            _brands.AddRange(brands);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch (HttpRequestException)
        {
            _error = "Couldn't reach the Castmill API.";
        }

        _loaded = true;
    }

    private string _lookupUrl = string.Empty;
    private bool _looking;
    private string? _lookupError;

    /// <summary>
    /// Drafts from the URL, creates the brand with what came back, and opens the editor. The
    /// draft is saved as a starting point rather than held in memory so a slow read is not
    /// lost to a stray navigation — the user edits a real row from there.
    /// </summary>
    private async Task LookupAsync()
    {
        if (string.IsNullOrWhiteSpace(_lookupUrl))
        {
            return;
        }

        _looking = true;
        _lookupError = null;
        try
        {
            var draft = await BrandsApi.LookupAsync(_lookupUrl.Trim());
            var brand = await BrandsApi.CreateAsync(draft.Name, draft.StyleCard);

            foreach (var note in draft.Notes)
            {
                Notifier.ShowWarning(note);
            }
            Notifier.ShowSuccess($"Drafted {draft.Name} from {draft.SourceUrl} — review it before using it.");
            Navigation.NavigateTo($"brands/{brand.Id}");
        }
        catch (ApiException ex)
        {
            _lookupError = ex.Message;
        }
        catch (HttpRequestException)
        {
            _lookupError = "Couldn't reach the Castmill API.";
        }
        finally
        {
            _looking = false;
        }
    }

    private async Task CreateAsync()
    {
        try
        {
            var brand = await BrandsApi.CreateAsync("New brand", null);
            Navigation.NavigateTo($"brands/{brand.Id}");
        }
        catch (ApiException ex)
        {
            Notifier.ShowError(ex.Message);
        }
    }

    private void Open(Guid id) => Navigation.NavigateTo($"brands/{id}");

    private async Task DeleteAsync(BrandProfileDetailResponse brand)
    {
        var accepted = await Confirm.ConfirmAsync(new ConfirmRequest(
            $"Delete \"{brand.Name}\"?",
            "Its templates and asset links go with it; campaigns using it fall back to no brand. This cannot be undone.",
            AcceptLabel: "Delete brand",
            Destructive: true));

        if (!accepted)
        {
            return;
        }

        try
        {
            await BrandsApi.DeleteAsync(brand.Id);
            _brands.RemoveAll(b => b.Id == brand.Id);
            Notifier.ShowSuccess($"Deleted \"{brand.Name}\".");
        }
        catch (ApiException ex)
        {
            Notifier.ShowError(ex.Message);
        }
    }

    private static string Excerpt(string value) =>
        value.Length <= 140 ? value : value[..140] + "…";
}
