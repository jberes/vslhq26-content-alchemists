@* The Wire renders the schedule mirror first, then reconciles after first paint. *@
@page "/wire"
@using Castmill.Core
@using Castmill.Core.Ai
@using Castmill.Core.Resources
@using Castmill.UI.Design
@using Castmill.UI.Http
@using Castmill.UI.Publishing
@using Castmill.UI.State
@inject CampaignsClient Campaigns
@inject ScheduleClient Schedule
@inject PublishClient Publish
@inject WorkspaceState Workspace
@inject NavigationManager Navigation
@inject INotifier Notifier

<PageTitle>The Wire — Castmill</PageTitle>

<div class="cm-page cm-page--fill"><div class="cm-measure--dashboard cm-front__frame">
    <header class="cm-front__head cm-wire__title">
        <div>
            <span class="cm-kicker">The Wire</span>
            <h1>@PeriodLabel</h1>
        </div>
        <div class="cm-wire__broker">
            @if (_brokerChecking)
            {
                <span class="cm-meta" role="status">Checking publishing readiness…</span>
            }
            else
            {
                <span class="@((_readiness?.Ready ?? false) ? "cm-status cm-status--queued" : "cm-status")">
                    @((_readiness?.Ready ?? false) ? "Broker ready" : "Local mirror")
                </span>
                <span class="cm-meta">@_brokerDetail</span>
            }
        </div>
    </header>

    @if (!_loaded)
    {
        <p class="cm-meta">Loading the schedule mirror…</p>
    }
    else
    {
        <div class="cm-wire">
            <aside class="cm-wire__queue cm-region">
                <div class="cm-wire__queue-head">
                    <div>
                        <span class="cm-kicker">Reviewed</span>
                        <h2 class="cm-front__block-title">Ready to schedule</h2>
                    </div>
                    <span class="cm-mono cm-meta">@_queue.Count</span>
                </div>
                @if (_queue.Count == 0)
                {
                    <p class="cm-meta">
                        Nothing is waiting for a slot. Distribution artifacts land here after review.
                    </p>
                }
                else
                {
                    <ul class="cm-rows">
                        @foreach (var item in _queue)
                        {
                            <li class="cm-row cm-wire__queue-row">
                                <div class="cm-wire__queue-item">
                                    <span class="cm-row__label">@item.Title</span>
                                    <span class="cm-meta">
                                        @item.CampaignName · @ArtifactDisplay.KindLabel(item.Kind)
                                    </span>
                                </div>
                                <div class="cm-wire__queue-actions">
                                    @if (CanCompose(item))
                                    {
                                        <button type="button" class="cm-button" disabled="@(!_channelsResolved)"
                                            title="@(!_channelsResolved ? "Resolving publishing channels…" : null)"
                                            @onclick="() => Compose(item)">Compose</button>
                                    }
                                    <button type="button" class="cm-button cm-button--quiet"
                                            @onclick="() => OpenFocus(item)">Open</button>
                                </div>
                            </li>
                        }
                    </ul>
                }

                <div class="cm-wire__clip-state">
                    <span class="cm-kicker">Exported clips</span>
                    <p class="cm-meta">
                        Scheduling unlocks when an exported clip has a durable published URL.
                        Local file paths and short-lived worker download links are not sent to the broker.
                    </p>
                </div>
            </aside>

            <section class="cm-wire__week cm-region">
                <div class="cm-wire__week-head">
                    <div class="cm-segmented" role="group" aria-label="Schedule view">
                        <button type="button" class="cm-segmented__option" aria-pressed="@(_viewMode == "Week")"
                            @onclick="ShowWeekAsync">Week</button>
                        <button type="button" class="cm-segmented__option" aria-pressed="@(_viewMode == "Day")"
                            @onclick="ShowDayAsync">Day</button>
                    </div>
                    <div class="cm-segmented" role="group" aria-label="Schedule period">
                        <button type="button" class="cm-segmented__option" @onclick="() => ShiftPeriodAsync(-1)">← Previous</button>
                        <button type="button" class="cm-segmented__option" aria-pressed="@IsCurrentPeriod"
                                @onclick="() => ShiftPeriodAsync(0)">@(_viewMode == "Week" ? "This week" : "Today")</button>
                        <button type="button" class="cm-segmented__option" @onclick="() => ShiftPeriodAsync(1)">Next →</button>
                    </div>
                </div>

                <div class="cm-wire__filters" role="group" aria-label="Publishing status">
                    @foreach (var status in StatusFilters)
                    {
                        <button type="button" class="cm-wire__filter" aria-pressed="@(_statusFilter == status)"
                                @onclick="() => _statusFilter = status">
                            @status <span class="cm-mono">@StatusCount(status)</span>
                        </button>
                    }
                </div>

                @if (_loadError is { } error)
                {
                    <p class="cm-form__error" role="alert">@error</p>
                }

                <div class="cm-wire__days cm-scroll-x @(_viewMode == "Day" ? "cm-wire__days--day" : "")" data-cm-scroll>
                    @foreach (var day in Days)
                    {
                        var entries = FilteredEntries
                            .Where(e => e.ScheduledAt.ToLocalTime().Date == day.Date)
                            .OrderBy(e => e.ScheduledAt)
                            .ToList();

                        <div class="cm-wire__day @(day.Date == DateTimeOffset.Now.Date ? "cm-wire__day--today" : "")">
                            <span class="cm-kicker">@day.ToString("ddd d MMM")</span>
                            @if (entries.Count == 0)
                            {
                                <span class="cm-meta cm-wire__day-empty">No @(_statusFilter == "All" ? "posts" : _statusFilter.ToLowerInvariant() + " posts")</span>
                            }
                            else
                            {
                                <ul class="cm-wire__entries">
                                    @foreach (var entry in entries)
                                    {
                                        var platform = PlatformFor(entry.ChannelId);
                                        var limit = LimitFor(platform);
                                        <li class="cm-wire__entry">
                                            <span class="cm-mono cm-meta">
                                                @entry.ScheduledAt.ToLocalTime().ToString("HH:mm") · @ChannelLabel(entry.ChannelId)
                                            </span>
                                            <span class="cm-wire__entry-text">@Excerpt(entry.Text)</span>
                                            <span class="@StatusClass(entry.Status)">@entry.Status</span>
                                            @if (entry.Error is { Length: > 0 } entryError)
                                            {
                                                <span class="cm-form__error">@entryError</span>
                                            }

                                            <div class="cm-wire__entry-preview">
                                                <span class="cm-kicker">@platform preview</span>
                                                <p>@entry.Text</p>
                                                @if (limit is { } characterLimit)
                                                {
                                                    <span class="cm-mono cm-meta">@PlatformLimits.CharacterCount(entry.Text) / @characterLimit</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(entry.MediaUrl))
                                                {
                                                    <img src="@entry.MediaUrl" alt="Scheduled attachment" />
                                                }
                                            </div>

                                            @if (entry.Status != "Sent")
                                            {
                                                <div class="cm-wire__entry-actions">
                                                    <button type="button" class="cm-button cm-button--quiet"
                                                            disabled="@IsWorking(entry.Id)" @onclick="() => BeginMove(entry)">Move</button>
                                                    @if (entry.Status == "Error" && entry.BrokerPostId is null)
                                                    {
                                                        <button type="button" class="cm-button cm-button--quiet"
                                                                disabled="@(IsWorking(entry.Id) || !(_readiness?.CanSchedule ?? false))"
                                                                @onclick="() => RetryAsync(entry)">Retry</button>
                                                    }
                                                    <button type="button" class="cm-button cm-button--quiet"
                                                            disabled="@IsWorking(entry.Id)" @onclick="() => CancelAsync(entry)">Cancel</button>
                                                </div>
                                            }

                                            @if (_movingId == entry.Id)
                                            {
                                                <div class="cm-wire__move">
                                                    <InputDate class="cm-input" Type="InputDateType.DateTimeLocal" @bind-Value="_moveAt" />
                                                    <button type="button" class="cm-button" disabled="@IsWorking(entry.Id)"
                                                            @onclick="() => MoveAsync(entry)">Save move</button>
                                                </div>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                </div>
            </section>
        </div>
    }
</div></div>

@if (_composing is { } composing)
{
    <div class="cm-modal" role="presentation">
        <div class="cm-modal__panel cm-modal__panel--wide" role="dialog" aria-modal="true"
             aria-label="Publishing composer" @onclick:stopPropagation>
            <PublishingComposer Item="composing" Readiness="_readiness" Channels="_channels"
                                Closed="CloseComposer" Scheduled="ReloadAfterScheduleAsync" />
        </div>
    </div>
}

@code {
    private readonly List<ScheduleEntryResponse> _entries = [];
    private readonly List<DashboardArtifact> _queue = [];
    private readonly List<PublishChannel> _channels = [];
    private static readonly string[] StatusFilters = ["All", "Draft", "Queued", "Sent", "Error"];

    private bool _loaded;
    private bool _brokerChecking = true;
    private bool _channelsResolved;
    private string? _loadError;
    private string? _brokerDetail;
    private PublishReadinessResponse? _readiness;
    private DashboardArtifact? _composing;
    private Guid? _workingEntryId;
    private Guid? _movingId;
    private DateTime _moveAt;
    private string _viewMode = "Week";
    private string _statusFilter = "All";
    private int _weekOffset;
    private int _dayOffset;

    /// <summary>Monday of the displayed week, local time.</summary>
    private DateTimeOffset WeekStart
    {
        get
        {
            var today = DateTimeOffset.Now.Date;
            var sinceMonday = ((int)today.DayOfWeek + 6) % 7;
            return new DateTimeOffset(today.AddDays(-sinceMonday + (_weekOffset * 7)), DateTimeOffset.Now.Offset);
        }
    }

    private DateTimeOffset DayStart => new(DateTimeOffset.Now.Date.AddDays(_dayOffset), DateTimeOffset.Now.Offset);

    private IEnumerable<DateTimeOffset> Days => _viewMode == "Week"
        ? Enumerable.Range(0, 7).Select(i => WeekStart.AddDays(i))
        : [DayStart];

    private IEnumerable<ScheduleEntryResponse> FilteredEntries => _statusFilter == "All"
        ? _entries
        : _entries.Where(entry => entry.Status == _statusFilter);

    private bool IsCurrentPeriod => _viewMode == "Week" ? _weekOffset == 0 : _dayOffset == 0;

    private string PeriodLabel => _viewMode == "Day"
        ? DayStart.Date == DateTimeOffset.Now.Date
            ? "On the wire today."
            : DayStart.ToString("dddd, d MMMM")
        : _weekOffset switch
    {
        0 => "On the wire this week.",
        _ => $"The week of {WeekStart:d MMM}.",
    };

    protected override async Task OnInitializedAsync()
    {
        await Workspace.LoadAsync();
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ReconcileAfterFirstPaintAsync();
        }
    }

    private async Task SetViewAsync(string mode)
    {
        _viewMode = mode;
        await LoadAsync(loadQueue: false);
    }

    private Task ShowWeekAsync() => SetViewAsync("Week");

    private Task ShowDayAsync() => SetViewAsync("Day");

    private async Task ShiftPeriodAsync(int offset)
    {
        if (_viewMode == "Week")
        {
            _weekOffset = offset == 0 ? 0 : _weekOffset + offset;
        }
        else
        {
            _dayOffset = offset == 0 ? 0 : _dayOffset + offset;
        }
        await LoadAsync();
    }

    private async Task LoadAsync(bool loadQueue = true)
    {
        _loadError = null;
        var from = _viewMode == "Week" ? WeekStart : DayStart;
        var to = from.AddDays(_viewMode == "Week" ? 7 : 1);

        try
        {
            var entries = await Schedule.ListAsync(from, to);
            _entries.Clear();
            _entries.AddRange(entries);
        }
        catch (ApiException ex)
        {
            _loadError = ex.Message;
        }
        catch (HttpRequestException)
        {
            _loadError = "Couldn't reach the Castmill API.";
        }

        if (loadQueue)
        {
            try
            {
                var dashboard = await Campaigns.GetDashboardAsync();
                _queue.Clear();
                _queue.AddRange((dashboard.ReadyToSchedule ?? [])
                    .Where(item => ArtifactKinds.IsDistributionContent(item.Kind)));
            }
            catch (ApiException)
            {
                // The mirror still renders; the queue keeps its last known local state.
            }
            catch (HttpRequestException)
            {
            }
        }

        _loaded = true;
    }

    private async Task ReconcileAfterFirstPaintAsync()
    {
        try
        {
            _readiness = await Publish.GetReadinessAsync();
            _brokerDetail = _readiness.Detail;
            if (_readiness.Ready)
            {
                _channels.Clear();
                _channels.AddRange(await Publish.ListChannelsAsync());
                _channelsResolved = true;
                await InvokeAsync(StateHasChanged);
                var result = await Schedule.ReconcileAsync();
                _brokerDetail = result.UnreachableChannels.Count > 0
                    ? $"Mirror loaded. Broker could not reconcile {result.UnreachableChannels.Count} channel(s)."
                    : $"Mirror reconciled with the broker · {result.Updated} update(s).";
                await LoadAsync(loadQueue: false);
            }
            else
            {
                _channelsResolved = true;
            }
        }
        catch (ApiException ex)
        {
            _brokerDetail = $"The local mirror is available. {ex.Message}";
            _readiness = _readiness is null
                ? null
                : _readiness with { Ready = false, CanSchedule = false, Detail = _brokerDetail };
            _channelsResolved = true;
        }
        catch (HttpRequestException)
        {
            _brokerDetail = "The local mirror is available; broker readiness could not be checked.";
            _readiness = _readiness is null
                ? null
                : _readiness with { Ready = false, CanSchedule = false, Detail = _brokerDetail };
            _channelsResolved = true;
        }
        finally
        {
            _brokerChecking = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Compose(DashboardArtifact item) => _composing = item;

    private void CloseComposer() => _composing = null;

    private async Task ReloadAfterScheduleAsync() => await LoadAsync();

    private void OpenFocus(DashboardArtifact item)
    {
        Workspace.SetActive(item.CampaignId);
        Navigation.NavigateTo(
            $"{CampaignViews.PathFor(item.CampaignId, CampaignView.Focus)}?artifact={item.ArtifactId}");
    }

    private void BeginMove(ScheduleEntryResponse entry)
    {
        _movingId = entry.Id;
        _moveAt = entry.ScheduledAt.ToLocalTime().DateTime;
    }

    private async Task MoveAsync(ScheduleEntryResponse entry)
    {
        await RunEntryActionAsync(entry.Id, async () =>
        {
            var moved = await Schedule.MoveAsync(entry.Id, ToDateTimeOffset(_moveAt));
            _movingId = null;
            if (moved.Status == "Error")
            {
                Notifier.ShowError(moved.Error ?? "The broker rejected the move.");
            }
            else
            {
                Notifier.ShowSuccess("Schedule moved.");
            }
        });
    }

    private async Task RetryAsync(ScheduleEntryResponse entry)
    {
        await RunEntryActionAsync(entry.Id, async () =>
        {
            var retried = await Schedule.RetryAsync(entry.Id);
            if (retried.Status == "Error")
            {
                Notifier.ShowError(retried.Error ?? "The broker rejected the retry.");
            }
            else
            {
                Notifier.ShowSuccess("Post returned to the broker queue.");
            }
        });
    }

    private async Task CancelAsync(ScheduleEntryResponse entry)
    {
        await RunEntryActionAsync(entry.Id, async () =>
        {
            await Schedule.CancelAsync(entry.Id);
            Notifier.ShowSuccess(entry.BrokerPostId is null
                ? "Local schedule removed."
                : "Broker post cancelled and mirror entry removed.");
        });
    }

    private async Task RunEntryActionAsync(Guid id, Func<Task> action)
    {
        _workingEntryId = id;
        try
        {
            await action();
            await LoadAsync(loadQueue: false);
        }
        catch (ApiException ex)
        {
            Notifier.ShowError(ex.Message);
            await LoadAsync(loadQueue: false);
        }
        catch (HttpRequestException)
        {
            Notifier.ShowError("Couldn't reach the Castmill API.");
        }
        finally
        {
            _workingEntryId = null;
        }
    }

    private int StatusCount(string status) => status == "All"
        ? _entries.Count
        : _entries.Count(entry => entry.Status == status);

    private bool IsWorking(Guid id) => _workingEntryId == id;

    private string ChannelLabel(string channelId) =>
        _channels.FirstOrDefault(channel => channel.Id == channelId)?.Name ?? channelId;

    private string PlatformFor(string channelId) =>
        NormalizePlatform(_channels.FirstOrDefault(channel => channel.Id == channelId)?.Platform ?? channelId);

    private static int? LimitFor(string platform) =>
        PlatformLimits.MaxChars.TryGetValue(platform, out var limit) ? limit : null;

    private static bool CanCompose(DashboardArtifact item) =>
        item.Kind.StartsWith("social-", StringComparison.Ordinal)
        && ArtifactKinds.IsDistributionContent(item.Kind);

    private static DateTimeOffset ToDateTimeOffset(DateTime local) =>
        new(DateTime.SpecifyKind(local, DateTimeKind.Unspecified), TimeZoneInfo.Local.GetUtcOffset(local));

    private static string NormalizePlatform(string value)
    {
        var platform = value.Trim().ToLowerInvariant();
        if (platform is "twitter" or "twitter-x")
        {
            return "x";
        }

        return PlatformLimits.MaxChars.Keys.FirstOrDefault(key =>
            platform.Equals(key, StringComparison.Ordinal)
            || platform.Contains(key, StringComparison.Ordinal)) ?? platform;
    }

    private static string StatusClass(string status) => status switch
    {
        "Sent" => "cm-status cm-status--published",
        "Queued" => "cm-status cm-status--queued",
        "Error" => "cm-status cm-status--review",
        _ => "cm-status",
    };

    private static string Excerpt(string text) =>
        text.Length <= 90 ? text : text[..90].TrimEnd() + "…";
}
