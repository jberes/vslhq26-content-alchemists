@page "/wire"
@using System.Globalization
@using Castmill.Core.Resources
@using Castmill.UI.Design
@using Castmill.UI.Http
@using Castmill.UI.Scheduling
@using Castmill.UI.State
@inject CampaignsClient Campaigns
@inject ScheduleClient Schedule
@inject PublishClient Publish
@inject INotifier Notifier
@inject NavigationManager Navigation
@inject WorkspaceState Workspace
@inject TimeProvider Clock
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>The Wire — Castmill</PageTitle>

<div class="cm-page cm-page--fill">
    @if (_loading)
    {
        <section class="cm-run-show cm-run-show--loading" aria-label="Loading The Wire" aria-busy="true">
            @foreach (var row in Enumerable.Range(0, 7))
            {
                <span class="cm-run-show__skeleton" aria-hidden="true"></span>
            }
        </section>
    }
    else if (_data is not null)
    {
        <section @ref="_wireSurface" class="cm-run-show @(_view == WireViewMode.Pipeline ? "cm-run-show--pipeline" : null)"
                 aria-labelledby="cm-wire-title">
            <header class="cm-run-show__header">
                <div>
                    <span class="cm-run-show__kicker">@(_view == WireViewMode.Pipeline ? "The Wire · Pipeline" : "The Wire")</span>
                    <h1 id="cm-wire-title">@ViewTitle</h1>
                    @if (_view != WireViewMode.Pipeline)
                    {
                        <div class="cm-run-show__states" aria-label="Schedule summary">
                            <IgbChip class="cm-run-show__chip" Outlined="true">@Count(WireDeliveryStatus.Queued, WireDeliveryStatus.Staged) queued</IgbChip>
                            <IgbChip>@Count(WireDeliveryStatus.Sent) sent</IgbChip>
                            <IgbChip class="cm-run-show__chip cm-run-show__chip--accent">@_data.Queue.Count ready to schedule</IgbChip>
                            <span class="cm-run-show__zone">@_data.TimeZone</span>
                        </div>
                    }
                </div>
                <div class="cm-run-show__controls" aria-label="Wire controls">
                    <IgbButtonGroup Selection="ButtonGroupSelection.Single" aria-label="Wire view">
                        <IgbToggleButton Value="run" Selected="@(_view == WireViewMode.RunOfShow)" Disabled="@_narrow"
                                         @onclick="() => SelectView(WireViewMode.RunOfShow)">Run of show</IgbToggleButton>
                        <IgbToggleButton Value="pipeline" Selected="@(_view == WireViewMode.Pipeline)" Disabled="@_narrow"
                                         @onclick="() => SelectView(WireViewMode.Pipeline)">Pipeline</IgbToggleButton>
                        <IgbToggleButton Value="agenda" Selected="@(_view == WireViewMode.Agenda)"
                                         @onclick="() => SelectView(WireViewMode.Agenda)">Agenda</IgbToggleButton>
                    </IgbButtonGroup>
                    @if (_view != WireViewMode.Pipeline)
                    {
                        <IgbButtonGroup Selection="ButtonGroupSelection.Single" aria-label="Schedule range">
                            <IgbToggleButton Value="week" Selected="@(_data.RangeDays == 7)" @onclick="() => ChangeRangeAsync(7)">Week</IgbToggleButton>
                            <IgbToggleButton Value="fortnight" Selected="@(_data.RangeDays == 14)" @onclick="() => ChangeRangeAsync(14)">Fortnight</IgbToggleButton>
                        </IgbButtonGroup>
                        <IgbButton Variant="ButtonVariant.Outlined" @onclick="() => NavigateRangeAsync(-1)">← Prev</IgbButton>
                        <IgbButton Variant="ButtonVariant.Outlined" @onclick="() => NavigateRangeAsync(1)">Next →</IgbButton>
                    }
                </div>
            </header>

            @switch (_view)
            {
                case WireViewMode.Pipeline:
                    <PipelineView Data="_data"
                                  CampaignOnly="_campaignOnly"
                                  CampaignId="Workspace.Active?.Id"
                                  CampaignOnlyChanged="SetCampaignOnly"
                                  EditQueue="EditQueueAsync"
                                  Edit="EditScheduleAsync"
                                  Export="EditScheduleAsync"
                                  Slot="ApplySlotAsync"
                                  Retry="RetryAsync"
                                  Unschedule="UnscheduleAsync"
                                  ConnectBroker="OpenSettings" />
                    break;
                case WireViewMode.Agenda:
                    <AgendaView Data="_data"
                                Narrow="_narrow"
                                EditQueue="EditQueueAsync"
                                Edit="EditScheduleAsync"
                                Export="EditScheduleAsync"
                                Slot="ApplySlotAsync" />
                    break;
                default:
                    <RunOfShowView Data="_data"
                                   ShowHeader="false"
                                   Edit="EditQueueAsync"
                                   Slot="ApplySlotAsync"
                                   Retry="RetryAsync"
                                   RangeDaysChanged="ChangeRangeAsync"
                                   NavigateRange="NavigateRangeAsync"
                                   ConnectBroker="OpenSettings" />
                    break;
            }
        </section>
    }
    else
    {
        <section class="cm-run-show" role="alert">
            <span class="cm-run-show__kicker">The Wire</span>
            <p>@(_loadError ?? "The schedule could not be loaded.")</p>
            <IgbButton Variant="ButtonVariant.Outlined" @onclick="LoadInitialAsync">Retry</IgbButton>
        </section>
    }
</div>

@code {
    private const string WireModulePath = "./_content/Castmill.UI/js/castmill-wire.js?v=2";
    private readonly TimeZoneInfo _zone = TimeZoneInfo.Local;
    private DashboardResponse? _dashboard;
    private List<ScheduleEntryResponse> _schedule = [];
    private PublishReadinessResponse? _readiness;
    private IReadOnlyList<PublishChannel> _channels = [];
    private WireBoardData? _data;
    private DateOnly _rangeStart;
    private int _rangeDays = 7;
    private bool _loading = true;
    private bool _narrow;
    private bool _campaignOnly;
    private string? _loadError;
    private WireViewMode _view = WireViewMode.RunOfShow;
    private ElementReference _wireSurface;
    private IJSObjectReference? _wireModule;
    private IJSObjectReference? _resizeObserver;
    private DotNetObjectReference<Wire>? _selfReference;

    protected override async Task OnInitializedAsync()
    {
        var today = DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(Clock.GetLocalNow(), _zone).DateTime);
        _rangeStart = StartOfWeek(today);
        await LoadInitialAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_data is null || _wireModule is not null)
        {
            return;
        }

        try
        {
            _wireModule = await JS.InvokeAsync<IJSObjectReference>("import", WireModulePath);
            _selfReference = DotNetObjectReference.Create(this);
            _resizeObserver = await _wireModule.InvokeAsync<IJSObjectReference>(
                "observeWidth", _wireSurface, _selfReference, 1100d);
        }
        catch (JSException)
        {
        }
    }

    private async Task LoadInitialAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var bounds = WireBoardMapper.UtcRange(_rangeStart, _rangeDays, _zone);
            var dashboardTask = Campaigns.GetDashboardAsync();
            var scheduleTask = Schedule.ListAsync(bounds.From, bounds.To);
            var readinessTask = Publish.GetReadinessAsync();
            await Task.WhenAll(dashboardTask, scheduleTask, readinessTask);

            _dashboard = await dashboardTask;
            _schedule = await scheduleTask;
            _readiness = await readinessTask;
            _channels = _readiness.Ready ? await Publish.ListChannelsAsync() : [];
            RebuildData();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _loadError = ex is ApiException api ? api.Message : "The Castmill API could not be reached.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadRangeAsync()
    {
        try
        {
            var bounds = WireBoardMapper.UtcRange(_rangeStart, _rangeDays, _zone);
            _schedule = await Schedule.ListAsync(bounds.From, bounds.To);
            RebuildData();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            Notifier.ShowError(ex is ApiException api ? api.Message : "The schedule range could not be loaded.");
        }
    }

    private void RebuildData()
    {
        if (_dashboard is null || _readiness is null)
        {
            return;
        }

        _data = WireBoardMapper.Create(
            _rangeStart,
            _rangeDays,
            _dashboard,
            _schedule,
            _readiness,
            _channels,
            Clock.GetUtcNow(),
            _zone);
    }

    private Task EditQueueAsync(WireQueueItem item) =>
        NavigateToArtifactAsync(item.CampaignId, item.ArtifactId);

    private Task EditScheduleAsync(WireScheduleItem item) =>
        NavigateToArtifactAsync(item.CampaignId, item.ArtifactId);

    private Task NavigateToArtifactAsync(Guid campaignId, Guid artifactId)
    {
        Workspace.SetActive(campaignId);
        Navigation.NavigateTo(
            $"{CampaignViews.PathFor(campaignId, CampaignView.Focus)}?artifact={artifactId}");
        return Task.CompletedTask;
    }

    private async Task ApplySlotAsync(WireSlotRequest request)
    {
        var utc = WireTime.ToUtc(request.Date, request.Minutes, _zone);
        if (utc is null)
        {
            Notifier.ShowWarning("Choose an unambiguous local time.");
            return;
        }
        if (utc <= Clock.GetUtcNow())
        {
            Notifier.ShowWarning("Choose a future time.");
            return;
        }

        try
        {
            if (request.QueueItem is { } queueItem)
            {
                var created = await Schedule.CreateAsync(new ScheduleEntryCreateRequest(
                    queueItem.CampaignId,
                    queueItem.ArtifactId,
                    queueItem.ChannelId,
                    queueItem.Title,
                    utc.Value,
                    MediaUrl: null,
                    PushToBroker: _readiness?.Ready == true));
                _schedule.Add(created);
                RebuildData();
                Notifier.ShowSuccess(SuccessMessage(queueItem.Title, utc.Value));
            }
            else if (request.ScheduleItem is { } scheduleItem)
            {
                if (WireTime.IsSameSlot(scheduleItem, request.Date, request.Minutes))
                {
                    return;
                }

                var moved = await Schedule.MoveAsync(scheduleItem.Id, utc.Value);
                ReplaceSchedule(moved);
                RebuildData();
                Notifier.ShowSuccess(SuccessMessage(scheduleItem.Title, utc.Value));
            }
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            Notifier.ShowError(ex is ApiException api ? api.Message : "The schedule could not be updated.");
        }
    }

    private async Task RetryAsync(WireScheduleItem item)
    {
        try
        {
            var retried = await Schedule.RetryAsync(item.Id);
            ReplaceSchedule(retried);
            RebuildData();
            Notifier.ShowSuccess($"{item.Title} queued again.");
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            Notifier.ShowError(ex is ApiException api ? api.Message : "The failed delivery could not be retried.");
        }
    }

    private async Task UnscheduleAsync(WireScheduleItem item)
    {
        try
        {
            await Schedule.CancelAsync(item.Id);
            _schedule.RemoveAll(entry => entry.Id == item.Id);
            RebuildData();
            Notifier.ShowSuccess($"{item.Title} returned to Ready.");
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            Notifier.ShowError(ex is ApiException api ? api.Message : "The scheduled item could not be returned to Ready.");
        }
    }

    private async Task ChangeRangeAsync(int days)
    {
        if (_rangeDays == days)
        {
            return;
        }
        _rangeDays = days;
        await LoadRangeAsync();
    }

    private async Task NavigateRangeAsync(int direction)
    {
        _rangeStart = _rangeStart.AddDays(direction * _rangeDays);
        await LoadRangeAsync();
    }

    private void ReplaceSchedule(ScheduleEntryResponse entry)
    {
        var index = _schedule.FindIndex(candidate => candidate.Id == entry.Id);
        if (index < 0)
        {
            _schedule.Add(entry);
        }
        else
        {
            _schedule[index] = entry;
        }
    }

    private string SuccessMessage(string title, DateTimeOffset scheduledAt)
    {
        var local = TimeZoneInfo.ConvertTime(scheduledAt, _zone);
        var destination = _readiness?.Ready == true ? "via broker" : "staged locally";
        return $"{title} scheduled {local:ddd d MMM HH:mm} {destination}.";
    }

    private void OpenSettings() => Navigation.NavigateTo("/settings");

    private string ViewTitle => _view == WireViewMode.Pipeline
        ? $"{_data!.Queue.Count + _data.Items.Count} items in flight"
        : $"{(_data!.RangeDays == 14 ? "Fortnight" : "Week")} of {_data.RangeStart.ToString("d MMM", CultureInfo.CurrentCulture)}";

    private int Count(params WireDeliveryStatus[] states) =>
        _data?.Items.Count(item => states.Contains(item.Status)) ?? 0;

    private void SelectView(WireViewMode view)
    {
        if (_narrow && view != WireViewMode.Agenda)
        {
            return;
        }

        _view = view;
    }

    private void SetCampaignOnly(bool campaignOnly) => _campaignOnly = campaignOnly;

    [JSInvokable]
    public Task WireWidthChanged(double width)
    {
        var narrow = width < 1100d;
        if (_narrow == narrow)
        {
            return Task.CompletedTask;
        }

        _narrow = narrow;
        if (_narrow && _view != WireViewMode.Agenda)
        {
            _view = WireViewMode.Agenda;
        }

        return InvokeAsync(StateHasChanged);
    }

    private static DateOnly StartOfWeek(DateOnly date)
    {
        var offset = ((int)date.DayOfWeek + 6) % 7;
        return date.AddDays(-offset);
    }

    public async ValueTask DisposeAsync()
    {
        if (_resizeObserver is not null)
        {
            try
            {
                await _resizeObserver.InvokeVoidAsync("dispose");
                await _resizeObserver.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        if (_wireModule is not null)
        {
            try
            {
                await _wireModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _selfReference?.Dispose();
    }
}