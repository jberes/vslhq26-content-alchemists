    private async Task StartCloudMediaIngestAsync()
    {
        if (_mediaFile is null || !CanStart)
        {
            return;
        }

        _error = null;
        _step = Step.Transcribing;
        _log.Clear();
        _cloudOperation = true;
        _uploadPaused = false;
        _mediaCancellation?.Dispose();
        _mediaCancellation = new CancellationTokenSource();
        var ct = _mediaCancellation.Token;
        try
        {
            await NarrateAsync("creating campaign…", 2);
            var campaign = await EnsureCampaignAsync();
            var contentType = NormalizeMediaContentType(_mediaFile.ContentType, _mediaFile.Name);
            if (_mediaUpload is null
                || _mediaUpload.Status == MediaUploadStatus.Cancelled
                || !string.Equals(_mediaUpload.FileName, _mediaFile.Name, StringComparison.Ordinal)
                || _mediaUpload.TotalBytes != _mediaFile.Size)
            {
                _mediaUpload = await MediaUploads.CreateAsync(
                    campaign.Id,
                    _mediaFile.Name,
                    contentType,
                    _mediaFile.Size,
                    ct);
            }

            if (_mediaUpload.Status == MediaUploadStatus.Uploading)
            {
                await using var stream = _mediaFile.OpenReadStream(MaxMediaBytes, ct);
                await SkipAsync(stream, _mediaUpload.UploadedBytes, ct);
                while (_mediaUpload.UploadedBytes < _mediaUpload.TotalBytes)
                {
                    while (_uploadPaused)
                    {
                        await Task.Delay(100, ct);
                    }
                    var wanted = (int)Math.Min(
                        _mediaUpload.BlockSize,
                        _mediaUpload.TotalBytes - _mediaUpload.UploadedBytes);
                    var block = await ReadExactlyAsync(stream, wanted, ct);
                    _mediaUpload = await MediaUploads.PutBlockAsync(
                        campaign.Id,
                        _mediaUpload.Id,
                        _mediaUpload.NextBlockIndex,
                        block,
                        ct);
                    _percent = 5 + (int)Math.Round(_mediaUpload.Percent * 0.7);
                    SetNarratedStage(
                        "uploading private media",
                        $"{FormatBytes(_mediaUpload.UploadedBytes)} / {FormatBytes(_mediaUpload.TotalBytes)}");
                    StateHasChanged();
                }

                await NarrateAsync("committing private media…", 78);
                _mediaUpload = await MediaUploads.CommitAsync(campaign.Id, _mediaUpload.Id, ct);
            }

            await NarrateAsync(
                _mediaUpload.TotalBytes > TranscriptionServiceShortLimit
                    ? "transcribing with Azure AI Speech…"
                    : "transcribing in the cloud…",
                85);
            _mediaUpload = await MediaUploads.TranscribeAsync(
                campaign.Id,
                _mediaUpload.Id,
                useSpeech: _mediaUpload.TotalBytes > TranscriptionServiceShortLimit,
                ct);
            _transcriptArtifactId = _mediaUpload.TranscriptArtifactId
                ?? throw new InvalidOperationException("The completed upload has no transcript artifact.");
            await LoadTranscriptEvidenceAsync(campaign.Id, _transcriptArtifactId.Value);
            await NarrateAsync("timed transcript evidence saved", 100);
            _step = Step.Intent;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            _error ??= "The media operation was paused. Resume when ready.";
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or IOException
            or InvalidOperationException or Microsoft.JSInterop.JSException)
        {
            _error = ex is ApiException api ? api.Message
                : ex is IOException io ? io.Message
                : ex is InvalidOperationException invalid ? invalid.Message
                : "Couldn't reach the Castmill API. Your uploaded blocks remain resumable.";
        }
        finally
        {
            _cloudOperation = false;
            StateHasChanged();
        }
    }

