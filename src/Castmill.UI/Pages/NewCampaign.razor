    /// <summary>
    /// The desktop ingest path (E7.3): extract audio with ffmpeg, transcribe with Whisper
    /// on-device — narrated with the engine's real stage + percent — then send the TIMED
    /// segments to the server, so provenance keeps genuine timestamps.
    /// </summary>
    private async Task StartLocalIngestAsync()
    {
        if (_pickedFiles.Count == 0)
        {
            return;
        }

        _error = null;
        _step = Step.Transcribing;
        _log.Clear();
        _percent = 0;
        StateHasChanged();

        var progress = new Progress<PipelineProgress>(p => InvokeAsync(() =>
        {
            _percent = (int)Math.Clamp(p.Percent ?? 0, 0, 100);
            var line = $"{p.Stage}…{(p.Detail is null ? "" : $" {p.Detail}")}";
            if (_log.Count == 0 || !_log[^1].StartsWith(p.Stage, StringComparison.Ordinal))
            {
                _log.Add(line);
            }
            else
            {
                _log[^1] = line;
            }

            StateHasChanged();
        }));

        try
        {
            var combined = new List<Castmill.Core.Ai.TranscriptSegment>();
            double offset = 0;
            for (var sourceIndex = 0; sourceIndex < _pickedFiles.Count; sourceIndex++)
            {
                var picked = _pickedFiles[sourceIndex];
                await NarrateAsync(
                    $"transcribing source {sourceIndex + 1}/{_pickedFiles.Count} · {picked.FileName}",
                    Math.Max(2, sourceIndex * 85 / _pickedFiles.Count));
                var transcription = await Media.TranscribeAsync(picked, progress);
                foreach (var segment in transcription.Segments)
                {
                    combined.Add(segment with
                    {
                        StartSeconds = segment.StartSeconds + offset,
                        EndSeconds = segment.EndSeconds + offset,
                        SourceLabel = picked.FileName,
                    });
                }
                if (transcription.Segments.Count > 0)
                {
                    offset = combined[^1].EndSeconds + 0.25;
                }
            }

            if (combined.Count == 0)
            {
                _error = "Whisper heard nothing usable in the selected files.";
                return;
            }

            await NarrateAsync("creating campaign…", 96);
            var campaign = await EnsureCampaignAsync();

            await NarrateAsync($"combining {_pickedFiles.Count} sources · {combined.Count} timed segments…", 98);
            var ingest = await Generation.IngestTranscriptAsync(
                campaign.Id, string.Join(' ', combined.Select(segment => segment.Text)),
                string.Join(" + ", _pickedFiles.Select(file => file.FileName)), combined);
            _transcriptArtifactId = ingest.TranscriptArtifactId;
            await LoadTranscriptEvidenceAsync(campaign.Id, ingest.TranscriptArtifactId);

            await NarrateAsync($"{ingest.Segments} timed segments saved", 100);
            _step = Step.Intent;
        }
        catch (NotSupportedException ex)
        {
            _error = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            // The engine's own errors (ffmpeg missing, unreadable file) are user-facing.
            _error = ex.Message;
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch (HttpRequestException)
        {
            _error = "Couldn't reach the Castmill API.";
        }
        finally
        {
            StateHasChanged();
        }
    }

    /// <summary>
    /// Appends a log line and advances the bar. The percentages mark real completed calls,
    /// not a timer — ADR-F13's rule is that progress must mean something.
    /// </summary>
    private async Task NarrateAsync(string line, int percent)
    {
        _log.Add(line);
        _percent = percent;
        StateHasChanged();

        // Yield so the line actually paints before the next call blocks.
        await Task.Yield();
    }

    private async Task LoadTranscriptEvidenceAsync(Guid campaignId, Guid transcriptArtifactId)
    {
        var sources = await Evidence.ListSourcesAsync(campaignId);
        var source = sources
            .Where(candidate => candidate.Kind == SourceKinds.Transcript
                && candidate.LegacyArtifactId == transcriptArtifactId)
            .OrderByDescending(candidate => candidate.CreatedAt)
            .FirstOrDefault()
            ?? throw new InvalidOperationException("The timed transcript evidence was not found.");
        _importedEvidence = await Evidence.GetEvidenceAsync(campaignId, source.Id);
    }

    private void SetNarratedStage(string stage, string? detail)
    {
        var line = $"{stage}…{(string.IsNullOrWhiteSpace(detail) ? string.Empty : $" {detail}")}";
        if (_log.Count == 0 || !_log[^1].StartsWith(stage, StringComparison.Ordinal))
        {
            _log.Add(line);
        }
        else
        {
            _log[^1] = line;
        }
    }

    private static async Task SkipAsync(Stream stream, long bytes, CancellationToken ct)
    {
        var buffer = new byte[64 * 1024];
        var remaining = bytes;
        while (remaining > 0)
        {
            var read = await stream.ReadAsync(
                buffer.AsMemory(0, (int)Math.Min(buffer.Length, remaining)),
                ct);
            if (read == 0)
            {
                throw new IOException("The reselected file is shorter than the resumable upload.");
            }
            remaining -= read;
        }
    }

    private static async Task<byte[]> ReadExactlyAsync(
        Stream stream, int length, CancellationToken ct)
    {
        var bytes = new byte[length];
        var offset = 0;
        while (offset < length)
        {
            var read = await stream.ReadAsync(bytes.AsMemory(offset, length - offset), ct);
            if (read == 0)
            {
                throw new IOException("The selected file ended before its declared size.");
            }
            offset += read;
        }
        return bytes;
    }

    private static bool IsMediaContentType(string contentType) =>
        contentType.StartsWith("audio/", StringComparison.OrdinalIgnoreCase)
        || contentType.StartsWith("video/", StringComparison.OrdinalIgnoreCase);

    private static string NormalizeMediaContentType(string contentType, string fileName)
    {
        if (IsMediaContentType(contentType))
        {
            return contentType;
        }
        return Path.GetExtension(fileName).ToLowerInvariant() switch
        {
            ".mp3" => "audio/mpeg",
            ".m4a" or ".aac" => "audio/mp4",
            ".wav" => "audio/wav",
            ".webm" => "audio/webm",
            ".mp4" or ".m4v" => "video/mp4",
            ".mov" => "video/quicktime",
            _ => "application/octet-stream",
        };
    }

    private static string FormatBytes(long bytes) => bytes >= 1024L * 1024 * 1024
        ? $"{bytes / (1024d * 1024 * 1024):0.0} GB"
        : $"{bytes / (1024d * 1024):0.0} MB";

    private const long TranscriptionServiceShortLimit = 25L * 1024 * 1024;

    private sealed class MemoryBrowserFile(
        string name,
        string contentType,
        byte[] bytes) : IBrowserFile
    {
        public string Name => name;
        public DateTimeOffset LastModified { get; } = DateTimeOffset.UtcNow;
        public long Size => bytes.LongLength;
        public string ContentType => contentType;

        public Stream OpenReadStream(
            long maxAllowedSize = 512_000,
            CancellationToken cancellationToken = default)
        {
            if (bytes.LongLength > maxAllowedSize)
            {
                throw new IOException("Recording exceeds the allowed media size.");
            }
            return new MemoryStream(bytes, writable: false);
        }
    }

    private async Task SuggestResearchContextAsync()
    {
        if (_campaignId is not { } campaignId)
        {
            return;
        }

        _contextSuggesting = true;
        _contextError = null;
        StateHasChanged();

        try
        {
            var suggestion = await Generation.SuggestResearchContextAsync(
                campaignId, _transcriptArtifactId);
            if (!string.IsNullOrWhiteSpace(suggestion.Audience))
            {
                _audience = suggestion.Audience.Trim();
            }
            else
            {
                _contextError = "The model did not return a research audience.";
            }
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _contextError = ex is ApiException api
                ? $"Couldn't infer the research audience: {api.Message}"
                : "Couldn't reach the Castmill API to infer the research audience.";
        }
        finally
        {
            _contextSuggesting = false;
            StateHasChanged();
        }
    }

    private string CampaignBrief => string.Join('\n',
        $"Campaign intent: {_intent}",
        $"Content type: {_contentType}",
        $"SEO/AEO: {(_skipSeoAnalysis ? "Skipped" : "Included")}",
        $"Audience: {_audience}",
        $"Brand voice: {_voice}",
        $"Angle: {_angle}");

    private async Task SaveCampaignContextAsync(Guid campaignId)
    {
        await _campaignSaveLock.WaitAsync();
        try
        {
            var links = _links
                .Where(l => !string.IsNullOrWhiteSpace(l.Url))
                .Select(l => new CampaignLink(
                    string.IsNullOrWhiteSpace(l.Label) ? "Link" : l.Label.Trim(), l.Url.Trim()))
                .ToList();
            if (HasValidSiteUrl && !links.Any(link =>
                    string.Equals(link.Url, _siteUrl.Trim(), StringComparison.OrdinalIgnoreCase)))
            {
                links.Insert(0, new CampaignLink("Site", _siteUrl.Trim()));
            }

            await Campaigns.UpdateAsync(
                campaignId, _name.Trim(), CampaignBrief,
                Guid.TryParse(_brandId, out var brandId) ? brandId : null,
                links.Count > 0 ? links : null,
                CampaignStatus.Draft, _contentType, _intent, SelectedRecipe(),
                _skipSeoAnalysis);
        }
        finally
        {
            _campaignSaveLock.Release();
        }
    }

    private async Task PressRunAsync()
    {
        if (_campaignId is not { } campaignId)
        {
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            if (!_skipSeoAnalysis && _analysis is null)
            {
                _error = "Complete the SEO/AEO analysis before starting the content run.";
                return;
            }
            if (!_fanOut.Any(item => item.Selected))
            {
                _error = "Choose at least one output for the Press Run.";
                return;
            }
            await SaveCampaignContextAsync(campaignId);

            // Saved BEFORE the run: the orchestrator reads targets off the campaign when it
            // builds each prompt, so a save that lands after the fan-out starts steers nothing.
            if (!_skipSeoAnalysis)
            {
                await SaveTargetsAsync(campaignId);
            }

            // Hand the run to the press-run service and go straight to the Mill Floor:
            // the reveal happens there, card by card, as completions land (ADR-F13).
            PressRun.Start(
                campaignId, _transcriptArtifactId, CampaignBrief,
                ExpandKinds(_fanOut.Where(f => f.Selected).Select(f => f.Kind)));

            Navigation.NavigateTo(CampaignViews.PathFor(campaignId, CampaignView.MillFloor));
        }
        catch (ApiException ex)
        {
            // A failed run must not lose the campaign the user just created.
            _error = $"{ex.Message} The campaign was created — you can start the run from its Mill Floor.";
        }
        catch (HttpRequestException)
        {
            _error = "Couldn't reach the Castmill API.";
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
