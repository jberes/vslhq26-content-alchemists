            CloseSourceReview();
        }
    }

    private static string SourceReviewLabel(EvidenceRevisionResponse evidence) =>
        evidence.Source.Kind == SourceKinds.Transcript ? "Review transcript" : "Review source";

    private static string SourceBlockLabel(EvidenceRevisionResponse evidence)
    {
        var count = evidence.Blocks.Count(block => !block.IsExcluded);
        var noun = evidence.Source.Kind == SourceKinds.Transcript
            ? (count == 1 ? "segment" : "segments")
            : (count == 1 ? "evidence block" : "evidence blocks");
        return $"{count} {noun}";
    }

    private static double? SourceDuration(EvidenceRevisionResponse evidence)
    {
        var ends = evidence.Blocks
            .Where(block => block.LocatorKind == EvidenceLocatorKinds.MediaTimeRange)
            .Select(block => block.Locator.TryGetProperty("endSeconds", out var end)
                && end.TryGetDouble(out var seconds)
                    ? (double?)seconds
                    : null)
            .Where(seconds => seconds is not null)
            .Select(seconds => seconds!.Value)
            .ToList();
        return ends.Count == 0 ? null : ends.Max();
    }

    private static string? SourceExcerpt(EvidenceRevisionResponse evidence)
    {
        var content = evidence.Blocks.FirstOrDefault(block =>
            !block.IsExcluded
            && block.LocatorKind is not EvidenceLocatorKinds.WebPageMetadata
            && block.LocatorKind is not EvidenceLocatorKinds.WebPageImage)?.Content;
        if (string.IsNullOrWhiteSpace(content))
        {
            return null;
        }
        const int limit = 240;
        return content.Length <= limit ? content : $"{content[..(limit - 1)].TrimEnd()}…";
    }

    private static string Clock(double seconds)
    {
        var duration = TimeSpan.FromSeconds(Math.Max(0, seconds));
        return duration.TotalHours >= 1
            ? duration.ToString(@"h\:mm\:ss")
            : duration.ToString(@"m\:ss");
    }

    [SupplyParameterFromQuery(Name = "campaign")]
