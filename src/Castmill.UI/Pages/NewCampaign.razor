@* New campaign — five steps, and the only path that creates one (ADR-F29).
     1. pick a source            drop zone + paste URL / paste transcript / pick from assets
     2. transcription progress   determinate bar + narrated log (ADR-F13: never a spinner)
     3. research context         audience, voice, brand and required site URL; no generation
     4. deep SEO/AEO report      live evidence, suggestions and editable target approval
     5. production brief         AI-drafted from the approved report, then Press Run

   Desktop (F7): pick an MP3/MP4 → ffmpeg extracts → Whisper transcribes on-device → the
   TIMED segments go to the server. Web: capability flagged off with a stated reason (G3);
   pasted transcripts work everywhere.
*@
@page "/campaigns/new"
@using Castmill.Core.Resources
@using Castmill.UI.Design
@using Castmill.UI.Http
@using Castmill.UI.Platform
@using Castmill.UI.State
@inject BrandsClient Brands
@inject SeoClient Seo
@inject CampaignsClient Campaigns
@inject GenerationClient Generation
@inject WorkspaceState Workspace
@inject PressRunService PressRun
@inject IMediaPipeline Media
@inject INotifier Notifier
@inject NavigationManager Navigation

<PageTitle>Start a run — Castmill</PageTitle>

<div class="cm-page"><div class="cm-measure--dashboard cm-run">
    <header class="cm-front__head">
        <span class="cm-kicker">Step @((int)_step + 1) of @(Enum.GetValues<Step>().Length)</span>
        <h1>@StepTitle</h1>
    </header>

    <ol class="cm-steps" aria-label="Progress">
        @foreach (var step in Enum.GetValues<Step>())
        {
            <li class="cm-steps__step @(step <= _step ? "cm-steps__step--done" : "")"
                aria-current="@(step == _step ? "step" : "false")">
                <span class="cm-mono">@((int)step + 1)</span>
                <span>@Title(step)</span>
            </li>
        }
    </ol>

    @if (_step == Step.Source)
    {
        <section class="cm-run__panel">
            @if (Media.CanProcessLocally)
            {
                <div class="cm-dropzone">
                    <p class="cm-dropzone__headline">Bring a video or audio file</p>
                    <p class="cm-meta">
                        MP3, MP4, MOV, M4A, WAV — extracted and transcribed on this machine.
                        Nothing leaves it except the finished transcript.
                    </p>
                    <button type="button" class="cm-button" @onclick="PickMediaAsync">
                        Pick a file &amp; transcribe…
                    </button>
                    @if (_picked is { } picked)
                    {
                        <p class="cm-mono cm-meta">@picked.FileName · @(picked.SizeBytes / 1_048_576) MB</p>
                    }
                </div>
            }
            else
            {
                @* Capability off with a stated reason — never a dead control (G3). *@
                <div class="cm-dropzone cm-dropzone--disabled" aria-disabled="true">
                    <p class="cm-dropzone__headline">Bring a video or audio file</p>
                    <p class="cm-meta">@Media.UnavailableReason</p>
                </div>
            }

            <div class="cm-run__sources">
                <label class="cm-field">
                    <span class="cm-field__label">Campaign name</span>
                    <input class="cm-input" @ref="_sourceFirstField" @bind="_name" @bind:event="oninput"
                           placeholder="Q3 product webinar" />
                </label>

                <label class="cm-field">
                    <span class="cm-field__label">Paste a transcript</span>
                    <textarea class="cm-input cm-textarea" rows="8" @bind="_transcript" @bind:event="oninput"
                              placeholder="Paste the transcript text. Segments and timings are derived server-side."></textarea>
                    <span class="cm-field__hint cm-meta">@_transcript.Length characters</span>
                </label>
            </div>

            @if (_error is not null)
            {
                <p class="cm-form__error" role="alert">@_error</p>
            }

            <div class="cm-form__actions">
                @if (_picked is not null)
                {
                    <button type="button" class="cm-button" disabled="@(_name.Trim().Length == 0)"
                            @onclick="StartLocalIngestAsync">
                        Transcribe on this machine
                    </button>
                }
                <button type="button" class="cm-button @(_picked is null ? "" : "cm-button--quiet")"
                        disabled="@(!CanStart)" @onclick="StartIngestAsync">
                    Transcribe pasted text
                </button>
                <a class="cm-meta" href="campaigns">Cancel</a>
            </div>
        </section>
    }
    else if (_step == Step.Transcribing)
    {
        <section class="cm-run__panel">
            @* Determinate progress + a narrated log line. The steps are real: each one is a
               call that has either completed or not. *@
            <div class="cm-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100"
                 aria-valuenow="@_percent">
                <div class="cm-progress__fill" style="inline-size: @_percent%"></div>
            </div>

            <ul class="cm-log">
                @foreach (var line in _log)
                {
                    <li class="cm-mono cm-meta">@line</li>
                }
            </ul>

            @if (_error is not null)
            {
                <p class="cm-form__error" role="alert">@_error</p>
                <div class="cm-form__actions">
                    <button type="button" class="cm-button cm-button--quiet" @onclick="() => _step = Step.Source">
                        Back
                    </button>
                </div>
            }
        </section>
    }
    else if (_step == Step.Context)
    {
        <section class="cm-run__panel">
            <p class="cm-seo__banner">
                <strong>No content is generated at this stage.</strong> Castmill infers the
                research audience from the transcript, and the selected Brand supplies its
                approved voice. The SEO/AEO report comes next; titles, angles, and the production
                brief are derived only after you approve it.
            </p>

            <label class="cm-field">
                <span class="cm-field__label">Brand</span>
                <select class="cm-input cm-brand__kind" value="@_brandId" @onchange="BrandChanged">
                    <option value="">None</option>
                    @foreach (var brand in _brands)
                    {
                        <option value="@brand.Id">@brand.Name</option>
                    }
                </select>
                <span class="cm-field__hint cm-meta">
                    The selected Brand's saved style card is authoritative for voice, colours and templates.
                </span>
            </label>

            <div class="cm-brief">
                <label class="cm-field">
                    <span class="cm-field__label">AI-generated audience for the analysis</span>
                    <textarea class="cm-input cm-textarea" rows="2" @ref="_briefFirstField" @bind="_audience"
                              placeholder="@(_contextSuggesting ? "Inferring the audience from the transcript…" : "Audience inferred from the transcript")"></textarea>
                    <span class="cm-field__hint cm-meta">Review or refine this before research.</span>
                </label>
                <label class="cm-field">
                    <span class="cm-field__label">Brand voice — from selected Brand</span>
                    <textarea class="cm-input cm-textarea" rows="2" value="@_voice" readonly
                              aria-readonly="true"
                              placeholder="@BrandVoicePlaceholder"></textarea>
                </label>
                <label class="cm-field">
                    <span class="cm-field__label">Site URL</span>
                    <input class="cm-input" type="url" @bind="_siteUrl" @bind:event="oninput"
                           placeholder="https://example.com" />
                    <span class="cm-field__hint cm-meta">Required for ranked keywords, backlinks, competitors, and AI citation visibility.</span>
                </label>
            </div>

            <button type="button" class="cm-button cm-button--quiet"
                    disabled="@_contextSuggesting" @onclick="SuggestResearchContextAsync">
                @(_contextSuggesting ? "Inferring audience…" : "Regenerate audience from transcript")
            </button>
            @if (_contextError is { } contextError)
            {
                <p class="cm-form__error" role="alert">@contextError You can refine the audience manually or try again.</p>
            }

            <h2 class="cm-front__block-title">Context links</h2>
            <p class="cm-meta">
                Real destinations — the home page, GitHub pages, docs — that generated
                content should reference and link to.
            </p>
            @foreach (var link in _links)
            {
                <div class="cm-links__row">
                    <input class="cm-input" placeholder="Label (Home page…)"
                           maxlength="100" @bind="link.Label" />
                    <input class="cm-input" placeholder="https://…" maxlength="2000" @bind="link.Url" />
                    <button type="button" class="cm-tree__delete" aria-label="Remove link"
                            @onclick="() => _links.Remove(link)">✕</button>
                </div>
            }
            <button type="button" class="cm-button cm-button--quiet" @onclick="() => _links.Add(new LinkRow())"
                    disabled="@(_links.Count >= 10)">+ Add link</button>

            @if (_error is not null)
            {
                <p class="cm-form__error" role="alert">@_error</p>
            }

            <div class="cm-form__actions">
                <button type="button" class="cm-button" disabled="@(!CanRunAnalysis)" @onclick="GoToTargetsAsync">
                    Build the deep SEO/AEO report
                </button>
                @if (!HasValidSiteUrl)
                {
                    <span class="cm-meta">Enter a valid site URL to unlock the full domain analysis.</span>
                }
            </div>
        </section>
    }
    else if (_step == Step.Targets)
    {
        <section class="cm-run__panel">
            @* Analysis is a required production stage, not a post-hoc report. Content cannot
               run until this report exists and its targets have been approved. *@
            @if (_researching)
            {
                <div class="cm-brief__reading" role="status">
                    <span class="cm-spinner" aria-hidden="true"></span>
                    <span>Building the deep SEO/AEO report — demand, SERP, AI visibility, rankings, authority, competitors, gaps and content opportunities…</span>
                </div>
            }
            else
            {
                @if (_researchNotes.Count > 0)
                {
                    @foreach (var note in _researchNotes)
                    {
                        <p class="cm-meta">@note</p>
                    }
                }

                @if (_analysis is { } analysis)
                {
                    <DeepSeoReport Report="analysis" />
                }

                <h2 class="cm-front__block-title">
                    Keywords
                    <span class="cm-mono cm-meta">(@_targets.Count(t => t.Selected) selected)</span>
                </h2>
                <p class="cm-meta">
                    The primary keyword goes in the title, the first heading and the opening
                    paragraph of everything printed.
                    @if (!_hasMetrics)
                    {
                        <text>No volume data — these are the model's reading of your source.</text>
                    }
                </p>

                @if (_targets.Count == 0)
                {
                    <p class="cm-form__error">No grounded keywords came back. Refine the brief and rerun the analysis before generating content.</p>
                }
                else
                {
                    <ul class="cm-targets">
                        @foreach (var target in _targets)
                        {
                            <li class="cm-targets__row @(target.Selected ? "cm-targets__row--on" : null)">
                                <label class="cm-targets__pick">
                                    <input type="checkbox" checked="@target.Selected"
                                           @onchange="e => Toggle(target, e)" />
                                    <span>@target.Term</span>
                                </label>
                                <button type="button"
                                        class="cm-primary-pick @(IsPrimary(target) ? "cm-primary-pick--on" : null)"
                                        aria-pressed="@(IsPrimary(target) ? "true" : "false")"
                                        title="Make this the primary keyword"
                                        @onclick="() => MakePrimary(target)">
                                    @(IsPrimary(target) ? "★ Primary" : "Set primary")
                                </button>
                                <span class="cm-mono cm-meta">
                                    @(target.Volume is { } v ? $"{v:N0}/mo" : "—")
                                </span>
                                <span class="cm-mono cm-meta">
                                    @(target.Difficulty is { } d ? $"KD {d:0}" : "—")
                                </span>
                            </li>
                        }
                    </ul>
                }

                @* Free-form entry: research proposes, but you know your product — a keyword the
                   transcript never says out loud is often the one worth targeting. Added with a
                   source of "manual" and no metrics, honestly. *@
                <div class="cm-links__row cm-targets__add">
                    <input class="cm-input" placeholder="Add a keyword of your own…"
                           aria-label="Add a keyword"
                           @bind="_manualKeyword" @bind:event="oninput"
                           @onkeydown="@(e => { if (e.Key == "Enter") AddManualKeyword(); })" />
                    <button type="button" class="cm-button cm-button--quiet"
                            disabled="@string.IsNullOrWhiteSpace(_manualKeyword)"
                            @onclick="AddManualKeyword">+ Add keyword</button>
                </div>

                <h2 class="cm-front__block-title">
                    Questions to answer
                    <span class="cm-mono cm-meta">(@_questions.Count(q => q.Selected) selected)</span>
                </h2>
                <p class="cm-meta">
                    Each selected question is answered in a self-contained sentence — that is what
                    an AI assistant can quote when someone asks.
                </p>

                @if (_questions.Count == 0)
                {
                    <p class="cm-meta">No questions found for this source.</p>
                }
                else
                {
                    <ul class="cm-targets">
                        @foreach (var question in _questions)
                        {
                            <li class="cm-targets__row @(question.Selected ? "cm-targets__row--on" : null)">
                                <label class="cm-targets__pick">
                                    <input type="checkbox" checked="@question.Selected"
                                           @onchange="e => ToggleQuestion(question, e)" />
                                    <span>@question.Question</span>
                                </label>
                                <span class="cm-chip cm-mono">@QuestionSource(question.Source)</span>
                            </li>
                        }
                    </ul>
                }
            }

            @if (_error is not null)
            {
                <p class="cm-form__error" role="alert">@_error</p>
            }

            <div class="cm-form__actions">
                <button type="button" class="cm-button" disabled="@(!CanApproveReport)"
                        @onclick="ApproveAnalysisAsync">
                    @(_busy ? "Building the content brief…" : "Approve report & build content brief")
                </button>
                <button type="button" class="cm-button cm-button--quiet" disabled="@_busy"
                        @onclick="() => _step = Step.Context">
                    Back
                </button>
                <button type="button" class="cm-button cm-button--quiet" disabled="@(_busy || _researching)"
                        @onclick="ResearchAsync">
                    Re-run analysis
                </button>
                <span class="cm-meta">
                    @(_targets.Count(t => t.Selected)) keywords ·
                    @(_questions.Count(q => q.Selected)) questions
                </span>
            </div>
        </section>
    }
    else if (_step == Step.Brief)
    {
        <section class="cm-run__panel">
            <p class="cm-seo__banner">
                <strong>Built from the approved report.</strong> This production brief, its angle,
                and every selected output inherit the SEO/AEO evidence you just approved.
            </p>

            @if (_briefing)
            {
                <div class="cm-brief__reading" role="status">
                    <span class="cm-spinner" aria-hidden="true"></span>
                    <span>Turning the approved SEO/AEO strategy into a production brief…</span>
                </div>
            }
            else if (_summary is { } summary)
            {
                <div class="cm-brief__summary">
                    <div class="cm-brief__summary-head">
                        <span class="cm-kicker">SEO-informed source brief</span>
                        <button type="button" class="cm-button cm-button--quiet" @onclick="SuggestBriefAsync">
                            Rebuild from report
                        </button>
                    </div>
                    <p>@summary</p>
                    @if (_keyPoints.Count > 0)
                    {
                        <ul class="cm-brief__points">
                            @foreach (var point in _keyPoints)
                            {
                                <li>@point</li>
                            }
                        </ul>
                    }
                </div>
            }
            else if (_briefError is { } briefError)
            {
                <p class="cm-form__error" role="alert">
                    Couldn't build the content brief — @briefError
                    <button type="button" class="cm-button cm-button--quiet" @onclick="SuggestBriefAsync">Try again</button>
                </p>
            }

            <div class="cm-brief">
                <label class="cm-field">
                    <span class="cm-field__label">Audience</span>
                    <textarea class="cm-input cm-textarea" rows="2" @bind="_audience"></textarea>
                </label>
                <label class="cm-field">
                    <span class="cm-field__label">Brand voice — from selected Brand</span>
                    <textarea class="cm-input cm-textarea" rows="2" value="@_voice" readonly
                              aria-readonly="true" placeholder="@BrandVoicePlaceholder"></textarea>
                </label>
                <label class="cm-field">
                    <span class="cm-field__label">SEO-informed campaign angle</span>
                    <textarea class="cm-input cm-textarea" rows="3" @bind="_angle"
                              placeholder="The approved report will propose the core angle."></textarea>
                </label>
            </div>

            <h2 class="cm-front__block-title">Fan-out</h2>
            <p class="cm-meta">Choose what to produce from this shared strategy. Channel titles and copy are generated only after Press Run.</p>
            <ul class="cm-fanout">
                @foreach (var item in _fanOut)
                {
                    <li>
                        <label class="cm-fanout__item">
                            <input type="checkbox" checked="@item.Selected"
                                   @onchange="e => item.Selected = (bool)(e.Value ?? false)" />
                            <span>@item.Label</span>
                        </label>
                    </li>
                }
            </ul>

            @if (_error is not null)
            {
                <p class="cm-form__error" role="alert">@_error</p>
            }

            <div class="cm-form__actions">
                <button type="button" class="cm-button" disabled="@(_busy || _briefing)" @onclick="PressRunAsync">
                    @(_busy ? "Starting the run…" : "Press Run")
                </button>
                <button type="button" class="cm-button cm-button--quiet" disabled="@_busy"
                        @onclick="() => _step = Step.Targets">Back to report</button>
                <span class="cm-meta">@_fanOut.Count(f => f.Selected) of @_fanOut.Count selected</span>
            </div>
        </section>
    }
</div>
</div>

@code {
    private enum Step
    {
        Source,
        Transcribing,
        Context,
        Targets,
        Brief,
    }

    private sealed class FanOutItem(string kind, string label, bool selected = true)
    {
        public string Kind { get; } = kind;

        public string Label { get; } = label;

        public bool Selected { get; set; } = selected;
    }

    private readonly List<string> _log = [];

    // Only the blog (and the cheap slot reservation) run by default: a full fan-out
    // against live models takes minutes, and the owner wants fast first feedback with
    // everything else generated on demand from the Mill Floor (2026-07-29). Images are
    // NEVER generated here — the plan only reserves slots + prompts; pixels are made in
    // the Image Studio, deliberately.
    // "social" expands to the six real per-platform generator kinds at submit — the
    // orchestrator matches kinds exactly. Image slots are reserved automatically by any
    // run, so there is no image checkbox: pixels only ever come from the Image Studio.
    /// <summary>
    /// Derived from the kind registry, never listed by hand — a hand-kept copy here is how
    /// "youtube" shipped as a generator, a lane and a board chip while the ONE surface that
    /// starts a full run never offered it. YouTube leads and is on by default: a perfect
    /// YouTube package is the app's founding use case.
    /// </summary>
    private readonly List<FanOutItem> _fanOut = BuildFanOutChoices();

    private static List<FanOutItem> BuildFanOutChoices()
    {
        var items = new List<FanOutItem>
        {
            new("youtube", "YouTube package"),
            new("blog", "Blog post"),
            new("social", "Social set (6 platforms)", selected: false),
        };

        items.AddRange(ArtifactDisplay.Known
            .Where(k => k.OnBoard
                        && k.Lane != "Social"
                        && k.Kind is not ("blog" or "youtube" or "seo-keyword-plan"))
            .Select(k => new FanOutItem(k.Kind, k.Label, selected: false)));

        return items;
    }

    private static string[] ExpandKinds(IEnumerable<string> kinds) =>
        // image-prompts always rides along on the initial run: it is what seeds the reserved
        // image slots, and omitting it here is why campaigns sat at 0/6 images until someone
        // pressed "Seed all prompts" by hand.
        [.. kinds.SelectMany(k => k == "social" ? ArtifactDisplay.SocialKinds : [k]),
         "thumbnail-concepts", "image-prompts"];

    private sealed class LinkRow
    {
        public string Label { get; set; } = string.Empty;
        public string Url { get; set; } = string.Empty;
    }

    private readonly List<BrandProfileDetailResponse> _brands = [];
    private readonly List<LinkRow> _links = [];
    private string _brandId = string.Empty;

    private Step _step = Step.Source;

    // Focus the first field when a step opens: without it, keyboard focus sits at the
    // document top and Tab walks the whole rail before ever reaching the form.
    private ElementReference _sourceFirstField;
    private ElementReference _briefFirstField;
    private Step? _focusedStep;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusedStep == _step)
        {
            return;
        }

        try
        {
            switch (_step)
            {
                case Step.Source:
                    await _sourceFirstField.FocusAsync();
                    _focusedStep = _step;
                    break;
                case Step.Context:
                    await _briefFirstField.FocusAsync();
                    _focusedStep = _step;
                    break;
                default:
                    // Steps without a first field (Transcribing, Targets) claim no focus.
                    _focusedStep = _step;
                    break;
            }
        }
        catch (Exception)
        {
            // Focus is a nicety; a torn-down or not-yet-rendered element must not fault the render.
        }
    }

    private string _name = string.Empty;
    private string _transcript = string.Empty;
    private string _audience = string.Empty;
    private string _voice = string.Empty;
    private string _angle = string.Empty;
    private string _siteUrl = string.Empty;
    private string? _error;
    private bool _busy;
    private int _percent;
    private Guid? _campaignId;
    private Guid? _transcriptArtifactId;
    private PickedMedia? _picked;
    private bool _contextSuggesting;
    private string? _contextError;

    private bool CanStart => _name.Trim().Length > 0 && _transcript.Trim().Length > 40;
    private bool HasValidSiteUrl => Uri.TryCreate(_siteUrl.Trim(), UriKind.Absolute, out var site)
        && site.Scheme is "http" or "https";
    private bool CanRunAnalysis => !_busy && !_researching && !_contextSuggesting
        && !string.IsNullOrWhiteSpace(_audience) && HasValidSiteUrl;

    private string BrandVoicePlaceholder => string.IsNullOrWhiteSpace(_brandId)
        ? "Select a Brand to inherit its voice"
        : "This Brand has no saved voice guidelines";

    // ---- Deep report and target-approval step ------------------------------------------

    private sealed class TargetRow
    {
        public required string Term { get; init; }

        public long? Volume { get; init; }

        public double? Difficulty { get; init; }

        public double? Opportunity { get; init; }

        public double? Competition { get; init; }

        public double? Cpc { get; init; }

        public string? Intent { get; init; }

        public required string Source { get; init; }

        public bool Selected { get; set; }
    }

    private sealed class QuestionRow
    {
        public required string Question { get; init; }

        public required string Source { get; init; }

        public bool Selected { get; set; }
    }

    private readonly List<TargetRow> _targets = [];
    private string _manualKeyword = string.Empty;
    private readonly List<QuestionRow> _questions = [];
    private readonly List<string> _researchNotes = [];
    private bool _researching;
    private bool _hasMetrics;
    private string? _primaryKeyword;
    private SeoAnalysisReportResponse? _analysis;
    private bool CanApproveReport => !_busy && !_researching && _analysis is not null
        && _targets.Any(t => t.Selected);

    private bool IsPrimary(TargetRow row) =>
        string.Equals(row.Term, _primaryKeyword, StringComparison.OrdinalIgnoreCase);

    private static string QuestionSource(string source) => source switch
    {
        "paa" => "people also ask",
        "knowledge-base" => "knowledge base",
        _ => "from the source",
    };

    private void Toggle(TargetRow row, ChangeEventArgs e)
    {
        row.Selected = e.Value is true;

        // Deselecting the primary must not leave a primary nothing else mentions.
        if (!row.Selected && IsPrimary(row))
        {
            _primaryKeyword = _targets.FirstOrDefault(t => t.Selected)?.Term;
        }
        else if (row.Selected && _primaryKeyword is null)
        {
            _primaryKeyword = row.Term;
        }
    }

    private void ToggleQuestion(QuestionRow row, ChangeEventArgs e) => row.Selected = e.Value is true;

    /// <summary>
    /// Adds a keyword the user typed. Deduplicated against what research already returned so a
    /// hand-typed "react data grid" does not shadow the one that carries volume data. New
    /// entries are pre-selected — you typed it because you want it.
    /// </summary>
    private void AddManualKeyword()
    {
        var term = _manualKeyword.Trim();
        if (term.Length == 0)
        {
            return;
        }

        var existing = _targets.FirstOrDefault(t => string.Equals(t.Term, term, StringComparison.OrdinalIgnoreCase));
        if (existing is not null)
        {
            existing.Selected = true;
        }
        else
        {
            _targets.Insert(0, new TargetRow { Term = term, Source = "manual", Selected = true });
        }

        _primaryKeyword ??= term;
        _manualKeyword = string.Empty;
    }

    private void MakePrimary(TargetRow row)
    {
        _primaryKeyword = row.Term;
        // Being primary implies being chosen; the alternative is a silent no-op.
        row.Selected = true;
    }

    /// <summary>
    /// Moves to the report step and researches in the background. The step is shown
    /// immediately rather than after the research: a blank wait with no context is worse than
    /// a visible step that fills in.
    /// </summary>
    private async Task GoToTargetsAsync()
    {
        _step = Step.Targets;
        _error = null;
        try
        {
            if (_campaignId is { } campaignId)
            {
                await SaveCampaignContextAsync(campaignId);
            }
            await ResearchAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _error = ex is ApiException api ? api.Message : "Couldn't reach the Castmill API.";
        }
    }

    private async Task ResearchAsync()
    {
        if (_campaignId is not { } campaignId || _transcriptArtifactId is not { } transcriptId)
        {
            return;
        }

        _researching = true;
        _targets.Clear();
        _questions.Clear();
        _researchNotes.Clear();
        _analysis = null;
        StateHasChanged();

        try
        {
            _analysis = await Seo.DeepAnalysisAsync(campaignId, transcriptId,
                _siteUrl.Trim());
            var research = _analysis.Research;

            _hasMetrics = research.HasProviderMetrics;
            _researchNotes.AddRange(research.Notes);

            _targets.AddRange(research.Keywords.Select(k => new TargetRow
            {
                Term = k.Term,
                Volume = k.Volume,
                Difficulty = k.Difficulty,
                Opportunity = k.Opportunity,
                Competition = k.Competition,
                Cpc = k.Cpc,
                Intent = k.Intent,
                Source = k.Source,
            }));

            // The low-friction default: the three best are already chosen and the top one is
            // primary, so "Press Run" is one click. Everything else is a refinement.
            foreach (var row in _targets.Take(3))
            {
                row.Selected = true;
            }

            _primaryKeyword = _targets.FirstOrDefault()?.Term;

            _questions.AddRange(research.Questions.Select(q => new QuestionRow
            {
                Question = q.Question,
                Source = q.Source,
            }));

            foreach (var row in _questions.Take(5))
            {
                row.Selected = true;
            }
        }
        catch (ApiException ex)
        {
            _researchNotes.Add($"The required SEO/AEO analysis could not be completed: {ex.Message}");
        }
        catch (HttpRequestException)
        {
            _researchNotes.Add("Couldn't reach the Castmill API. Content generation stays locked until the analysis completes.");
        }
        finally
        {
            _researching = false;
            StateHasChanged();
        }
    }

    /// <summary>Saves the chosen targets so every generator in the run — and any content added
    /// later — reads them.</summary>
    private async Task SaveTargetsAsync(Guid campaignId)
    {
        var keywords = _targets
            .Where(t => t.Selected)
            .Select(t => new SeoTarget(
                t.Term, t.Volume, t.Difficulty, t.Opportunity, t.Source,
                t.Competition, t.Cpc, t.Intent))
            .ToList();

        var questions = _questions
            .Where(q => q.Selected)
            .Select(q => new SeoQuestion(q.Question, q.Source))
            .ToList();

        if (keywords.Count == 0)
        {
            throw new InvalidOperationException("Approve at least one keyword before pressing Run.");
        }

        await Seo.SaveTargetsAsync(campaignId, new SeoTargetsRequest(_primaryKeyword, keywords, questions));
    }

    private async Task ApproveAnalysisAsync()
    {
        if (_campaignId is not { } campaignId || _analysis is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            // Approval lands before the model drafts a single content angle. The brief endpoint
            // reads the saved targets and report, so reversing these two awaits would recreate
            // the post-hoc SEO flow this screen exists to prevent.
            await SaveTargetsAsync(campaignId);
            _step = Step.Brief;
            await SuggestBriefAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or InvalidOperationException)
        {
            _error = ex is ApiException api ? api.Message
                : ex is InvalidOperationException invalid ? invalid.Message
                : "Couldn't reach the Castmill API.";
        }
        finally
        {
            _busy = false;
        }
    }

    private bool _briefing;
    private string? _summary;
    private string? _briefError;
    private readonly List<string> _keyPoints = [];

    /// <summary>
    /// Drafts the brief from the transcript. Suggestions only fill fields the user has left
    /// empty — re-reading must never overwrite something they typed, which is the difference
    /// between a helpful default and a fight with the form.
    /// </summary>
    private async Task SuggestBriefAsync()
    {
        if (_campaignId is not { } campaignId || _transcriptArtifactId is not { } transcriptId)
        {
            return;
        }

        _briefing = true;
        _briefError = null;
        StateHasChanged();

        try
        {
            var brief = await Generation.SuggestBriefAsync(campaignId, transcriptId, _name);

            // The title is the one field the user has already committed to, so it is only
            // taken when they left it blank.
            if (string.IsNullOrWhiteSpace(_name) && brief.Title is { } title)
            {
                _name = title;
            }
            if (string.IsNullOrWhiteSpace(_audience) && brief.Audience is { } audience)
            {
                _audience = audience;
            }
            if (string.IsNullOrWhiteSpace(_angle) && brief.Angle is { } angle)
            {
                _angle = angle;
            }

            _summary = brief.Summary;
            _keyPoints.Clear();
            _keyPoints.AddRange(brief.KeyPoints);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            // A failed draft leaves the form exactly as it was — typing it by hand still works.
            _briefError = ex is ApiException api ? api.Message : "Couldn't reach the Castmill API.";
        }
        finally
        {
            _briefing = false;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _brands.AddRange(await Brands.ListAsync());
        }
        catch (ApiException)
        {
            // Brand-less runs work fine; the picker just offers None.
        }
        catch (HttpRequestException)
        {
        }
    }

    private void BrandChanged(ChangeEventArgs args)
    {
        _brandId = args.Value?.ToString() ?? string.Empty;
        var selected = Guid.TryParse(_brandId, out var brandId)
            ? _brands.FirstOrDefault(brand => brand.Id == brandId)
            : null;
        _voice = selected?.StyleCard?.Voice?.Trim() ?? string.Empty;
    }

    private string StepTitle => StepTitleFor(_step);

    private static string StepTitleFor(Step step) => step switch
    {
        Step.Source => "Pick a source.",
        Step.Transcribing => "Reading the source.",
        Step.Context => "Set the research context.",
        Step.Targets => "Review the deep SEO/AEO report.",
        _ => "Build from the approved strategy.",
    };

    private static string Title(Step step) => step switch
    {
        Step.Source => "Source",
        Step.Transcribing => "Transcript",
        Step.Context => "Context",
        Step.Targets => "SEO/AEO",
        _ => "Production brief",
    };

    private async Task StartIngestAsync()
    {
        _error = null;
        _step = Step.Transcribing;
        _log.Clear();
        _percent = 0;

        try
        {
            await NarrateAsync("creating campaign…", 10);
            var campaign = await Campaigns.CreateAsync(_name.Trim(), brief: null);
            _campaignId = campaign.Id;
            Workspace.Add(campaign);

            await NarrateAsync($"ingesting transcript · {_transcript.Length:N0} characters…", 45);
            var ingest = await Generation.IngestTranscriptAsync(campaign.Id, _transcript);
            _transcriptArtifactId = ingest.TranscriptArtifactId;

            await NarrateAsync($"{ingest.Segments} timed segments · inferring the research audience…", 85);
            await SuggestResearchContextAsync();
            await NarrateAsync("research audience ready for review", 100);
            _step = Step.Context;
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch (HttpRequestException)
        {
            _error = "Couldn't reach the Castmill API.";
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task PickMediaAsync()
    {
        _error = null;
        var picked = await Media.PickMediaAsync();
        if (picked is null)
        {
            return;
        }

        _picked = picked;
        if (_name.Trim().Length == 0)
        {
            _name = System.IO.Path.GetFileNameWithoutExtension(picked.FileName);
        }

        // The pick resumes on the MAUI main thread, outside Blazor's render loop — without
        // an explicit re-render the UI sits unchanged and the flow looks dead. And since
        // the campaign name is auto-filled from the file, there is nothing left to ask:
        // go straight into the narrated pipeline rather than waiting for a second click.
        await InvokeAsync(StateHasChanged);
        await StartLocalIngestAsync();
    }

    /// <summary>
    /// The desktop ingest path (E7.3): extract audio with ffmpeg, transcribe with Whisper
    /// on-device — narrated with the engine's real stage + percent — then send the TIMED
    /// segments to the server, so provenance keeps genuine timestamps.
    /// </summary>
    private async Task StartLocalIngestAsync()
    {
        if (_picked is not { } picked)
        {
            return;
        }

        _error = null;
        _step = Step.Transcribing;
        _log.Clear();
        _percent = 0;
        StateHasChanged();

        var progress = new Progress<PipelineProgress>(p => InvokeAsync(() =>
        {
            _percent = (int)Math.Clamp(p.Percent ?? 0, 0, 100);
            var line = $"{p.Stage}…{(p.Detail is null ? "" : $" {p.Detail}")}";
            if (_log.Count == 0 || !_log[^1].StartsWith(p.Stage, StringComparison.Ordinal))
            {
                _log.Add(line);
            }
            else
            {
                _log[^1] = line;
            }

            StateHasChanged();
        }));

        try
        {
            var transcription = await Media.TranscribeAsync(picked, progress);

            if (transcription.Segments.Count == 0)
            {
                _error = "Whisper heard nothing usable in that file.";
                return;
            }

            await NarrateAsync("creating campaign…", 96);
            var campaign = await Campaigns.CreateAsync(_name.Trim(), brief: null);
            _campaignId = campaign.Id;
            Workspace.Add(campaign);

            await NarrateAsync($"ingesting {transcription.Segments.Count} timed segments…", 98);
            var ingest = await Generation.IngestTranscriptAsync(
                campaign.Id, transcription.JoinedText, picked.FileName, transcription.Segments);
            _transcriptArtifactId = ingest.TranscriptArtifactId;

            await NarrateAsync($"{ingest.Segments} timed segments · inferring the research audience…", 85);
            await SuggestResearchContextAsync();
            await NarrateAsync("research audience ready for review", 100);
            _step = Step.Context;
        }
        catch (NotSupportedException ex)
        {
            _error = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            // The engine's own errors (ffmpeg missing, unreadable file) are user-facing.
            _error = ex.Message;
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch (HttpRequestException)
        {
            _error = "Couldn't reach the Castmill API.";
        }
        finally
        {
            StateHasChanged();
        }
    }

    /// <summary>
    /// Appends a log line and advances the bar. The percentages mark real completed calls,
    /// not a timer — ADR-F13's rule is that progress must mean something.
    /// </summary>
    private async Task NarrateAsync(string line, int percent)
    {
        _log.Add(line);
        _percent = percent;
        StateHasChanged();

        // Yield so the line actually paints before the next call blocks.
        await Task.Yield();
    }

    private async Task SuggestResearchContextAsync()
    {
        if (_campaignId is not { } campaignId || _transcriptArtifactId is not { } transcriptId)
        {
            return;
        }

        _contextSuggesting = true;
        _contextError = null;
        StateHasChanged();

        try
        {
            var suggestion = await Generation.SuggestResearchContextAsync(campaignId, transcriptId);
            if (!string.IsNullOrWhiteSpace(suggestion.Audience))
            {
                _audience = suggestion.Audience.Trim();
            }
            else
            {
                _contextError = "The model did not return a research audience.";
            }
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _contextError = ex is ApiException api
                ? $"Couldn't infer the research audience: {api.Message}"
                : "Couldn't reach the Castmill API to infer the research audience.";
        }
        finally
        {
            _contextSuggesting = false;
            StateHasChanged();
        }
    }

    private string CampaignBrief => string.Join('\n',
        $"Audience: {_audience}",
        $"Brand voice: {_voice}",
        $"Angle: {_angle}");

    private async Task SaveCampaignContextAsync(Guid campaignId)
    {
        var links = _links
            .Where(l => !string.IsNullOrWhiteSpace(l.Url))
            .Select(l => new CampaignLink(
                string.IsNullOrWhiteSpace(l.Label) ? "Link" : l.Label.Trim(), l.Url.Trim()))
            .ToList();
        if (HasValidSiteUrl && !links.Any(link =>
                string.Equals(link.Url, _siteUrl.Trim(), StringComparison.OrdinalIgnoreCase)))
        {
            links.Insert(0, new CampaignLink("Site", _siteUrl.Trim()));
        }

        await Campaigns.UpdateAsync(
            campaignId, _name.Trim(), CampaignBrief,
            Guid.TryParse(_brandId, out var brandId) ? brandId : null,
            links.Count > 0 ? links : null);
    }

    private async Task PressRunAsync()
    {
        if (_campaignId is not { } campaignId)
        {
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            if (_analysis is null)
            {
                _error = "Complete the SEO/AEO analysis before starting the content run.";
                return;
            }
            await SaveCampaignContextAsync(campaignId);

            if (_transcriptArtifactId is not { } transcriptId)
            {
                _error = "This campaign has no transcript to generate from.";
                return;
            }

            // Saved BEFORE the run: the orchestrator reads targets off the campaign when it
            // builds each prompt, so a save that lands after the fan-out starts steers nothing.
            await SaveTargetsAsync(campaignId);

            // Hand the run to the press-run service and go straight to the Mill Floor:
            // the reveal happens there, card by card, as completions land (ADR-F13).
            PressRun.Start(
                campaignId, transcriptId, CampaignBrief,
                ExpandKinds(_fanOut.Where(f => f.Selected).Select(f => f.Kind)));

            Navigation.NavigateTo(CampaignViews.PathFor(campaignId, CampaignView.MillFloor));
        }
        catch (ApiException ex)
        {
            // A failed run must not lose the campaign the user just created.
            _error = $"{ex.Message} The campaign was created — you can start the run from its Mill Floor.";
        }
        catch (HttpRequestException)
        {
            _error = "Couldn't reach the Castmill API.";
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
