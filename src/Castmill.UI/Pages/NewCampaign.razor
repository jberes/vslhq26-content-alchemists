                new(SourceStarter.Document, "▤", "Upload document", "TXT, Markdown, HTML, PDF, DOCX, or PPTX"),
                new(SourceStarter.CloudMedia, "↑", "Upload media", "Private resumable audio or video transcription"),
            };
