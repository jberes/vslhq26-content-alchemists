            }
            if (Media.CanProcessLocally)
            {
                starters.Add(new StarterOption(
                    SourceStarter.LocalMedia, "▶", "Local media", "Audio or video transcribed on this machine"));
            }
            return starters;
        }
    }

    private static readonly IntentOption[] IntentOptions =
    [
        new(CampaignIntent.Repurpose, "Repurpose", "Turn the source into a coordinated multi-channel campaign"),
        new(CampaignIntent.Promote, "Promote", "Drive attention to the source, offer, or event"),
        new(CampaignIntent.Launch, "Launch", "Introduce something new with a focused market narrative"),
        new(CampaignIntent.BuildAuthority, "Build authority", "Own a topic with useful, evidence-backed depth"),
        new(CampaignIntent.Refresh, "Refresh", "Reframe existing material for current demand and gaps"),
        new(CampaignIntent.CaptureIdea, "Capture an idea", "Develop early source material into a deliberate campaign"),
    ];

    private static readonly IntentOption[] WebPageIntentOptions =
    [
        new(CampaignIntent.Repurpose, "Repurpose this page", "Turn the saved page into a coordinated multi-channel campaign"),
        new(CampaignIntent.Promote, "Promote or expand this page", "Drive attention to the page or develop its evidence into deeper content"),
    ];

    private IReadOnlyList<IntentOption> AvailableIntentOptions =>
        _sourceStarter == SourceStarter.WebPage ? WebPageIntentOptions : IntentOptions;

    private bool ImportedEvidenceIsApproved => _importedEvidence?.IsApproved != false;

    private static string IntentLabel(string? intent) =>
        IntentOptions.FirstOrDefault(option => option.Value == intent)?.Label ?? "Intent not selected";

    private sealed class FanOutItem(string kind, string label, bool selected = true)
    {
        public string Kind { get; } = kind;

        public string Label { get; } = label;

        public bool Selected { get; set; } = selected;
    }

    private readonly List<string> _log = [];

    // Only the blog (and the cheap slot reservation) run by default: a full fan-out
    // against live models takes minutes, and the owner wants fast first feedback with
    // everything else generated on demand from the Mill Floor (2026-07-29). Images are
    // NEVER generated here — the plan only reserves slots + prompts; pixels are made in
    // the Image Studio, deliberately.
    // "social" expands to the six real per-platform generator kinds at submit — the
    // orchestrator matches kinds exactly. Image slots are reserved automatically by any
    // run, so there is no image checkbox: pixels only ever come from the Image Studio.
    /// <summary>
    /// Derived from the kind registry, never listed by hand — a hand-kept copy here is how
    /// "youtube" shipped as a generator, a lane and a board chip while the ONE surface that
    /// starts a full run never offered it. YouTube leads and is on by default: a perfect
    /// YouTube package is the app's founding use case.
    /// </summary>
    private readonly List<FanOutItem> _fanOut = BuildFanOutChoices();
    private readonly SemaphoreSlim _campaignSaveLock = new(1, 1);

    private static List<FanOutItem> BuildFanOutChoices()
    {
        var items = new List<FanOutItem>
        {
            new("youtube", "YouTube package"),
            new("blog", "Blog post"),
            new("social", "Social set (6 platforms)", selected: false),
        };

        items.AddRange(ArtifactDisplay.UserGeneratableKinds
            .Where(k => k.Lane != "Social"
                        && k.Kind is not ("blog" or "youtube"))
            .Select(k => new FanOutItem(k.Kind, k.Label, selected: false)));

        return items;
    }

    private static string[] ExpandKinds(IEnumerable<string> kinds) =>
        // image-prompts always rides along on the initial run: it is what seeds the reserved
        // image slots, and omitting it here is why campaigns sat at 0/6 images until someone
        // pressed "Seed all prompts" by hand.
        [.. kinds.SelectMany(k => k == "social" ? ArtifactDisplay.SocialKinds : [k]),
         "thumbnail-concepts", "image-prompts"];

    private IReadOnlyList<string> SelectedRecipe() =>
        _fanOut.Where(item => item.Selected).Select(item => item.Kind).ToList();

    private async Task RecipeChangedAsync(FanOutItem item, ChangeEventArgs args)
    {
        item.Selected = args.Value is true;
        if (_campaignId is not { } campaignId)
        {
            return;
        }
        try
        {
            await SaveCampaignContextAsync(campaignId);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _error = ex is ApiException api ? api.Message : "Couldn't save the output recipe.";
        }
    }

    private sealed class LinkRow
    {
        public string Label { get; set; } = string.Empty;
        public string Url { get; set; } = string.Empty;
    }

    private readonly List<BrandProfileDetailResponse> _brands = [];
    private readonly List<LinkRow> _links = [];
    private string _brandId = string.Empty;

    private Step _step = Step.Source;

    // Focus the first field when a step opens: without it, keyboard focus sits at the
    // document top and Tab walks the whole rail before ever reaching the form.
    private ElementReference _sourceFirstField;
    private ElementReference _briefFirstField;
    private ElementReference _sourceReviewPanel;
    private Step? _focusedStep;
    private bool _sourceReviewOpen;
    private bool _sourceReviewNeedsFocus;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_sourceReviewNeedsFocus)
        {
            _sourceReviewNeedsFocus = false;
            try
            {
                await _sourceReviewPanel.FocusAsync();
            }
            catch (Exception)
            {
            }
            return;
        }

        if (_focusedStep == _step)
        {
            return;
        }

        try
        {
            switch (_step)
            {
                case Step.Source:
                    await _sourceFirstField.FocusAsync();
                    _focusedStep = _step;
                    break;
                case Step.Context:
                    await _briefFirstField.FocusAsync();
                    _focusedStep = _step;
                    break;
                default:
                    // Steps without a first field (Transcribing, Targets) claim no focus.
                    _focusedStep = _step;
                    break;
            }
        }
        catch (Exception)
        {
            // Focus is a nicety; a torn-down or not-yet-rendered element must not fault the render.
        }
    }

    private string _name = string.Empty;
    private string _transcript = string.Empty;
    private string _sourceUrl = string.Empty;
    private IBrowserFile? _documentFile;
    private IBrowserFile? _mediaFile;
    private MediaUploadResponse? _mediaUpload;
    private CancellationTokenSource? _mediaCancellation;
    private bool _cloudOperation;
