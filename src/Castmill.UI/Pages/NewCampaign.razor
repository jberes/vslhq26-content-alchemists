@* Start a Run is one six-step path for every working source capability (ADR-F29).
    1. source                    capability-backed text, page, document, or local media
    2. reading                   determinate import/transcription progress (ADR-F13)
    3. intent                    source review plus campaign intent
    4. research context          audience, voice, brand and required site URL; no generation
    5. deep SEO/AEO report       live evidence, suggestions and editable target approval
    6. output recipe             AI-drafted brief, persisted recipe, then Press Run

   Desktop (F7): pick an MP3/MP4 → ffmpeg extracts → Whisper transcribes on-device → the
   TIMED segments go to the server. Web: capability flagged off with a stated reason (G3);
   pasted transcripts work everywhere.
*@
@page "/campaigns/new"
@using Castmill.Core
@using Castmill.Core.Resources
@using Castmill.UI.Design
@using Castmill.UI.Http
@using Castmill.UI.Platform
@using Castmill.UI.State
@using Microsoft.AspNetCore.Components.Forms
@inject BrandsClient Brands
@inject SeoClient Seo
@inject CampaignsClient Campaigns
@inject GenerationClient Generation
@inject EvidenceClient Evidence
@inject MediaUploadClient MediaUploads
@inject WorkspaceState Workspace
@inject PressRunService PressRun
@inject IMediaPipeline Media
@inject IVoiceCaptureService Voice
@inject INotifier Notifier
@inject NavigationManager Navigation

<PageTitle>Start a run — Castmill</PageTitle>

<div class="cm-page"><div class="cm-measure--dashboard cm-run">
    <header class="cm-front__head">
        <span class="cm-kicker">Step @((int)_step + 1) of @(Enum.GetValues<Step>().Length)</span>
        <h1>@StepTitle</h1>
    </header>

    <ol class="cm-steps" aria-label="Progress">
        @foreach (var step in Enum.GetValues<Step>())
        {
            <li class="cm-steps__step @(step <= _step ? "cm-steps__step--done" : "")"
                aria-current="@(step == _step ? "step" : "false")">
                <span class="cm-mono">@((int)step + 1)</span>
                <span>@(step == Step.Targets && _skipSeoAnalysis ? "SEO/AEO skipped" : Title(step))</span>
            </li>
        }
    </ol>

    <section class="cm-run__panel" hidden="@(!_step.Equals(Step.Source))">
            <div class="cm-starter-grid" role="list" aria-label="Source type">
                @foreach (var starter in AvailableStarters)
                {
                    <button type="button" role="listitem"
                            class="cm-starter @(_sourceStarter == starter.Kind ? "cm-starter--active" : null)"
                            aria-pressed="@(_sourceStarter == starter.Kind ? "true" : "false")"
                            @onclick="() => SelectStarter(starter.Kind)">
                        <span class="cm-starter__mark" aria-hidden="true">@starter.Mark</span>
                        <span class="cm-starter__copy">
                            <strong>@starter.Label</strong>
                            <span class="cm-meta">@starter.Detail</span>
                        </span>
                    </button>
                }
            </div>
            @if (_voiceUnavailableReason is { Length: > 0 } voiceReason)
            {
                <p class="cm-meta" role="status">Voice recording unavailable: @voiceReason</p>
            }

            <label class="cm-field">
                <span class="cm-field__label">Campaign name</span>
                <input class="cm-input" @ref="_sourceFirstField" @bind="_name" @bind:event="oninput"
                       placeholder="Q3 product webinar" />
            </label>

            @if (_sourceStarter == SourceStarter.PasteText)
            {
                <label class="cm-field">
                    <span class="cm-field__label">Paste source text</span>
                    <textarea class="cm-input cm-textarea" rows="8" @bind="_transcript" @bind:event="oninput"
                              placeholder="Paste a transcript, notes, article draft, or source material."></textarea>
                    <span class="cm-field__hint cm-meta">@_transcript.Length characters</span>
                </label>
            }
            else if (_sourceStarter == SourceStarter.WebPage)
            {
                <label class="cm-field">
                    <span class="cm-field__label">Public webpage URL</span>
                    <input class="cm-input" type="url" @bind="_sourceUrl" @bind:event="oninput"
                           placeholder="https://example.com/article" />
                    <span class="cm-field__hint cm-meta">Castmill saves an immutable HTML snapshot; it never runs page scripts.</span>
                </label>
            }
            else if (_sourceStarter == SourceStarter.Document)
            {
                <label class="cm-field cm-dropzone">
                    <span class="cm-field__label">Upload a document</span>
                    <InputFile OnChange="DocumentSelected" accept=".txt,.md,.markdown,.html,.htm,.pdf,.docx,.pptx" />
                    <span class="cm-field__hint cm-meta">TXT, Markdown, HTML, PDF, DOCX, or PPTX · 20 MB maximum</span>
                    @if (_documentFile is not null)
                    {
                        <span class="cm-mono cm-meta">@_documentFile.Name · @(_documentFile.Size / 1024) KB</span>
                    }
                </label>
            }
            else if (_sourceStarter == SourceStarter.CloudMedia)
            {
                <label class="cm-field cm-dropzone">
                    <span class="cm-field__label">Upload audio or video</span>
                    <InputFile OnChange="CloudMediaSelected" accept="audio/*,video/*" />
                    <span class="cm-field__hint cm-meta">Private resumable upload · 2 GB maximum</span>
                    @if (_mediaFile is not null)
                    {
                        <span class="cm-mono cm-meta">@_mediaFile.Name · @FormatBytes(_mediaFile.Size)</span>
                    }
                    else if (_mediaUpload is { Status: MediaUploadStatus.Uploading } pending)
                    {
                        <span class="cm-meta">
                            Reselect @pending.FileName to resume at @FormatBytes(pending.UploadedBytes)
                            of @FormatBytes(pending.TotalBytes).
                        </span>
                    }
                </label>
            }
            else if (_sourceStarter == SourceStarter.VoiceNote)
            {
                <VoiceRecorder OnUse="UseVoiceRecordingAsync" />
            }
            else if (_sourceStarter == SourceStarter.LocalMedia)
            {
                <div class="cm-dropzone">
                    <p class="cm-dropzone__headline">Bring video or audio</p>
                    <p class="cm-meta">MP3, MP4, MOV, M4A, WAV — transcribed on this machine.</p>
                    <button type="button" class="cm-button" @onclick="PickMediaAsync">Pick files…</button>
                    @if (_pickedFiles.Count > 0)
                    {
                        <ul class="cm-log" aria-label="Selected source files">
                            @foreach (var picked in _pickedFiles)
                            {
                                <li class="cm-mono cm-meta">@picked.FileName · @(picked.SizeBytes / 1_048_576) MB</li>
                            }
                        </ul>
                    }
                </div>
            }

            @if (_error is not null && _step == Step.Source)
            {
                <p class="cm-form__error" role="alert">@_error</p>
            }

            <div class="cm-form__actions">
                @if (_sourceStarter == SourceStarter.LocalMedia)
                {
                    <button type="button" class="cm-button" disabled="@(_name.Trim().Length == 0)"
                            @onclick="StartLocalIngestAsync">
                        Transcribe on this machine
                    </button>
                }
                else if (_sourceStarter == SourceStarter.WebPage)
                {
                    <button type="button" class="cm-button" disabled="@(!CanStart)" @onclick="StartWebImportAsync">Import webpage</button>
                }
                else if (_sourceStarter == SourceStarter.Document)
                {
                    <button type="button" class="cm-button" disabled="@(!CanStart)" @onclick="StartDocumentImportAsync">Import document</button>
                }
                else if (_sourceStarter == SourceStarter.CloudMedia)
                {
                    <button type="button" class="cm-button" disabled="@(!CanStart)" @onclick="StartCloudMediaIngestAsync">
                        @(_mediaUpload is { Status: MediaUploadStatus.Uploading, UploadedBytes: > 0 }
                            ? "Resume upload"
                            : "Upload and transcribe")
                    </button>
                }
                else if (_sourceStarter == SourceStarter.VoiceNote)
                {
                }
                else
                {
                    <button type="button" class="cm-button" disabled="@(!CanStart)" @onclick="StartIngestAsync">Use pasted text</button>
                }
                <a class="cm-meta" href="campaigns">Cancel</a>
            </div>
    </section>
    @if (_step == Step.Transcribing)
    {
        <section class="cm-run__panel">
            @* Determinate progress + a narrated log line. The steps are real: each one is a
               call that has either completed or not. *@
            <div class="cm-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100"
                 aria-valuenow="@_percent">
                <div class="cm-progress__fill" style="inline-size: @_percent%"></div>
            </div>

            <ul class="cm-log">
                @foreach (var line in _log)
                {
                    <li class="cm-mono cm-meta">@line</li>
                }
            </ul>

            @if (_error is not null)
            {
                <p class="cm-form__error" role="alert">@_error</p>
            }
            @if (IsCloudMediaSource && _mediaUpload is not null)
            {
                <div class="cm-form__actions">
                    @if (_cloudOperation && _mediaUpload.Status == MediaUploadStatus.Uploading)
                    {
                        <button type="button" class="cm-button cm-button--quiet"
                                @onclick="ToggleUploadPause">
                            @(_uploadPaused ? "Resume" : "Pause")
                        </button>
                    }
                    @if (!_cloudOperation && _mediaFile is not null && _error is not null)
                    {
                        <button type="button" class="cm-button" @onclick="ReturnToCloudMediaSelection">
                            Reselect file to resume
                        </button>
                    }
                    <button type="button" class="cm-button cm-button--quiet"
                            @onclick="CancelCloudUploadAsync">Cancel upload</button>
                </div>
            }
            @if (_error is not null)
            {
                <div class="cm-form__actions">
                    <button type="button" class="cm-button cm-button--quiet" @onclick="() => _step = Step.Source">
                        Back
                    </button>
                </div>
            }
        </section>
    }
    else if (_step == Step.Intent)
    {
        <section class="cm-run__panel cm-run__panel--wide">
            <div class="cm-run__decision-layout">
                <div class="cm-run__decision">
                    <p class="cm-seo__banner">
                        <strong>The source is saved.</strong> Choose why this campaign exists.
                        Intent steers research and production without changing the approved source.
                    </p>
                    <div class="cm-intent-grid" role="radiogroup" aria-label="Campaign intent">
                        @foreach (var option in AvailableIntentOptions)
                        {
                            <button type="button" role="radio"
                                    class="cm-intent @(_intent == option.Value ? "cm-intent--active" : null)"
                                    aria-checked="@(_intent == option.Value ? "true" : "false")"
                                    disabled="@(_busy || !ImportedEvidenceIsApproved)"
                                    @onclick="() => ChooseIntentAsync(option.Value)">
                                <strong>@option.Label</strong>
                                <span class="cm-meta">@option.Detail</span>
                            </button>
                        }
                    </div>
                    @if (!ImportedEvidenceIsApproved)
                    {
                        <p class="cm-meta">Approve the current evidence revision before choosing an intent.</p>
                    }
                    @if (_error is not null)
                    {
                        <p class="cm-form__error" role="alert">@_error</p>
                    }
                </div>

                @if (_importedEvidence is { } importedEvidence)
                {
                    <aside class="cm-run__source-summary" aria-label="Imported source summary">
                        <div class="cm-run__source-summary-head">
                            <div>
                                <span class="cm-kicker">Source ready</span>
                                <h2>@importedEvidence.Source.Label</h2>
                            </div>
                            <span class="cm-badge @(importedEvidence.IsApproved ? "cm-badge--success" : "cm-badge--warning")">
                                @(importedEvidence.IsApproved ? "Approved" : $"Draft r{importedEvidence.Revision}")
                            </span>
                        </div>
                        <div class="cm-run__source-facts cm-meta">
                            <span>@SourceBlockLabel(importedEvidence)</span>
                            @if (SourceDuration(importedEvidence) is { } duration)
                            {
                                <span>@Clock(duration)</span>
                            }
                            <span>@importedEvidence.Source.Modality</span>
                        </div>
                        @if (SourceExcerpt(importedEvidence) is { Length: > 0 } excerpt)
                        {
                            <blockquote>@excerpt</blockquote>
                        }
                        <button type="button" class="cm-button cm-button--quiet"
                                @onclick="OpenSourceReview">
                            @SourceReviewLabel(importedEvidence)
                        </button>
                    </aside>
                }
            </div>
        </section>
    }
    else if (_step == Step.Context)
    {
        <section class="cm-run__panel">
            <p class="cm-seo__banner">
                <strong>No content is generated at this stage.</strong> Castmill infers the
                research audience from approved source evidence, and the selected Brand supplies its
                approved voice. The SEO/AEO report comes next; titles, angles, and the production
                brief are derived only after you approve it.
            </p>

            <label class="cm-field">
                <span class="cm-field__label">Brand</span>
                <select class="cm-input cm-brand__kind" value="@_brandId" @onchange="BrandChanged">
                    <option value="">None</option>
                    @foreach (var brand in _brands)
                    {
                        <option value="@brand.Id">@brand.Name</option>
                    }
                </select>
                <span class="cm-field__hint cm-meta">
                    The selected Brand's saved style card is authoritative for voice, colours and templates.
                </span>
            </label>

            <div class="cm-brief">
                <label class="cm-field cm-brief__compact">
                    <span class="cm-field__label">Content type</span>
                    <select class="cm-input" @bind="_contentType">
                        @foreach (var contentType in CampaignContentType.All)
                        {
                            <option value="@contentType">@CampaignContentType.DisplayLabel(contentType)</option>
                        }
                    </select>
                    <span class="cm-field__hint cm-meta">Steers the analysis, brief, and every downstream generator.</span>
                </label>
                <label class="cm-field cm-brief__wide">
                    <span class="cm-field__label">AI-generated audience for the analysis</span>
                    <textarea class="cm-input cm-textarea" rows="2" @ref="_briefFirstField" @bind="_audience"
                              placeholder="@(_contextSuggesting ? "Inferring the audience from approved evidence…" : "Audience inferred from approved evidence")"></textarea>
                    <span class="cm-field__hint cm-meta">Review or refine this before research.</span>
                </label>
                <label class="cm-field cm-brief__wide">
                    <span class="cm-field__label">Brand voice — from selected Brand</span>
                    <textarea class="cm-input cm-textarea" rows="2" value="@_voice" readonly
                              aria-readonly="true"
                              placeholder="@BrandVoicePlaceholder"></textarea>
                </label>
                <label class="cm-field cm-brief__compact">
                    <span class="cm-field__label">Site URL <span class="cm-meta">SEO/AEO only</span></span>
                    <input class="cm-input" type="url" @bind="_siteUrl" @bind:event="oninput"
                           placeholder="https://example.com" />
                    <span class="cm-field__hint cm-meta">Required only for the deep SEO/AEO path: rankings, backlinks, competitors, and AI citation visibility.</span>
                </label>
            </div>

            <button type="button" class="cm-button cm-button--quiet"
                    disabled="@_contextSuggesting" @onclick="SuggestResearchContextAsync">
                @(_contextSuggesting ? "Inferring audience…" : "Regenerate audience from evidence")
            </button>
            @if (_contextError is { } contextError)
            {
                <p class="cm-form__error" role="alert">@contextError You can refine the audience manually or try again.</p>
            }

            <h2 class="cm-front__block-title">Context links</h2>
            <p class="cm-meta">
                Real destinations — the home page, GitHub pages, docs — that generated
                content should reference and link to.
            </p>
            @foreach (var link in _links)
            {
                <div class="cm-links__row">
                    <input class="cm-input" placeholder="Label (Home page…)"
                           maxlength="100" @bind="link.Label" />
                    <input class="cm-input" placeholder="https://…" maxlength="2000" @bind="link.Url" />
                    <button type="button" class="cm-tree__delete" aria-label="Remove link"
                            @onclick="() => _links.Remove(link)">✕</button>
                </div>
            }
            <button type="button" class="cm-button cm-button--quiet" @onclick="() => _links.Add(new LinkRow())"
                    disabled="@(_links.Count >= 10)">+ Add link</button>

            @if (_error is not null)
            {
                <p class="cm-form__error" role="alert">@_error</p>
            }

            <div class="cm-form__actions">
                <button type="button" class="cm-button" disabled="@(!CanRunAnalysis)" @onclick="GoToTargetsAsync">
                    Build the deep SEO/AEO report
                </button>
                <button type="button" class="cm-button cm-button--quiet"
                        disabled="@(!CanSkipSeo)" @onclick="SkipSeoAsync">
                    Create content without SEO
                </button>
                @if (!HasValidSiteUrl)
                {
                    <span class="cm-meta">No URL needed to create source-informed content. Enter one only for the deep analysis.</span>
                }
            </div>
        </section>
    }
    else if (_step == Step.Targets)
    {
        <section class="cm-run__panel">
            @* Analysis is a required production stage, not a post-hoc report. Content cannot
               run until this report exists and its targets have been approved. *@
            @if (_researching)
            {
                <div class="cm-brief__reading" role="status">
                    <span class="cm-spinner" aria-hidden="true"></span>
                    <span>Building the deep SEO/AEO report — demand, SERP, AI visibility, rankings, authority, competitors, gaps and content opportunities…</span>
                </div>
            }
            else
            {
                @if (_researchNotes.Count > 0)
                {
                    @foreach (var note in _researchNotes)
                    {
                        <p class="cm-meta">@note</p>
                    }
                }

                @if (_analysis is { } analysis)
                {
                    <DeepSeoReport Report="analysis" />
                }

                <h2 class="cm-front__block-title">
                    Keywords
                    <span class="cm-mono cm-meta">(@_targets.Count(t => t.Selected) selected)</span>
                </h2>
                <p class="cm-meta">
                    The primary keyword goes in the title, the first heading and the opening
                    paragraph of everything printed.
                    @if (!_hasMetrics)
                    {
                        <text>No volume data — these are the model's reading of your source.</text>
                    }
                </p>

                @if (_targets.Count == 0)
                {
                    <p class="cm-form__error">No grounded keywords came back. Refine the brief and rerun the analysis before generating content.</p>
                }
                else
                {
                    <ul class="cm-targets">
                        @foreach (var target in _targets)
                        {
                            <li class="cm-targets__row @(target.Selected ? "cm-targets__row--on" : null)">
                                <label class="cm-targets__pick">
                                    <input type="checkbox" checked="@target.Selected"
                                           @onchange="e => Toggle(target, e)" />
                                    <span>@target.Term</span>
                                </label>
                                <button type="button"
                                        class="cm-primary-pick @(IsPrimary(target) ? "cm-primary-pick--on" : null)"
                                        aria-pressed="@(IsPrimary(target) ? "true" : "false")"
                                        title="Make this the primary keyword"
                                        @onclick="() => MakePrimary(target)">
                                    @(IsPrimary(target) ? "★ Primary" : "Set primary")
                                </button>
                                <span class="cm-mono cm-meta">
                                    @(target.Volume is { } v ? $"{v:N0}/mo" : "—")
                                </span>
                                <span class="cm-mono cm-meta">
                                    @(target.Difficulty is { } d ? $"KD {d:0}" : "—")
                                </span>
                            </li>
                        }
                    </ul>
                }

                @* Free-form entry: research proposes, but you know your product — a keyword the
                   transcript never says out loud is often the one worth targeting. Added with a
                   source of "manual" and no metrics, honestly. *@
                <div class="cm-links__row cm-targets__add">
                    <input class="cm-input" placeholder="Add a keyword of your own…"
                           aria-label="Add a keyword"
                           @bind="_manualKeyword" @bind:event="oninput"
                           @onkeydown="@(e => { if (e.Key == "Enter") AddManualKeyword(); })" />
                    <button type="button" class="cm-button cm-button--quiet"
                            disabled="@string.IsNullOrWhiteSpace(_manualKeyword)"
                            @onclick="AddManualKeyword">+ Add keyword</button>
                </div>

                <h2 class="cm-front__block-title">
                    Questions to answer
                    <span class="cm-mono cm-meta">(@_questions.Count(q => q.Selected) selected)</span>
                </h2>
                <p class="cm-meta">
                    Each selected question is answered in a self-contained sentence — that is what
                    an AI assistant can quote when someone asks.
                </p>

                @if (_questions.Count == 0)
                {
                    <p class="cm-meta">No questions found for this source.</p>
                }
                else
                {
                    <ul class="cm-targets">
                        @foreach (var question in _questions)
                        {
                            <li class="cm-targets__row @(question.Selected ? "cm-targets__row--on" : null)">
                                <label class="cm-targets__pick">
                                    <input type="checkbox" checked="@question.Selected"
                                           @onchange="e => ToggleQuestion(question, e)" />
                                    <span>@question.Question</span>
                                </label>
                                <span class="cm-chip cm-mono">@QuestionSource(question.Source)</span>
                            </li>
                        }
                    </ul>
                }
            }

            @if (_error is not null)
            {
                <p class="cm-form__error" role="alert">@_error</p>
            }

            <div class="cm-form__actions">
                <button type="button" class="cm-button" disabled="@(!CanApproveReport)"
                        @onclick="ApproveAnalysisAsync">
                    @(_busy ? "Building the content brief…" : "Approve report & build content brief")
                </button>
                <button type="button" class="cm-button cm-button--quiet" disabled="@_busy"
                        @onclick="() => _step = Step.Context">
                    Back
                </button>
                <button type="button" class="cm-button cm-button--quiet" disabled="@(_busy || _researching)"
                        @onclick="ResearchAsync">
                    Re-run analysis
                </button>
                <span class="cm-meta">
                    @(_targets.Count(t => t.Selected)) keywords ·
                    @(_questions.Count(q => q.Selected)) questions
                </span>
            </div>
        </section>
    }
    else if (_step == Step.Brief)
    {
        <section class="cm-run__panel">
            <p class="cm-seo__banner">
                <strong>@(_skipSeoAnalysis ? "Built from approved source evidence." : "Built from the approved report.")</strong>
                @(_skipSeoAnalysis
                    ? " This production brief and every selected output are grounded in the source, without keyword or ranking targets."
                    : " This production brief, its angle, and every selected output inherit the SEO/AEO evidence you just approved.")
                <span class="cm-chip cm-mono">@IntentLabel(_intent)</span>
            </p>

            @if (_briefing)
            {
                <div class="cm-brief__reading" role="status">
                    <span class="cm-spinner" aria-hidden="true"></span>
                    <span>@(_skipSeoAnalysis ? "Turning the approved source into a production brief…" : "Turning the approved SEO/AEO strategy into a production brief…")</span>
                </div>
            }
            else if (_summary is { } summary)
            {
                <div class="cm-brief__summary">
                    <div class="cm-brief__summary-head">
                        <span class="cm-kicker">@(_skipSeoAnalysis ? "Source-informed content brief" : "SEO-informed source brief")</span>
                        <button type="button" class="cm-button cm-button--quiet" @onclick="SuggestBriefAsync">
                            @(_skipSeoAnalysis ? "Rebuild from source" : "Rebuild from report")
                        </button>
                    </div>
                    <p>@summary</p>
                    @if (_keyPoints.Count > 0)
                    {
                        <ul class="cm-brief__points">
                            @foreach (var point in _keyPoints)
                            {
                                <li>@point</li>
                            }
                        </ul>
                    }
                </div>
            }
            else if (_briefError is { } briefError)
            {
                <p class="cm-form__error" role="alert">
                    Couldn't build the content brief — @briefError
                    <button type="button" class="cm-button cm-button--quiet" @onclick="SuggestBriefAsync">Try again</button>
                </p>
            }

            <div class="cm-brief">
                <label class="cm-field cm-brief__compact">
                    <span class="cm-field__label">Content type</span>
                    <select class="cm-input" @bind="_contentType">
                        @foreach (var contentType in CampaignContentType.All)
                        {
                            <option value="@contentType">@CampaignContentType.DisplayLabel(contentType)</option>
                        }
                    </select>
                </label>
                <label class="cm-field cm-brief__wide">
                    <span class="cm-field__label">Audience</span>
                    <textarea class="cm-input cm-textarea" rows="2" @bind="_audience"></textarea>
                </label>
                <label class="cm-field cm-brief__wide">
                    <span class="cm-field__label">Brand voice — from selected Brand</span>
                    <textarea class="cm-input cm-textarea" rows="2" value="@_voice" readonly
                              aria-readonly="true" placeholder="@BrandVoicePlaceholder"></textarea>
                </label>
                <label class="cm-field cm-brief__wide">
                    <span class="cm-field__label">@(_skipSeoAnalysis ? "Campaign angle" : "SEO-informed campaign angle")</span>
                    <textarea class="cm-input cm-textarea" rows="3" @bind="_angle"
                              placeholder="@(_skipSeoAnalysis ? "The source-informed brief will propose the core angle." : "The approved report will propose the core angle.")"></textarea>
                </label>
            </div>

            <h2 class="cm-front__block-title">Output recipe</h2>
            <p class="cm-meta">Choose the first outputs to produce from this shared strategy. This recipe is saved on the campaign and remains editable before Press Run.</p>
            <ul class="cm-fanout">
                @foreach (var item in _fanOut)
                {
                    <li>
                        <label class="cm-fanout__item">
                            <input type="checkbox" checked="@item.Selected"
                                @onchange="e => RecipeChangedAsync(item, e)" />
                            <span>@item.Label</span>
                        </label>
                    </li>
                }
            </ul>

            @if (_error is not null)
            {
                <p class="cm-form__error" role="alert">@_error</p>
            }

            <div class="cm-form__actions">
                <button type="button" class="cm-button" disabled="@(_busy || _briefing)" @onclick="PressRunAsync">
                    @(_busy ? "Starting the run…" : "Press Run")
                </button>
                <button type="button" class="cm-button cm-button--quiet" disabled="@_busy"
                        @onclick="() => _step = _skipSeoAnalysis ? Step.Context : Step.Targets">
                    @(_skipSeoAnalysis ? "Back to context" : "Back to report")
                </button>
                <span class="cm-meta">@_fanOut.Count(f => f.Selected) of @_fanOut.Count selected</span>
            </div>
        </section>
    }
</div>
</div>

@if (_sourceReviewOpen && _importedEvidence is { } reviewEvidence)
{
    <div class="cm-run-review" role="presentation" @onclick="CloseSourceReview">
        <section class="cm-run-review__drawer" role="dialog" aria-modal="true"
                 aria-label="Review source evidence" tabindex="-1" @ref="_sourceReviewPanel"
                 @onclick:stopPropagation="true" @onkeydown="OnSourceReviewKey">
            <header class="cm-run-review__head">
                <div>
                    <span class="cm-kicker">Source review</span>
                    <h2>@reviewEvidence.Source.Label</h2>
                </div>
                <button type="button" class="cm-button cm-button--quiet"
                        aria-label="Close source review" @onclick="CloseSourceReview">Close</button>
            </header>
            <div class="cm-run-review__body">
                <SourceEvidenceReview Source="reviewEvidence.Source"
                                      Evidence="reviewEvidence"
                                      CampaignId="reviewEvidence.Source.CampaignId"
                                      Busy="_busy"
                                      OnCorrect="CorrectImportedEvidenceAsync"
                                      OnToggleExcluded="ToggleImportedEvidenceAsync"
                                      OnApprove="ApproveImportedEvidenceAsync" />
            </div>
        </section>
    </div>
}

@code {
    private enum Step
    {
