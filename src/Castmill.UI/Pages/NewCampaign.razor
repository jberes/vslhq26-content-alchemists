                + (picked.Count > 1 ? $" + {picked.Count - 1} sources" : string.Empty);
        }

        // The pick resumes on the MAUI main thread, outside Blazor's render loop — without
        // an explicit re-render the UI sits unchanged and the flow looks dead. And since
        // the campaign name is auto-filled from the file, there is nothing left to ask:
