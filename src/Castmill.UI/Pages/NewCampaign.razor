        SourceStarter.PasteText => _transcript.Trim().Length > 40,
        SourceStarter.WebPage => Uri.TryCreate(_sourceUrl.Trim(), UriKind.Absolute, out var url)
            && url.Scheme is "http" or "https",
        SourceStarter.Document => _documentFile is { Size: > 0 and <= 20 * 1024 * 1024 },
        SourceStarter.CloudMedia => _mediaFile is { Size: > 0 and <= MaxMediaBytes },
        SourceStarter.VoiceNote => _mediaFile is { Size: > 0 and <= MaxMediaBytes },
        SourceStarter.LocalMedia => _pickedFiles.Count > 0,
        _ => false,
    };
    private bool HasValidSiteUrl => Uri.TryCreate(_siteUrl.Trim(), UriKind.Absolute, out var site)
        && site.Scheme is "http" or "https";
    private bool CanRunAnalysis => !_busy && !_researching && !_contextSuggesting
        && !string.IsNullOrWhiteSpace(_audience) && HasValidSiteUrl;
    private bool CanSkipSeo => !_busy && !_contextSuggesting
        && !string.IsNullOrWhiteSpace(_audience);

    private string BrandVoicePlaceholder => string.IsNullOrWhiteSpace(_brandId)
        ? "Select a Brand to inherit its voice"
        : "This Brand has no saved voice guidelines";

    private const long MaxMediaBytes = 2L * 1024 * 1024 * 1024;
    private bool IsCloudMediaSource =>
        _sourceStarter is SourceStarter.CloudMedia or SourceStarter.VoiceNote;

    // ---- Deep report and target-approval step ------------------------------------------

    private sealed class TargetRow
    {
        public required string Term { get; init; }

        public long? Volume { get; init; }

        public double? Difficulty { get; init; }

        public double? Opportunity { get; init; }

        public double? Competition { get; init; }

        public double? Cpc { get; init; }

        public string? Intent { get; init; }

        public required string Source { get; init; }

        public bool Selected { get; set; }
    }

    private sealed class QuestionRow
    {
        public required string Question { get; init; }

        public required string Source { get; init; }

        public bool Selected { get; set; }
    }

    private readonly List<TargetRow> _targets = [];
    private string _manualKeyword = string.Empty;
    private readonly List<QuestionRow> _questions = [];
    private readonly List<string> _researchNotes = [];
    private bool _researching;
    private bool _hasMetrics;
    private string? _primaryKeyword;
    private SeoAnalysisReportResponse? _analysis;
    private bool CanApproveReport => !_busy && !_researching && _analysis is not null
        && _targets.Any(t => t.Selected);

    private bool IsPrimary(TargetRow row) =>
        string.Equals(row.Term, _primaryKeyword, StringComparison.OrdinalIgnoreCase);

    private static string QuestionSource(string source) => source switch
    {
        "paa" => "people also ask",
        "knowledge-base" => "knowledge base",
        _ => "from the source",
    };

    private void Toggle(TargetRow row, ChangeEventArgs e)
    {
        row.Selected = e.Value is true;

        // Deselecting the primary must not leave a primary nothing else mentions.
        if (!row.Selected && IsPrimary(row))
        {
            _primaryKeyword = _targets.FirstOrDefault(t => t.Selected)?.Term;
        }
        else if (row.Selected && _primaryKeyword is null)
        {
            _primaryKeyword = row.Term;
        }
    }

    private void ToggleQuestion(QuestionRow row, ChangeEventArgs e) => row.Selected = e.Value is true;

    /// <summary>
    /// Adds a keyword the user typed. Deduplicated against what research already returned so a
    /// hand-typed "react data grid" does not shadow the one that carries volume data. New
    /// entries are pre-selected — you typed it because you want it.
    /// </summary>
    private void AddManualKeyword()
    {
        var term = _manualKeyword.Trim();
        if (term.Length == 0)
        {
            return;
        }

        var existing = _targets.FirstOrDefault(t => string.Equals(t.Term, term, StringComparison.OrdinalIgnoreCase));
        if (existing is not null)
        {
            existing.Selected = true;
        }
        else
        {
            _targets.Insert(0, new TargetRow { Term = term, Source = "manual", Selected = true });
        }

        _primaryKeyword ??= term;
        _manualKeyword = string.Empty;
    }

    private void MakePrimary(TargetRow row)
    {
        _primaryKeyword = row.Term;
        // Being primary implies being chosen; the alternative is a silent no-op.
        row.Selected = true;
    }

    /// <summary>
    /// Moves to the report step and researches in the background. The step is shown
    /// immediately rather than after the research: a blank wait with no context is worse than
    /// a visible step that fills in.
    /// </summary>
    private async Task GoToTargetsAsync()
    {
        _skipSeoAnalysis = false;
        _step = Step.Targets;
        _error = null;
        try
        {
            if (_campaignId is { } campaignId)
            {
                await SaveCampaignContextAsync(campaignId);
            }
            await ResearchAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _error = ex is ApiException api ? api.Message : "Couldn't reach the Castmill API.";
        }
    }

    private async Task SkipSeoAsync()
    {
        if (_campaignId is not { } campaignId)
        {
            return;
        }

        _busy = true;
        _error = null;
        _skipSeoAnalysis = true;
        try
        {
            await SaveCampaignContextAsync(campaignId);

            // A campaign can opt out after previously completing research. Clear those
            // targets so the generators do not silently keep using SEO steering while the
            // UI says this run is source-only.
            await Seo.SaveTargetsAsync(campaignId, new SeoTargetsRequest(null, [], []));
            _analysis = null;
            _targets.Clear();
            _questions.Clear();
            _primaryKeyword = null;
            _step = Step.Brief;
            await SuggestBriefAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _step = Step.Context;
            _error = ex is ApiException api
                ? api.Message
                : "Couldn't save the no-SEO content path.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ResearchAsync()
    {
        if (_campaignId is not { } campaignId)
        {
            return;
        }

        _researching = true;
        _targets.Clear();
        _questions.Clear();
        _researchNotes.Clear();
        _analysis = null;
        StateHasChanged();

        try
        {
            _analysis = await Seo.DeepAnalysisAsync(campaignId, _transcriptArtifactId,
                _siteUrl.Trim());
            var research = _analysis.Research;

            _hasMetrics = research.HasProviderMetrics;
            _researchNotes.AddRange(research.Notes);

            _targets.AddRange(research.Keywords.Select(k => new TargetRow
            {
                Term = k.Term,
                Volume = k.Volume,
                Difficulty = k.Difficulty,
                Opportunity = k.Opportunity,
                Competition = k.Competition,
                Cpc = k.Cpc,
                Intent = k.Intent,
                Source = k.Source,
            }));

            // The low-friction default: the three best are already chosen and the top one is
            // primary, so "Press Run" is one click. Everything else is a refinement.
            foreach (var row in _targets.Take(3))
            {
                row.Selected = true;
            }

            _primaryKeyword = _targets.FirstOrDefault()?.Term;

            _questions.AddRange(research.Questions.Select(q => new QuestionRow
            {
                Question = q.Question,
                Source = q.Source,
            }));

            foreach (var row in _questions.Take(5))
            {
                row.Selected = true;
            }
        }
        catch (ApiException ex)
        {
            _researchNotes.Add($"The required SEO/AEO analysis could not be completed: {ex.Message}");
        }
        catch (HttpRequestException)
        {
            _researchNotes.Add("Couldn't reach the Castmill API. Content generation stays locked until the analysis completes.");
        }
        finally
        {
            _researching = false;
            StateHasChanged();
        }
    }

    /// <summary>Saves the chosen targets so every generator in the run — and any content added
    /// later — reads them.</summary>
    private async Task SaveTargetsAsync(Guid campaignId)
    {
        var keywords = _targets
            .Where(t => t.Selected)
            .Select(t => new SeoTarget(
                t.Term, t.Volume, t.Difficulty, t.Opportunity, t.Source,
                t.Competition, t.Cpc, t.Intent))
            .ToList();

        var questions = _questions
            .Where(q => q.Selected)
            .Select(q => new SeoQuestion(q.Question, q.Source))
            .ToList();

        if (keywords.Count == 0)
        {
            throw new InvalidOperationException("Approve at least one keyword before pressing Run.");
        }

        await Seo.SaveTargetsAsync(campaignId, new SeoTargetsRequest(_primaryKeyword, keywords, questions));
    }

    private async Task ApproveAnalysisAsync()
    {
        if (_campaignId is not { } campaignId || _analysis is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            // Approval lands before the model drafts a single content angle. The brief endpoint
            // reads the saved targets and report, so reversing these two awaits would recreate
            // the post-hoc SEO flow this screen exists to prevent.
            await SaveTargetsAsync(campaignId);
            _step = Step.Brief;
            await SuggestBriefAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or InvalidOperationException)
        {
            _error = ex is ApiException api ? api.Message
                : ex is InvalidOperationException invalid ? invalid.Message
                : "Couldn't reach the Castmill API.";
        }
        finally
        {
            _busy = false;
        }
    }

    private bool _briefing;
    private string? _summary;
    private string? _briefError;
    private readonly List<string> _keyPoints = [];

    /// <summary>
    /// Drafts the brief from the transcript. Suggestions only fill fields the user has left
    /// empty — re-reading must never overwrite something they typed, which is the difference
    /// between a helpful default and a fight with the form.
    /// </summary>
    private async Task SuggestBriefAsync()
    {
        if (_campaignId is not { } campaignId)
        {
            return;
        }

        _briefing = true;
        _briefError = null;
        StateHasChanged();

        try
        {
            var brief = await Generation.SuggestBriefAsync(
                campaignId, _transcriptArtifactId, _name);

            // The title is the one field the user has already committed to, so it is only
            // taken when they left it blank.
            if (string.IsNullOrWhiteSpace(_name) && brief.Title is { } title)
            {
                _name = title;
            }
            if (string.IsNullOrWhiteSpace(_audience) && brief.Audience is { } audience)
            {
                _audience = audience;
            }
            if (string.IsNullOrWhiteSpace(_angle) && brief.Angle is { } angle)
            {
                _angle = angle;
            }

            _summary = brief.Summary;
            _keyPoints.Clear();
            _keyPoints.AddRange(brief.KeyPoints);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            // A failed draft leaves the form exactly as it was — typing it by hand still works.
            _briefError = ex is ApiException api ? api.Message : "Couldn't reach the Castmill API.";
        }
        finally
        {
            _briefing = false;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Voice.InitializeAsync();
        _voiceAvailable = Voice.Snapshot.State != VoiceCaptureStates.Unsupported;
        _voiceUnavailableReason = _voiceAvailable ? null : Voice.Snapshot.Message;
        try
        {
            _brands.AddRange(await Brands.ListAsync());
        }
        catch (ApiException)
        {
            // Brand-less runs work fine; the picker just offers None.
        }
        catch (HttpRequestException)
        {
        }

        if (ResumeCampaignId is { } campaignId)
        {
            await ResumeAsync(campaignId);
        }
    }

    private async Task ResumeAsync(Guid campaignId)
    {
        try
        {
            var campaign = await Campaigns.GetAsync(campaignId);
            var preview = await Campaigns.GetPreviewAsync(campaignId);
            _campaignId = campaign.Id;
            _name = campaign.Name;
            _brandId = campaign.BrandId?.ToString() ?? string.Empty;
            _contentType = campaign.ContentType ?? CampaignContentType.ThoughtLeadership;
            _intent = campaign.Intent;
            _skipSeoAnalysis = campaign.SkipSeoAnalysis;
            _links.Clear();
            _links.AddRange((campaign.Links ?? []).Select(link => new LinkRow
            {
                Label = link.Label,
                Url = link.Url,
            }));
            _siteUrl = campaign.Links?
                .FirstOrDefault(link => Uri.TryCreate(link.Url, UriKind.Absolute, out _))?.Url
                ?? string.Empty;
            RestoreBrief(campaign.Brief);
            ApplyRecipe(campaign.OutputRecipe);

            var transcript = preview.Artifacts.FirstOrDefault(item => item.Kind == "transcript");
            _transcriptArtifactId = transcript?.Id;
            var source = preview.Sources?.OrderBy(item => item.CreatedAt).FirstOrDefault();
            _sourceStarter = source?.Kind switch
            {
                SourceKinds.WebPage => SourceStarter.WebPage,
                SourceKinds.Document => SourceStarter.Document,
                SourceKinds.Transcript when source.Modality == SourceModalities.Media
                    => SourceStarter.LocalMedia,
                _ => SourceStarter.PasteText,
            };
            _sourceUrl = source?.OriginalUri ?? string.Empty;

            var pendingUpload = await MediaUploads.GetLatestAsync(campaignId);
            if (pendingUpload is { Status: MediaUploadStatus.Uploading or MediaUploadStatus.Committed })
            {
                _mediaUpload = pendingUpload;
                _sourceStarter = SourceStarter.CloudMedia;
                _percent = (int)Math.Clamp(pendingUpload.Percent, 0, 100);
                _error = pendingUpload.Status == MediaUploadStatus.Uploading
                    ? $"Reselect {pendingUpload.FileName} to resume this private upload."
                    : $"Reselect {pendingUpload.FileName} to retry transcription.";
                _step = Step.Source;
                return;
            }

            if (source is null && transcript is null)
            {
                _step = Step.Source;
                return;
            }

            if (_skipSeoAnalysis)
            {
                _step = Step.Brief;
                return;
            }

            var reportPreview = preview.Artifacts
                .Where(item => item.Kind == "seo-report")
                .OrderByDescending(item => item.UpdatedAt)
                .FirstOrDefault();
            if (reportPreview is not null)
            {
                _analysis = await Seo.GetReportAsync(reportPreview.Id);
                RestoreResearch(_analysis.Research);
                var targets = await Seo.GetTargetsAsync(campaignId);
                if (targets.Keywords.Count > 0)
                {
                    ApplyApprovedTargets(targets);
                    _step = Step.Brief;
                    return;
                }
                _step = Step.Targets;
                return;
            }
            _step = string.IsNullOrWhiteSpace(_intent) ? Step.Intent : Step.Context;
            if (_step == Step.Intent && source is not null
                && source.Kind is SourceKinds.WebPage or SourceKinds.Document or SourceKinds.Transcript)
            {
                _importedEvidence = await Evidence.GetEvidenceAsync(campaignId, source.Id);
            }
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            _error = ex is ApiException api ? api.Message : "Couldn't restore this run.";
            _step = Step.Source;
        }
    }

    private void RestoreBrief(string? brief)
    {
        if (string.IsNullOrWhiteSpace(brief))
        {
            return;
        }
        foreach (var line in brief.Split('\n', StringSplitOptions.RemoveEmptyEntries))
        {
            var separator = line.IndexOf(':');
            if (separator < 0)
            {
                continue;
            }
            var key = line[..separator].Trim();
            var value = line[(separator + 1)..].Trim();
            switch (key)
            {
                case "Campaign intent": _intent = value; break;
                case "Audience": _audience = value; break;
                case "Brand voice": _voice = value; break;
                case "Angle": _angle = value; break;
            }
        }
    }

    private void ApplyRecipe(IReadOnlyList<string>? recipe)
    {
        if (recipe is not { Count: > 0 })
        {
            return;
        }
        foreach (var item in _fanOut)
        {
            item.Selected = recipe.Contains(item.Kind, StringComparer.OrdinalIgnoreCase);
        }
    }

    private void RestoreResearch(SeoResearchResponse research)
    {
        _targets.Clear();
        _targets.AddRange(research.Keywords.Select(keyword => new TargetRow
        {
            Term = keyword.Term,
            Volume = keyword.Volume,
            Difficulty = keyword.Difficulty,
            Opportunity = keyword.Opportunity,
            Competition = keyword.Competition,
            Cpc = keyword.Cpc,
            Intent = keyword.Intent,
            Source = keyword.Source,
        }));
        _questions.Clear();
        _questions.AddRange(research.Questions.Select(question => new QuestionRow
        {
            Question = question.Question,
            Source = question.Source,
        }));
        _hasMetrics = research.HasProviderMetrics;
        _researchNotes.Clear();
        _researchNotes.AddRange(research.Notes);
    }

    private void ApplyApprovedTargets(SeoTargetsResponse targets)
    {
        _primaryKeyword = targets.PrimaryKeyword;
        var selectedKeywords = targets.Keywords.Select(item => item.Term)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        foreach (var target in _targets)
        {
            target.Selected = selectedKeywords.Contains(target.Term);
        }
        var selectedQuestions = targets.Questions.Select(item => item.Question)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        foreach (var question in _questions)
        {
            question.Selected = selectedQuestions.Contains(question.Question);
        }
    }

