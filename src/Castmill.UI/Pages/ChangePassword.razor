@* Change password. The server revokes every refresh token in the family on success, so
   other devices are signed out — which is the point. *@
@page "/settings/password"
@using Castmill.Core.Auth
@using Castmill.UI.Auth
@using Castmill.UI.Design
@using Castmill.UI.Http
@inject AuthClient Auth
@inject INotifier Notifier

<PageTitle>Change password — Castmill</PageTitle>

<span class="cm-kicker">Settings</span>
<h1>Change password.</h1>

<div class="cm-measure">
    <EditForm Model="_model" OnValidSubmit="SubmitAsync" class="cm-form">
        <DataAnnotationsValidator />

        <label class="cm-field">
            <span class="cm-field__label">Current password</span>
            <InputText @bind-Value="_model.CurrentPassword" class="cm-input" type="password"
                       autocomplete="current-password" disabled="@_busy" />
            <ValidationMessage For="() => _model.CurrentPassword" class="cm-field__error" />
        </label>

        <label class="cm-field">
            <span class="cm-field__label">New password</span>
            <InputText @bind-Value="_model.NewPassword" class="cm-input" type="password"
                       autocomplete="new-password" disabled="@_busy" />
            <span class="cm-field__hint cm-meta">
                At least 12 characters. Changing it signs out your other devices.
            </span>
            <ValidationMessage For="() => _model.NewPassword" class="cm-field__error" />
        </label>

        @if (_error is not null)
        {
            <p class="cm-form__error" role="alert">@_error</p>
        }

        <div class="cm-form__actions">
            <button type="submit" class="cm-button" disabled="@_busy">
                @(_busy ? "Changing…" : "Change password")
            </button>
        </div>
    </EditForm>
</div>

@code {
    private readonly Model _model = new();
    private bool _busy;
    private string? _error;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        try
        {
            await Auth.ChangePasswordAsync(
                new ChangePasswordRequest(_model.CurrentPassword, _model.NewPassword));

            Notifier.ShowSuccess("Password changed. Other devices have been signed out.");
            _model.CurrentPassword = string.Empty;
            _model.NewPassword = string.Empty;
        }
        catch (ValidationApiException ex)
        {
            _error = string.Join(" ", ex.Errors.SelectMany(e => e.Value));
        }
        catch (UnauthorizedApiException)
        {
            _error = "That current password isn't right.";
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class Model
    {
        [Required]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required, MinLength(12, ErrorMessage = "Use at least 12 characters.")]
        public string NewPassword { get; set; } = string.Empty;
    }
}
