@* ApexTree renders the campaign as an actual hierarchy: the pillar owns the channel pieces
   that reinforce it, while missing channels remain actionable "+ add" leaves. The component
   owns the semantic model and callbacks; JS owns only layout, pan/zoom, and node rendering. *@
@using Castmill.Core
@using Castmill.UI.State
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime Js

@if (Cluster is { IsEmpty: false } cluster)
{
    <div class="cm-cluster">
        <div class="cm-cluster__tree" @ref="_host"
             data-node-count="@NodeCount(cluster)"
             aria-label="Content hierarchy around @(cluster.PrimaryKeyword ?? "this campaign")">
        </div>

        <p class="cm-meta cm-cluster__legend">
            @cluster.Supporting.Count supporting @(cluster.Supporting.Count == 1 ? "piece" : "pieces")
            reinforce the pillar@(cluster.Gaps.Count > 0 ? $" · {cluster.Gaps.Count} channel{(cluster.Gaps.Count == 1 ? "" : "s")} still open" : "")@(cluster.Questions.Count > 0 ? $" · {cluster.Questions.Count} AEO questions targeted" : "").
            Select an artifact to open it in Focus; select an Add node to draft that channel.
        </p>
    </div>
}

@code {
    private const string ModulePath = "./_content/Castmill.UI/js/castmill-apextree.js";

    private ElementReference _host;
    private IJSObjectReference? _module;
    private IJSObjectReference? _handle;
    private DotNetObjectReference<ClusterMap>? _self;
    private string? _renderedSignature;

    [Parameter, EditorRequired] public ContentCluster? Cluster { get; set; }

    /// <summary>Opens an existing artifact (Focus mode).</summary>
    [Parameter] public EventCallback<Guid> OnOpen { get; set; }

    /// <summary>Drafts a missing kind against the campaign's targets.</summary>
    [Parameter] public EventCallback<string> OnDraft { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Cluster is not { IsEmpty: false } cluster)
        {
            return;
        }

        var data = BuildTree(cluster);
        var signature = Signature(cluster);

        if (firstRender)
        {
            _module = await Js.InvokeAsync<IJSObjectReference>("import", ModulePath);
            _self = DotNetObjectReference.Create(this);
            _handle = await _module.InvokeAsync<IJSObjectReference>(
                "initContentClusterTree", _host, data, _self);
            _renderedSignature = signature;
            return;
        }

        if (_handle is not null && !string.Equals(_renderedSignature, signature, StringComparison.Ordinal))
        {
            await _handle.InvokeVoidAsync("update", data);
            _renderedSignature = signature;
        }
    }

    [JSInvokable]
    public Task HandleNodeAsync(string action, string value) => action switch
    {
        "open" when Guid.TryParse(value, out var id) => OnOpen.InvokeAsync(id),
        "draft" when !string.IsNullOrWhiteSpace(value) => OnDraft.InvokeAsync(value),
        _ => Task.CompletedTask,
    };

    internal static TreeNode BuildTree(ContentCluster cluster)
    {
        var children = CategoryNodes(cluster);

        if (cluster.Pillar is { } pillar)
        {
            return new TreeNode(
                pillar.ArtifactId.ToString("D"),
                pillar.Title,
                "Pillar blog",
                cluster.PrimaryKeyword ?? "Campaign foundation",
                pillar.Status,
                "open",
                pillar.ArtifactId.ToString("D"),
                Tone(pillar.Status),
                children);
        }

        return new TreeNode(
            "campaign-root",
            cluster.PrimaryKeyword ?? "Campaign content",
            "Campaign cluster",
            "Pillar blog not created yet",
            "Building",
            "none",
            string.Empty,
            "default",
            children);
    }

    /// <summary>
    /// One level of channel-family nodes between the pillar and the pieces. A dozen supporting
    /// artifacts hung directly off the pillar rendered as one undifferentiated vertical run —
    /// legible per card but shapeless as a whole, and it read as a list rather than a cluster.
    /// Grouped, the map answers the question the SEO view is actually for: which channels this
    /// pillar reaches, and how deeply. Empty families are omitted, and open channels (the "+
    /// add" affordances) collect under one node so a gap can never hide between real pieces.
    /// </summary>
    private static IReadOnlyList<TreeNode> CategoryNodes(ContentCluster cluster)
    {
        var groups = cluster.Supporting
            .GroupBy(node => ArtifactKinds.CategoryOf(node.Kind))
            .OrderBy(group => ArtifactKinds.CategoryOrder(group.Key))
            .ThenBy(group => group.Key, StringComparer.Ordinal)
            .Select(CategoryNode)
            .ToList();

        if (cluster.Gaps.Count > 0)
        {
            groups.Add(new TreeNode(
                "category-gaps",
                "Open channels",
                Pieces(cluster.Gaps.Count),
                "Draft from the approved strategy",
                "Add",
                "none",
                string.Empty,
                "gap",
                [.. cluster.Gaps.Select(GapNode)]));
        }

        return groups;
    }

    private static TreeNode CategoryNode(IGrouping<string, ClusterNode> group)
    {
        var pending = group.Count(node => Tone(node.Status) != "success");
        return new TreeNode(
            $"category-{group.Key}",
            ArtifactKinds.CategoryLabel(group.Key),
            Pieces(group.Count()),
            pending == 0 ? "All approved" : $"{pending} still in draft",
            // A family whose pieces are all approved is itself done — the same status
            // encoding the cards use, one level up, so there is no new vocabulary.
            pending == 0 ? "Ready" : "In progress",
            "none",
            string.Empty,
            pending == 0 ? "success" : "default",
            [.. group.OrderBy(node => node.KindLabel, StringComparer.Ordinal).Select(ArtifactNode)]);
    }

    private static string Pieces(int count) => count == 1 ? "1 piece" : $"{count} pieces";

    private static TreeNode ArtifactNode(ClusterNode node) => new(
        node.ArtifactId.ToString("D"),
        node.KindLabel,
        node.Title,
        "Supporting content",
        node.Status,
        "open",
        node.ArtifactId.ToString("D"),
        Tone(node.Status),
        []);

    private static TreeNode GapNode(ClusterGap gap) => new(
        $"gap-{gap.Kind}",
        $"Add {gap.KindLabel}",
        "Open channel",
        "Uses the approved SEO/AEO strategy",
        "Add",
        "draft",
        gap.Kind,
        "gap",
        []);

    private static string Tone(string status) => status is "Approved" or "Published"
        ? "success"
        : "default";

    private static int NodeCount(ContentCluster cluster) =>
        1 + cluster.Supporting.Count + cluster.Gaps.Count;

    private static string Signature(ContentCluster cluster) => string.Join('|',
        cluster.PrimaryKeyword,
        cluster.Pillar?.ArtifactId,
        cluster.Pillar?.Status,
        string.Join(',', cluster.Supporting.Select(node => $"{node.ArtifactId}:{node.Status}")),
        string.Join(',', cluster.Gaps.Select(gap => gap.Kind)));

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_handle is not null)
            {
                await _handle.InvokeVoidAsync("destroy");
                await _handle.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The browser or desktop WebView is already gone.
        }

        _self?.Dispose();
    }

    internal sealed record TreeNode(
        string Id,
        string Name,
        string Title,
        string Subtitle,
        string Badge,
        string Action,
        string Value,
        string Tone,
        IReadOnlyList<TreeNode> Children);
}
