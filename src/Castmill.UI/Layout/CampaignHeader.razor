@* Persistent header on all four campaign views: breadcrumb, name, the n/6 image counter and
   the view tabs as real <button>s (ADR-F11).

   The counter comes from the same Preview payload as everything else, so it can never
   disagree with the front page's "slots waiting" block or Focus Mode's slot list (G9). *@
@using Castmill.UI.State
@using Castmill.Core
@using Castmill.Core.Resources
@using Castmill.UI.Http
@using Castmill.UI.Design
@implements IDisposable
@inject CampaignState Campaign
@inject WorkspaceState Workspace
@inject PressRunService PressRun
@inject NavigationManager Navigation
@inject CampaignsClient Campaigns
@inject INotifier Notifier

<header class="cm-campaign-header">
    <div class="cm-campaign-header__identity">
        <a class="cm-meta" href="campaigns">Campaigns /</a>
        @if (_renaming)
        {
            <input class="cm-input cm-campaign-header__rename" aria-label="Campaign name"
                   @bind="_name" @onkeydown="OnRenameKey" />
            <button type="button" class="cm-button cm-button--quiet" @onclick="SaveRenameAsync">Save</button>
        }
        else
        {
            <h1 class="cm-campaign-header__name">@(Campaign.Campaign?.Name ?? "…")</h1>
            <button type="button" class="cm-button cm-button--quiet" @onclick="BeginRename">Rename</button>
        }
    </div>

    <div class="cm-campaign-header__meta">
        @* The press never runs invisibly: whichever view is open, the header names what is
           printing right now, and clicking it lands on the narrated panel (ADR-F13). *@
        @if (Campaign.CampaignId is { } cid && PressRun.IsActiveFor(cid) && PressRun.IsRunning)
        {
            <button type="button" class="cm-header-run" @onclick="() => Go(CampaignView.MillFloor)">
                <span class="cm-ai-dot" aria-hidden="true"></span>
                @RunLine
            </button>
        }

        @if (Campaign.Brand is { } brand)
        {
            <span class="cm-chip cm-mono" title="Brand steering this campaign">@brand.Name</span>
        }

        @if (Campaign.Campaign is { } campaign)
        {
            <span class="cm-chip cm-mono" title="Campaign content format">
                @CampaignContentType.DisplayLabel(campaign.ContentType)
            </span>
            <button type="button" class="cm-chip @(campaign.Status == CampaignStatus.Ready ? "cm-chip--on" : "")"
                    title="Toggle campaign readiness" @onclick="ToggleReadyAsync">
                @(campaign.Status == CampaignStatus.Ready ? "Ready" : "Draft")
            </button>
            @if (campaign.IsOwner)
            {
                <button type="button" class="cm-button cm-button--quiet cm-button--compact"
                        aria-label="Manage campaign sharing" @onclick="OpenSharingAsync">
                    Share
                </button>
            }
            else
            {
                <span class="cm-chip cm-mono" title="You can edit this campaign">Shared campaign</span>
            }
        }

        <span class="cm-mono cm-meta" title="Image slots filled">
            @Campaign.ImagesFilled/@Campaign.ImagesTotal images
        </span>
        @if (Campaign.IsLoadingDetails)
        {
            <span class="cm-loading-line cm-meta" role="status">
                <span class="cm-ai-dot" aria-hidden="true"></span>
                Loading source details…
            </span>
        }
    </div>

    @* Real buttons, keyboard-reachable, with a visible focus ring — not links styled as
       tabs and not divs with click handlers (G5). The tablist is separate from metadata so
       its alignment does not depend on how many campaign chips happen to exist. *@
    <div class="cm-tabs" role="tablist" aria-label="Campaign views">
        @foreach (var (view, segment, label) in CampaignViews.All)
        {
            @* aria-selected is written as a STRING, not a bool: a bool renders as a
               presence-only attribute, so `aria-selected="@(view == Current)"` emitted a
               bare `aria-selected` and the stylesheet's [aria-selected="true"] never
               matched — the active tab looked like the other three. Same trap as
               aria-expanded on the artifact tree.

               This comment lives ABOVE the tag on purpose. Inside an attribute list Razor
               does NOT strip it; it emits the whole comment as an attribute NAME, and the
               browser then throws InvalidCharacterError on setAttribute and tears down the
               render tree — a blank campaign with Blazor's global error bar. bUnit will
               not catch it: AngleSharp accepts invalid attribute names where a real
               browser refuses them. *@
            <button type="button" role="tab"
                    class="cm-tabs__tab"
                    aria-selected="@(view == Current ? "true" : "false")"
                    @onclick="() => Go(view)">
                @label
            </button>
        }
    </div>
</header>

@if (_sharingOpen && Campaign.Campaign is { IsOwner: true } sharedCampaign)
{
    <div class="cm-modal" role="presentation" @onclick="CloseSharing">
        <section class="cm-modal__panel cm-campaign-sharing" role="dialog" aria-modal="true"
                 aria-labelledby="cm-campaign-sharing-title" @onclick:stopPropagation>
            <div class="cm-campaign-sharing__head">
                <div>
                    <span class="cm-kicker">Campaign access</span>
                    <h2 id="cm-campaign-sharing-title" class="cm-modal__title">Share @sharedCampaign.Name</h2>
                </div>
                <button type="button" class="cm-tree__delete" aria-label="Close sharing"
                        @onclick="CloseSharing">✕</button>
            </div>

            @if (_sharingLoading)
            {
                <p class="cm-meta" role="status">Loading access…</p>
            }
            else
            {
                <label class="cm-campaign-sharing__domain">
                    <input type="checkbox" checked="@_domainEnabled" disabled="@_sharingBusy"
                           @onchange="SetDomainSharingAsync" />
                    <span>
                        <strong>Anyone at @(_shareDomain ?? "your email domain")</strong>
                        <span class="cm-meta">Signed-in Castmill users at this exact domain can edit the campaign.</span>
                    </span>
                </label>

                <div class="cm-brand__share-form">
                    <label class="cm-field">
                        <span class="cm-field__label">Share with any email</span>
                        <input class="cm-input" type="email" maxlength="256"
                               placeholder="person@company.com" disabled="@_sharingBusy"
                               @bind="_shareEmail" @bind:event="oninput"
                               @onkeydown="ShareKeyDownAsync" />
                        <span class="cm-meta">They get access when they sign in with this address.</span>
                    </label>
                    <button type="button" class="cm-button"
                            disabled="@(_sharingBusy || string.IsNullOrWhiteSpace(_shareEmail))"
                            @onclick="AddCollaboratorAsync">Add</button>
                </div>

                @if (_sharingError is { } sharingError)
                {
                    <p class="cm-form__error" role="alert">@sharingError</p>
                }

                @if (_collaborators.Count == 0)
                {
                    <p class="cm-meta">No individual email shares.</p>
                }
                else
                {
                    <ul class="cm-brand__collaborators">
                        @foreach (var collaborator in _collaborators)
                        {
                            <li @key="collaborator.Id">
                                <span>
                                    <strong>@(string.IsNullOrWhiteSpace(collaborator.DisplayName)
                                        ? collaborator.Email
                                        : collaborator.DisplayName)</strong>
                                    <span class="cm-meta">@collaborator.Email</span>
                                </span>
                                <button type="button" class="cm-tree__delete"
                                        aria-label="Remove @collaborator.Email"
                                        disabled="@(_removingCollaborator == collaborator.Id)"
                                        @onclick="() => RemoveCollaboratorAsync(collaborator)">✕</button>
                            </li>
                        }
                    </ul>
                }
            }
        </section>
    </div>
}

@code {
    /// <summary>The view currently shown, supplied by the campaign layout.</summary>
    [Parameter, EditorRequired] public CampaignView Current { get; set; }
    private bool _renaming;
    private bool _saving;
    private string _name = string.Empty;
    private bool _sharingOpen;
    private bool _sharingLoading;
    private bool _sharingBusy;
    private bool _domainEnabled;
    private string? _shareDomain;
    private string _shareEmail = string.Empty;
    private string? _sharingError;
    private Guid? _removingCollaborator;
    private readonly List<CampaignCollaboratorResponse> _collaborators = [];

    private async Task OpenSharingAsync()
    {
        if (Campaign.Campaign is not { IsOwner: true } campaign)
        {
            return;
        }

        _sharingOpen = true;
        _sharingLoading = true;
        _sharingError = null;
        try
        {
            var sharing = await Campaigns.GetSharingAsync(campaign.Id);
            ApplySharing(sharing);
        }
        catch (ApiException ex)
        {
            _sharingError = ex.Message;
        }
        finally
        {
            _sharingLoading = false;
        }
    }

    private void CloseSharing() => _sharingOpen = false;

    private async Task SetDomainSharingAsync(ChangeEventArgs args)
    {
        if (_sharingBusy || Campaign.Campaign is not { IsOwner: true } campaign)
        {
            return;
        }

        var enabled = args.Value is true || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        _sharingBusy = true;
        _sharingError = null;
        try
        {
            ApplySharing(await Campaigns.UpdateSharingAsync(campaign.Id, enabled));
            Notifier.ShowSuccess(enabled ? "Domain access enabled." : "Domain access disabled.");
        }
        catch (ApiException ex)
        {
            _sharingError = ex.Message;
        }
        finally
        {
            _sharingBusy = false;
        }
    }

    private Task ShareKeyDownAsync(KeyboardEventArgs args) =>
        args.Key == "Enter" ? AddCollaboratorAsync() : Task.CompletedTask;

    private async Task AddCollaboratorAsync()
    {
        if (_sharingBusy || string.IsNullOrWhiteSpace(_shareEmail)
            || Campaign.Campaign is not { IsOwner: true } campaign)
        {
            return;
        }

        _sharingBusy = true;
        _sharingError = null;
        try
        {
            var collaborator = await Campaigns.AddCollaboratorAsync(
                campaign.Id, _shareEmail.Trim());
            _collaborators.Add(collaborator);
            _collaborators.Sort((left, right) =>
                StringComparer.OrdinalIgnoreCase.Compare(left.Email, right.Email));
            _shareEmail = string.Empty;
            Notifier.ShowSuccess($"Shared with {collaborator.Email}.");
        }
        catch (ApiException ex)
        {
            _sharingError = ex.Message;
        }
        finally
        {
            _sharingBusy = false;
        }
    }

    private async Task RemoveCollaboratorAsync(CampaignCollaboratorResponse collaborator)
    {
        if (Campaign.Campaign is not { IsOwner: true } campaign)
        {
            return;
        }

        _removingCollaborator = collaborator.Id;
        try
        {
            await Campaigns.RemoveCollaboratorAsync(campaign.Id, collaborator.Id);
            _collaborators.RemoveAll(item => item.Id == collaborator.Id);
            Notifier.ShowSuccess($"Removed {collaborator.Email}.");
        }
        catch (ApiException ex)
        {
            Notifier.ShowError(ex.Message);
        }
        finally
        {
            _removingCollaborator = null;
        }
    }

    private void ApplySharing(CampaignSharingResponse sharing)
    {
        _domainEnabled = sharing.DomainEnabled;
        _shareDomain = sharing.Domain;
        _collaborators.Clear();
        _collaborators.AddRange(sharing.Collaborators);
    }

    private void BeginRename()
    {
        _name = Campaign.Campaign?.Name ?? string.Empty;
        _renaming = true;
    }

    private async Task OnRenameKey(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") await SaveRenameAsync();
        else if (args.Key == "Escape") _renaming = false;
    }

    private async Task SaveRenameAsync()
    {
        if (_saving || Campaign.Campaign is not { } campaign || string.IsNullOrWhiteSpace(_name)) return;
        await SaveCampaignAsync(campaign, _name.Trim(), campaign.Status);
        _renaming = false;
    }

    private async Task ToggleReadyAsync()
    {
        if (_saving || Campaign.Campaign is not { } campaign) return;
        var status = campaign.Status == CampaignStatus.Ready ? CampaignStatus.Draft : CampaignStatus.Ready;
        await SaveCampaignAsync(campaign, campaign.Name, status);
    }

    private async Task SaveCampaignAsync(Castmill.Core.Resources.CampaignResponse campaign, string name, string status)
    {
        _saving = true;
        try
        {
            var updated = await Campaigns.UpdateAsync(campaign.Id, name, campaign.Brief, campaign.BrandId,
                campaign.Links, status, campaign.ContentType,
                skipSeoAnalysis: campaign.SkipSeoAnalysis);
            // CampaignState owns this view; WorkspaceState owns the persistent campaign
            // switcher. The API response is authoritative for both, so reconcile the rail
            // immediately rather than leaving its cached name stale until a page reload.
            Workspace.Synchronize(updated);
            await Campaign.RefreshAsync(campaign.Id);
            Notifier.ShowSuccess(status == campaign.Status ? "Campaign renamed." : $"Campaign marked {status.ToLowerInvariant()}.");
        }
        catch (ApiException ex) { Notifier.ShowError(ex.Message); }
        finally { _saving = false; }
    }

    private string RunLine
    {
        get
        {
            var progress = PressRun.Progress;
            if (progress is null)
            {
                return "Printing…";
            }
            var last = progress.Items.LastOrDefault();
            return last is null
                ? $"Printing · 0 of {progress.TotalKinds}"
                : $"Printing {ArtifactDisplay.KindLabel(last.Kind)} · {progress.Completed} of {progress.TotalKinds}";
        }
    }

    protected override void OnInitialized()
    {
        Campaign.Changed += OnChanged;
        PressRun.Changed += OnChanged;
    }

    private void Go(CampaignView view)
    {
        if (Campaign.CampaignId is { } id)
        {
            Navigation.NavigateTo(CampaignViews.PathFor(id, view));
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Campaign.Changed -= OnChanged;
        PressRun.Changed -= OnChanged;
    }
}
