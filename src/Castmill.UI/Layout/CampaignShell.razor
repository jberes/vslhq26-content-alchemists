@* Wraps the four campaign views: loads the campaign into CampaignState, renders the header,
   then the view's own content.

   This component is the answer to the prototype's most common bug ("header changed, content
   didn't"). Both the header AND the body read from CampaignState, and the load is keyed on
   the route parameter, so a campaign switch cannot update one without the other.
   CampaignSwitchTests holds that. *@
@using Castmill.UI.Design
@using Castmill.UI.State
@implements IDisposable
@inject CampaignState Campaign
@inject WorkspaceState Workspace

<div class="cm-campaign-frame">
    <CampaignHeader Current="View" />

    @if (Campaign.LoadError is { } error)
    {
        <div class="cm-page">
            <EmptyState Kicker="Campaign"
                        Headline="This campaign couldn't be loaded."
                        Detail="@error" />
        </div>
    }
    else if (Campaign.IsLoading)
    {
        @* Narrated, not a spinner (ADR-F13). *@
        <div class="cm-page">
            <p class="cm-meta">Loading campaign…</p>
        </div>
    }
    else
    {
        @* A component that throws must show a message, not a blank screen. Without a
           boundary, ANY exception in a campaign view tears down the whole render tree and
           leaves the user staring at nothing with no way back. @key resets the boundary on
           navigation, so a failure on one campaign does not poison the next. *@
        <ErrorBoundary @key="CampaignId" @ref="_boundary">
            <ChildContent>@ChildContent</ChildContent>
            <ErrorContent Context="error">
                <div class="cm-page">
                    <EmptyState Kicker="Campaign"
                                Headline="This view hit an error."
                                Detail="@($"{error.GetType().Name}: {error.Message}")">
                        <Action>
                            <button type="button" class="cm-button" @onclick="Recover">Try again</button>
                        </Action>
                    </EmptyState>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid CampaignId { get; set; }

    [Parameter, EditorRequired] public CampaignView View { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized() => Campaign.Changed += OnChanged;

    /// <summary>
    /// Runs on every parameter change, which is what makes a campaign switch reload rather
    /// than only re-render. OnInitializedAsync would fire once and leave the body stale.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        await Workspace.LoadAsync();

        // Keep the rail's active-campaign card in step with the route, so a deep link or a
        // browser Back lands with the rail showing the right campaign.
        if (Workspace.Active?.Id != CampaignId)
        {
            Workspace.SetActive(CampaignId);
        }

        await Campaign.LoadAsync(CampaignId);
    }

    private ErrorBoundary? _boundary;

    /// <summary>Clears the boundary and reloads, so "try again" is a real retry.</summary>
    private async Task Recover()
    {
        _boundary?.Recover();
        await Campaign.LoadAsync(CampaignId, force: true);
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Campaign.Changed -= OnChanged;
}
