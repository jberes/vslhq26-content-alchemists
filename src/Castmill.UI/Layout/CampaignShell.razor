@* Wraps the four campaign views: loads the campaign into CampaignState, renders the header,
   then the view's own content.

   This component is the answer to the prototype's most common bug ("header changed, content
   didn't"). Both the header AND the body read from CampaignState, and the load is keyed on
   the route parameter, so a campaign switch cannot update one without the other.
   CampaignSwitchTests holds that. *@
@using Castmill.UI.Design
@using Castmill.UI.State
@implements IDisposable
@inject CampaignState Campaign
@inject WorkspaceState Workspace

<div class="cm-campaign-frame">
    @* The HEADER is inside a boundary too. It reads the same store and renders the tab
       strip, so a throw there is just as fatal — and being outside the boundary it went
       straight to Blazor's generic error bar with the view frozen mid-load. *@
    @* No @key here: sibling boundaries may not share one, and the outer boundary already
       carries the campaign id, so switching campaigns resets both. *@
    <ErrorBoundary>
        <ChildContent>
            <CampaignHeader Current="View" />
        </ChildContent>
        <ErrorContent Context="headerError">
            <p class="cm-form__error" role="alert">
                The campaign header failed: @headerError.GetType().Name — @headerError.Message
            </p>
        </ErrorContent>
    </ErrorBoundary>

    @if (_shellError is { } shellError)
    {
        <div class="cm-page">
            <EmptyState Kicker="Campaign"
                        Headline="This campaign couldn't be opened."
                        Detail="@shellError">
                <Action>
                    <button type="button" class="cm-button" @onclick="Recover">Try again</button>
                </Action>
            </EmptyState>
        </div>
    }
    else if (Campaign.LoadError is { } error)
    {
        <div class="cm-page">
            <EmptyState Kicker="Campaign"
                        Headline="This campaign couldn't be loaded."
                        Detail="@error" />
        </div>
    }
    else if (Campaign.IsLoading)
    {
        <div class="cm-page">
            <p class="cm-loading-line" role="status">
                <span class="cm-ai-dot" aria-hidden="true"></span>
                Loading campaign overview…
            </p>
        </div>
    }
    else
    {
        @* A component that throws must show a message, not a blank screen. Without a
           boundary, ANY exception in a campaign view tears down the whole render tree and
           leaves the user staring at nothing with no way back. @key resets the boundary on
           navigation, so a failure on one campaign does not poison the next. *@
        <ErrorBoundary @key="CampaignId" @ref="_boundary">
            <ChildContent>@ChildContent</ChildContent>
            <ErrorContent Context="error">
                <div class="cm-page">
                    <EmptyState Kicker="Campaign"
                                Headline="This view hit an error."
                                Detail="@($"{error.GetType().Name}: {error.Message}")">
                        <Action>
                            <button type="button" class="cm-button" @onclick="Recover">Try again</button>
                        </Action>
                    </EmptyState>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid CampaignId { get; set; }

    [Parameter, EditorRequired] public CampaignView View { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized() => Campaign.Changed += OnChanged;

    /// <summary>
    /// Runs on every parameter change, which is what makes a campaign switch reload rather
    /// than only re-render. OnInitializedAsync would fire once and leave the body stale.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        // Everything here is guarded. An exception escaping a lifecycle method is not a
        // caught error the user can read — it is Blazor's generic "An unhandled error has
        // occurred" bar plus a view frozen on "Loading campaign…", which is exactly what
        // this screen did.
        try
        {
            var workspaceLoad = Workspace.LoadAsync();
            var campaignLoad = Campaign.LoadAsync(CampaignId);
            await Task.WhenAll(workspaceLoad, campaignLoad);

            // Keep the rail's active-campaign card in step with the route, so a deep link or
            // a browser Back lands with the rail showing the right campaign.
            if (Workspace.Active?.Id != CampaignId)
            {
                Workspace.SetActive(CampaignId);
            }

        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _shellError = $"{ex.GetType().Name}: {ex.Message}";
        }
    }

    private ErrorBoundary? _boundary;
    private string? _shellError;

    /// <summary>Clears the boundary and reloads, so "try again" is a real retry.</summary>
    private async Task Recover()
    {
        _shellError = null;
        _boundary?.Recover();
        await Campaign.LoadAsync(CampaignId, force: true);
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Campaign.Changed -= OnChanged;
}
