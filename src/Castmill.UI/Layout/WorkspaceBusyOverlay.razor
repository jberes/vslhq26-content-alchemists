@* Covers the main pane while a campaign is being deleted. A delete removes every artifact,
   image and uploaded file, so it can take a while; without this the page looked frozen yet
   still took clicks against a campaign that was disappearing. No spinner (ADR-F13): a pulse
   says work is live and the elapsed seconds say how long it has run. *@
@using Castmill.UI.Design
@using Castmill.UI.State
@implements IDisposable
@inject WorkspaceState Workspace
@inject TimeProvider Clock
@inject INotifier Notifier

@if (Workspace.Deleting is { } campaign)
{
    <div class="cm-app__busy" role="status" aria-live="polite">
        <div class="cm-app__busy-card">
            <span class="cm-ai-dot" aria-hidden="true"></span>
            <strong>Deleting “@campaign.Name”</strong>
            <span class="cm-meta">Removing its artifacts, generated images and uploaded media. The workspace unlocks when it is done.</span>
            <span class="cm-meta cm-mono">@Elapsed</span>
        </div>
    </div>
}

@code {
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _ticking;

    private string Elapsed =>
        Workspace.DeletingSince is { } since
            ? $"{Math.Max(0, (int)(Clock.GetUtcNow() - since).TotalSeconds)}s"
            : string.Empty;

    protected override void OnInitialized() => Workspace.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(() => StoreEvents.GuardedAsync(() =>
    {
        if (Workspace.Deleting is not null && _ticking is null)
        {
            _ticking = new CancellationTokenSource();
            _ = TickAsync(_ticking.Token);
        }
        else if (Workspace.Deleting is null)
        {
            StopTicking();
        }
        return Task.CompletedTask;
    }, Notifier, StateHasChanged, "Showing the delete progress"));

    private async Task TickAsync(CancellationToken ct)
    {
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(1), Clock);
        try
        {
            while (await _timer.WaitForNextTickAsync(ct))
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // The delete finished; the overlay is gone.
        }
    }

    private void StopTicking()
    {
        _ticking?.Cancel();
        _ticking?.Dispose();
        _ticking = null;
        _timer?.Dispose();
        _timer = null;
    }

    public void Dispose()
    {
        Workspace.Changed -= OnChanged;
        StopTicking();
    }
}
