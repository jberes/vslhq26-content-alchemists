@namespace Castmill.UI.Scheduling
@using System.Globalization

<section class="cm-agenda @(Narrow ? "cm-agenda--narrow" : null)" aria-label="Wire agenda">
    <div class="cm-agenda__list">
        @foreach (var day in Data.Days)
        {
            <section class="cm-agenda__day @(day.IsToday ? "cm-agenda__day--today" : null)">
                <header class="cm-agenda__day-head">
                    <h2>@DayLabel(day)</h2>
                    <span>@DayState(day)</span>
                </header>
                <div class="cm-agenda__rows @(_dropDate == day.Date ? "cm-agenda__rows--drop" : null)"
                     @ondragenter="() => _dropDate = day.Date" @ondragleave="() => _dropDate = null"
                     @ondragover:preventDefault @ondrop:preventDefault @ondrop="() => DropAsync(day)">
                    @if (day.Items.Count == 0)
                    {
                        <div class="cm-agenda__empty">Nothing scheduled — drop an item here</div>
                    }
                    @foreach (var item in day.Items.OrderBy(WireTime.Local))
                    {
                        <article class="cm-agenda__row cm-agenda__row--@StatusName(item.Status)"
                                 draggable="@CanDrag(item.Status)"
                                 @ondragstart="() => BeginScheduleDrag(item)" @ondragend="EndDrag">
                            <time class="cm-agenda__time" datetime="@item.ScheduledAtUtc.ToString("O", CultureInfo.InvariantCulture)">
                                @WireTime.Local(item).ToString("HH:mm", CultureInfo.InvariantCulture)
                            </time>
                            <span class="cm-agenda__channel">@item.Channel</span>
                            <span class="cm-agenda__title cm-wire-clamp-1">@item.Title</span>
                            <IgbChip class="cm-agenda__status" Outlined="true">@StatusLabel(item.Status)</IgbChip>
                            <span class="cm-agenda__actions" aria-label="Agenda item actions">
                                <IgbButton Variant="ButtonVariant.Outlined" @onclick="() => Edit.InvokeAsync(item)">Edit</IgbButton>
                                @if (item.Status == WireDeliveryStatus.Blocked)
                                {
                                    <IgbButton Variant="ButtonVariant.Outlined" @onclick="() => Export.InvokeAsync(item)">Export</IgbButton>
                                }
                                else if (item.Status != WireDeliveryStatus.Sent)
                                {
                                    <IgbButton Variant="ButtonVariant.Outlined" @onclick="() => _slotDialog?.Open(item)">Move</IgbButton>
                                }
                            </span>
                        </article>
                    }
                </div>
            </section>
        }
    </div>

    <QueueRail Items="Data.Queue"
               Compact="Narrow"
               Edit="EditQueue"
               Slot="OpenQueueSlot"
               DragStarted="BeginQueueDrag"
               DragEnded="EndDrag" />

    <SlotDialog @ref="_slotDialog" TimeZone="@Data.TimeZone" Confirmed="Slot" />
</section>

@code {
    private SlotDialog? _slotDialog;
    private WireQueueItem? _draggedQueue;
    private WireScheduleItem? _draggedSchedule;
    private DateOnly? _dropDate;

    [Parameter, EditorRequired] public WireBoardData Data { get; set; } = default!;
    [Parameter] public bool Narrow { get; set; }
    [Parameter] public EventCallback<WireQueueItem> EditQueue { get; set; }
    [Parameter] public EventCallback<WireScheduleItem> Edit { get; set; }
    [Parameter] public EventCallback<WireScheduleItem> Export { get; set; }
    [Parameter] public EventCallback<WireSlotRequest> Slot { get; set; }

    private static string DayLabel(WireDay day) =>
        $"{day.Date.ToString("ddd d MMM", CultureInfo.CurrentCulture).ToUpperInvariant()}{(day.IsToday ? " · TODAY" : string.Empty)}";

    private static string DayState(WireDay day)
    {
        var attention = day.Items.Count(item => item.Status is WireDeliveryStatus.Error or WireDeliveryStatus.Blocked);
        if (attention > 0)
        {
            return $"{attention} blocked";
        }

        var sent = day.Items.Count(item => item.Status == WireDeliveryStatus.Sent);
        if (sent > 0)
        {
            return $"{sent} sent";
        }

        return day.Items.Count == 0 ? "empty" : $"{day.Items.Count} queued";
    }

    private string StatusLabel(WireDeliveryStatus status) => status switch
    {
        WireDeliveryStatus.Draft or WireDeliveryStatus.Queued when !Data.BrokerConfigured => "STAGED",
        WireDeliveryStatus.Staged => "STAGED",
        WireDeliveryStatus.Blocked => "NO URL",
        _ => status.ToString().ToUpperInvariant(),
    };

    private static string StatusName(WireDeliveryStatus status) => status.ToString().ToLowerInvariant();
    private static bool CanDrag(WireDeliveryStatus status) => status is not WireDeliveryStatus.Sent;

    private void OpenQueueSlot(WireQueueItem item) => _slotDialog?.Open(item, DefaultSlotDate, 9 * 60);

    private void BeginQueueDrag(WireQueueItem item)
    {
        _draggedQueue = item;
        _draggedSchedule = null;
    }

    private void BeginScheduleDrag(WireScheduleItem item)
    {
        _draggedSchedule = item;
        _draggedQueue = null;
    }

    private void EndDrag()
    {
        _draggedQueue = null;
        _draggedSchedule = null;
        _dropDate = null;
    }

    private async Task DropAsync(WireDay day)
    {
        _dropDate = null;
        if (_draggedQueue is { } queueItem)
        {
            _slotDialog?.Open(queueItem, day.Date, 9 * 60);
            EndDrag();
            return;
        }

        if (_draggedSchedule is not { } scheduleItem)
        {
            return;
        }

        var local = WireTime.Local(scheduleItem);
        var minutes = WireTime.Minutes(local);
        if (WireTime.IsSameSlot(scheduleItem, day.Date, minutes))
        {
            EndDrag();
            return;
        }

        var request = new WireSlotRequest(null, scheduleItem, day.Date, minutes);
        EndDrag();
        if (WireTime.ToUtc(day.Date, minutes, TimeZoneInfo.FindSystemTimeZoneById(Data.TimeZone)) is null)
        {
            _slotDialog?.Open(request);
            return;
        }

        await Slot.InvokeAsync(request);
    }

    private DateOnly DefaultSlotDate => Data.Days.FirstOrDefault(day => day.IsToday && day.HasPostingWindow)?.Date
        ?? Data.Days.First(day => day.HasPostingWindow).Date;
}