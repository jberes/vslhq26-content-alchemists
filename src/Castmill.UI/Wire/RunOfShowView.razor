@namespace Castmill.UI.Scheduling
@using System.Globalization
@implements IAsyncDisposable
@inject IJSRuntime JS

<section @ref="_root" class="cm-run-show__projection" aria-label="Run of show">
    @if (!Data.BrokerConfigured)
    {
        <div class="cm-run-show__broker blueprint" role="status">
            <span class="cm-run-show__broker-label">No broker</span>
            <span>Nothing leaves Castmill until a publishing broker is connected — everything below stages locally.</span>
            <IgbButton @onclick="() => ConnectBroker.InvokeAsync()">Connect broker</IgbButton>
        </div>
    }

    <div class="cm-run-show__frame">
        <QueueRail Items="Data.Queue"
                   Edit="Edit"
                   Slot="OpenSlot" />

        <div class="cm-run-show__timeline">
            <div class="cm-run-show__ruler" aria-label="Posting time ruler">
                @foreach (var time in RulerTimes)
                {
                    <span>@time</span>
                }
            </div>

            <div class="cm-run-show__days">
                @foreach (var day in VisibleDays)
                {
                    <div class="@DayClass(day)">
                        <div class="cm-run-show__day-gutter">
                            <strong>@DayLabel(day)</strong>
                            @if (day.HasPostingWindow && day.Items.Count > 0)
                            {
                                <span class="@DayStateClass(day)">@DayState(day)</span>
                            }
                        </div>
                        @if (!day.HasPostingWindow)
                        {
                            <div class="cm-run-show__lane cm-run-show__lane--collapsed">
                                collapsed — no posting window
                            </div>
                        }
                        else
                        {
                            <div class="@LaneClass(day)" style="@LaneStyle(day)"
                                 data-wire-lane="@day.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">
                                @if (day.Items.Count == 0)
                                {
                                    <span class="cm-run-show__empty-copy">nothing scheduled — drop here</span>
                                }
                                @foreach (var item in day.Items)
                                {
                                    <article class="cm-run-show__item cm-run-show__item--@StatusName(item.Status)"
                                             style="@PositionStyle(day, item)"
                                             data-wire-drag="@(CanDrag(item.Status) ? $"s:{item.Id}" : null)">
                                        <span class="cm-run-show__item-copy">
                                            <span class="cm-run-show__item-meta">
                                                <span>@WireTime.Local(item).ToString("HH:mm", CultureInfo.InvariantCulture)</span>
                                                <span class="cm-run-show__channel">@item.Channel</span>
                                                <IgbChip class="cm-run-show__status-chip" Outlined="true">@StatusLabel(item.Status)</IgbChip>
                                            </span>
                                            <span class="cm-run-show__item-title cm-wire-clamp-1">@item.Title</span>
                                            @if (item.Status == WireDeliveryStatus.Sent)
                                            {
                                                <span class="cm-run-show__receipt" aria-label="Delivery receipt">
                                                    @if (item.SentAtUtc is { } sentAt)
                                                    {
                                                        <time datetime="@sentAt.ToString("O", CultureInfo.InvariantCulture)">@WireTime.Local(item with { ScheduledAtUtc = sentAt }).ToString("d MMM HH:mm", CultureInfo.CurrentCulture)</time>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(item.BrokerRef))
                                                    {
                                                        <span>@item.BrokerRef</span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(item.Permalink))
                                                    {
                                                        <a href="@item.Permalink" target="_blank" rel="noopener noreferrer">Live post</a>
                                                    }
                                                </span>
                                            }
                                            else if (item.Status == WireDeliveryStatus.Blocked)
                                            {
                                                <span class="cm-run-show__blocked">@item.BlockedReason</span>
                                            }
                                            else if (item.Status == WireDeliveryStatus.Error)
                                            {
                                                <span class="cm-run-show__blocked">@item.LastError</span>
                                            }
                                        </span>
                                        @if (item.Status != WireDeliveryStatus.Sent)
                                        {
                                            <span class="cm-run-show__item-actions" aria-label="Scheduled item actions">
                                                <WireIconButton Kind="move" Label="Move" OnClick="() => OpenMove(item)" />
                                                @if (item.Status == WireDeliveryStatus.Error)
                                                {
                                                    <WireIconButton Kind="retry" Label="Retry" OnClick="() => Retry.InvokeAsync(item)" />
                                                }
                                            </span>
                                        }
                                    </article>
                                }
                                @if (day.Items.Count > 0)
                                {
                                    <span class="cm-run-show__lane-spacer" aria-hidden="true"></span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <SlotDialog @ref="_slotDialog" TimeZone="@Data.TimeZone" Confirmed="Slot" />
</section>

@code {
    private const string ModulePath = "./_content/Castmill.UI/js/castmill-wire.js?v=4";
    private static readonly string[] RulerTimes = ["06:00", "09:00", "12:00", "15:00", "18:00", "21:00"];
    private ElementReference _root;
    private IJSObjectReference? _module;
    private IJSObjectReference? _dragSession;
    private DotNetObjectReference<RunOfShowView>? _selfReference;
    private SlotDialog? _slotDialog;

    [Parameter, EditorRequired] public WireBoardData Data { get; set; } = default!;
    [Parameter] public EventCallback<WireQueueItem> Edit { get; set; }
    [Parameter] public EventCallback<WireSlotRequest> Slot { get; set; }
    [Parameter] public EventCallback<WireScheduleItem> Retry { get; set; }
    [Parameter] public EventCallback ConnectBroker { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // Pointer-based drag: HTML5 drag events are unreliable in embedded WebViews
        // (WebView2 and Catalyst's WKWebView), so the JS module drives the gesture and
        // calls back with the drop target. The Slot button remains the keyboard path.
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            _selfReference = DotNetObjectReference.Create(this);
            _dragSession = await _module.InvokeAsync<IJSObjectReference>(
                "armPointerDrag", _root, _selfReference);
        }
        catch (JSException)
        {
        }
    }

    [JSInvokable]
    public async Task DropFromPointerAsync(string dragId, string targetKind, string targetValue, double ratio)
    {
        if (targetKind != "lane"
            || !DateOnly.TryParseExact(targetValue, "yyyy-MM-dd", out var date))
        {
            return;
        }

        var queueItem = ResolveQueueItem(dragId);
        var scheduleItem = ResolveScheduleItem(dragId);
        if (queueItem is null && scheduleItem is null)
        {
            return;
        }

        var minutes = WireTime.Snap(ratio, Data.WindowStart, Data.WindowEnd);
        var request = new WireSlotRequest(queueItem, scheduleItem, date, minutes);
        if (WireTime.ToUtc(date, minutes, TimeZoneInfo.FindSystemTimeZoneById(Data.TimeZone)) is null)
        {
            _slotDialog?.Open(request);
            await InvokeAsync(StateHasChanged);
            return;
        }
        if (scheduleItem is { } moving && WireTime.IsSameSlot(moving, date, minutes))
        {
            return;
        }

        await InvokeAsync(() => Slot.InvokeAsync(request));
    }

    private WireQueueItem? ResolveQueueItem(string dragId) =>
        dragId.StartsWith("q:", StringComparison.Ordinal)
            ? Data.Queue.FirstOrDefault(item => $"q:{item.ArtifactId}:{item.ChannelId}" == dragId)
            : null;

    private WireScheduleItem? ResolveScheduleItem(string dragId) =>
        dragId.StartsWith("s:", StringComparison.Ordinal) && Guid.TryParse(dragId[2..], out var id)
            ? Data.Items.FirstOrDefault(item => item.Id == id)
            : null;

    private IReadOnlyList<WireDay> VisibleDays
    {
        get
        {
            var visible = new List<WireDay>();
            for (var index = 0; index < Data.Days.Count; index++)
            {
                var day = Data.Days[index];
                if (day.HasPostingWindow)
                {
                    visible.Add(day);
                    continue;
                }

                var end = day.Date;
                while (index + 1 < Data.Days.Count && !Data.Days[index + 1].HasPostingWindow)
                {
                    end = Data.Days[++index].Date;
                }
                visible.Add(day with { EndDate = end, Items = [] });
            }
            return visible;
        }
    }

    private static string DayClass(WireDay day) => string.Join(' ', new[]
    {
        "cm-run-show__day",
        day.IsToday ? "cm-run-show__day--today" : null,
        !day.HasPostingWindow ? "cm-run-show__day--weekend" : null,
        day.HasPostingWindow && day.Items.Count == 0 ? "cm-run-show__day--empty" : null,
    }.Where(value => value is not null));

    private static string LaneClass(WireDay day) => string.Join(' ', new[]
    {
        "cm-run-show__lane",
        day.Items.Count == 0 ? "cm-run-show__lane--empty" : null,
    }.Where(value => value is not null));

    private static string DayLabel(WireDay day) => !day.HasPostingWindow
        ? day.EndDate == day.Date
            ? day.Date.ToString("ddd d MMM", CultureInfo.CurrentCulture).ToUpperInvariant()
            : $"{day.Date:ddd}–{day.EndDate:ddd}".ToUpperInvariant()
        : day.Date.ToString("ddd d MMM", CultureInfo.CurrentCulture).ToUpperInvariant();

    private static string DayState(WireDay day)
    {
        var errors = day.Items.Count(item => item.Status is WireDeliveryStatus.Error or WireDeliveryStatus.Blocked);
        var sent = day.Items.Count(item => item.Status == WireDeliveryStatus.Sent);
        var queued = day.Items.Count - errors - sent;
        if (errors > 0)
        {
            return $"{errors} error";
        }
        if (day.IsToday)
        {
            return $"today · {queued} queued";
        }
        if (sent > 0)
        {
            return $"{sent} sent";
        }
        return $"{queued} queued";
    }

    private static string DayStateClass(WireDay day) =>
        day.Items.Any(item => item.Status is WireDeliveryStatus.Error or WireDeliveryStatus.Blocked)
            ? "cm-run-show__day-state cm-run-show__day-state--error"
            : day.IsToday
                ? "cm-run-show__day-state cm-run-show__day-state--today"
                : "cm-run-show__day-state";

    private string PositionStyle(WireDay day, WireScheduleItem item)
    {
        var minutes = WireTime.Minutes(WireTime.Local(item));
        var start = (Data.WindowStart.Hour * 60) + Data.WindowStart.Minute;
        var end = (Data.WindowEnd.Hour * 60) + Data.WindowEnd.Minute;
        var percent = Math.Clamp((minutes - start) * 100d / (end - start), 0d, 100d);
        var level = WireTime.StackLevels(day.Items).GetValueOrDefault(item.Id);
        return $"--cm-wire-left: {percent.ToString("0.###", CultureInfo.InvariantCulture)}%; --cm-wire-level: {level};";
    }

    private static string LaneStyle(WireDay day)
    {
        var levels = WireTime.StackLevels(day.Items);
        var rows = levels.Count == 0 ? 0 : levels.Values.Max() + 1;
        return $"--cm-wire-rows: {rows};";
    }

    private static string StatusName(WireDeliveryStatus status) => status.ToString().ToLowerInvariant();
    private static bool CanDrag(WireDeliveryStatus status) => status is not WireDeliveryStatus.Sent;

    private string StatusLabel(WireDeliveryStatus status) => status switch
    {
        WireDeliveryStatus.Draft or WireDeliveryStatus.Queued when !Data.BrokerConfigured => "STAGED",
        WireDeliveryStatus.Staged => "STAGED",
        WireDeliveryStatus.Blocked => "NO URL",
        _ => status.ToString().ToUpperInvariant(),
    };

    private void OpenSlot(WireQueueItem item) =>
        _slotDialog?.Open(item, DefaultSlotDate, 9 * 60);

    private void OpenMove(WireScheduleItem item) => _slotDialog?.Open(item);

    private DateOnly DefaultSlotDate => Data.Days.FirstOrDefault(day => day.IsToday && day.HasPostingWindow)?.Date
        ?? Data.Days.First(day => day.HasPostingWindow).Date;

    public async ValueTask DisposeAsync()
    {
        if (_dragSession is not null)
        {
            try
            {
                await _dragSession.InvokeVoidAsync("dispose");
                await _dragSession.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _selfReference?.Dispose();
    }
}
