@* Icon-only card action. The accessible name is the Label (aria-label + tooltip); the
   glyph is decorative. Cards stay compact — no worded buttons inside cards. *@
@namespace Castmill.UI.Scheduling

<button type="button" class="cm-wire-icon-btn" title="@Label" aria-label="@Label"
        @onclick="OnClick" @onclick:stopPropagation>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        @((MarkupString)IconMarkup)
    </svg>
</button>

@code {
    [Parameter, EditorRequired] public string Kind { get; set; } = default!;
    [Parameter, EditorRequired] public string Label { get; set; } = default!;
    [Parameter] public EventCallback OnClick { get; set; }

    private string IconMarkup => Kind switch
    {
        // Pencil.
        "edit" => "<path d='M12 20h9'/><path d='M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z'/>",
        // Calendar with a plus: pick a slot.
        "slot" => "<rect x='3' y='4' width='18' height='17' rx='0'/><path d='M8 2v4M16 2v4M3 9h18M12 13v5M9.5 15.5h5'/>",
        // Clock with an arrow: reschedule.
        "move" => "<circle cx='12' cy='12' r='8'/><path d='M12 8v4l3 2'/>",
        // Circular arrow: retry.
        "retry" => "<path d='M21 12a9 9 0 1 1-2.64-6.36'/><path d='M21 3v6h-6'/>",
        // Tray with a down arrow: export.
        "export" => "<path d='M12 3v10'/><path d='m8 9 4 4 4-4'/><path d='M4 17v3h16v-3'/>",
        _ => string.Empty,
    };
}
