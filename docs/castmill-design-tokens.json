{
  "$description": "Castmill design tokens — two theme families (Warm Editorial, Industry Blueprint) × light/dark, plus the shared type/space/motion scale. Generated from src/Castmill.UI/wwwroot/css/tokens. Format: W3C Design Tokens Community Group (DTCG). Colours with alpha are 8-digit hex; the original CSS is kept in $extensions['com.castmill.css'].",
  "shared": {
    "font": {
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "IBM Plex Mono",
          "ui-monospace",
          "SF Mono",
          "Menlo",
          "monospace"
        ]
      }
    },
    "fontSize": {
      "h1": {
        "$type": "dimension",
        "$value": "2.625rem",
        "$description": "Fluid: max size. Use the CSS clamp in $extensions on the web.",
        "$extensions": {
          "com.castmill.css": "clamp(2rem, 1.6rem + 1.4vw, 2.625rem)"
        }
      },
      "h2": {
        "$type": "dimension",
        "$value": "2rem"
      },
      "h3": {
        "$type": "dimension",
        "$value": "1.5625rem"
      },
      "h4": {
        "$type": "dimension",
        "$value": "1.25rem"
      },
      "body": {
        "$type": "dimension",
        "$value": "1rem"
      },
      "meta": {
        "$type": "dimension",
        "$value": "0.8125rem"
      },
      "kicker": {
        "$type": "dimension",
        "$value": "0.6875rem"
      }
    },
    "lineHeight": {
      "tight": {
        "$type": "number",
        "$value": 1.15
      },
      "body": {
        "$type": "number",
        "$value": 1.55
      },
      "loose": {
        "$type": "number",
        "$value": 1.62
      }
    },
    "letterSpacing": {
      "kicker": {
        "$type": "dimension",
        "$value": "0.13em"
      },
      "wordmark": {
        "$type": "dimension",
        "$value": "0.18em"
      }
    },
    "space": {
      "unit": {
        "$type": "dimension",
        "$value": "4px",
        "$description": "Base unit; every step is a multiple. Compact density sets it to 3.4px."
      },
      "1": {
        "$type": "dimension",
        "$value": "4px"
      },
      "2": {
        "$type": "dimension",
        "$value": "8px"
      },
      "3": {
        "$type": "dimension",
        "$value": "12px"
      },
      "4": {
        "$type": "dimension",
        "$value": "16px"
      },
      "6": {
        "$type": "dimension",
        "$value": "24px"
      },
      "8": {
        "$type": "dimension",
        "$value": "32px"
      },
      "12": {
        "$type": "dimension",
        "$value": "48px"
      }
    },
    "density": {
      "compact": {
        "spaceUnit": {
          "$type": "dimension",
          "$value": "3.4px"
        },
        "lineHeightBody": {
          "$type": "number",
          "$value": 1.45
        }
      }
    },
    "motion": {
      "duration": {
        "$type": "duration",
        "$value": "200ms",
        "$description": "Collapse to 1ms under prefers-reduced-motion. No bounce, no parallax."
      },
      "easing": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0.0,
          0.2,
          1.0
        ]
      }
    },
    "statusBarWidth": {
      "$type": "dimension",
      "$value": "3px"
    },
    "color": {
      "scrim": {
        "$type": "color",
        "$value": "#00000070",
        "$extensions": {
          "com.castmill.css": "rgb(0 0 0 / 0.44)"
        },
        "$description": "Modal backdrop; same in every theme."
      }
    }
  },
